# RUN: llc -mtriple=riscv64 -mcpu=xiangshan-kunminghu -run-pass=riscv-vplan-analytics -verify-machineinstrs -vplan-ra-run-id=test -vplan-probe-candidate=copy:0:0:s4 -vplan-analytics-output=%t.json.analytics %s -o %t.mir
# RUN: %python %S/Inputs/check-observation.py %t.json.analytics
# Observe whole-register copies and physical groups alongside memory and arithmetic.
--- |
  define void @copy() #0 {
  entry:
    br label %loop
  loop:
    br i1 true, label %loop, label %exit, !llvm.loop !900
  exit:
    ret void
  }
  attributes #0 = { "vplan.ra.iteration-mapping"="1" "vplan.ra.width"="4" "vplan.ra.vf"="4" "vplan.ra.scalable"="1" "vplan.ra.candidate"="copy:0:0:s4" }
  !900 = distinct !{!900, !901}
  !901 = !{!"llvm.loop.vplan.candidate", !"copy:0:0:s4"}
...
---
name: copy
tracksRegLiveness: false
stack:
  - { id: 0, type: spill-slot, size: 16, alignment: 8, stack-id: scalable-vector }
body: |
  bb.0.entry:
    successors: %bb.1
    $v8m8 = COPY $v16m8
    PseudoBR %bb.1

  bb.1.loop:
    successors: %bb.1, %bb.2
    $x13 = PseudoVSETVLI $x12, 215, implicit-def $vl, implicit-def $vtype
    $v8 = COPY $v10
    $v8m2 = COPY $v12m2
    $v8m4 = COPY $v12m4
    $v8m8 = COPY $v16m8
    $v0 = COPY $v1
    $v8 = COPY $v8
    $v8m2 = COPY $v8m2
    $v8m4 = COPY $v8m4
    $v8m8 = COPY $v8m8
    $v0 = COPY $v0
    $x11 = COPY $x10
    $v8m2 = PseudoVADD_VV_M2 undef $v8m2, $v12m2, $v14m2, $noreg, 5, 1, implicit $vl, implicit $vtype
    $v8 = PseudoVFADD_VV_M1_E32 undef $v8, $v10, $v11, 7, $noreg, 5, 1, implicit $frm, implicit $vl, implicit $vtype
    $v8m2 = PseudoVFMACC_VV_M2_E64 $v8m2, $v12m2, $v14m2, 7, $noreg, 6, 0, implicit $frm, implicit $vl, implicit $vtype
    $v8m4 = PseudoVLSE32_V_M4_MASK undef $v8m4, $x10, $x11, $v0, $noreg, 5, 2, implicit $vl, implicit $vtype
    VS2R_V $v8m2, %stack.0
    $v8m2 = VL2RE8_V %stack.0
    $x12 = ADDI $x12, -1
    BNE $x12, $x0, %bb.1
    PseudoBR %bb.2

  bb.2.exit:
    $v8m8 = COPY $v16m8
    PseudoRET
...
