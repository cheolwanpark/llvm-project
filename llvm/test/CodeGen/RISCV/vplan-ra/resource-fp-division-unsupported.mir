# RUN: llc -mtriple=riscv64 -mcpu=xiangshan-kunminghu -run-pass=riscv-vplan-analytics -verify-machineinstrs -vplan-ra-run-id=test -vplan-probe-candidate=unsupported:0:0:s4 -vplan-analytics-output=%t.json.analytics %s -o %t.mir
# RUN: %python %S/Inputs/check-raw.py %t.json.analytics %S/Inputs/resource-fp-division-unsupported.json 0
# A supported divide does not enable square root or other unsupported work.
# The partial observation proves divide was accepted before square root
# stopped collection. Arithmetic counters still exclude division service.
--- |
  define void @unsupported() #0 {
  entry:
    br label %loop
  loop:
    br i1 true, label %loop, label %exit, !llvm.loop !900
  exit:
    ret void
  }
  attributes #0 = { "vplan.ra.iteration-mapping"="1" "vplan.ra.width"="4" "vplan.ra.vf"="4" "vplan.ra.scalable"="1" "vplan.ra.candidate"="unsupported:0:0:s4" }
  !900 = distinct !{!900, !901}
  !901 = !{!"llvm.loop.vplan.candidate", !"unsupported:0:0:s4"}
...
---
name: unsupported
tracksRegLiveness: false
body: |
  bb.0.entry:
    successors: %bb.1
    PseudoBR %bb.1
  bb.1.loop:
    successors: %bb.1, %bb.2
    $x13 = PseudoVSETVLI $x12, 208, implicit-def $vl, implicit-def $vtype
    $v8m2 = PseudoVFDIV_VV_M2_E32 undef $v8m2, $v12m2, $v14m2, 7, $noreg, 5, 3, implicit $frm, implicit $vl, implicit $vtype
    $v8m2 = PseudoVFSQRT_V_M2_E32 undef $v8m2, $v12m2, 7, $noreg, 5, 3, implicit $frm, implicit $vl, implicit $vtype
    BNE $x12, $x0, %bb.1
    PseudoBR %bb.2
  bb.2.exit:
    PseudoRET
...
