# RUN: split-file %s %t
# RUN: llc -mtriple=riscv64 -mcpu=xiangshan-kunminghu -run-pass=riscv-vplan-analytics -verify-machineinstrs -vplan-ra-run-id=test -vplan-probe-candidate=loads:0:0:s4 -vplan-analytics-output=%t.loads.json.analytics %t/loads.mir -o %t.loads.mir
# RUN: %python %S/Inputs/check-raw.py %t.loads.json.analytics %S/Inputs/resource-memory-direction.json 0
# RUN: llc -mtriple=riscv64 -mcpu=xiangshan-kunminghu -run-pass=riscv-vplan-analytics -verify-machineinstrs -vplan-ra-run-id=test -vplan-probe-candidate=stores:0:0:s4 -vplan-analytics-output=%t.stores.json.analytics %t/stores.mir -o %t.stores.mir
# RUN: %python %S/Inputs/check-raw.py %t.stores.json.analytics %S/Inputs/resource-memory-direction.json 1
#
# No MachineMemOperands are supplied: load/store direction must come from
# instruction descriptor metadata. Identical loads and stores preserve access
# class, SEW, fractional/integral data grouping, index grouping, masking and
# predicate provenance. Configuration and loop-control instructions are not
# operation records. Mixed directions and spill exclusion are checked in
# resource-demand.mir.
#

#--- loads.mir
--- |
  define void @loads() #0 {
  entry:
    br label %loop
  loop:
    br i1 true, label %loop, label %exit, !llvm.loop !900
  exit:
    ret void
  }
  attributes #0 = { "vplan.ra.iteration-mapping"="1" "vplan.ra.width"="4" "vplan.ra.vf"="4" "vplan.ra.scalable"="1" "vplan.ra.candidate"="loads:0:0:s4" }
  !900 = distinct !{!900, !901}
  !901 = !{!"llvm.loop.vplan.candidate", !"loads:0:0:s4"}
...
---
name: loads
tracksRegLiveness: false
body: |
  bb.0.entry:
    successors: %bb.1
    PseudoBR %bb.1
  bb.1.loop:
    successors: %bb.1, %bb.2
    $x13 = PseudoVSETVLI $x12, 210, implicit-def $vl, implicit-def $vtype
    $v8 = PseudoVLE16_V_MF2 undef $v8, $x10, $noreg, 4, 2, implicit $vl, implicit $vtype
    $v8m8 = PseudoVLE32_V_M8 undef $v8m8, $x10, $noreg, 5, 2, implicit $vl, implicit $vtype
    $v8m4 = PseudoVLSE32_V_M4_MASK undef $v8m4, $x10, $x11, $v0, $noreg, 5, 2, implicit $vl, implicit $vtype
    $v8m4 = PseudoVLUXEI32_V_M4_M4_MASK undef $v8m4, $x10, $v16m4, $v0, $noreg, 5, 2, implicit $vl, implicit $vtype
    BNE $x12, $x0, %bb.1
    PseudoBR %bb.2
  bb.2.exit:
    PseudoRET
...

#--- stores.mir
--- |
  define void @stores() #0 {
  entry:
    br label %loop
  loop:
    br i1 true, label %loop, label %exit, !llvm.loop !900
  exit:
    ret void
  }
  attributes #0 = { "vplan.ra.iteration-mapping"="1" "vplan.ra.width"="4" "vplan.ra.vf"="4" "vplan.ra.scalable"="1" "vplan.ra.candidate"="stores:0:0:s4" }
  !900 = distinct !{!900, !901}
  !901 = !{!"llvm.loop.vplan.candidate", !"stores:0:0:s4"}
...
---
name: stores
tracksRegLiveness: false
body: |
  bb.0.entry:
    successors: %bb.1
    PseudoBR %bb.1
  bb.1.loop:
    successors: %bb.1, %bb.2
    $x13 = PseudoVSETVLI $x12, 210, implicit-def $vl, implicit-def $vtype
    PseudoVSE16_V_MF2 $v8, $x10, $noreg, 4, implicit $vl, implicit $vtype
    PseudoVSE32_V_M8 $v8m8, $x10, $noreg, 5, implicit $vl, implicit $vtype
    PseudoVSSE32_V_M4_MASK $v8m4, $x10, $x11, $v0, $noreg, 5, implicit $vl, implicit $vtype
    PseudoVSUXEI32_V_M4_M4_MASK $v8m4, $x10, $v16m4, $v0, $noreg, 5, implicit $vl, implicit $vtype
    BNE $x12, $x0, %bb.1
    PseudoBR %bb.2
  bb.2.exit:
    PseudoRET
...
