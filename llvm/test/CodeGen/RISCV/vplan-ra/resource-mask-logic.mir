# RUN: llc -mtriple=riscv64 -mcpu=xiangshan-kunminghu -riscv-v-vector-bits-min=128 -run-pass=riscv-vplan-analytics -verify-machineinstrs -vplan-ra-run-id=test -vplan-probe-candidate=mask_logic:0:0:s4 -vplan-analytics-output=%t.128.json.analytics %s -o %t.128.mir
# RUN: %python %S/Inputs/check-observation.py %t.128.json.analytics
# RUN: llc -mtriple=riscv64 -mcpu=xiangshan-kunminghu -riscv-v-vector-bits-min=256 -run-pass=riscv-vplan-analytics -verify-machineinstrs -vplan-ra-run-id=test -vplan-probe-candidate=mask_logic:0:0:s4 -vplan-analytics-output=%t.256.json.analytics %s -o %t.256.mir
# RUN: %python %S/Inputs/check-observation.py %t.256.json.analytics
# RUN: llc -mtriple=riscv64 -mcpu=xiangshan-kunminghu -riscv-v-vector-bits-min=1024 -run-pass=riscv-vplan-analytics -verify-machineinstrs -vplan-ra-run-id=test -vplan-probe-candidate=mask_logic:0:0:s4 -vplan-analytics-output=%t.1024.json.analytics %s -o %t.1024.mir
# RUN: %python %S/Inputs/check-observation.py %t.1024.json.analytics
# RUN: llc -mtriple=riscv64 -mcpu=xiangshan-kunminghu -riscv-v-vector-bits-min=2048 -run-pass=riscv-vplan-analytics -verify-machineinstrs -vplan-ra-run-id=test -vplan-probe-candidate=mask_logic:0:0:s4 -vplan-analytics-output=%t.2048.json.analytics %s -o %t.2048.mir
# RUN: %python %S/Inputs/check-observation.py %t.2048.json.analytics
# RUN: llc -mtriple=riscv64 -mcpu=xiangshan-kunminghu -riscv-v-vector-bits-min=128 -run-pass=none -verify-machineinstrs %s -o %t.before.mir
# RUN: diff %t.before.mir %t.128.mir
# Preserve mask SEW operands and register units; the observer must leave MIR unchanged.
--- |
  define void @mask_logic() #0 {
  entry:
    br label %loop
  loop:
    br i1 true, label %loop, label %exit, !llvm.loop !900
  exit:
    ret void
  }
  attributes #0 = { "vplan.ra.iteration-mapping"="1" "vplan.ra.width"="4" "vplan.ra.vf"="4" "vplan.ra.scalable"="1" "vplan.ra.candidate"="mask_logic:0:0:s4" }
  !900 = distinct !{!900, !901}
  !901 = !{!"llvm.loop.vplan.candidate", !"mask_logic:0:0:s4"}
...
---
name: mask_logic
tracksRegLiveness: false
body: |
  bb.0.entry:
    successors: %bb.1
    $v8 = PseudoVMSET_M_B1 $noreg, 0, implicit $vl, implicit $vtype
    PseudoBR %bb.1
  bb.1.loop:
    successors: %bb.1, %bb.2
    $x13 = PseudoVSETVLI $x12, 208, implicit-def $vl, implicit-def $vtype
    $v8 = PseudoVMAND_MM_B1 $v10, $v11, $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMAND_MM_B2 $v10, $v11, $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMAND_MM_B4 $v10, $v11, $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMAND_MM_B8 $v10, $v11, $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMAND_MM_B16 $v10, $v11, $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMAND_MM_B32 $v10, $v11, $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMAND_MM_B64 $v10, $v11, -1, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMNAND_MM_B1 $v10, $v11, $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMNAND_MM_B2 $v10, $v11, $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMNAND_MM_B4 $v10, $v11, $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMNAND_MM_B8 $v10, $v11, $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMNAND_MM_B16 $v10, $v11, $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMNAND_MM_B32 $v10, $v11, $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMNAND_MM_B64 $v10, $v11, -1, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMANDN_MM_B1 $v10, $v11, $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMANDN_MM_B2 $v10, $v11, $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMANDN_MM_B4 $v10, $v11, $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMANDN_MM_B8 $v10, $v11, $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMANDN_MM_B16 $v10, $v11, $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMANDN_MM_B32 $v10, $v11, $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMANDN_MM_B64 $v10, $v11, -1, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMXOR_MM_B1 $v10, $v11, $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMXOR_MM_B2 $v10, $v11, $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMXOR_MM_B4 $v10, $v11, $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMXOR_MM_B8 $v10, $v11, $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMXOR_MM_B16 $v10, $v11, $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMXOR_MM_B32 $v10, $v11, $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMXOR_MM_B64 $v10, $v11, -1, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMOR_MM_B1 $v10, $v11, $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMOR_MM_B2 $v10, $v11, $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMOR_MM_B4 $v10, $v11, $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMOR_MM_B8 $v10, $v11, $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMOR_MM_B16 $v10, $v11, $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMOR_MM_B32 $v10, $v11, $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMOR_MM_B64 $v10, $v11, -1, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMNOR_MM_B1 $v10, $v11, $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMNOR_MM_B2 $v10, $v11, $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMNOR_MM_B4 $v10, $v11, $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMNOR_MM_B8 $v10, $v11, $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMNOR_MM_B16 $v10, $v11, $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMNOR_MM_B32 $v10, $v11, $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMNOR_MM_B64 $v10, $v11, -1, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMORN_MM_B1 $v10, $v11, $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMORN_MM_B2 $v10, $v11, $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMORN_MM_B4 $v10, $v11, $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMORN_MM_B8 $v10, $v11, $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMORN_MM_B16 $v10, $v11, $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMORN_MM_B32 $v10, $v11, $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMORN_MM_B64 $v10, $v11, -1, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMXNOR_MM_B1 $v10, $v11, $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMXNOR_MM_B2 $v10, $v11, $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMXNOR_MM_B4 $v10, $v11, $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMXNOR_MM_B8 $v10, $v11, $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMXNOR_MM_B16 $v10, $v11, $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMXNOR_MM_B32 $v10, $v11, $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMXNOR_MM_B64 $v10, $v11, -1, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMCLR_M_B1 $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMCLR_M_B2 $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMCLR_M_B4 $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMCLR_M_B8 $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMCLR_M_B16 $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMCLR_M_B32 $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMCLR_M_B64 -1, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMSET_M_B1 $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMSET_M_B2 $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMSET_M_B4 $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMSET_M_B8 $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMSET_M_B16 $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMSET_M_B32 $noreg, 0, implicit $vl, implicit $vtype
    $v8 = PseudoVMSET_M_B64 -1, 0, implicit $vl, implicit $vtype
    $x12 = ADDI $x12, -1
    BNE $x12, $x0, %bb.1
    PseudoBR %bb.2
  bb.2.exit:
    $v8 = PseudoVMCLR_M_B1 $noreg, 0, implicit $vl, implicit $vtype
    PseudoRET
...
