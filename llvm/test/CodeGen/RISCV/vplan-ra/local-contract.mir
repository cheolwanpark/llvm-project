# RUN: llc -mtriple=riscv64 -mcpu=xiangshan-kunminghu -run-pass=riscv-vplan-analytics -verify-machineinstrs -vplan-ra-run-id=test -vplan-probe-candidate=contract:0:0:s4 -vplan-analytics-output=%t.json %s -o %t.observed.mir
# RUN: %python %S/Inputs/check-local-contract.py %t.json
# RUN: llc -mtriple=riscv64 -mcpu=xiangshan-kunminghu -run-pass=none -verify-machineinstrs %s -o %t.plain.mir
# RUN: diff %t.plain.mir %t.observed.mir
--- |
  define void @contract() #0 {
  entry:
    br label %loop
  loop:
    br i1 true, label %loop, label %exit, !llvm.loop !0
  exit:
    ret void
  }
  attributes #0 = { "vplan.ra.iteration-mapping"="1" "vplan.ra.width"="16" "vplan.ra.vf"="4" "vplan.ra.scalable"="1" "vplan.ra.candidate"="contract:0:0:s4" }
  !0 = distinct !{!0, !1}
  !1 = !{!"llvm.loop.vplan.candidate", !"contract:0:0:s4"}
...
---
name: contract
tracksRegLiveness: false
stack:
  - { id: 0, type: spill-slot, size: 8, alignment: 8 }
body: |
  bb.0.entry:
    successors: %bb.1
    $x10 = ADDI $x0, 128
    PseudoBR %bb.1
  bb.1.loop:
    successors: %bb.1, %bb.2
    $x11 = ADDI $x11, 1
    $x12 = ADD $x11, $x13
    SD $x12, %stack.0, 0 :: (store (s64) into %stack.0)
    $x14 = LD %stack.0, 0 :: (load (s64) from %stack.0)
    BNE $x11, $x10, %bb.1
    PseudoBR %bb.2
  bb.2.exit:
    PseudoRET
...
