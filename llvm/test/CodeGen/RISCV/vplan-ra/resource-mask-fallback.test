# RUN: split-file %s %t
# RUN: llc -mtriple=riscv64 -mcpu=xiangshan-kunminghu -run-pass=riscv-vplan-analytics -verify-machineinstrs -vplan-ra-run-id=test -vplan-probe-candidate=mask_fallback:0:0:s4 -vplan-analytics-output=%t/population.out.json.analytics %t/population.mir -o %t/population.out.mir
# RUN: %python %S/Inputs/check-raw.py %t/population.out.json.analytics %S/Inputs/resource-mask-fallback.json 0
# RUN: llc -mtriple=riscv64 -mcpu=xiangshan-kunminghu -run-pass=riscv-vplan-analytics -verify-machineinstrs -vplan-ra-run-id=test -vplan-probe-candidate=mask_fallback:0:0:s4 -vplan-analytics-output=%t/first.out.json.analytics %t/first.mir -o %t/first.out.mir
# RUN: %python %S/Inputs/check-raw.py %t/first.out.json.analytics %S/Inputs/resource-mask-fallback.json 1
# RUN: llc -mtriple=riscv64 -mcpu=xiangshan-kunminghu -run-pass=riscv-vplan-analytics -verify-machineinstrs -vplan-ra-run-id=test -vplan-probe-candidate=mask_fallback:0:0:s4 -vplan-analytics-output=%t/prefix.out.json.analytics %t/prefix.mir -o %t/prefix.out.mir
# RUN: %python %S/Inputs/check-raw.py %t/prefix.out.json.analytics %S/Inputs/resource-mask-fallback.json 2
# RUN: llc -mtriple=riscv64 -mcpu=xiangshan-kunminghu -run-pass=riscv-vplan-analytics -verify-machineinstrs -vplan-ra-run-id=test -vplan-probe-candidate=mask_fallback:0:0:s4 -vplan-analytics-output=%t/load.out.json.analytics %t/load.mir -o %t/load.out.mir
# RUN: %python %S/Inputs/check-raw.py %t/load.out.json.analytics %S/Inputs/resource-mask-fallback.json 3
# RUN: llc -mtriple=riscv64 -mcpu=xiangshan-kunminghu -run-pass=riscv-vplan-analytics -verify-machineinstrs -vplan-ra-run-id=test -vplan-probe-candidate=mask_fallback:0:0:s4 -vplan-analytics-output=%t/store.out.json.analytics %t/store.mir -o %t/store.out.mir
# RUN: %python %S/Inputs/check-raw.py %t/store.out.json.analytics %S/Inputs/resource-mask-fallback.json 4
# All fixtures satisfy the verifier, including mask SEW=0 and single VRs.
# Accept the Boolean prefix, then retain unsupported fallback for each distinct
# mask operation. Do not enable general VM families, mask memory or reductions.
#--- population.mir
--- |
  define void @mask_fallback() #0 {
  entry:
    br label %loop
  loop:
    br i1 true, label %loop, label %exit, !llvm.loop !900
  exit:
    ret void
  }
  attributes #0 = { "vplan.ra.iteration-mapping"="1" "vplan.ra.width"="4" "vplan.ra.vf"="4" "vplan.ra.scalable"="1" "vplan.ra.candidate"="mask_fallback:0:0:s4" }
  !900 = distinct !{!900, !901}
  !901 = !{!"llvm.loop.vplan.candidate", !"mask_fallback:0:0:s4"}
...
---
name: mask_fallback
tracksRegLiveness: false
body: |
  bb.0.entry:
    successors: %bb.1
    PseudoBR %bb.1
  bb.1.loop:
    successors: %bb.1, %bb.2
    $x13 = PseudoVSETVLI $x12, 208, implicit-def $vl, implicit-def $vtype
    $v8 = PseudoVMAND_MM_B1 $v10, $v11, $noreg, 0, implicit $vl, implicit $vtype
    $x14 = PseudoVCPOP_M_B8 $v10, $noreg, 0, implicit $vl, implicit $vtype
    $x12 = ADDI $x12, -1
    BNE $x12, $x0, %bb.1
    PseudoBR %bb.2
  bb.2.exit:
    PseudoRET
...
