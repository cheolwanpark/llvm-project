# RUN: llc -mtriple=riscv64 -mcpu=xiangshan-kunminghu -run-pass=riscv-vplan-analytics -verify-machineinstrs -vplan-ra-run-id=test -vplan-probe-candidate=facts:0:0:s2 -vplan-analytics-output=%t.json %s -o %t.observed.mir
# RUN: %python %S/Inputs/check-memory-facts.py %t.json
# RUN: llc -mtriple=riscv64 -mcpu=xiangshan-kunminghu -run-pass=none -verify-machineinstrs %s -o %t.plain.mir
# RUN: diff %t.plain.mir %t.observed.mir
--- |
  define void @facts() #0 {
  entry:
    br label %loop
  loop:
    br i1 true, label %loop, label %exit, !llvm.loop !0
  exit:
    ret void
  }
  attributes #0 = { vscale_range(2,2) "vplan.ra.iteration-mapping"="1" "vplan.ra.width"="4" "vplan.ra.vf"="2" "vplan.ra.scalable"="1" "vplan.ra.candidate"="facts:0:0:s2" }
  !0 = distinct !{!0, !1}
  !1 = !{!"llvm.loop.vplan.candidate", !"facts:0:0:s2"}
...
---
name: facts
tracksRegLiveness: true
body: |
  bb.0.entry:
    successors: %bb.1
    $x10 = ADDI $x0, 128
    $x11 = ADDI $x0, 64
    $x13 = IMPLICIT_DEF
    $x0 = PseudoVSETIVLI 3, 208, implicit-def $vl, implicit-def $vtype
    PseudoBR %bb.1
  bb.1.loop:
    successors: %bb.1, %bb.2
    liveins: $x10, $x11, $x13
    dead $v8 = PseudoVLSE32_V_M1 undef $v8, $x10, $x11, $noreg, 5, 3, implicit $vl, implicit $vtype :: (load unknown-size, align 4)
    $x0 = PseudoVSETIVLI 3, 208, implicit-def $vl, implicit-def $vtype
    dead $v8 = PseudoVLSE32_V_M1 undef $v8, $x10, $x11, $noreg, 5, 3, implicit $vl, implicit $vtype :: (load unknown-size, align 4)
    $x12 = ADDI $x0, -4
    $x0 = PseudoVSETVLIX0X0 $x0, 80, implicit-def $vl, implicit-def $vtype, implicit $vl
    dead $v8 = PseudoVLSE32_V_M1 undef $v8, $x10, killed $x12, $noreg, 5, 3, implicit $vl, implicit $vtype :: (load unknown-size, align 4)
    dead $x14 = PseudoVSETVLIX0 $x0, 208, implicit-def $vl, implicit-def $vtype
    dead $v8 = PseudoVLSE32_V_M1 undef $v8, $x10, $x0, $noreg, 5, 3, implicit $vl, implicit $vtype :: (load unknown-size, align 4)
    dead $x14 = PseudoVSETVLI $x13, 208, implicit-def $vl, implicit-def $vtype
    dead $v8 = PseudoVLSE32_V_M1 undef $v8, $x10, $x13, $noreg, 5, 3, implicit $vl, implicit $vtype :: (load unknown-size, align 4)
    $x14 = PseudoVSETIVLI 2, 208, implicit-def $vl, implicit-def $vtype
    dead $v8 = PseudoVLSE32_V_M1 undef $v8, $x10, killed $x14, $noreg, 5, 3, implicit $vl, implicit $vtype :: (load unknown-size, align 4)
    $x13 = ADDI $x13, 1
    $x0 = PseudoVSETIVLI 3, 208, implicit-def $vl, implicit-def $vtype
    BNE $x13, $x10, %bb.1
    PseudoBR %bb.2
  bb.2.exit:
    PseudoRET
...
