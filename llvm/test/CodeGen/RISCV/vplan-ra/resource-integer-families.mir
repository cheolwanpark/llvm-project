# RUN: llc -mtriple=riscv64 -mcpu=xiangshan-kunminghu -mattr=+zvbb -run-pass=riscv-vplan-analytics -verify-machineinstrs -vplan-ra-run-id=test -vplan-probe-candidate=integer:0:0:f1 -vplan-analytics-output=%t.analytics.json %s -o /dev/null
# RUN: %python %S/Inputs/check-observation.py %t.analytics.json
# Preserve exact integer base opcodes, operand positions and physical register groups.
--- |
  define void @integer() #0 {
  entry:
    br label %loop
  loop:
    br i1 true, label %loop, label %exit, !llvm.loop !0
  exit:
    ret void
  }
  attributes #0 = { "vplan.ra.iteration-mapping"="1" "vplan.ra.width"="1" "vplan.ra.vf"="1" "vplan.ra.scalable"="0" "vplan.ra.candidate"="integer:0:0:f1" }
  !0 = distinct !{!0, !1}
  !1 = !{!"llvm.loop.vplan.candidate", !"integer:0:0:f1"}
...
---
name: integer
tracksRegLiveness: false
body: |
  bb.0.entry:
    successors: %bb.1
    PseudoBR %bb.1

  bb.1.loop:
    successors: %bb.1, %bb.2
    $v8 = PseudoVAADD_VV_M1 undef $v8, $v10, $v11, 0, $noreg, 5, 1, implicit $vxrm, implicit $vl, implicit $vtype
    early-clobber $v8m2 = PseudoVWSLL_VI_M1 undef $v8m2, $v12, 1, $noreg, 5, 1, implicit $vl, implicit $vtype
    early-clobber $v8m2 = PseudoVSEXT_VF2_M2 undef $v8m2, $v12, $noreg, 5, 1, implicit $vl, implicit $vtype
    early-clobber $v8m2 = PseudoVZEXT_VF2_M2 undef $v8m2, $v12, $noreg, 5, 1, implicit $vl, implicit $vtype
    $x12 = ADDI $x12, -1
    BNE $x12, $x0, %bb.1
    PseudoBR %bb.2

  bb.2.exit:
    PseudoRET
...
