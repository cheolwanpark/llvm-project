# RUN: llc -mtriple=riscv64 -mcpu=xiangshan-kunminghu -run-pass=riscv-vplan-analytics -verify-machineinstrs -vplan-ra-run-id=test -vplan-probe-candidate=region:0:0:s4 -vplan-analytics-output=%t.json.analytics %s -o %t.mir
# RUN: %python %S/Inputs/legacy-view.py %t.json.analytics > %t.json
# RUN: FileCheck %s --check-prefix=FEATURES < %t.json
# RUN: FileCheck %s --check-prefix=OPS < %t.json
#
# The two unconditional main-loop blocks dominate the exiting latch.
# The scalar path's short immediate-VL vector loop must not be accumulated.
# FEATURES-DAG: "supported":true
# FEATURES-DAG: "loop_blocks":2
# FEATURES-DAG: "recurrences":[]
# FEATURES-DAG: "unit8":16
# FEATURES-DAG: "integer8":8
# FEATURES-DAG: "scalar8":32
# FEATURES-DAG: "config8":8
# FEATURES-DAG: "spill8":0
# FEATURES-DAG: "indexed8":0
# FEATURES-DAG: "strided8":0
# FEATURES-DAG: "masked8":0
# FEATURES-DAG: "fp8":0
# FEATURES-DAG: "fused8":0
# OPS-DAG: {"direction":"load","group8":8,"index_group8":0,"index_sew":0,"kind":"unit","masked":false,"sew":32,"work8":8}
# OPS-DAG: {"direction":"load","group8":8,"index_group8":0,"index_sew":0,"kind":"unit","masked":false,"sew":32,"work8":8}
# OPS-DAG: {"group8":8,"index_group8":0,"index_sew":0,"kind":"integer","masked":false,"sew":32,"work8":8}
--- |
  define void @region() #0 {
  entry:
    br i1 true, label %header, label %scalar
  header:
    br label %latch
  latch:
    br i1 true, label %header, label %exit, !llvm.loop !900
  exit:
    ret void
  scalar:
    br i1 true, label %scalar, label %exit
  }
  attributes #0 = { "vplan.ra.iteration-mapping"="1" "vplan.ra.width"="4" "vplan.ra.vf"="4" "vplan.ra.scalable"="1" "vplan.ra.candidate"="region:0:0:s4" }
  !900 = distinct !{!900, !901}
  !901 = !{!"llvm.loop.vplan.candidate", !"region:0:0:s4"}
...
---
name: region
tracksRegLiveness: false
body: |
  bb.0.entry:
    successors: %bb.1, %bb.4
    BNE $x10, $x0, %bb.4
    PseudoBR %bb.1

  bb.1.header:
    successors: %bb.2
    $x13 = PseudoVSETVLI $x12, 208, implicit-def $vl, implicit-def $vtype
    $v8 = PseudoVLE32_V_M1 undef $v8, $x10, $noreg, 5, 2, implicit $vl, implicit $vtype
    PseudoBR %bb.2

  bb.2.latch:
    successors: %bb.1, %bb.3
    $v9 = PseudoVLE32_V_M1 undef $v9, $x10, $noreg, 5, 2, implicit $vl, implicit $vtype
    $v8 = PseudoVADD_VV_M1 undef $v8, $v8, $v9, $noreg, 5, 1, implicit $vl, implicit $vtype
    $x12 = ADDI $x12, -1
    BNE $x12, $x0, %bb.1
    PseudoBR %bb.3

  bb.3.exit:
    PseudoRET

  bb.4.scalar:
    successors: %bb.4, %bb.3
    dead $x0 = PseudoVSETIVLI 2, 208, implicit-def $vl, implicit-def $vtype
    $v8 = PseudoVMV_V_I_M1 undef $v8, 0, 2, 5, 0, implicit $vl, implicit $vtype
    PseudoVSE32_V_M1 $v8, $x10, 2, 5, implicit $vl, implicit $vtype
    $x11 = ADDI $x11, -1
    BNE $x11, $x0, %bb.4
    PseudoBR %bb.3
...
