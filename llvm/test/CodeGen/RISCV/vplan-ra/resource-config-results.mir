# RUN: llc -mtriple=riscv64 -mcpu=xiangshan-kunminghu -run-pass=riscv-vplan-ra-observe -verify-machineinstrs -vplan-ra-run-id=test -vplan-probe-candidate=config_results:0:0:s4 -vplan-ra-features-output=%t.live.json %s -o %t.after.mir
# RUN: llc -mtriple=riscv64 -mcpu=xiangshan-kunminghu -run-pass=none -verify-machineinstrs %s -o %t.before.mir
# RUN: diff %t.before.mir %t.after.mir
# RUN: %python -c "import json; r=json.load(open('%t.live.json'))['features']['resource_demand']; assert r['supported'] and r['loop_blocks']==1; assert r['config8']==72 and r['config_unused8']==48 and r['config_additive8']==24; assert r['scalar8']==40 and r['unit8']==8; assert len(r['operations'])==1"
# RUN: %python -c "s=open('%s').read(); open('%t.unknown.mir','w').write(s.replace('tracksRegLiveness: true','tracksRegLiveness: false'))"
# RUN: llc -mtriple=riscv64 -mcpu=xiangshan-kunminghu -run-pass=riscv-vplan-ra-observe -verify-machineinstrs -vplan-ra-run-id=test -vplan-probe-candidate=config_results:0:0:s4 -vplan-ra-features-output=%t.unknown.json %t.unknown.mir -o %t.unknown.after.mir
# RUN: %python -c "import json; a=json.load(open('%t.live.json'))['features']['resource_demand']; b=json.load(open('%t.unknown.json'))['features']['resource_demand']; assert b['config_unused8']==24 and b['config_additive8']==48; assert {k:v for k,v in a.items() if k not in ('config_unused8','config_additive8')}=={k:v for k,v in b.items() if k not in ('config_unused8','config_additive8')}"
#
# A mixed recurring region includes register AVL, VLMAX, immediate AVL and
# VL-preserving forms. Live AVL consumers keep the existing region selection.
# X0 always discards rd; other dead destinations require tracked liveness.
# Nondead results remain additive, including a result live into the exit.
# Configurations still define vector state: unused rd is no independence proof.
# Setup and exit configurations are excluded. No instruction/operand changes.
--- |
  define void @config_results() #0 {
  entry:
    br label %loop
  loop:
    br i1 true, label %loop, label %exit
  exit:
    ret void
  }
  attributes #0 = { "vplan.ra.candidate"="config_results:0:0:s4" }
...
---
name: config_results
tracksRegLiveness: true
body: |
  bb.0.entry:
    successors: %bb.1
    liveins: $x10, $x12
    dead $x0 = PseudoVSETIVLI 2, 208, implicit-def $vl, implicit-def $vtype
    PseudoBR %bb.1

  bb.1.loop:
    successors: %bb.1, %bb.2
    liveins: $x10, $x12
    $x13 = PseudoVSETVLI $x12, 208, implicit-def $vl, implicit-def $vtype
    $x12 = SUB $x12, $x13
    $x10 = ADD $x10, killed $x13
    dead $x0 = PseudoVSETVLI $x12, 208, implicit-def $vl, implicit-def $vtype
    dead $x14 = PseudoVSETVLI $x12, 208, implicit-def $vl, implicit-def $vtype
    dead $x15 = PseudoVSETVLIX0 $x0, 208, implicit-def $vl, implicit-def $vtype
    dead $x16 = PseudoVSETIVLI 2, 208, implicit-def $vl, implicit-def $vtype
    $x17 = PseudoVSETIVLI 2, 208, implicit-def $vl, implicit-def $vtype
    $x10 = ADD $x10, killed $x17
    dead $x0 = PseudoVSETVLIX0X0 $x0, 208, implicit-def $vl, implicit-def $vtype, implicit $vl
    dead $x0 = PseudoVSETIVLI 2, 208, implicit-def $vl, implicit-def $vtype
    $x18 = PseudoVSETVLI $x12, 208, implicit-def $vl, implicit-def $vtype
    dead $v8 = PseudoVLE32_V_M1 undef $v8, $x10, $noreg, 5, 2, implicit $vl, implicit $vtype
    BNE $x12, $x0, %bb.1
    PseudoBR %bb.2

  bb.2.exit:
    liveins: $x18
    dead $x0 = PseudoVSETIVLI 2, 208, implicit-def $vl, implicit-def $vtype
    PseudoRET implicit $x18
...
