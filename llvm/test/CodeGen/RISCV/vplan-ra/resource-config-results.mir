# RUN: llc -mtriple=riscv64 -mcpu=xiangshan-kunminghu -run-pass=riscv-vplan-analytics -verify-machineinstrs -vplan-ra-run-id=test -vplan-probe-candidate=config_results:0:0:s4 -vplan-analytics-output=%t.live.json.analytics %s -o %t.after.mir
# RUN: %python %S/Inputs/check-observation.py %t.live.json.analytics
# RUN: llc -mtriple=riscv64 -mcpu=xiangshan-kunminghu -run-pass=none -verify-machineinstrs %s -o %t.before.mir
# RUN: diff %t.before.mir %t.after.mir
# RUN: %python -c "s=open('%s').read(); open('%t.unknown.mir','w').write(s.replace('tracksRegLiveness: true','tracksRegLiveness: false'))"
# RUN: llc -mtriple=riscv64 -mcpu=xiangshan-kunminghu -run-pass=riscv-vplan-analytics -verify-machineinstrs -vplan-ra-run-id=test -vplan-probe-candidate=config_results:0:0:s4 -vplan-analytics-output=%t.unknown.json.analytics %t.unknown.mir -o %t.unknown.after.mir
# RUN: %python %S/Inputs/check-observation.py %t.unknown.json.analytics
# Preserve configuration operands and vector-state definitions with and without tracked liveness.
--- |
  define void @config_results() #0 {
  entry:
    br label %loop
  loop:
    br i1 true, label %loop, label %exit, !llvm.loop !900
  exit:
    ret void
  }
  attributes #0 = { "vplan.ra.iteration-mapping"="1" "vplan.ra.width"="4" "vplan.ra.vf"="4" "vplan.ra.scalable"="1" "vplan.ra.candidate"="config_results:0:0:s4" }
  !900 = distinct !{!900, !901}
  !901 = !{!"llvm.loop.vplan.candidate", !"config_results:0:0:s4"}
...
---
name: config_results
tracksRegLiveness: true
body: |
  bb.0.entry:
    successors: %bb.1
    liveins: $x10, $x12
    dead $x0 = PseudoVSETIVLI 2, 208, implicit-def $vl, implicit-def $vtype
    PseudoBR %bb.1

  bb.1.loop:
    successors: %bb.1, %bb.2
    liveins: $x10, $x12
    $x13 = PseudoVSETVLI $x12, 208, implicit-def $vl, implicit-def $vtype
    $x12 = SUB $x12, $x13
    $x10 = ADD $x10, killed $x13
    dead $x0 = PseudoVSETVLI $x12, 208, implicit-def $vl, implicit-def $vtype
    dead $x14 = PseudoVSETVLI $x12, 208, implicit-def $vl, implicit-def $vtype
    dead $x15 = PseudoVSETVLIX0 $x0, 208, implicit-def $vl, implicit-def $vtype
    dead $x16 = PseudoVSETIVLI 2, 208, implicit-def $vl, implicit-def $vtype
    $x17 = PseudoVSETIVLI 2, 208, implicit-def $vl, implicit-def $vtype
    $x10 = ADD $x10, killed $x17
    dead $x0 = PseudoVSETVLIX0X0 $x0, 208, implicit-def $vl, implicit-def $vtype, implicit $vl
    dead $x0 = PseudoVSETIVLI 2, 208, implicit-def $vl, implicit-def $vtype
    $x18 = PseudoVSETVLI $x12, 208, implicit-def $vl, implicit-def $vtype
    dead $v8 = PseudoVLE32_V_M1 undef $v8, $x10, $noreg, 5, 2, implicit $vl, implicit $vtype
    BNE $x12, $x0, %bb.1
    PseudoBR %bb.2

  bb.2.exit:
    liveins: $x18
    dead $x0 = PseudoVSETIVLI 2, 208, implicit-def $vl, implicit-def $vtype
    PseudoRET implicit $x18
...
