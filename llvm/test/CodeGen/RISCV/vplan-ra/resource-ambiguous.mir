# RUN: llc -mtriple=riscv64 -mcpu=xiangshan-kunminghu -run-pass=riscv-vplan-analytics -verify-machineinstrs -vplan-ra-run-id=test -vplan-probe-candidate=ambiguous:0:0:s4 -vplan-analytics-output=%t.json.analytics %s -o %t.mir
# RUN: %python %S/Inputs/check-observation.py %t.json.analytics
# Observe multiple untagged loops without guessing the candidate loop identity.
--- |
  define void @ambiguous() #0 {
  entry:
    br label %first
  first:
    br i1 true, label %first, label %second
  second:
    br i1 true, label %second, label %exit
  exit:
    ret void
  }
  attributes #0 = { "vplan.ra.iteration-mapping"="1" "vplan.ra.width"="4" "vplan.ra.vf"="4" "vplan.ra.scalable"="1" "vplan.ra.candidate"="ambiguous:0:0:s4" }
...
---
name: ambiguous
tracksRegLiveness: false
body: |
  bb.0.entry:
    successors: %bb.1
    PseudoBR %bb.1

  bb.1.first:
    successors: %bb.1, %bb.2
    $x13 = PseudoVSETVLI $x12, 208, implicit-def $vl, implicit-def $vtype
    $v8 = PseudoVLE32_V_M1 undef $v8, $x10, $noreg, 5, 2, implicit $vl, implicit $vtype
    $x12 = ADDI $x12, -1
    BNE $x12, $x0, %bb.1
    PseudoBR %bb.2

  bb.2.second:
    successors: %bb.2, %bb.3
    $x15 = PseudoVSETVLI $x14, 208, implicit-def $vl, implicit-def $vtype
    $v9 = PseudoVLE32_V_M1 undef $v9, $x11, $noreg, 5, 2, implicit $vl, implicit $vtype
    $x14 = ADDI $x14, -1
    BNE $x14, $x0, %bb.2
    PseudoBR %bb.3

  bb.3.exit:
    PseudoRET
...
