# RUN: llc -mtriple=riscv64 -mcpu=xiangshan-kunminghu -run-pass=riscv-vplan-analytics -verify-machineinstrs -vplan-ra-run-id=test -vplan-probe-candidate=chain:0:0:s4 -vplan-analytics-output=%t.json.analytics %s -o %t.mir
# RUN: %python %S/Inputs/check-raw.py %t.json.analytics %S/Inputs/resource-predicate-chain.json 0
#
# Carry proven identity along a unique forward edge, with repeated copies in
# the successor. Ignore the backedge and any setup predicate provenance.
--- |
  define void @chain() #0 {
  entry:
    br label %header
  header:
    br label %latch
  latch:
    br i1 true, label %header, label %exit, !llvm.loop !900
  exit:
    ret void
  }
  attributes #0 = { "vplan.ra.iteration-mapping"="1" "vplan.ra.width"="4" "vplan.ra.vf"="4" "vplan.ra.scalable"="1" "vplan.ra.candidate"="chain:0:0:s4" }
  !900 = distinct !{!900, !901}
  !901 = !{!"llvm.loop.vplan.candidate", !"chain:0:0:s4"}
...
---
name: chain
tracksRegLiveness: false
body: |
  bb.0.entry:
    successors: %bb.1
    $v0 = COPY $v2
    PseudoBR %bb.1

  bb.1.header:
    successors: %bb.2
    $x13 = PseudoVSETVLI $x12, 209, implicit-def $vl, implicit-def $vtype
    $v0 = COPY $v1
    PseudoVSE32_V_M2_MASK $v8m2, $x10, $v0, $noreg, 5, implicit $vl, implicit $vtype
    PseudoBR %bb.2

  bb.2.latch:
    successors: %bb.1, %bb.3
    $v0 = COPY $v1
    PseudoVSE32_V_M4_MASK $v8m4, $x10, $v0, $noreg, 5, implicit $vl, implicit $vtype
    $x12 = ADDI $x12, -1
    BNE $x12, $x0, %bb.1
    PseudoBR %bb.3

  bb.3.exit:
    PseudoRET
...
