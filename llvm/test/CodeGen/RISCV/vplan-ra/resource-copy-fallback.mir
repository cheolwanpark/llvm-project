# RUN: split-file %s %t
# RUN: llc -mtriple=riscv64 -mcpu=xiangshan-kunminghu -run-pass=riscv-vplan-analytics -verify-machineinstrs -vplan-ra-run-id=test -vplan-probe-candidate=fallback:0:0:s4 -vplan-analytics-output=%t.slide.json.analytics %t/slide.mir -o %t.slide.mir
# RUN: %python %S/Inputs/check-observation.py %t.slide.json.analytics
# RUN: llc -mtriple=riscv64 -mcpu=xiangshan-kunminghu -run-pass=riscv-vplan-analytics -verify-machineinstrs -vplan-ra-run-id=test -vplan-probe-candidate=fallback:0:0:s4 -vplan-analytics-output=%t.gather.json.analytics %t/gather.mir -o %t.gather.mir
# RUN: %python %S/Inputs/check-observation.py %t.gather.json.analytics
# Observe copies, slides and gathers without truncating the raw instruction list.
#--- slide.mir
--- |
  define void @fallback() #0 {
  entry:
    br label %loop
  loop:
    br i1 true, label %loop, label %exit, !llvm.loop !900
  exit:
    ret void
  }
  attributes #0 = { "vplan.ra.iteration-mapping"="1" "vplan.ra.width"="4" "vplan.ra.vf"="4" "vplan.ra.scalable"="1" "vplan.ra.candidate"="fallback:0:0:s4" }
  !900 = distinct !{!900, !901}
  !901 = !{!"llvm.loop.vplan.candidate", !"fallback:0:0:s4"}
...
---
name: fallback
tracksRegLiveness: false
body: |
  bb.0.entry:
    successors: %bb.1
    PseudoBR %bb.1
  bb.1.loop:
    successors: %bb.1, %bb.2
    $x13 = PseudoVSETVLI $x12, 208, implicit-def $vl, implicit-def $vtype
    $v8m2 = COPY $v12m2
    $v8m2 = PseudoVADD_VV_M2 undef $v8m2, $v12m2, $v14m2, $noreg, 5, 1, implicit $vl, implicit $vtype
    $v8m2 = PseudoVSLIDEDOWN_VI_M2 undef $v8m2, $v12m2, 1, $noreg, 5, 3, implicit $vl, implicit $vtype
    BNE $x12, $x0, %bb.1
    PseudoBR %bb.2
  bb.2.exit:
    PseudoRET
...
#--- gather.mir
--- |
  define void @fallback() #0 {
  entry:
    br label %loop
  loop:
    br i1 true, label %loop, label %exit, !llvm.loop !900
  exit:
    ret void
  }
  attributes #0 = { "vplan.ra.iteration-mapping"="1" "vplan.ra.width"="4" "vplan.ra.vf"="4" "vplan.ra.scalable"="1" "vplan.ra.candidate"="fallback:0:0:s4" }
  !900 = distinct !{!900, !901}
  !901 = !{!"llvm.loop.vplan.candidate", !"fallback:0:0:s4"}
...
---
name: fallback
tracksRegLiveness: false
body: |
  bb.0.entry:
    successors: %bb.1
    PseudoBR %bb.1
  bb.1.loop:
    successors: %bb.1, %bb.2
    $x13 = PseudoVSETVLI $x12, 208, implicit-def $vl, implicit-def $vtype
    $v8m2 = COPY $v12m2
    $v8m2 = PseudoVADD_VV_M2 undef $v8m2, $v12m2, $v14m2, $noreg, 5, 1, implicit $vl, implicit $vtype
    ; Gather: rd, tied passthru, rs2, rs1, vl, sew, policy. All vector
    ; operands use VRM2; early-clobber rd does not overlap either source.
    early-clobber $v8m2 = PseudoVRGATHER_VV_M2_E32 undef $v8m2, $v12m2, $v14m2, $noreg, 5, 3, implicit $vl, implicit $vtype
    BNE $x12, $x0, %bb.1
    PseudoBR %bb.2
  bb.2.exit:
    PseudoRET
...
