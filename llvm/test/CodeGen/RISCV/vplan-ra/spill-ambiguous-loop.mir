# RUN: llc -mtriple=riscv64 -mcpu=xiangshan-kunminghu -run-pass=riscv-vplan-analytics -verify-machineinstrs -vplan-ra-run-id=test -vplan-probe-candidate=kernel:0:0:s4 -vplan-analytics-output=%t.raw.json %s -o %t.mir
# RUN: %python %S/Inputs/check-observation.py %t.raw.json
# Keep ambiguous loop identity explicit in the raw observation.
--- |
  define void @kernel() #0 {
  entry:
    br i1 true, label %header, label %other
  header:
    br label %latch
  latch:
    br i1 true, label %header, label %exit, !llvm.loop !0
  other:
    br i1 true, label %other, label %exit, !llvm.loop !0
  exit:
    ret void
  }
  attributes #0 = { "vplan.ra.iteration-mapping"="1" "vplan.ra.vf"="4" "vplan.ra.scalable"="1" "vplan.ra.width"="16" "vplan.ra.candidate"="kernel:0:0:s4" }
  !0 = distinct !{!0, !1}
  !1 = !{!"llvm.loop.vplan.candidate", !"kernel:0:0:s4"}
...
---
name: kernel
tracksRegLiveness: false
stack:
  - { id: 0, type: spill-slot, size: 8, alignment: 8, stack-id: scalable-vector }
body: |
  bb.0.entry:
    successors: %bb.1, %bb.3
    BNE $x10, $x0, %bb.3
    PseudoBR %bb.1
  bb.1.header:
    successors: %bb.2
    VS1R_V $v8, %stack.0
    PseudoBR %bb.2
  bb.2.latch:
    successors: %bb.1, %bb.4
    $v8 = VL1RE8_V %stack.0
    BNE $x11, $x0, %bb.1
    PseudoBR %bb.4
  bb.3.other:
    successors: %bb.3, %bb.4
    VS1R_V $v8, %stack.0
    VS1R_V $v9, %stack.0
    BNE $x12, $x0, %bb.3
    PseudoBR %bb.4
  bb.4.exit:
    PseudoRET
...
