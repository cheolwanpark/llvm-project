# RUN: llc -mtriple=riscv64 -mcpu=xiangshan-kunminghu -run-pass=riscv-vplan-ra-observe -verify-machineinstrs -vplan-ra-run-id=test -vplan-probe-candidate=unsupported:0:0:s4 -vplan-ra-features-output=%t.json %s -o %t.mir
# RUN: FileCheck %s < %t.json
# RUN: %python -c "import json; r=json.load(open('%t.json'))['features']['resource_demand']; assert r['supported'] is False; assert r['operations'] == [dict(group8=16, index_group8=0, index_sew=0, kind='slide', masked=False, sew=32, work8=16)]"
# A supported slide followed by an unsupported gather must retain fallback.
# The partial observation proves the slide was accepted before the gather
# stopped collection: no loop-control instructions after it were observed.
# CHECK-DAG: "supported":false
# CHECK-DAG: "loop_blocks":1
# CHECK-DAG: "config8":8
# CHECK-DAG: "scalar8":0
# CHECK-DAG: {"group8":16,"index_group8":0,"index_sew":0,"kind":"slide","masked":false,"sew":32,"work8":16}
--- |
  define void @unsupported() #0 {
  entry:
    br label %loop
  loop:
    br i1 true, label %loop, label %exit
  exit:
    ret void
  }
  attributes #0 = { "vplan.ra.candidate"="unsupported:0:0:s4" }
...
---
name: unsupported
tracksRegLiveness: false
body: |
  bb.0.entry:
    successors: %bb.1
    PseudoBR %bb.1
  bb.1.loop:
    successors: %bb.1, %bb.2
    $x13 = PseudoVSETVLI $x12, 208, implicit-def $vl, implicit-def $vtype
    $v8m2 = PseudoVSLIDEDOWN_VI_M2 undef $v8m2, $v12m2, 1, $noreg, 5, 3, implicit $vl, implicit $vtype
    ; VV gather names are SEW-specialized. VPseudoBinaryNoMaskPolicy has
    ; seven explicit operands: rd, tied passthru, rs2, rs1, vl, sew, policy.
    ; M2 uses VRM2 throughout; early-clobber rd must not overlap either source.
    early-clobber $v8m2 = PseudoVRGATHER_VV_M2_E32 undef $v8m2, $v12m2, $v14m2, $noreg, 5, 3, implicit $vl, implicit $vtype
    BNE $x12, $x0, %bb.1
    PseudoBR %bb.2
  bb.2.exit:
    PseudoRET
...
