# RUN: llc -mtriple=riscv64 -mcpu=xiangshan-kunminghu -run-pass=riscv-vplan-analytics -verify-machineinstrs -vplan-ra-run-id=test -vplan-probe-candidate=fallback:0:0:s4 -vplan-analytics-output=%t.json.analytics %s -o %t.mir
# RUN: %python %S/Inputs/legacy-view.py %t.json.analytics > %t.json
# RUN: %python -c "import json; r=json.load(open('%t.json'))['features']['resource_demand']; assert not r['supported'] and r['loop_blocks']==1; assert r['unit8']==16 and r['masked8']==16 and r['scalar8']==0; o=r['operations']; assert len(o)==2 and o[0]['kind']=='copy'; assert o[1]['kind']=='unit' and o[1]['predicate_id']>0"
# RUN: FileCheck %s < %t.mir
# CHECK: $v0 = COPY $v1
# CHECK: PseudoVSE32_V_M2_MASK
# CHECK: $v0 = VMV1R_V $v1
#
# Proven predicate reuse must not expand the resource model's support set.
# VMV1R_V remains unsupported here, even though provenance recognizes its
# full-register value transfer. The region retains its original cost.
--- |
  define void @fallback() #0 {
  entry:
    br label %loop
  loop:
    br i1 true, label %loop, label %exit, !llvm.loop !900
  exit:
    ret void
  }
  attributes #0 = { "vplan.ra.iteration-mapping"="1" "vplan.ra.width"="4" "vplan.ra.vf"="4" "vplan.ra.scalable"="1" "vplan.ra.candidate"="fallback:0:0:s4" }
  !900 = distinct !{!900, !901}
  !901 = !{!"llvm.loop.vplan.candidate", !"fallback:0:0:s4"}
...
---
name: fallback
tracksRegLiveness: false
body: |
  bb.0.entry:
    successors: %bb.1
    PseudoBR %bb.1

  bb.1.loop:
    successors: %bb.1, %bb.2
    $x13 = PseudoVSETVLI $x12, 209, implicit-def $vl, implicit-def $vtype
    $v0 = COPY $v1
    PseudoVSE32_V_M2_MASK $v8m2, $x10, $v0, $noreg, 5, implicit $vl, implicit $vtype
    $v0 = VMV1R_V $v1, implicit $vtype
    PseudoVSE32_V_M2_MASK $v8m2, $x10, $v0, $noreg, 5, implicit $vl, implicit $vtype
    $x12 = ADDI $x12, -1
    BNE $x12, $x0, %bb.1
    PseudoBR %bb.2

  bb.2.exit:
    PseudoRET
...
