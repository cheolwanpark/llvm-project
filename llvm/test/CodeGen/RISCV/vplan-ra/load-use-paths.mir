    $v8 = PseudoVLE32_V_M1 undef $v8, $x10, $noreg, 5, 2, implicit $vl, implicit $vtype
    $v10 = PseudoVLE32_V_M1 undef $v10, $x10, $noreg, 5, 2, implicit $vl, implicit $vtype
    $v14 = PseudoVFADD_VV_M1_E32 undef $v14, $v12, $v16, 7, $noreg, 5, 0, implicit $frm, implicit $vl, implicit $vtype
