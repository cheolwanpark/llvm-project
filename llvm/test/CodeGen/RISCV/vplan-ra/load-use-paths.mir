# Register and memory dependency fixtures covering aliases, partial writes and loop-carried uses.

#--- chain.mir
--- |
  define void @loaduse() #0 {
  entry:
    br label %loop
  loop:
    br i1 true, label %loop, label %exit, !llvm.loop !900
  exit:
    ret void
  }
  attributes #0 = { "vplan.ra.iteration-mapping"="1" "vplan.ra.width"="4" "vplan.ra.vf"="4" "vplan.ra.scalable"="1" "vplan.ra.candidate"="loaduse:0:0:s4" }
  !900 = distinct !{!900, !901}
  !901 = !{!"llvm.loop.vplan.candidate", !"loaduse:0:0:s4"}
...
---
name: loaduse
tracksRegLiveness: false
body: |
  bb.0.entry:
    successors: %bb.1
    PseudoBR %bb.1
  bb.1.loop:
    successors: %bb.1, %bb.2
    $x13 = PseudoVSETVLI $x12, 208, implicit-def $vl, implicit-def $vtype
    $v8 = PseudoVLE32_V_M1 undef $v8, $x10, $noreg, 5, 2, implicit $vl, implicit $vtype
    $v10 = PseudoVFADD_VV_M1_E32 undef $v10, $v8, $v12, 7, $noreg, 5, 0, implicit $frm, implicit $vl, implicit $vtype
    $v14 = PseudoVFMUL_VV_M1_E32 undef $v14, $v10, $v16, 7, $noreg, 5, 0, implicit $frm, implicit $vl, implicit $vtype
    $x12 = ADDI $x12, -1
    BNE $x12, $x0, %bb.1
    PseudoBR %bb.2
  bb.2.exit:
    PseudoRET
...

