# RUN: %python %t/check.py %t/masked-arithmetic.json masked-arithmetic
# RUN: llc -mtriple=riscv64 -mcpu=xiangshan-kunminghu -run-pass=riscv-vplan-ra-observe -verify-machineinstrs -vplan-ra-run-id=test -vplan-probe-candidate=loaduse:0:0:s4 -vplan-ra-features-output=%t/unsupported-resource.json %t/unsupported-resource.mir -o %t/unsupported-resource-out.mir
# RUN: %python %t/check.py %t/unsupported-resource.json unsupported-resource
# RUN: llc -mtriple=riscv64 -mcpu=xiangshan-kunminghu -run-pass=riscv-vplan-ra-observe -verify-machineinstrs -vplan-ra-run-id=test -vplan-probe-candidate=loaduse:0:0:s4 -vplan-ra-features-output=%t/no-backedge.json %t/no-backedge.mir -o %t/no-backedge-out.mir
# RUN: %python %t/check.py %t/no-backedge.json no-backedge
#
# Block-local, same-shaped physical reaching definitions. No backedge seed,
# alias-derived memory edges, or propagation through unsupported operations.
# Undef and ordinary tail passthrough are ignored; all FMA tied inputs count.
# Fanout and repeated source uses retain one edge per reaching value.

#--- check.py
import json, sys
r = json.load(open(sys.argv[1]))["features"]["resource_demand"]
expected = {
    'chain': [('load', 1, []), ('fp', 1, [0]), ('fp', 1, [1])],
    'independent-loads': [('load', 1, []), ('load', 1, [])],
    'fanout-join': [('load', 1, []), ('fp', 1, [0]), ('fp', 1, [0]), ('fp', 1, [1, 2])],
    'two-loads': [('load', 1, []), ('load', 1, []), ('fp', 1, [0, 1])],
    'redefinition': [('load', 1, [])],
    'unsupported-copy': [('load', 1, [])],
    'partial-overwrite': [('load', 2, [])],
    'partial-use': [('load', 2, [])],
    'undef': [('load', 1, [])],
    'tail-only': [('load', 1, [])],
    'tied-fma': [('load', 1, []), ('fused', 1, [0])],
    'tied-fmadd': [('load', 1, []), ('fused', 1, [0])],
    'fractional': [('load', 1, []), ('fp', 1, [0])],
    'm8': [('load', 8, []), ('fp', 8, [0])],
    'e64': [('load', 1, []), ('fp', 1, [0])],
    'integer-multiply': [('load', 1, []), ('integer', 1, [0]), ('multiply', 1, [1])],
    'shape-change': [('load', 1, [])],
    'implicit-def': [('load', 1, [])],
    'reload': [],
    'masked-load': [],
    'masked-arithmetic': [('load', 1, [])],
    'unsupported-resource': [],
    'no-backedge': [('load', 1, [])],
}
actual = [(n["kind"], n["chunks"], n["predecessors"]) for n in r["load_use_nodes"]]
assert actual == expected[sys.argv[2]], (sys.argv[2], actual)
assert r["supported"] == (sys.argv[2] != "unsupported-resource")

#--- chain.mir
--- |
  define void @loaduse() #0 {
  entry:
    br label %loop
  loop:
    br i1 true, label %loop, label %exit
  exit:
    ret void
  }
  attributes #0 = { "vplan.ra.candidate"="loaduse:0:0:s4" }
...
---
name: loaduse
tracksRegLiveness: false
body: |
  bb.0.entry:
    successors: %bb.1
    PseudoBR %bb.1
  bb.1.loop:
    successors: %bb.1, %bb.2
    $x13 = PseudoVSETVLI $x12, 208, implicit-def $vl, implicit-def $vtype
    $v8 = PseudoVLE32_V_M1 undef $v8, $x10, $noreg, 5, 2, implicit $vl, implicit $vtype
    $v10 = PseudoVFADD_VV_M1_E32 undef $v10, $v8, $v12, 7, $noreg, 5, 0, implicit $frm, implicit $vl, implicit $vtype
    $v14 = PseudoVFMUL_VV_M1_E32 undef $v14, $v10, $v16, 7, $noreg, 5, 0, implicit $frm, implicit $vl, implicit $vtype
    $x12 = ADDI $x12, -1
    BNE $x12, $x0, %bb.1
    PseudoBR %bb.2
  bb.2.exit:
    PseudoRET
...

