# RUN: llc -mtriple=riscv64 -mcpu=xiangshan-kunminghu -run-pass=riscv-vplan-analytics -verify-machineinstrs -vplan-ra-run-id=test -vplan-probe-candidate=movement:0:0:s4 -vplan-analytics-output=%t.json.analytics %s -o %t.mir
# RUN: %python %S/Inputs/legacy-view.py %t.json.analytics > %t.json
# RUN: FileCheck %s --check-prefix=FEATURES < %t.json
# RUN: FileCheck %s --check-prefix=OPS < %t.json
# RUN: %python -c "import json; r=json.load(open('%t.json'))['features']['resource_demand']; assert len(r['operations']) == 14; assert r['recurrences']==[]"
#
# VLEN=128. TSFlags preserve fractional groups; all fractional slides issue
# one chunk. M2/M4/M8 slide work is 2/4/8 chunks. Physical COPY keeps
# whole-register grouping. No new copy instruction families are recognized.
# Scalar broadcasts remain integer work. Setup and exit movements are excluded.
# FEATURES-DAG: "supported":true
# FEATURES-DAG: "integer8":8
# FEATURES-DAG: "fp8":0
# FEATURES-DAG: "fused8":0
# FEATURES-DAG: "unit8":0
# FEATURES-DAG: "spill8":0
# FEATURES-DAG: "masked8":0
# FEATURES-DAG: "scalar8":24
# FEATURES-DAG: "config8":8
# FEATURES-DAG: "loop_blocks":1
# OPS-DAG: {"group8":1,"index_group8":0,"index_sew":0,"kind":"slide","masked":false,"sew":8,"work8":8}
# OPS-DAG: {"group8":2,"index_group8":0,"index_sew":0,"kind":"slide","masked":false,"sew":16,"work8":8}
# OPS-DAG: {"group8":4,"index_group8":0,"index_sew":0,"kind":"slide","masked":true,"sew":32,"work8":8}
# OPS-DAG: {"group8":8,"index_group8":0,"index_sew":0,"kind":"slide","masked":false,"sew":64,"work8":8}
# OPS-DAG: {"group8":16,"index_group8":0,"index_sew":0,"kind":"slide","masked":false,"sew":32,"work8":16}
# OPS-DAG: {"group8":32,"index_group8":0,"index_sew":0,"kind":"slide","masked":true,"sew":32,"work8":32}
# OPS-DAG: {"group8":64,"index_group8":0,"index_sew":0,"kind":"slide","masked":false,"sew":64,"work8":64}
# OPS-DAG: {"group8":8,"index_group8":0,"index_sew":0,"kind":"slide","masked":true,"sew":32,"work8":8}
# OPS-DAG: {"group8":8,"index_group8":0,"index_sew":0,"kind":"copy","masked":false,"sew":0,"work8":8}
# OPS-DAG: {"group8":16,"index_group8":0,"index_sew":0,"kind":"copy","masked":false,"sew":0,"work8":16}
# OPS-DAG: {"group8":32,"index_group8":0,"index_sew":0,"kind":"copy","masked":false,"sew":0,"work8":32}
# OPS-DAG: {"group8":64,"index_group8":0,"index_sew":0,"kind":"copy","masked":false,"sew":0,"work8":64}
# OPS-DAG: {"group8":64,"index_group8":0,"index_sew":0,"kind":"copy","masked":false,"sew":0,"work8":0}
# OPS-NOT: "kind":"slide"
# OPS-NOT: "kind":"copy"
--- |
  define void @movement() #0 {
  entry:
    br label %loop
  loop:
    br i1 true, label %loop, label %exit, !llvm.loop !900
  exit:
    ret void
  }
  attributes #0 = { "vplan.ra.iteration-mapping"="1" "vplan.ra.width"="4" "vplan.ra.vf"="4" "vplan.ra.scalable"="1" "vplan.ra.candidate"="movement:0:0:s4" }
  !900 = distinct !{!900, !901}
  !901 = !{!"llvm.loop.vplan.candidate", !"movement:0:0:s4"}
...
---
name: movement
tracksRegLiveness: false
body: |
  bb.0.entry:
    successors: %bb.1
    $v8m8 = COPY $v16m8
    PseudoBR %bb.1

  bb.1.loop:
    successors: %bb.1, %bb.2
    $x13 = PseudoVSETVLI $x12, 208, implicit-def $vl, implicit-def $vtype
    early-clobber $v8 = PseudoVSLIDEUP_VI_MF8 undef $v8, $v10, 1, $noreg, 3, 3, implicit $vl, implicit $vtype
    early-clobber $v8 = PseudoVSLIDEUP_VX_MF4 undef $v8, $v10, $x11, $noreg, 4, 3, implicit $vl, implicit $vtype
    $v8 = PseudoVSLIDEDOWN_VI_MF2_MASK undef $v8, $v10, 1, $v0, $noreg, 5, 3, implicit $vl, implicit $vtype
    $v8 = PseudoVSLIDEDOWN_VX_M1 undef $v8, $v10, $x11, $noreg, 6, 3, implicit $vl, implicit $vtype
    early-clobber $v8m2 = PseudoVSLIDE1UP_VX_M2 undef $v8m2, $v12m2, $x11, $noreg, 5, 3, implicit $vl, implicit $vtype
    $v8m4 = PseudoVSLIDE1DOWN_VX_M4_MASK undef $v8m4, $v12m4, $x11, $v0, $noreg, 5, 3, implicit $vl, implicit $vtype
    early-clobber $v8m8 = PseudoVFSLIDE1UP_VFPR64_M8 undef $v8m8, $v16m8, $f10_d, $noreg, 6, 3, implicit $vl, implicit $vtype
    $v8 = PseudoVFSLIDE1DOWN_VFPR32_M1_MASK undef $v8, $v10, $f10_f, $v0, $noreg, 5, 3, implicit $vl, implicit $vtype
    $v8 = COPY $v10
    $v8m2 = COPY $v12m2
    $v8m4 = COPY $v12m4
    $v8m8 = COPY $v16m8
    $v8m8 = COPY $v8m8
    $v8 = PseudoVMV_V_X_M1 undef $v8, $x11, $noreg, 5, 3, implicit $vl, implicit $vtype
    $x12 = ADDI $x12, -1
    BNE $x12, $x0, %bb.1
    PseudoBR %bb.2

  bb.2.exit:
    early-clobber $v8m8 = PseudoVSLIDEUP_VI_M8 undef $v8m8, $v16m8, 1, $noreg, 6, 3, implicit $vl, implicit $vtype
    PseudoRET
...
