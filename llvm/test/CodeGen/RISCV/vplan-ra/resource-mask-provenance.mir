# RUN: llc -mtriple=riscv64 -mcpu=xiangshan-kunminghu -run-pass=riscv-vplan-analytics -verify-machineinstrs -vplan-ra-run-id=test -vplan-probe-candidate=mask_provenance:0:0:s4 -vplan-analytics-output=%t.json.analytics %s -o %t.mir
# RUN: %python %S/Inputs/check-observation.py %t.json.analytics
# RUN: llc -mtriple=riscv64 -mcpu=xiangshan-kunminghu -run-pass=none -verify-machineinstrs %s -o %t.before.mir
# RUN: diff %t.before.mir %t.mir
# Observe mask definitions, full copies and grouped aliases as physical register facts.
--- |
  define void @mask_provenance() #0 {
  entry:
    br label %loop
  loop:
    br i1 true, label %loop, label %exit, !llvm.loop !900
  exit:
    ret void
  }
  attributes #0 = { "vplan.ra.iteration-mapping"="1" "vplan.ra.width"="4" "vplan.ra.vf"="4" "vplan.ra.scalable"="1" "vplan.ra.candidate"="mask_provenance:0:0:s4" }
  !900 = distinct !{!900, !901}
  !901 = !{!"llvm.loop.vplan.candidate", !"mask_provenance:0:0:s4"}
...
---
name: mask_provenance
tracksRegLiveness: false
body: |
  bb.0.entry:
    successors: %bb.1
    PseudoBR %bb.1
  bb.1.loop:
    successors: %bb.1, %bb.2
    $x13 = PseudoVSETVLI $x12, 208, implicit-def $vl, implicit-def $vtype
    $v1 = PseudoVMAND_MM_B8 $v2, $v3, $noreg, 0, implicit $vl, implicit $vtype
    $v0 = COPY $v1
    PseudoVSE32_V_M2_MASK $v8m2, $x10, $v0, $noreg, 5, implicit $vl, implicit $vtype
    $v4 = COPY $v1
    $v1 = PseudoVMOR_MM_B8 $v2, $v3, $noreg, 0, implicit $vl, implicit $vtype
    $v0 = COPY $v1
    PseudoVSE32_V_M2_MASK $v8m2, $x10, $v0, $noreg, 5, implicit $vl, implicit $vtype
    $v0 = COPY $v4
    PseudoVSE32_V_M2_MASK $v8m2, $x10, $v0, $noreg, 5, implicit $vl, implicit $vtype
    $v0 = PseudoVMAND_MM_B8 $v0, $v2, $noreg, 0, implicit $vl, implicit $vtype
    PseudoVSE32_V_M2_MASK $v8m2, $x10, $v0, $noreg, 5, implicit $vl, implicit $vtype
    PseudoVSE32_V_M2_MASK $v8m2, $x10, $v0, $noreg, 5, implicit $vl, implicit $vtype
    $v0 = PseudoVMCLR_M_B8 $noreg, 0, implicit $vl, implicit $vtype
    PseudoVSE32_V_M2_MASK $v8m2, $x10, $v0, $noreg, 5, implicit $vl, implicit $vtype
    $v0 = PseudoVMCLR_M_B8 $noreg, 0, implicit $vl, implicit $vtype
    PseudoVSE32_V_M2_MASK $v8m2, $x10, $v0, $noreg, 5, implicit $vl, implicit $vtype
    $v0 = PseudoVMSET_M_B8 $noreg, 0, implicit $vl, implicit $vtype
    PseudoVSE32_V_M2_MASK $v8m2, $x10, $v0, $noreg, 5, implicit $vl, implicit $vtype
    $v0 = PseudoVMSET_M_B8 $noreg, 0, implicit $vl, implicit $vtype
    PseudoVSE32_V_M2_MASK $v8m2, $x10, $v0, $noreg, 5, implicit $vl, implicit $vtype
    $v0 = PseudoVMXOR_MM_B8 $v0, $v0, $noreg, 0, implicit $vl, implicit $vtype
    PseudoVSE32_V_M2_MASK $v8m2, $x10, $v0, $noreg, 5, implicit $vl, implicit $vtype
    $v4 = COPY undef $v1
    $v0 = COPY $v4
    PseudoVSE32_V_M2_MASK $v8m2, $x10, $v0, $noreg, 5, implicit $vl, implicit $vtype
    $x12 = ADDI $x12, -1
    BNE $x12, $x0, %bb.1
    PseudoBR %bb.2
  bb.2.exit:
    PseudoRET
...
