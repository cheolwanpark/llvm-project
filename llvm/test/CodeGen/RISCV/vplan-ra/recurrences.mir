#
# Identical instruction totals can describe a two-step recurrence, independent
# arithmetic, two serial tied FMAs, or two independent FMA accumulators. Only
# true value dependencies cross the backedge. Partial alias writes, complete
# overwrites, undef, implicit definitions, and tail passthrough break a chain.
# LMUL aliases share physical register units: v9 overwrites part of v8m2.
#
# DEPENDENT-DAG: "supported":true
# DEPENDENT-DAG: "recurrences":[{"extra_chunks":0,"fp_steps":2,"fused_steps":0}]
# DEPENDENT-DAG: "fp8":16
# INDEPENDENT-DAG: "supported":true
# INDEPENDENT-DAG: "recurrences":[]
# INDEPENDENT-DAG: "fp8":16
# TIED-DEPENDENT-DAG: "supported":true
# TIED-DEPENDENT-DAG: "recurrences":[{"extra_chunks":0,"fp_steps":0,"fused_steps":2}]
# TIED-DEPENDENT-DAG: "fused8":16
# TIED-INDEPENDENT-DAG: "supported":true
# TIED-INDEPENDENT-DAG: "recurrences":[{"extra_chunks":0,"fp_steps":0,"fused_steps":1},{"extra_chunks":0,"fp_steps":0,"fused_steps":1}]
# TIED-INDEPENDENT-DAG: "fused8":16
# GROUPED-DAG: "supported":true
# GROUPED-DAG: "recurrences":[{"extra_chunks":1,"fp_steps":0,"fused_steps":1}]
# ALIAS-OVERWRITE-DAG: "supported":true
# ALIAS-OVERWRITE-DAG: "recurrences":[]
# ALIAS-REUSE-DAG: "supported":true
# ALIAS-REUSE-DAG: "recurrences":[]
# OVERWRITE-DAG: "supported":true
# OVERWRITE-DAG: "recurrences":[]
# UNDEF-DAG: "supported":true
# UNDEF-DAG: "recurrences":[]
# PASSTHROUGH-DAG: "supported":true
# PASSTHROUGH-DAG: "recurrences":[]
# LOAD-REUSE-DAG: "supported":true
# LOAD-REUSE-DAG: "recurrences":[]
# IMPLICIT-DEF-DAG: "supported":true
# IMPLICIT-DEF-DAG: "recurrences":[]
# FRACTIONAL-DAG: "supported":true
# FRACTIONAL-DAG: "recurrences":[{"extra_chunks":0,"fp_steps":0,"fused_steps":1}]
# E64-DAG: "supported":true
# E64-DAG: "recurrences":[{"extra_chunks":0,"fp_steps":0,"fused_steps":1}]
# MASKED-DAG: "supported":true
# MASKED-DAG: "recurrences":[]
# INTEGER-DAG: "supported":true
# INTEGER-DAG: "recurrences":[]
# BRANCHING-DAG: "supported":true
# BRANCHING-DAG: "recurrences":[]
# MULTIPLE-BACKEDGES-DAG: "supported":true
# MULTIPLE-BACKEDGES-DAG: "recurrences":[]
# WIDENING-DAG: "supported":true
# WIDENING-DAG: "recurrences":[]
# REDUCTION-DAG: "supported":false
# REDUCTION-DAG: "recurrences":[]

#--- dependent.mir
--- |
  define void @recurrence() #0 {
  entry:
    br label %loop
  loop:
    br i1 true, label %loop, label %exit, !llvm.loop !900
  exit:
    ret void
  }
  attributes #0 = { "vplan.ra.iteration-mapping"="1" "vplan.ra.width"="4" "vplan.ra.vf"="4" "vplan.ra.scalable"="1" "vplan.ra.candidate"="recurrence:0:0:s4" }
  !900 = distinct !{!900, !901}
  !901 = !{!"llvm.loop.vplan.candidate", !"recurrence:0:0:s4"}
...
---
name: recurrence
tracksRegLiveness: false
body: |
  bb.0.entry:
    successors: %bb.1
    PseudoBR %bb.1

  bb.1.loop:
    successors: %bb.1, %bb.2
    $x13 = PseudoVSETVLI $x12, 208, implicit-def $vl, implicit-def $vtype
    $v10 = PseudoVFADD_VV_M1_E32 undef $v10, $v8, $v12, 7, $noreg, 5, 0, implicit $frm, implicit $vl, implicit $vtype
    $v8 = PseudoVFADD_VV_M1_E32 undef $v8, $v10, $v14, 7, $noreg, 5, 0, implicit $frm, implicit $vl, implicit $vtype
    $x12 = ADDI $x12, -1
    BNE $x12, $x0, %bb.1
    PseudoBR %bb.2

  bb.2.exit:
    PseudoRET
...

