# RUN: llc -mtriple=riscv64 -mcpu=xiangshan-kunminghu -run-pass=riscv-vplan-analytics -verify-machineinstrs -vplan-ra-run-id=test -vplan-probe-candidate=resource:0:0:s4 -vplan-analytics-output=%t.json.analytics %s -o %t.mir
# RUN: %python %S/Inputs/check-observation.py %t.json.analytics
# Observe fractional groups, indexed memory geometry, wide operands and stack transfers.
--- |
  define void @resource() #0 {
  entry:
    br label %loop
  loop:
    br i1 true, label %loop, label %exit, !llvm.loop !900
  exit:
    ret void
  }
  attributes #0 = { "vplan.ra.iteration-mapping"="1" "vplan.ra.width"="4" "vplan.ra.vf"="4" "vplan.ra.scalable"="1" "vplan.ra.candidate"="resource:0:0:s4" }
  !900 = distinct !{!900, !901}
  !901 = !{!"llvm.loop.vplan.candidate", !"resource:0:0:s4"}
...
---
name: resource
tracksRegLiveness: false
stack:
  - { id: 0, type: spill-slot, size: 16, alignment: 8, stack-id: scalable-vector }
  - { id: 1, type: spill-slot, size: 8, alignment: 8 }
  - { id: 2, type: default, size: 8, alignment: 8 }
body: |
  bb.0.entry:
    successors: %bb.1
    dead $x13 = PseudoVSETVLIX0 $x0, 208, implicit-def $vl, implicit-def $vtype
    $v8 = PseudoVMV_V_I_M1 undef $v8, 0, -1, 5, 0, implicit $vl, implicit $vtype
    PseudoBR %bb.1

  bb.1.loop:
    successors: %bb.1, %bb.2
    $x13 = PseudoVSETVLI $x12, 208, implicit-def $vl, implicit-def $vtype
    $v8 = PseudoVLE32_V_M1 undef $v8, $x10, $noreg, 5, 2, implicit $vl, implicit $vtype
    PseudoVSE32_V_M1 $v8, $x10, $noreg, 5, implicit $vl, implicit $vtype
    $v9 = PseudoVLE16_V_MF2 undef $v9, $x10, $noreg, 4, 2, implicit $vl, implicit $vtype
    PseudoVSE32_V_M1_MASK $v8, $x10, $v0, $noreg, 5, implicit $vl, implicit $vtype
    $v8 = PseudoVLSE32_V_M1 undef $v8, $x10, $x11, $noreg, 5, 2, implicit $vl, implicit $vtype
    PseudoVSSE32_V_M1_MASK $v8, $x10, $x11, $v0, $noreg, 5, implicit $vl, implicit $vtype
    early-clobber $v10 = PseudoVLUXEI64_V_M2_M1 undef $v10, $x10, $v16m2, $noreg, 5, 2, implicit $vl, implicit $vtype
    PseudoVSUXEI32_V_M1_M1_MASK $v8, $x10, $v11, $v0, $noreg, 5, implicit $vl, implicit $vtype
    $v8m2 = PseudoVADD_VV_M2 undef $v8m2, $v12m2, $v14m2, $noreg, 5, 1, implicit $vl, implicit $vtype
    early-clobber $v8m2 = PseudoVWMULSU_VX_M1 undef $v8m2, $v12, $x11, $noreg, 5, 1, implicit $vl, implicit $vtype
    $v8 = PseudoVADD_VV_M1_MASK undef $v8, $v10, $v11, $v0, $noreg, 5, 1, implicit $vl, implicit $vtype
    $v8 = PseudoVFADD_VV_M1_E32 undef $v8, $v10, $v11, 7, $noreg, 5, 1, implicit $frm, implicit $vl, implicit $vtype
    $v8m2 = PseudoVFMACC_VV_M2_E64 $v8m2, $v12m2, $v14m2, 7, $noreg, 6, 0, implicit $frm, implicit $vl, implicit $vtype
    VS2R_V $v8m2, %stack.0
    $v8m2 = VL2RE8_V %stack.0
    SD $x11, %stack.1, 0
    $x11 = LD %stack.1, 0
    SD $x11, %stack.2, 0
    $x11 = LD %stack.2, 0
    $x12 = ADDI $x12, -1
    BNE $x12, $x0, %bb.1
    PseudoBR %bb.2

  bb.2.exit:
    $v8 = PseudoVFREDUSUM_VS_M2_E64 undef $v8, $v12m2, $v10, 7, -1, 6, 1, implicit $frm, implicit $vl, implicit $vtype
    PseudoRET
...
