# REQUIRES: riscv-registered-target
# RUN: split-file %s %t
# RUN: %python %t/check.py opt llc %S/../../utils/check-reduction-fission.py %S/../Transforms/LoopVectorize/RISCV/reduction-fission-scalar-affine-composition.ll %S/Inputs %t
#
# Actual composed IR, not a normalized replacement: original affine exits,
# carried IV/state, stores feeding later iterations, compact P, ordered FP/sub
# and defined products. Host original/transformed/independent-oracle execution
# is mandatory through check-reduction-fission.py. RVV verification is codegen.

#--- check.py
import importlib.util
from itertools import product
import json
from pathlib import Path
import re
import sys

sys.dont_write_bytecode = True
opt, llc, utility, fixture, inputs, work = sys.argv[1:]
work = Path(work)
spec = importlib.util.spec_from_file_location('checker', utility)
checker = importlib.util.module_from_spec(spec)
sys.modules[spec.name] = checker
spec.loader.exec_module(checker)
identity_spec = importlib.util.spec_from_file_location(
    'identity', Path(inputs) / 'reduction-fission-consumer-identity.py')
identity = importlib.util.module_from_spec(identity_spec)
identity_spec.loader.exec_module(identity)
checker.command_log_dir = work
source = Path(fixture).read_text()
counts = dict(modules=0, bodies=0, rejections=0, source_rejections=0, complete=False)


def save():
    (work / 'composition-counts.json').write_text(json.dumps(counts, indent=2) + '\n')


def replace_one(text, old, new):
    assert old != new and text.count(old) == 1, ('mutation anchor', old)
    changed = text.replace(old, new, 1)
    assert changed != text
    return changed


save()
for (capacity, ceiling), reordered, repeated, scalar in product(
        ((1, 16), (8, 111), (9, 112), (16, 192)), (False, True), (False, True), (True, False)):
    functions = list(checker.NC_COMPOSITIONS) if scalar else [
        'nc_mul_store', 'nc_bits_store', 'nc_compact_bits_store', 'nc_compact_mul_store']
    original = checker.keep_functions(source, functions)
    options = (checker.subtraction_options if scalar else checker.fneg_vector_options)(ceiling, reordered, repeated)
    result = checker.run([opt, *options], input=original)
    ir, probed = result.stdout, result.stdout
    tag = f'c{capacity}-r{int(reordered)}-lv{1 + repeated}-s{int(scalar)}'
    (work / (tag + '.input.ll')).write_text(original)
    (work / (tag + '.ll')).write_text(ir)
    (work / (tag + '.remarks')).write_text(result.stderr)
    checker.run([opt, '-passes=verify', '-disable-output'], input=original)
    checker.run([llc, '-mtriple=riscv64', '-mattr=+v', '-verify-machineinstrs',
                 '-o', str(work / (tag + '.s'))], input=ir)
    for name in functions:
        body = checker.check_affine_composition(ir, original, name, capacity)
        blocks = checker.loop_blocks(body)
        vector = 'vector.body' in blocks
        shape = checker.consumer_vf4(body, allow_fixed=True)
        assert not scalar or not vector
        assert scalar or vector or capacity == 1
        checker.check_affine_composition_remarks(result.stderr, name, capacity, shape)
        checked = checker.check_affine_composition(ir, original, name, capacity, probe=True)
        probed = replace_one(probed, body, checked)

        def certify(candidate):
            return checker.check_affine_composition(candidate, original, name, capacity)

        if not shape or shape.scalable:
            for renamed in identity.exercise(checker, ir, name, False, certify):
                checker.run([opt, '-passes=verify', '-disable-output'], input=renamed)
        else:
            # The producer already owns familiar index names. Prove fixed
            # consumers by the actual recurrence, with the same positive
            # renaming obligation as the scalable helper above.
            code = checker.chunk_instructions(blocks['vector.body'])
            indices = re.findall(r'getelementptr inbounds \[\d+ x (?:i32|double)\], '
                                 r'ptr %[-\w.$]+, i32 0, i64 (%[-\w.$]+)', blocks['vector.body'])
            assert len(indices) == 2 and len(set(indices)) == 1
            index = indices[0]
            ordinal = next(line for line in code if line.startswith(index + ' = phi i64 '))
            backedge = re.findall(r'\[ (%[-\w.$]+), %vector.body \]', ordinal)
            assert len(backedge) == 1
            renamed = body
            for old, new in ((index, '%composed.consumer.index'), (backedge[0], '%composed.consumer.next')):
                assert new not in body
                renamed = re.sub(re.escape(old) + r'(?![-\w.$])', new, renamed)
            renamed = replace_one(ir, body, renamed)
            certify(renamed)
            checker.run([opt, '-passes=verify', '-disable-output'], input=renamed)

        def reject(old, new):
            candidate = replace_one(body, old, new)
            module = replace_one(ir, body, candidate)
            try:
                certify(module)
            except AssertionError:
                counts['rejections'] += 1
            else:
                (work / (tag + '.' + name + '.accepted-mutation.ll')).write_text(module)
                save()
                raise AssertionError('accepted composed corruption: ' + old)

        for old, new in [
            (f'%fission.producer.more = icmp ne i64 %fission.producer.next, {capacity}',
             f'%fission.producer.more = icmp ne i64 %fission.producer.next, {capacity + 1}'),
            ('%fission.producer.iv.next = phi i64 [ %next, %latch ]',
             '%fission.producer.iv.next = phi i64 [ %iv, %latch ]'),
            ('%older.chunk.backedge = phi i32 [ %prev, %latch ]',
             '%older.chunk.backedge = phi i32 [ %state.next, %latch ]'),
            ('br i1 %fission.producer.continue, label %scalar.fission.chunk, label %producer.exit',
             'br i1 false, label %scalar.fission.chunk, label %producer.exit'),
            ('%fission.producer.completed = phi i64 [ %fission.producer.next, %latch ]',
             f'%fission.producer.completed = phi i64 [ {capacity}, %latch ]'),
            ('%dc = fneg double %dx', '%dc = fneg double %dnext'),
            ('%wp = getelementptr i32, ptr %p, i64 1', '%wp = getelementptr i32, ptr %p, i64 0'),
            ('store i32 %state.next, ptr %wp, align 4', 'store i32 %prev, ptr %wp, align 4'),
            ('store double %dc, ptr %dp, align 8', 'store double %dx, ptr %dp, align 8'),
        ]:
            reject(old, new)
        for state, ty, start in [('r0', 'i32', '17'), ('r1', 'i32', '-7'), ('rd', 'double', '%start')]:
            old = f'%{state}.chunk.carry = phi {ty} [ {start}, %preheader ]'
            reject(old, old.replace(start + ',', ('0.000000e+00' if ty == 'double' else '0') + ','))
        scalar_body = checker.chunk_instructions(blocks['scalar.fission.consumer.body'])
        for value in ('%u0.consume', '%u1.consume', '%ud.consume'):
            line = next(line for line in scalar_body if line.startswith(value + ' = '))
            operation = line.split(' = ', 1)[1].split(' ', 1)[0]
            replacement = 'add' if operation != 'add' else 'xor'
            reject(line, line.replace(' = ' + operation + ' ', ' = ' + replacement + ' ', 1))
            if name == 'nc_defined_store' and value != '%ud.consume':
                reject(line, line.replace(' nuw nsw ', ' ', 1))
        induction = next(line for line in scalar_body if line.startswith('%fission.consumer.iv = '))
        reject(induction, induction.replace('%fission.consumer.next,', '%fission.consumer.iv,', 1))
        if vector:
            for line in checker.chunk_instructions(blocks['vector.ph']):
                if ' = insertelement ' not in line:
                    continue
                reject(line, line.replace('i32 0', 'i32 1', 1))
                neutral = ('splat (i32 -1)' if 'splat (i32 -1)' in line else
                           'splat (i32 1)' if 'splat (i32 1)' in line else 'zeroinitializer')
                reject(line, line.replace(neutral, 'zeroinitializer' if neutral == 'splat (i32 1)' else 'splat (i32 1)', 1))
                reject(line, re.sub(r'i32 %r[01]\.chunk\.carry', 'i32 0', line))
        counts['bodies'] += 1
        save()
    probed += checker.NC_PROBE_DECLARATIONS
    (work / (tag + '.probe.ll')).write_text(probed)
    checker.run([opt, '-passes=verify', '-disable-output'], input=probed)
    counts['modules'] += 1
    save()

# Equivalent positive/rejection boundaries on these exact original bodies.
# Keep the minimum padded slot boundary and unsafe effects independent of the
# newly admitted affine scheduling. Feedback remains producer-local.
for reordered in (False, True):
    options = checker.subtraction_options(15, reordered, True)
    rejected = checker.run([opt, *options], input=source).stdout
    assert 'scalar.fission' not in rejected
    counts['source_rejections'] += len(checker.NC_COMPOSITIONS)
    for name in checker.NC_COMPOSITIONS:
        original = checker.keep_functions(source, [name])
        volatile = replace_one(original, 'store double %dc, ptr %dp', 'store volatile double %dc, ptr %dp')
        rejected = checker.run([opt, *checker.subtraction_options(112, reordered, True)], input=volatile).stdout
        assert 'scalar.fission' not in rejected
        counts['source_rejections'] += 1
    feedback = checker.keep_functions(source, ['nc_mul_store'])
    feedback = replace_one(feedback, '  %next = add i64 %iv, 3',
                           '  store i32 %r0, ptr %p, align 4\n'
                           '  store i32 %r1, ptr %p, align 4\n'
                           '  store double %rd, ptr %dp, align 8\n  %next = add i64 %iv, 3')
    rejected = checker.run([opt, *checker.subtraction_options(112, reordered, True)], input=feedback).stdout
    assert 'scalar.fission' not in rejected
    counts['source_rejections'] += 1
    incompatible = checker.keep_functions(source, ['nc_compact_bits_store'])
    update = re.findall(r'^  %ud = fadd double %rd, %dc, !dbg !\d+\n', incompatible, re.M)
    assert len(update) == 1
    incompatible = replace_one(incompatible, update[0], '')
    incompatible = replace_one(incompatible, '  %choose = icmp ne i32 %x, 0',
                               update[0].replace('%dc', '%dx') + '  %choose = icmp ne i32 %x, 0')
    incompatible = replace_one(incompatible, '%rd = phi double [%start, %preheader], [%ud.merge, %latch]',
                               '%rd = phi double [%start, %preheader], [%ud, %latch]')
    incompatible = replace_one(incompatible, '%out.rd = phi double [%ud.merge, %latch]',
                               '%out.rd = phi double [%ud, %latch]')
    incompatible = replace_one(incompatible, '  %ud.merge = phi double [%ud, %left], [%rd, %loop]\n', '')
    rejected = checker.run([opt, *checker.subtraction_options(112, reordered, True)], input=incompatible).stdout
    assert 'scalar.fission' not in rejected
    counts['source_rejections'] += 1

assert counts['modules'] == 32 and counts['bodies'] == 160, counts
counts['complete'] = True
save()
