# RUN: split-file %s %t
# RUN: %python %t/check.py %S/../../utils/check-reduction-fission.py %t/functions.ll %t/compact-evl.ll \
# RUN:   %S/../Transforms/LoopVectorize/RISCV/reduction-fission-scalar-affine.ll %t/affine-evl.ll

# Parsing and checker boundaries only; transformed execution is exercised by
# check-reduction-fission.py with the real opt/llc and the C harness.

#--- check.py
import importlib.util
from pathlib import Path
import sys

spec = importlib.util.spec_from_file_location('fission_checker', sys.argv[1])
checker = importlib.util.module_from_spec(spec)
spec.loader.exec_module(checker)
source = Path(sys.argv[2]).read_text()

# Keep the multiline definition whole and drop the following definition.
body = checker.function_definition(source, 'multiline')
assert 'i64 %n)' in body and 'ret i64 %n' in body
kept = checker.keep_functions(source, ['multiline'])
assert kept.count('define ') == 1
assert checker.function_definition(kept, 'multiline') == body

try:
    checker.function_definition(source, 'missing')
except ValueError as error:
    assert 'expected one definition for @missing, found 0' in str(error)
    assert 'multiline' in str(error)
else:
    raise AssertionError('missing function did not fail')

try:
    checker.function_definition(source + body + '\n', 'multiline')
except ValueError as error:
    assert 'found 2' in str(error)
else:
    raise AssertionError('duplicate function did not fail')

# A reduction in the producer or another function cannot satisfy the exact
# consumer's check. This used to be possible with module-wide substring tests.
try:
    checker.check_scalar_function(source, 'arithmetic_sum', evl=False)
except AssertionError as error:
    assert '@arithmetic_sum: missing integer consumer reduction' in str(error)
else:
    raise AssertionError('producer reduction accepted as consumer evidence')

# A diamond must retain its control, unsafe operations and merge. Instrument
# both exact consumer headers after their PHIs, including the scalar tail.
diamond = checker.check_scalar_function(source, 'scalar_diamond', evl=False, probe=True)
assert diamond.count('call void @record_scalar_consumer_vector()') == 1
assert diamond.count('call void @record_scalar_consumer_tail()') == 1
assert ('%vi = phi i64 [ 0, %scalar.fission.consumer.ph ]\n'
        '  call void @record_scalar_consumer_vector()') in diamond
assert ('%ti = phi i64 [ 0, %vector.body ]\n'
        '  call void @record_scalar_consumer_tail()') in diamond
hoisted = source.replace('left:\n  %q = sdiv i32 840, %x\n',
                         '  %q = sdiv i32 840, %x\nleft:\n')
try:
    checker.check_scalar_function(hoisted, 'scalar_diamond', evl=False)
except AssertionError:
    pass
else:
    raise AssertionError('speculated diamond division accepted as producer evidence')

# Compact instrumentation must retain the whole function and insert the
# producer probes after PHIs as well as the two exact consumer probes.
compact = checker.check_scalar_function(source, 'compact_triangle', evl=False, probe=True)
for probe in ('compact_iteration', 'compact_participant',
              'scalar_consumer_vector', 'scalar_consumer_tail'):
    assert compact.count('call void @record_' + probe + '()') == 1
assert compact.startswith('define void @compact_triangle(') and compact.endswith('}')
assert ('%pi = phi i64 [ 0, %preheader ], [ %next, %latch ]\n'
        '  call void @record_compact_iteration()') in compact

# SCEV expansion can use the export or latch value; repeated LV forwards the
# latter through one PHI in the guard. Check actual definitions, edges and
# control operands, even if a dead use of the original export remains.
compact_tail = checker.function_definition(source, 'compact_triangle')
producer, _ = checker.scalar_consumer(compact_tail, 'compact_triangle')
compact_evl = producer + Path(sys.argv[3]).read_text().rstrip()
exported = '%fission.participating.count'
merged = '%fission.participating.merge'
forwarded = merged + '.lcssa'
forwarding_phi = '  ' + forwarded + ' = phi i64 [ ' + merged + ', %latch ]\n'


def change_line(body, value, old, new):
    lines = [line for line in body.splitlines() if line.startswith('  ' + value + ' = ')]
    assert len(lines) == 1, (value, body)
    definition, expression = lines[0].split(' = ', 1)
    assert old in expression, (value, old, expression)
    return body.replace(lines[0], definition + ' = ' + expression.replace(old, new), 1)


def reject_compact(body, evl, reason):
    try:
        checker.check_scalar_function(body, 'compact_triangle', evl=evl)
    except AssertionError:
        pass
    else:
        raise AssertionError('accepted compact ' + reason)


for evl, original in ((False, compact_tail), (True, compact_evl)):
    for bound in (exported, merged, forwarded):
        producer, consumer = checker.scalar_consumer(original, 'compact_triangle')
        if bound == forwarded:
            producer = producer.replace('scalar.fission.consumer.guard:\n',
                                        'scalar.fission.consumer.guard:\n' + forwarding_phi)
        candidate = (producer + 'scalar.fission.consumer.ph:\n' +
                     consumer.replace(exported, bound))
        if bound != exported:
            assert exported not in checker.scalar_consumer(candidate, 'compact_triangle')[1]
        assert checker.check_scalar_function(candidate, 'compact_triangle', evl=evl) == candidate
        # Forwarding in the zero check is also valid after proving the export.
        guard_bounds = (exported, merged) + ((forwarded,) if bound == forwarded else ())
        for guard_bound in guard_bounds:
            forwarded_guard = change_line(candidate, '%fission.empty', exported, guard_bound)
            checker.check_scalar_function(forwarded_guard, 'compact_triangle', evl=evl)

        controls = (['%avl'] if evl else
                    ['%min.iters.check', '%n.mod.vf', '%n.vec', '%cmp.n',
                     '%fission.consumer.more'])
        same_prefix = candidate.replace(
            'scalar.fission.consumer.guard:\n',
            'scalar.fission.consumer.guard:\n  ' + forwarded +
            '.unrelated = phi i64 [ %n, %latch ]\n')
        for control in controls:
            # Vector control may forward the count while the scalar tail
            # still uses its export, or conversely. Both are exactly P.
            other = merged if bound == exported else exported
            checker.check_scalar_function(change_line(candidate, control, bound, other),
                                          'compact_triangle', evl=evl)
            for wrong in ('%n', '%unrelated', '%fission.participating',
                          '%fission.participating.next', '65',
                          merged + '.unrelated', forwarded + '.unrelated',
                          exported + '.lcssa'):
                reject_compact(change_line(candidate, control, bound, wrong), evl,
                               control + ' bound ' + wrong)
            reject_compact(change_line(same_prefix, control, bound, forwarded + '.unrelated'),
                           evl, 'defined same-prefix original-trip bound at ' + control)
        conditions = (['%done.evl'] if evl else
                      ['%min.iters.check', '%vector.done', '%cmp.n', '%fission.consumer.more'])
        for condition in conditions:
            reject_compact(candidate.replace('  br i1 ' + condition + ',', '  br i1 %choose,'),
                           evl, 'unused count-controlled predicate ' + condition)
        if evl:
            for value, old, new in [
                ('%evl', 'i64 %avl', 'i64 %n'),
                ('%step', 'i32 %evl', 'i32 4'),
                ('%avl.next', '%avl, %step', '%n, %step'),
                ('%avl.next', '%avl, %step', '%avl, %n'),
                ('%done.evl', ', 0', ', 1'),
                ('%il', 'i32 %evl)', 'i32 4)'),
                ('%dr', 'i32 %evl)', 'i32 4)'),
            ]:
                reject_compact(change_line(candidate, value, old, new), evl,
                               'broken active-length linkage at ' + value)
        else:
            for value, old, new in [
                ('%n.vec', '%n.mod.vf', '%unrelated'),
                ('%n.vec', '%n.mod.vf', '%n.mod.vf.unrelated'),
                ('%cmp.n', '%n.vec', '%unrelated'),
                ('%vector.done', '%n.vec', '%n'),
            ]:
                reject_compact(change_line(candidate, value, old, new), evl,
                               'broken rounded-bound linkage at ' + value)

        for old, new in [
            ('icmp eq', 'icmp ne'), (', 0', ', 1'), (exported, '%n'),
            (exported, '%unrelated'), (exported, forwarded + '.unrelated'),
        ]:
            reject_compact(change_line(candidate, '%fission.empty', old, new),
                           evl, 'incorrect empty-stream comparison')
        guard_branch = ('  br i1 %fission.empty, label %scalar.fission.consumer.exit, '
                        'label %scalar.fission.consumer.ph')
        for replacement in (
            '  br label %scalar.fission.consumer.ph',
            '  br i1 %choose, label %scalar.fission.consumer.exit, label %scalar.fission.consumer.ph',
            '  br i1 %fission.empty, label %scalar.fission.consumer.ph, label %scalar.fission.consumer.exit',
        ):
            reject_compact(candidate.replace(guard_branch, replacement), evl,
                           'missing/incorrect empty-stream branch')
        reject_compact(candidate.replace('  %fission.empty = icmp eq i64 ' + exported + ', 0\n', ''),
                       evl, 'missing empty-stream comparison')
        for value, start, wrong in [('%r0.result', '17', '0'),
                                    ('%r1.result', '-7', '0'),
                                    ('%rd.result', '%start', '0.000000e+00'),
                                    ('%rf.result', '%fstart', '0.000000e+00')]:
            reject_compact(change_line(candidate, value, start, wrong),
                           evl, 'changed empty-stream initial accumulator ' + value)
            for old, new in [('%scalar.fission.consumer.guard', '%left'),
                             ('%scalar.fission.consumer.loopexit', '%vector.body'),
                             (' ]', ' ], [ ' + start + ', %entry ]')]:
                reject_compact(change_line(candidate, value, old, new),
                               evl, 'incorrect result incoming edge/cardinality ' + value)

        # In particular, using the latch bound must not hide a broken guard
        # export. Check edge, incoming value, cardinality and counter linkage.
        for value, old, new in [
            (exported, merged, '%n'),
            (exported, merged, '%unrelated'),
            (exported, merged, '%fission.participating.next'),
            (exported, merged, forwarded + '.unrelated'),
            (exported, '%latch', '%left'),
            (exported, ' ]', ' ], [ %n, %entry ]'),
            ('%fission.participating', '[ 0,', '[ 1,'),
            ('%fission.participating', merged, '%pi'),
            ('%fission.participating', '%latch', '%left'),
            (merged, '%fission.participating, %loop', '%pi, %loop'),
            (merged, '%left', '%preheader'),
            (merged, ' ]', ' ], [ %n, %entry ]'),
            ('%fission.participating.next', '%fission.participating, 1', '%pi, 1'),
            ('%fission.participating.next', ', 1', ', 2'),
        ]:
            reject_compact(change_line(candidate, value, old, new), evl,
                           'broken count linkage at ' + value)

        # A correct PHI spelling does not establish the real entry edge.
        reject_compact(candidate.replace('preheader:\n  br label %loop',
                                         'preheader:\n  br label %scalar.fission.consumer.guard'),
                       evl, 'extra guard predecessor')
        reject_compact(candidate.replace('  br label %loop\nloop:',
                                         '  br label %scalar.fission.consumer.ph\nloop:'),
                       evl, 'extra consumer preheader predecessor')

        if bound == forwarded:
            # No arbitrary suffix, copy chain, wrong edge or multi-input PHI
            # qualifies as the one demonstrated LCSSA export of the latch.
            for old, new in [
                (merged, '%n'), (merged, '%unrelated'), (merged, exported),
                (merged, '%fission.participating'),
                (merged, '%fission.participating.next'),
                (merged, forwarded + '.unrelated'),
                ('%latch', '%left'), ('%latch', '%loop'),
                (' ]', ' ], [ ' + merged + ', %left ]'),
                (' ]', ' ], [ %n, %entry ]'),
            ]:
                reject_compact(change_line(candidate, forwarded, old, new), evl,
                               'incorrect forwarding PHI: ' + new)
            reject_compact(candidate.replace(forwarding_phi, ''), evl,
                           'undefined forwarding value')
            moved = candidate.replace(forwarding_phi, '').replace(
                'scalar.fission.consumer.ph:\n',
                'scalar.fission.consumer.ph:\n' + forwarding_phi)
            reject_compact(moved, evl, 'forwarding PHI outside guard')
            reject_compact(change_line(forwarded_guard, '%fission.empty',
                                       forwarded, forwarded + '.unrelated'),
                           evl, 'unrelated forwarding value in empty guard')

        if evl:
            # Ordered double/float results may be direct or each forwarded
            # through exactly one middle.block PHI. All combinations keep the
            # actual reduction result and the vector.body incoming edge.
            for exports in (('dr',), ('fr',), ('dr', 'fr')):
                result_candidate = candidate
                for value in exports:
                    ty = 'double' if value == 'dr' else 'float'
                    result_phi = f'  %{value}.lcssa = phi {ty} [ %{value}, %vector.body ]\n'
                    result_candidate = result_candidate.replace(
                        'middle.block:\n', 'middle.block:\n' + result_phi)
                    result_candidate = change_line(result_candidate,
                                                   '%rd.result' if value == 'dr' else '%rf.result',
                                                   '%' + value + ',', '%' + value + '.lcssa,')
                checker.check_scalar_function(result_candidate, 'compact_triangle', evl=True)
                for value in exports:
                    result = '%rd.result' if value == 'dr' else '%rf.result'
                    for old, new in [
                        ('[ %' + value + ',', '[ %unrelated,'),
                        ('[ %' + value + ',', '[ %' + value + '.unrelated,'),
                        ('%vector.body', '%vector.ph'),
                        (' ]', ' ], [ %' + value + ', %vector.ph ]'),
                    ]:
                        reject_compact(change_line(result_candidate, '%' + value + '.lcssa', old, new),
                                       True, 'broken result forwarding at ' + value)
                    reject_compact(change_line(result_candidate, result,
                                               '%' + value + '.lcssa,', '%' + value + '.lcssa.unrelated,'),
                                   True, 'unrelated same-prefix result')
                    # Preserve the PHI but move it away from the vector exit.
                    ty = 'double' if value == 'dr' else 'float'
                    result_phi = f'  %{value}.lcssa = phi {ty} [ %{value}, %vector.body ]\n'
                    same_prefix = result_candidate.replace(
                        'middle.block:\n', 'middle.block:\n' +
                        f'  %{value}.lcssa.unrelated = phi {ty} [ %start, %vector.body ]\n')
                    reject_compact(change_line(same_prefix, result,
                                               '%' + value + '.lcssa,', '%' + value + '.lcssa.unrelated,'),
                                   True, 'defined unrelated same-prefix result')
                    reject_compact(result_candidate.replace(result_phi, '').replace(
                        'scalar.fission.consumer.loopexit:\n',
                        'scalar.fission.consumer.loopexit:\n' + result_phi),
                        True, 'result forwarding outside middle.block')
            for result, old in (('%rd.result', '%dr,'), ('%rf.result', '%fr,'),
                                ('%r0.result', '%ir,'), ('%r1.result', '%ir2,')):
                reject_compact(change_line(candidate, result, old, '%unrelated,'),
                               True, 'unrelated nonempty result')
            reject_compact(candidate.replace('  br label %vector.ph\nvector.ph:',
                                             '  br label %middle.block\nvector.ph:'),
                           True, 'extra vector exit predecessor')

# Retained output from the affine execution fixture that exposed whole-block
# metadata truncation. Use the real original and production checker, including
# every control, scratch and actual-count assertion, rather than a normalization
# helper or an independent approximation of the preservation check.
affine_name = 'affine_const'
affine_source = checker.function_definition(Path(sys.argv[4]).read_text(), affine_name)
affine = checker.function_definition(Path(sys.argv[5]).read_text(), affine_name)
assert checker.check_affine_function(affine, affine_source, affine_name, evl=True) == affine


def replace_once(body, old, new):
    assert body.count(old) == 1, (old, body)
    return body.replace(old, new, 1)


def attach_metadata(body, value, attachments):
    lines = [line for line in body.splitlines() if line.startswith('  ' + value + ' = ')]
    assert len(lines) == 1, (value, body)
    return replace_once(body, lines[0], lines[0].split(', !', 1)[0] + attachments)


def reject_affine(body, label, instruction):
    try:
        checker.check_affine_function(body, affine_source, affine_name, evl=True)
    except AssertionError as error:
        # Require the exact preservation assertion. A later scratch, count or
        # reduction assertion must not disguise missing mutation coverage.
        failure = error.args[0]
        assert isinstance(failure, tuple) and failure[:2] == (affine_name, label), failure
        assert failure[2].split(', !', 1)[0].strip() == instruction, failure
    else:
        raise AssertionError('accepted affine mutation: ' + instruction)


# An early attachment in the latch is followed by retained arithmetic, compare
# and branch. Analogous placements cover entry/preheader, header PHIs, loads,
# calls and merge/arm instructions. Metadata IDs/order may differ on each side;
# neither side's first attachment may truncate later instructions in the block.
placements = ('%valid', '%limit', '%iv', '%index', '%x', '%lc', '%first.c',
              '%pc', '%pd', '%c', '%fc', '%next', '%done')
many_metadata = affine
for value in placements:
    marked = attach_metadata(affine, value, ', !dbg !71, !annotation !72')
    marked_source = attach_metadata(affine_source, value, ', !annotation !82, !dbg !81')
    for candidate, original in ((marked, affine_source), (affine, marked_source),
                                (marked, marked_source)):
        assert checker.check_affine_function(candidate, original, affine_name, evl=True) == candidate
    many_metadata = attach_metadata(many_metadata, value, ', !dbg !71, !annotation !72')
assert checker.check_affine_function(many_metadata, affine_source, affine_name, evl=True) == many_metadata

# The three exact dyadic values may retain decimal spelling or print with an
# exponent. This allowance cannot hide a changed value or added FP flags.
decimal = affine.replace('3.000000e+00', '3.0').replace('5.000000e-01', '0.5').replace(
    '-1.000000e+00', '-1.0')
assert checker.check_affine_function(decimal, affine_source, affine_name, evl=True) == decimal

for candidate in (affine, many_metadata):
    for value, old, new, label, instruction in [
        ('%next', 'add nuw nsw', 'sub nuw nsw', 'latch', '%next = add nuw nsw i64 %iv, 1'),
        ('%next', 'nuw nsw', 'nsw', 'latch', '%next = add nuw nsw i64 %iv, 1'),
        ('%next', 'nuw nsw', 'nuw', 'latch', '%next = add nuw nsw i64 %iv, 1'),
        # 1 is a prefix of 10: substring membership incorrectly accepts this.
        ('%next', ', 1', ', 10', 'latch', '%next = add nuw nsw i64 %iv, 1'),
        ('%next', '%iv, 1', '1, %iv', 'latch', '%next = add nuw nsw i64 %iv, 1'),
        ('%index', ', 7', ', 70', 'loop', '%index = sub nuw nsw i64 %iv, 7'),
        ('%pc', 'add i32', 'add nsw i32', 'positive', '%pc = add i32 %first.c, 23'),
        ('%pc', '%first.c, 23', '%first.different, 23', 'positive', '%pc = add i32 %first.c, 23'),
        ('%q', '840', '420', 'left', '%q = sdiv i32 840, %x'),
        ('%lc', '%q)', '%x)', 'left', '%lc = call i32 @scalar_helper(i32 %q)'),
        ('%p', '%index', '%index.other', 'loop', '%p = getelementptr i32, ptr %a, i64 %index'),
        ('%pd', 'fmul double', 'fmul fast double', 'positive', '%pd = fmul double %first.d, 0.5'),
        ('%pd', '5.000000e-01', '5.000000e+00', 'positive', '%pd = fmul double %first.d, 0.5'),
        ('%rc', '3.000000e+00', '3.000000e+01', 'right', '%rc = fmul double %dx, 3.0'),
        ('%done', 'icmp eq', 'icmp ne', 'latch', '%done = icmp eq i64 %limit, %next'),
        ('%done', 'icmp eq', 'icmp ult', 'latch', '%done = icmp eq i64 %limit, %next'),
        ('%done', '%limit, %next', '%next, %limit', 'latch', '%done = icmp eq i64 %limit, %next'),
        ('%choose', 'icmp ne', 'icmp eq', 'loop', '%choose = icmp ne i32 %x, 0'),
    ]:
        reject_affine(change_line(candidate, value, old, new), label, instruction)

    for branch, replacements, label in [
        ('br i1 %enter, label %preheader, label %exit', (
            'br i1 %nonzero, label %preheader, label %exit',
            'br i1 %enter, label %exit, label %preheader',
            'br i1 %enter, label %preheader, label %exit.other'), 'entry'),
        ('br label %loop', ('br label %loop.other',), 'preheader'),
        ('br i1 %choose, label %left, label %right', (
            'br i1 %done, label %left, label %right',
            'br i1 %choose, label %right, label %left',
            'br i1 %choose, label %left, label %right.other'), 'loop'),
        ('br i1 %done, label %scalar.fission.consumer.ph, label %loop', (
            'br i1 %choose, label %scalar.fission.consumer.ph, label %loop',
            'br i1 %done, label %loop, label %scalar.fission.consumer.ph',
            'br i1 %done, label %scalar.fission.consumer.ph.other, label %loop',
            'br i1 %done, label %scalar.fission.consumer.ph, label %loop.other'), 'latch'),
    ]:
        for replacement in replacements:
            reject_affine(replace_once(candidate, '  ' + branch, '  ' + replacement),
                          label, branch)

    # Full instruction text elsewhere in the same function cannot establish
    # preservation in its original block, even for an otherwise safe move.
    for value, source_label, destination, instruction in [
        ('%q', 'left', '  %choose = ', '%q = sdiv i32 840, %x'),
        ('%pc', 'positive', '  %parity = ', '%pc = add i32 %first.c, 23'),
        ('%done', 'latch', '  %nc = ', '%done = icmp eq i64 %limit, %next'),
    ]:
        line = next(line for line in candidate.splitlines() if line.startswith('  ' + value + ' = '))
        moved = replace_once(candidate, line + '\n', '')
        moved = replace_once(moved, destination, line + '\n' + destination)
        reject_affine(moved, source_label, instruction)

    # Concatenating whitespace across physical instructions, or finding the
    # instruction only in a comment, cannot supply a complete printed line.
    reject_affine(replace_once(candidate, '  %next = add nuw nsw i64 %iv, 1',
                              '  %next = add nuw nsw\n  i64 %iv, 1'),
                  'latch', '%next = add nuw nsw i64 %iv, 1')
    reject_affine(replace_once(candidate, '  %pc = add i32 %first.c, 23',
                              '  ; %pc = add i32 %first.c, 23'),
                  'positive', '%pc = add i32 %first.c, 23')

# Fixed-vscale specialization must fail before handing unsupported EVL/VP
# operations to a host backend. Renaming scalable types alone is not sound.
for intrinsic in ('llvm.experimental.get.vector.length.i64',
                  'llvm.vp.load.nxv4i32.p0', 'llvm.vp.merge.nxv4i32',
                  'llvm.vp.reduce.fadd.nxv4f64'):
    try:
        checker.specialize('@' + intrinsic + '()', 2)
    except ValueError as error:
        assert intrinsic in str(error) and 'scalar-remainder' in str(error)
    else:
        raise AssertionError('unsupported intrinsic silently specialized')

#--- functions.ll
define i64 @multiline(ptr %a,
                      i64 %n) {
entry:
  ret i64 %n
}

define i64 @arithmetic_sum(ptr %a) {
entry:
  %producer.load = load <vscale x 4 x i64>, ptr %a
  %producer.reduction = call i64 @llvm.vector.reduce.add.nxv4i64(<vscale x 4 x i64> %producer.load)
  br label %scalar.fission.consumer.ph
scalar.fission.consumer.ph:
  br label %vector.body
vector.body:
  %consumer.load = load <vscale x 4 x i64>, ptr %a
  br label %scalar.fission.consumer.body
scalar.fission.consumer.body:
  ret i64 %producer.reduction
}

declare i64 @llvm.vector.reduce.add.nxv4i64(<vscale x 4 x i64>)

; Parser/probe fixture only. Executable comparisons use the real transformed
; reduction-fission-scalar-diamond.ll, not this synthetic consumer.
define void @scalar_diamond(ptr %a, ptr %fp) {
entry:
  %s = alloca [65 x i32]
  %d = alloca [65 x double]
  %f = alloca [65 x float]
  %x = load i32, ptr %a
  %choose = icmp ne i32 %x, 0
  br i1 %choose, label %left, label %right
left:
  %q = sdiv i32 840, %x
  %lc = call i32 @scalar_helper(i32 %q)
  br label %latch
right:
  %dp = getelementptr double, ptr %fp, i64 0
  %dx = load double, ptr %dp
  br label %latch
latch:
  %c = phi i32 [ %lc, %left ], [ 17, %right ]
  store i32 %c, ptr %s
  br label %scalar.fission.consumer.ph
scalar.fission.consumer.ph:
  br label %vector.body
vector.body:
  %vi = phi i64 [ 0, %scalar.fission.consumer.ph ]
  %il = load <vscale x 4 x i32>, ptr %s
  %dl = load <vscale x 4 x double>, ptr %d
  %fl = load <vscale x 4 x float>, ptr %f
  %dr = call double @llvm.vector.reduce.fadd.nxv4f64(double 0.0, <vscale x 4 x double> %dl)
  %fr = call float @llvm.vector.reduce.fadd.nxv4f32(float 0.0, <vscale x 4 x float> %fl)
  %ir = call i32 @llvm.vector.reduce.add.nxv4i32(<vscale x 4 x i32> %il)
  br label %scalar.fission.consumer.body
scalar.fission.consumer.body:
  %ti = phi i64 [ 0, %vector.body ]
  ret void
}

; Parser/probe fixture only; actual transformed execution uses scalar-compact.ll.
define void @compact_triangle(ptr %a, ptr %fp, i64 %n, i64 %unrelated, double %start) {
entry:
  %s = alloca [65 x i32]
  %d = alloca [65 x double]
  %f = alloca [65 x float]
  %fstart = fptrunc double %start to float
  br label %preheader
preheader:
  br label %loop
loop:
  %fission.participating = phi i64 [ 0, %preheader ], [ %fission.participating.merge, %latch ]
  %pi = phi i64 [ 0, %preheader ], [ %next, %latch ]
  %x = load i32, ptr %a
  %choose = icmp ne i32 %x, 0
  br i1 %choose, label %left, label %latch
left:
  %q = sdiv i32 840, %x
  %lc = call i32 @scalar_helper(i32 %q)
  %dp = getelementptr double, ptr %fp, i64 0
  %dc = load double, ptr %dp
  %fc = fptrunc double %dc to float
  %fission.participating.next = add nuw i64 %fission.participating, 1
  store i32 %lc, ptr %s
  store double %dc, ptr %d
  store float %fc, ptr %f
  br label %latch
latch:
  %fission.participating.merge = phi i64 [ %fission.participating.next, %left ], [ %fission.participating, %loop ]
  %next = add nuw i64 %pi, 1
  %done = icmp eq i64 %next, %n
  br i1 %done, label %scalar.fission.consumer.guard, label %loop
scalar.fission.consumer.guard:
  %fission.participating.count = phi i64 [ %fission.participating.merge, %latch ]
  %fission.empty = icmp eq i64 %fission.participating.count, 0
  br i1 %fission.empty, label %scalar.fission.consumer.exit, label %scalar.fission.consumer.ph
scalar.fission.consumer.ph:
  %dead.bound = add i64 0, %fission.participating.count
  %scale = call i64 @llvm.vscale.i64()
  %vf = shl nuw i64 %scale, 2
  %min.iters.check = icmp ult i64 %fission.participating.count, %vf
  br i1 %min.iters.check, label %scalar.ph, label %vector.ph
vector.ph:
  %n.mod.vf = urem i64 %fission.participating.count, %vf
  %n.vec = sub i64 %fission.participating.count, %n.mod.vf
  br label %vector.body
vector.body:
  %vi = phi i64 [ 0, %vector.ph ], [ %vector.next, %vector.body ]
  %il = load <vscale x 4 x i32>, ptr %s
  %dl = load <vscale x 4 x double>, ptr %d
  %fl = load <vscale x 4 x float>, ptr %f
  %dr = call double @llvm.vector.reduce.fadd.nxv4f64(double 0.0, <vscale x 4 x double> %dl)
  %fr = call float @llvm.vector.reduce.fadd.nxv4f32(float 0.0, <vscale x 4 x float> %fl)
  %ir = call i32 @llvm.vector.reduce.add.nxv4i32(<vscale x 4 x i32> %il)
  %vector.next = add nuw i64 %vi, %vf
  %vector.done = icmp eq i64 %vector.next, %n.vec
  br i1 %vector.done, label %middle.block, label %vector.body
middle.block:
  %cmp.n = icmp eq i64 %fission.participating.count, %n.vec
  br i1 %cmp.n, label %scalar.fission.consumer.loopexit, label %scalar.ph
scalar.ph:
  %resume = phi i64 [ 0, %scalar.fission.consumer.ph ], [ %n.vec, %middle.block ]
  br label %scalar.fission.consumer.body
scalar.fission.consumer.body:
  %ti = phi i64 [ %resume, %scalar.ph ], [ %fission.consumer.next, %scalar.fission.consumer.body ]
  %fission.consumer.next = add nuw i64 %ti, 1
  %fission.consumer.more = icmp ne i64 %fission.consumer.next, %fission.participating.count
  br i1 %fission.consumer.more, label %scalar.fission.consumer.body, label %scalar.fission.consumer.loopexit
scalar.fission.consumer.loopexit:
  %r0.lcssa = phi i32 [ %ir, %middle.block ], [ 23, %scalar.fission.consumer.body ]
  %r1.lcssa = phi i32 [ %ir, %middle.block ], [ 29, %scalar.fission.consumer.body ]
  %rd.lcssa = phi double [ %dr, %middle.block ], [ 1.000000e+00, %scalar.fission.consumer.body ]
  %rf.lcssa = phi float [ %fr, %middle.block ], [ 2.000000e+00, %scalar.fission.consumer.body ]
  br label %scalar.fission.consumer.exit
scalar.fission.consumer.exit:
  %r0.result = phi i32 [ 17, %scalar.fission.consumer.guard ], [ %r0.lcssa, %scalar.fission.consumer.loopexit ]
  %r1.result = phi i32 [ -7, %scalar.fission.consumer.guard ], [ %r1.lcssa, %scalar.fission.consumer.loopexit ]
  %rd.result = phi double [ %start, %scalar.fission.consumer.guard ], [ %rd.lcssa, %scalar.fission.consumer.loopexit ]
  %rf.result = phi float [ %fstart, %scalar.fission.consumer.guard ], [ %rf.lcssa, %scalar.fission.consumer.loopexit ]
  ret void
}

#--- compact-evl.ll
scalar.fission.consumer.ph:
  %dead.bound = add i64 0, %fission.participating.count
  br label %vector.ph
vector.ph:
  br label %vector.body
vector.body:
  %vi = phi i64 [ 0, %vector.ph ], [ %vector.next, %vector.body ]
  %avl = phi i64 [ %fission.participating.count, %vector.ph ], [ %avl.next, %vector.body ]
  %evl = call i32 @llvm.experimental.get.vector.length.i64(i64 %avl, i32 4, i1 true)
  %il = call <vscale x 4 x i32> @llvm.vp.load.nxv4i32.p0(ptr %s, <vscale x 4 x i1> splat (i1 true), i32 %evl)
  %dl = call <vscale x 4 x double> @llvm.vp.load.nxv4f64.p0(ptr %d, <vscale x 4 x i1> splat (i1 true), i32 %evl)
  %fl = call <vscale x 4 x float> @llvm.vp.load.nxv4f32.p0(ptr %f, <vscale x 4 x i1> splat (i1 true), i32 %evl)
  %dr = call double @llvm.vp.reduce.fadd.nxv4f64(double %start, <vscale x 4 x double> %dl, <vscale x 4 x i1> splat (i1 true), i32 %evl)
  %fr = call float @llvm.vp.reduce.fadd.nxv4f32(float %fstart, <vscale x 4 x float> %fl, <vscale x 4 x i1> splat (i1 true), i32 %evl)
  %step = zext i32 %evl to i64
  %vector.next = add i64 %step, %vi
  %avl.next = sub nuw i64 %avl, %step
  %done.evl = icmp eq i64 %avl.next, 0
  br i1 %done.evl, label %middle.block, label %vector.body
middle.block:
  %ir = call i32 @llvm.vector.reduce.add.nxv4i32(<vscale x 4 x i32> %il)
  %ir2 = call i32 @llvm.vector.reduce.add.nxv4i32(<vscale x 4 x i32> %il)
  br label %scalar.fission.consumer.loopexit
scalar.fission.consumer.loopexit:
  br label %scalar.fission.consumer.exit
scalar.fission.consumer.exit:
  %r0.result = phi i32 [ 17, %scalar.fission.consumer.guard ], [ %ir, %scalar.fission.consumer.loopexit ]
  %r1.result = phi i32 [ -7, %scalar.fission.consumer.guard ], [ %ir2, %scalar.fission.consumer.loopexit ]
  %rd.result = phi double [ %start, %scalar.fission.consumer.guard ], [ %dr, %scalar.fission.consumer.loopexit ]
  %rf.result = phi float [ %fstart, %scalar.fission.consumer.guard ], [ %fr, %scalar.fission.consumer.loopexit ]
  ret void
}

#--- affine-evl.ll
; Retained affine_const EVL output. Checker/probe fixture only; executable
; comparisons continue to compile the original affine fixture with real opt.
define void @affine_const(ptr readonly %a, ptr readonly %fp, ptr %out, ptr %dout, ptr %fout, i64 %n, double %start, i64 %begin) #1 !dbg !4 {
entry:
  %scalar.fission.scratch = alloca [65 x i32], align 4
  %scalar.fission.scratch1 = alloca [65 x double], align 8
  %scalar.fission.scratch2 = alloca [65 x float], align 4
  %valid = icmp ule i64 %n, 65
  %nonzero = icmp ne i64 %n, 0
  %enter = and i1 %valid, %nonzero
  %fstart = fptrunc double %start to float
  br i1 %enter, label %preheader, label %exit

preheader:                                        ; preds = %entry
  %limit = add nuw nsw i64 %n, 7
  br label %loop, !dbg !7

loop:                                             ; preds = %latch, %preheader
  %fission.ordinal = phi i64 [ 0, %preheader ], [ %fission.completed, %latch ]
  %iv = phi i64 [ 7, %preheader ], [ %next, %latch ]
  %index = sub nuw nsw i64 %iv, 7
  %p = getelementptr i32, ptr %a, i64 %index
  %x = load i32, ptr %p, align 4
  %choose = icmp ne i32 %x, 0
  br i1 %choose, label %left, label %right, !dbg !7

left:                                             ; preds = %loop
  %q = sdiv i32 840, %x
  %lc = call i32 @scalar_helper(i32 %q)
  %ld = sitofp i32 %q to double
  br label %first.merge

right:                                            ; preds = %loop
  %dp = getelementptr double, ptr %fp, i64 %index
  %dx = load double, ptr %dp, align 8
  %rc = fmul double %dx, 3.000000e+00
  br label %first.merge

first.merge:                                      ; preds = %right, %left
  %first.c = phi i32 [ %lc, %left ], [ 17, %right ]
  %first.d = phi double [ %ld, %left ], [ %rc, %right ]
  %parity = and i64 %index, 1
  %second = icmp ne i64 %parity, 0
  br i1 %second, label %positive, label %negative

positive:                                         ; preds = %first.merge
  %pc = add i32 %first.c, 23
  %pd = fmul double %first.d, 5.000000e-01
  br label %latch

negative:                                         ; preds = %first.merge
  %nc = sub i32 %first.c, 9
  %nd = fmul double %first.d, -1.000000e+00
  br label %latch

latch:                                            ; preds = %negative, %positive
  %c = phi i32 [ %pc, %positive ], [ %nc, %negative ]
  %dc = phi double [ %pd, %positive ], [ %nd, %negative ]
  %fc = fptrunc double %dc to float
  %next = add nuw nsw i64 %iv, 1
  %done = icmp eq i64 %limit, %next
  %fission.completed = add nuw i64 %fission.ordinal, 1, !dbg !7
  %0 = getelementptr inbounds [65 x i32], ptr %scalar.fission.scratch, i32 0, i64 %fission.ordinal, !dbg !7
  store i32 %c, ptr %0, align 4, !dbg !7
  %1 = getelementptr inbounds [65 x double], ptr %scalar.fission.scratch1, i32 0, i64 %fission.ordinal, !dbg !7
  store double %dc, ptr %1, align 8, !dbg !7
  %2 = getelementptr inbounds [65 x float], ptr %scalar.fission.scratch2, i32 0, i64 %fission.ordinal, !dbg !7
  store float %fc, ptr %2, align 4, !dbg !7
  br i1 %done, label %scalar.fission.consumer.ph, label %loop, !dbg !7, !llvm.loop !8

scalar.fission.consumer.ph:                       ; preds = %latch
  %fission.completed.count = phi i64 [ %fission.completed, %latch ]
  br label %vector.ph

vector.ph:                                        ; preds = %scalar.fission.consumer.ph
  br label %vector.body

vector.body:                                      ; preds = %vector.body, %vector.ph
  %index5 = phi i64 [ 0, %vector.ph ], [ %current.iteration.next, %vector.body ], !dbg !7
  %vec.phi = phi <vscale x 4 x i32> [ insertelement (<vscale x 4 x i32> zeroinitializer, i32 17, i32 0), %vector.ph ], [ %11, %vector.body ]
  %vec.phi6 = phi <vscale x 4 x i32> [ insertelement (<vscale x 4 x i32> zeroinitializer, i32 -7, i32 0), %vector.ph ], [ %12, %vector.body ]
  %vec.phi7 = phi double [ %start, %vector.ph ], [ %9, %vector.body ]
  %vec.phi8 = phi float [ %fstart, %vector.ph ], [ %10, %vector.body ]
  %avl = phi i64 [ %n, %vector.ph ], [ %avl.next, %vector.body ]
  %3 = call i32 @llvm.experimental.get.vector.length.i64(i64 %avl, i32 4, i1 true)
  %4 = getelementptr inbounds [65 x i32], ptr %scalar.fission.scratch, i32 0, i64 %index5, !dbg !7
  %vp.op.load = call <vscale x 4 x i32> @llvm.vp.load.nxv4i32.p0(ptr align 4 %4, <vscale x 4 x i1> splat (i1 true), i32 %3), !dbg !7
  %5 = getelementptr inbounds [65 x double], ptr %scalar.fission.scratch1, i32 0, i64 %index5, !dbg !7
  %vp.op.load9 = call <vscale x 4 x double> @llvm.vp.load.nxv4f64.p0(ptr align 8 %5, <vscale x 4 x i1> splat (i1 true), i32 %3), !dbg !7
  %6 = getelementptr inbounds [65 x float], ptr %scalar.fission.scratch2, i32 0, i64 %index5, !dbg !7
  %vp.op.load10 = call <vscale x 4 x float> @llvm.vp.load.nxv4f32.p0(ptr align 4 %6, <vscale x 4 x i1> splat (i1 true), i32 %3), !dbg !7
  %7 = add <vscale x 4 x i32> %vec.phi, %vp.op.load, !dbg !7
  %8 = add <vscale x 4 x i32> %vp.op.load, %vec.phi6, !dbg !7
  %9 = call double @llvm.vp.reduce.fadd.nxv4f64(double %vec.phi7, <vscale x 4 x double> %vp.op.load9, <vscale x 4 x i1> splat (i1 true), i32 %3)
  %10 = call float @llvm.vp.reduce.fadd.nxv4f32(float %vec.phi8, <vscale x 4 x float> %vp.op.load10, <vscale x 4 x i1> splat (i1 true), i32 %3)
  %11 = call <vscale x 4 x i32> @llvm.vp.merge.nxv4i32(<vscale x 4 x i1> splat (i1 true), <vscale x 4 x i32> %7, <vscale x 4 x i32> %vec.phi, i32 %3)
  %12 = call <vscale x 4 x i32> @llvm.vp.merge.nxv4i32(<vscale x 4 x i1> splat (i1 true), <vscale x 4 x i32> %8, <vscale x 4 x i32> %vec.phi6, i32 %3)
  %13 = zext i32 %3 to i64, !dbg !7
  %current.iteration.next = add nuw i64 %13, %index5, !dbg !7
  %avl.next = sub nuw i64 %avl, %13
  %14 = icmp eq i64 %avl.next, 0
  br i1 %14, label %middle.block, label %vector.body, !dbg !7, !llvm.loop !10

middle.block:                                     ; preds = %vector.body
  %15 = call i32 @llvm.vector.reduce.add.nxv4i32(<vscale x 4 x i32> %11), !dbg !7
  %16 = call i32 @llvm.vector.reduce.add.nxv4i32(<vscale x 4 x i32> %12), !dbg !7
  br label %exit.loopexit, !dbg !7

exit.loopexit:                                    ; preds = %middle.block
  br label %exit

exit:                                             ; preds = %exit.loopexit, %entry
  %v0 = phi i32 [ 17, %entry ], [ %15, %exit.loopexit ]
  %v1 = phi i32 [ -7, %entry ], [ %16, %exit.loopexit ]
  %vd = phi double [ %start, %entry ], [ %9, %exit.loopexit ]
  %vf = phi float [ %fstart, %entry ], [ %10, %exit.loopexit ]
  %o1 = getelementptr i32, ptr %out, i64 1
  store i32 %v0, ptr %out, align 4
  store i32 %v1, ptr %o1, align 4
  store double %vd, ptr %dout, align 8
  store float %vf, ptr %fout, align 4
  ret void
}
