# RUN: split-file %s %t
# RUN: %python %t/check.py %S/../../utils/check-reduction-fission.py %t/functions.ll %t/compact-evl.ll \
# RUN:   %S/../Transforms/LoopVectorize/RISCV/reduction-fission-scalar-affine.ll %t/affine-evl.ll \
# RUN:   %S/Inputs/reduction-fission-affine-counts.ll

# Parsing and checker boundaries only; transformed execution is exercised by
# check-reduction-fission.py with the real opt/llc and the C harness.

#--- check.py
import importlib.util
from pathlib import Path
import re
import sys

spec = importlib.util.spec_from_file_location('fission_checker', sys.argv[1])
checker = importlib.util.module_from_spec(spec)
spec.loader.exec_module(checker)
source = Path(sys.argv[2]).read_text()

# Keep the multiline definition whole and drop the following definition.
body = checker.function_definition(source, 'multiline')
assert 'i64 %n)' in body and 'ret i64 %n' in body
kept = checker.keep_functions(source, ['multiline'])
assert kept.count('define ') == 1
assert checker.function_definition(kept, 'multiline') == body

try:
    checker.function_definition(source, 'missing')
except ValueError as error:
    assert 'expected one definition for @missing, found 0' in str(error)
    assert 'multiline' in str(error)
else:
    raise AssertionError('missing function did not fail')

try:
    checker.function_definition(source + body + '\n', 'multiline')
except ValueError as error:
    assert 'found 2' in str(error)
else:
    raise AssertionError('duplicate function did not fail')

# A reduction in the producer or another function cannot satisfy the exact
# consumer's check. This used to be possible with module-wide substring tests.
try:
    checker.check_scalar_function(source, 'arithmetic_sum', evl=False)
except AssertionError as error:
    assert '@arithmetic_sum: missing integer consumer reduction' in str(error)
else:
    raise AssertionError('producer reduction accepted as consumer evidence')

# A diamond must retain its control, unsafe operations and merge. Instrument
# both exact consumer headers after their PHIs, including the scalar tail.
diamond = checker.check_scalar_function(source, 'scalar_diamond', evl=False, probe=True)
assert diamond.count('call void @record_scalar_consumer_vector()') == 1
assert diamond.count('call void @record_scalar_consumer_tail()') == 1
assert ('%vi = phi i64 [ 0, %scalar.fission.consumer.ph ]\n'
        '  call void @record_scalar_consumer_vector()') in diamond
assert ('%ti = phi i64 [ 0, %vector.body ]\n'
        '  call void @record_scalar_consumer_tail()') in diamond
hoisted = source.replace('left:\n  %q = sdiv i32 840, %x\n',
                         '  %q = sdiv i32 840, %x\nleft:\n')
try:
    checker.check_scalar_function(hoisted, 'scalar_diamond', evl=False)
except AssertionError:
    pass
else:
    raise AssertionError('speculated diamond division accepted as producer evidence')

# Compact instrumentation must retain the whole function and insert the
# producer probes after PHIs as well as the two exact consumer probes.
compact = checker.check_scalar_function(source, 'compact_triangle', evl=False, probe=True)
for probe in ('compact_iteration', 'compact_participant',
              'scalar_consumer_vector', 'scalar_consumer_tail'):
    assert compact.count('call void @record_' + probe + '()') == 1
assert compact.startswith('define void @compact_triangle(') and compact.endswith('}')
assert ('%pi = phi i64 [ 0, %preheader ], [ %next, %latch ]\n'
        '  call void @record_compact_iteration()') in compact

# SCEV expansion can use the export or latch value; repeated LV forwards the
# latter through one PHI in the guard. Check actual definitions, edges and
# control operands, even if a dead use of the original export remains.
compact_tail = checker.function_definition(source, 'compact_triangle')
producer, _ = checker.scalar_consumer(compact_tail, 'compact_triangle')
compact_evl = producer + Path(sys.argv[3]).read_text().rstrip()
exported = '%fission.participating.count'
merged = '%fission.participating.merge'
forwarded = merged + '.lcssa'
forwarding_phi = '  ' + forwarded + ' = phi i64 [ ' + merged + ', %latch ]\n'


def ssa_token(value):
    assert re.fullmatch(r'%[-\w.$]+', value), value
    return re.escape(value) + r'(?![-\w.$])'


def change_line(body, value, old, new):
    matches = list(re.finditer(r'^  ' + re.escape(value) + r' = ([^\n]*)$', body, re.M))
    assert len(matches) == 1, (value, body)
    match = matches[0]
    expression = match[1]
    assert old in expression, (value, old, expression)
    if re.fullmatch(r'%[-\w.$]+', old):
        assert re.search(ssa_token(old), expression), (value, old, expression)
        changed = re.sub(ssa_token(old), new, expression)
    else:
        changed = expression.replace(old, new)
    return body[:match.start(1)] + changed + body[match.end(1):]


def reject_compact(body, evl, reason):
    try:
        checker.check_scalar_function(body, 'compact_triangle', evl=evl)
    except AssertionError:
        pass
    else:
        raise AssertionError('accepted compact ' + reason)


for evl, original in ((False, compact_tail), (True, compact_evl)):
    for bound in (exported, merged, forwarded):
        producer, consumer = checker.scalar_consumer(original, 'compact_triangle')
        if bound == forwarded:
            producer = producer.replace('scalar.fission.consumer.guard:\n',
                                        'scalar.fission.consumer.guard:\n' + forwarding_phi)
        candidate = (producer + 'scalar.fission.consumer.ph:\n' +
                     consumer.replace(exported, bound))
        if bound != exported:
            assert exported not in checker.scalar_consumer(candidate, 'compact_triangle')[1]
        assert checker.check_scalar_function(candidate, 'compact_triangle', evl=evl) == candidate
        # Forwarding in the zero check is also valid after proving the export.
        guard_bounds = (exported, merged) + ((forwarded,) if bound == forwarded else ())
        for guard_bound in guard_bounds:
            forwarded_guard = change_line(candidate, '%fission.empty', exported, guard_bound)
            checker.check_scalar_function(forwarded_guard, 'compact_triangle', evl=evl)

        controls = (['%avl'] if evl else
                    ['%min.iters.check', '%n.mod.vf', '%n.vec', '%cmp.n',
                     '%fission.consumer.more'])
        same_prefix = candidate.replace(
            'scalar.fission.consumer.guard:\n',
            'scalar.fission.consumer.guard:\n  ' + forwarded +
            '.unrelated = phi i64 [ %n, %latch ]\n')
        for control in controls:
            # Vector control may forward the count while the scalar tail
            # still uses its export, or conversely. Both are exactly P.
            other = merged if bound == exported else exported
            checker.check_scalar_function(change_line(candidate, control, bound, other),
                                          'compact_triangle', evl=evl)
            for wrong in ('%n', '%unrelated', '%fission.participating',
                          '%fission.participating.next', '65',
                          merged + '.unrelated', forwarded + '.unrelated',
                          exported + '.lcssa'):
                reject_compact(change_line(candidate, control, bound, wrong), evl,
                               control + ' bound ' + wrong)
            reject_compact(change_line(same_prefix, control, bound, forwarded + '.unrelated'),
                           evl, 'defined same-prefix original-trip bound at ' + control)
        conditions = (['%done.evl'] if evl else
                      ['%min.iters.check', '%vector.done', '%cmp.n', '%fission.consumer.more'])
        for condition in conditions:
            reject_compact(candidate.replace('  br i1 ' + condition + ',', '  br i1 %choose,'),
                           evl, 'unused count-controlled predicate ' + condition)
        if evl:
            for value, old, new in [
                ('%evl', 'i64 %avl', 'i64 %n'),
                ('%step', 'i32 %evl', 'i32 4'),
                ('%avl.next', '%avl, %step', '%n, %step'),
                ('%avl.next', '%avl, %step', '%avl, %n'),
                ('%done.evl', ', 0', ', 1'),
                ('%il', 'i32 %evl)', 'i32 4)'),
                ('%dr', 'i32 %evl)', 'i32 4)'),
            ]:
                reject_compact(change_line(candidate, value, old, new), evl,
                               'broken active-length linkage at ' + value)
        else:
            for value, old, new in [
                ('%n.vec', '%n.mod.vf', '%unrelated'),
                ('%n.vec', '%n.mod.vf', '%n.mod.vf.unrelated'),
                ('%cmp.n', '%n.vec', '%unrelated'),
                ('%vector.done', '%n.vec', '%n'),
            ]:
                reject_compact(change_line(candidate, value, old, new), evl,
                               'broken rounded-bound linkage at ' + value)

        for old, new in [
            ('icmp eq', 'icmp ne'), (', 0', ', 1'), (exported, '%n'),
            (exported, '%unrelated'), (exported, forwarded + '.unrelated'),
        ]:
            reject_compact(change_line(candidate, '%fission.empty', old, new),
                           evl, 'incorrect empty-stream comparison')
        guard_branch = ('  br i1 %fission.empty, label %scalar.fission.consumer.exit, '
                        'label %scalar.fission.consumer.ph')
        for replacement in (
            '  br label %scalar.fission.consumer.ph',
            '  br i1 %choose, label %scalar.fission.consumer.exit, label %scalar.fission.consumer.ph',
            '  br i1 %fission.empty, label %scalar.fission.consumer.ph, label %scalar.fission.consumer.exit',
        ):
            reject_compact(candidate.replace(guard_branch, replacement), evl,
                           'missing/incorrect empty-stream branch')
        reject_compact(candidate.replace('  %fission.empty = icmp eq i64 ' + exported + ', 0\n', ''),
                       evl, 'missing empty-stream comparison')
        for value, start, wrong in [('%r0.result', '17', '0'),
                                    ('%r1.result', '-7', '0'),
                                    ('%rd.result', '%start', '0.000000e+00'),
                                    ('%rf.result', '%fstart', '0.000000e+00')]:
            reject_compact(change_line(candidate, value, start, wrong),
                           evl, 'changed empty-stream initial accumulator ' + value)
            for old, new in [('%scalar.fission.consumer.guard', '%left'),
                             ('%scalar.fission.consumer.loopexit', '%vector.body'),
                             (' ]', ' ], [ ' + start + ', %entry ]')]:
                reject_compact(change_line(candidate, value, old, new),
                               evl, 'incorrect result incoming edge/cardinality ' + value)

        # In particular, using the latch bound must not hide a broken guard
        # export. Check edge, incoming value, cardinality and counter linkage.
        for value, old, new in [
            (exported, merged, '%n'),
            (exported, merged, '%unrelated'),
            (exported, merged, '%fission.participating.next'),
            (exported, merged, forwarded + '.unrelated'),
            (exported, '%latch', '%left'),
            (exported, ' ]', ' ], [ %n, %entry ]'),
            ('%fission.participating', '[ 0,', '[ 1,'),
            ('%fission.participating', merged, '%pi'),
            ('%fission.participating', '%latch', '%left'),
            (merged, '%fission.participating, %loop', '%pi, %loop'),
            (merged, '%left', '%preheader'),
            (merged, ' ]', ' ], [ %n, %entry ]'),
            ('%fission.participating.next', '%fission.participating, 1', '%pi, 1'),
            ('%fission.participating.next', ', 1', ', 2'),
        ]:
            reject_compact(change_line(candidate, value, old, new), evl,
                           'broken count linkage at ' + value)

        # A correct PHI spelling does not establish the real entry edge.
        reject_compact(candidate.replace('preheader:\n  br label %loop',
                                         'preheader:\n  br label %scalar.fission.consumer.guard'),
                       evl, 'extra guard predecessor')
        reject_compact(candidate.replace('  br label %loop\nloop:',
                                         '  br label %scalar.fission.consumer.ph\nloop:'),
                       evl, 'extra consumer preheader predecessor')

        if bound == forwarded:
            # No arbitrary suffix, copy chain, wrong edge or multi-input PHI
            # qualifies as the one demonstrated LCSSA export of the latch.
            for old, new in [
                (merged, '%n'), (merged, '%unrelated'), (merged, exported),
                (merged, '%fission.participating'),
                (merged, '%fission.participating.next'),
                (merged, forwarded + '.unrelated'),
                ('%latch', '%left'), ('%latch', '%loop'),
                (' ]', ' ], [ ' + merged + ', %left ]'),
                (' ]', ' ], [ %n, %entry ]'),
            ]:
                reject_compact(change_line(candidate, forwarded, old, new), evl,
                               'incorrect forwarding PHI: ' + new)
            reject_compact(candidate.replace(forwarding_phi, ''), evl,
                           'undefined forwarding value')
            moved = candidate.replace(forwarding_phi, '').replace(
                'scalar.fission.consumer.ph:\n',
                'scalar.fission.consumer.ph:\n' + forwarding_phi)
            reject_compact(moved, evl, 'forwarding PHI outside guard')
            reject_compact(change_line(forwarded_guard, '%fission.empty',
                                       forwarded, forwarded + '.unrelated'),
                           evl, 'unrelated forwarding value in empty guard')

        if evl:
            # Ordered double/float results may be direct or each forwarded
            # through exactly one middle.block PHI. All combinations keep the
            # actual reduction result and the vector.body incoming edge.
            for exports in (('dr',), ('fr',), ('dr', 'fr')):
                result_candidate = candidate
                for value in exports:
                    ty = 'double' if value == 'dr' else 'float'
                    result_phi = f'  %{value}.lcssa = phi {ty} [ %{value}, %vector.body ]\n'
                    result_candidate = result_candidate.replace(
                        'middle.block:\n', 'middle.block:\n' + result_phi)
                    result_candidate = change_line(result_candidate,
                                                   '%rd.result' if value == 'dr' else '%rf.result',
                                                   '%' + value + ',', '%' + value + '.lcssa,')
                checker.check_scalar_function(result_candidate, 'compact_triangle', evl=True)
                for value in exports:
                    result = '%rd.result' if value == 'dr' else '%rf.result'
                    for old, new in [
                        ('[ %' + value + ',', '[ %unrelated,'),
                        ('[ %' + value + ',', '[ %' + value + '.unrelated,'),
                        ('%vector.body', '%vector.ph'),
                        (' ]', ' ], [ %' + value + ', %vector.ph ]'),
                    ]:
                        reject_compact(change_line(result_candidate, '%' + value + '.lcssa', old, new),
                                       True, 'broken result forwarding at ' + value)
                    reject_compact(change_line(result_candidate, result,
                                               '%' + value + '.lcssa,', '%' + value + '.lcssa.unrelated,'),
                                   True, 'unrelated same-prefix result')
                    # Preserve the PHI but move it away from the vector exit.
                    ty = 'double' if value == 'dr' else 'float'
                    result_phi = f'  %{value}.lcssa = phi {ty} [ %{value}, %vector.body ]\n'
                    same_prefix = result_candidate.replace(
                        'middle.block:\n', 'middle.block:\n' +
                        f'  %{value}.lcssa.unrelated = phi {ty} [ %start, %vector.body ]\n')
                    reject_compact(change_line(same_prefix, result,
                                               '%' + value + '.lcssa,', '%' + value + '.lcssa.unrelated,'),
                                   True, 'defined unrelated same-prefix result')
                    reject_compact(result_candidate.replace(result_phi, '').replace(
                        'scalar.fission.consumer.loopexit:\n',
                        'scalar.fission.consumer.loopexit:\n' + result_phi),
                        True, 'result forwarding outside middle.block')
            for result, old in (('%rd.result', '%dr,'), ('%rf.result', '%fr,'),
                                ('%r0.result', '%ir,'), ('%r1.result', '%ir2,')):
                reject_compact(change_line(candidate, result, old, '%unrelated,'),
                               True, 'unrelated nonempty result')
            reject_compact(candidate.replace('  br label %vector.ph\nvector.ph:',
                                             '  br label %middle.block\nvector.ph:'),
                           True, 'extra vector exit predecessor')

# Retained output from the affine execution fixture that exposed whole-block
# metadata truncation. Use the real original and production checker, including
# every control, scratch and actual-count assertion, rather than a normalization
# helper or an independent approximation of the preservation check.
affine_name = 'affine_const'
affine_source = checker.function_definition(Path(sys.argv[4]).read_text(), affine_name)
affine = checker.function_definition(Path(sys.argv[5]).read_text(), affine_name)
assert checker.check_affine_function(affine, affine_source, affine_name, evl=True) == affine


def replace_once(body, old, new):
    assert body.count(old) == 1, (old, body)
    return body.replace(old, new, 1)


def match_once(body, pattern):
    matches = list(re.finditer(pattern, body, re.M))
    assert len(matches) == 1, (pattern, len(matches))
    return matches[0]


def replace_match_once(body, pattern, new):
    match = match_once(body, pattern)
    return body[:match.start()] + new + body[match.end():]


def specialize_i64_argument(text, function, argument, value):
    # Fixture syntax only: define void @unquoted_name, flat named ptr (with
    # optional readonly), i64/double/float parameters, and unquoted body tokens.
    # Parameters may span lines and the selected i64 may occupy any position.
    # Use the existing definition extractor, then retain the signature/parameter
    # spans. A typed operand such as "i64 %n, " is NOT unique to the signature.
    assert argument in ('%n', '%rows'), argument
    assert type(value) is int and 0 <= value < 2**64, value
    definitions = [m for m in checker.FUNCTION_DEFINITION.finditer(text) if m['name'] == function]
    assert len(definitions) == 1, ('function definition', function, len(definitions))
    definition = definitions[0]
    body = definition[0]
    signature = match_once(body, r'^define void @' + re.escape(function) +
                           r'\((?P<parameters>[^(){};]*)\)[^\n{]*\{')
    parameters = signature['parameters']
    fields = parameters.split(',') if parameters.strip() else []
    names = []
    for field in fields:
        parameter = re.fullmatch(r'\s*(ptr(?: readonly)?|i64|double|float)\s+(%[-\w.$]+)\s*', field)
        assert parameter, ('unsupported parameter', field)
        names.append(parameter[2])
    assert names.count(argument) == 1, ('formal parameter', function, argument, names.count(argument))
    index = names.index(argument)
    assert re.fullmatch(r'\s*i64\s+' + re.escape(argument) + r'\s*', fields[index]), fields[index]
    start = sum(len(field) + 1 for field in fields[:index])
    end = start + len(fields[index])
    if index + 1 < len(fields):
        end += 1  # Remove the following separator for a first/middle parameter.
    elif index:
        start -= 1  # The last parameter owns the preceding separator.
    start += signature.start('parameters')
    end += signature.start('parameters')
    header = body[:start] + body[end:signature.end()]

    # Substitute uses only inside this definition, after its signature. Keep
    # guards/instructions and comments; never match a longer SSA identifier.
    token = ssa_token(argument)
    lines = []
    for line in body[signature.end():].splitlines(keepends=True):
        code, separator, comment = line.partition(';')
        assert '"' not in code, ('unsupported quoted token', code)
        assert not re.match(r'\s*' + token + r'\s*=', code), ('argument redefinition', code)
        lines.append(re.sub(token, str(value), code) + separator + comment)
    return text[:definition.start()] + header + ''.join(lines) + text[definition.end():]


# Construction coverage only, independently comparing the complete expected
# strings. Repeated typed operands in guards/shifts/calls must survive as typed
# constants, and the other parameters, definitions and comments stay unchanged.
for argument, other, maximum, values in (
    ('%n', '%rows', 65, (0, 1, 65, 66, 2**64 - 1)),
    ('%rows', '%n', 4, (0, 1, 4, 5, 2**64 - 1)),
):
    similar = ''.join('  ' + argument + suffix + ' = add i64 9, 1\n'
                      for suffix in ('.more', 'more', '0', '_more', '$more', '-more'))
    template = (f'\nentry: ; keep {argument} in comments\n' + similar +
                f'  %valid = icmp ule i64 OPERAND, {maximum}\n'
                '  %nonzero = icmp ne i64 OPERAND, 0\n'
                '  %enter = and i1 %valid, %nonzero\n'
                '  br i1 %enter, label %work, label %exit\n'
                'work:\n'
                '  %span = shl i64 OPERAND, 1\n'
                '  %half = lshr i64 OPERAND, 1\n'
                f'  call void @observe(i64 OPERAND, i64 OPERAND, i64 {argument}.more)\n'
                '  br label %exit\nexit:\n  ret void\n}')
    original_body = template.replace('OPERAND', argument)
    before = (f'define void @specialization.before(i64 {argument}) {{\nentry:\n'
              f'  call void @observe(i64 {argument}, i64 {argument}, i64 {argument})\n'
              '  ret void\n}\n')
    after = before.replace('@specialization.before(', '@specialization.after(')
    for parameters, remaining in (
        (f'i64 {argument}, i64 {other}, double %start', f' i64 {other}, double %start'),
        (f'ptr readonly %a, i64 {argument}, i64 {other}', f'ptr readonly %a, i64 {other}'),
        (f'i64 {argument}.arg, i64 {argument}, i64 {argument}0.arg',
         f'i64 {argument}.arg, i64 {argument}0.arg'),
        (f'ptr %a, i64 {other}, i64 {argument}', f'ptr %a, i64 {other}'),
        (f'i64 {argument}', ''),
        (f'\n  i64 {argument},\n  i64 {other},\n  double %start\n',
         f'\n  i64 {other},\n  double %start\n'),
        (f'\n  ptr readonly %a,\n  i64 {argument},\n  i64 {other}\n',
         f'\n  ptr readonly %a,\n  i64 {other}\n'),
        (f'\n  ptr %a,\n  i64 {other},\n  i64 {argument}\n', f'\n  ptr %a,\n  i64 {other}'),
        (f'\n  i64 {argument}\n', ''),
    ):
        original = 'define void @specialization(' + parameters + ') #1 !dbg !39 {' + original_body
        for value in values:
            constructed = specialize_i64_argument(before + original + '\n' + after,
                                                  'specialization', argument, value)
            expected = (before + 'define void @specialization(' + remaining + ') #1 !dbg !39 {' +
                        template.replace('OPERAND', str(value)) + '\n' + after)
            assert constructed == expected, (argument, parameters, value, constructed, expected)
            assert similar in constructed and constructed.startswith(before) and constructed.endswith(after)

    # Body uses and similarly named parameters cannot stand in for a formal;
    # duplicate exact formals fail even when separated or of different types.
    for parameters, count in (('', 0), (f'i64 {other}', 0), (f'i64 {argument}.more', 0),
                              (f'i64 {argument}, i64 {argument}', 2),
                              (f'i64 {argument}, double %start, i64 {argument}', 2),
                              (f'\n  i64 {argument},\n  i64 {argument}\n', 2),
                              (f'ptr {argument}, i64 {argument}', 2)):
        malformed = 'define void @specialization(' + parameters + ') {' + original_body
        try:
            specialize_i64_argument(malformed, 'specialization', argument, 0)
        except AssertionError as error:
            assert error.args == (('formal parameter', 'specialization', argument, count),), error
        else:
            raise AssertionError('accepted missing/duplicate formal: ' + parameters)

    valid = 'define void @specialization(i64 ' + argument + ') {' + original_body
    for malformed, count in ((before + after, 0), (valid + '\n' + valid, 2)):
        try:
            specialize_i64_argument(malformed, 'specialization', argument, 0)
        except AssertionError as error:
            assert error.args == (('function definition', 'specialization', count),), error
        else:
            raise AssertionError('accepted missing/duplicate definition')

    for field in ('i32 ' + argument, 'i64 noundef ' + argument, '...'):
        try:
            specialize_i64_argument('define void @specialization(' + field + ') {' + original_body,
                                    'specialization', argument, 0)
        except AssertionError as error:
            assert error.args == (('unsupported parameter', field),), error
        else:
            raise AssertionError('accepted unsupported parameter: ' + field)

    comment = f'  ; copied:   %changed = add i64 {argument}, {argument}.more\n'
    mutation = (comment + f'  %changed = add i64 {argument}, {argument}.more\n'
                f'  %changed.more = add i64 {argument}, 1\n')
    assert change_line(mutation, '%changed', argument, '0') == (
        comment + f'  %changed = add i64 0, {argument}.more\n'
        f'  %changed.more = add i64 {argument}, 1\n')
    try:
        change_line(f'  %changed = add i64 {argument}.more, 1\n', '%changed', argument, '0')
    except AssertionError as error:
        assert error.args[0][:2] == ('%changed', argument), error
    else:
        raise AssertionError('SSA prefix accepted as a mutation operand')

assert re.sub(ssa_token('%3'), '%renamed', '  %30 = add i64 %3, %30') == (
    '  %30 = add i64 %renamed, %30')


def attach_metadata(body, value, attachments):
    lines = [line for line in body.splitlines() if line.startswith('  ' + value + ' = ')]
    assert len(lines) == 1, (value, body)
    return replace_once(body, lines[0], lines[0].split(', !', 1)[0] + attachments)


def reject_affine(body, label, instruction):
    try:
        checker.check_affine_function(body, affine_source, affine_name, evl=True)
    except AssertionError as error:
        # Require the exact preservation assertion. A later scratch, count or
        # reduction assertion must not disguise missing mutation coverage.
        failure = error.args[0]
        assert isinstance(failure, tuple) and failure[:2] == (affine_name, label), failure
        assert failure[2].split(', !', 1)[0].strip() == instruction, failure
    else:
        raise AssertionError('accepted affine mutation: ' + instruction)


# An early attachment in the latch is followed by retained arithmetic, compare
# and branch. Analogous placements cover entry/preheader, header PHIs, loads,
# calls and merge/arm instructions. Metadata IDs/order may differ on each side;
# neither side's first attachment may truncate later instructions in the block.
placements = ('%valid', '%limit', '%iv', '%index', '%x', '%lc', '%first.c',
              '%pc', '%pd', '%c', '%fc', '%next', '%done')
many_metadata = affine
for value in placements:
    marked = attach_metadata(affine, value, ', !dbg !71, !annotation !72')
    marked_source = attach_metadata(affine_source, value, ', !annotation !82, !dbg !81')
    for candidate, original in ((marked, affine_source), (affine, marked_source),
                                (marked, marked_source)):
        assert checker.check_affine_function(candidate, original, affine_name, evl=True) == candidate
    many_metadata = attach_metadata(many_metadata, value, ', !dbg !71, !annotation !72')
assert checker.check_affine_function(many_metadata, affine_source, affine_name, evl=True) == many_metadata

# The three exact dyadic values may retain decimal spelling or print with an
# exponent. This allowance cannot hide a changed value or added FP flags.
decimal = affine.replace('3.000000e+00', '3.0').replace('5.000000e-01', '0.5').replace(
    '-1.000000e+00', '-1.0')
assert checker.check_affine_function(decimal, affine_source, affine_name, evl=True) == decimal

for candidate in (affine, many_metadata):
    # Removing integer nuw/nsw is a one-way poison refinement. These two
    # former negative cases now intentionally succeed; so does removing both.
    # The opcode, scalar integer type, ordered operands and block still match.
    for value, flags in (('%next', 'nuw nsw'), ('%index', 'nuw nsw'),
                         ('%limit', 'nuw nsw')):
        for remaining in ('nuw', 'nsw', ''):
            dropped = change_line(candidate, value, flags + ' ', remaining + ' ' if remaining else '')
            assert checker.check_affine_function(dropped, affine_source, affine_name, evl=True) == dropped
    for value, old, new, label, instruction in [
        ('%next', 'add nuw nsw', 'sub nuw nsw', 'latch', '%next = add nuw nsw i64 %iv, 1'),
        ('%next', 'i64', 'i32', 'latch', '%next = add nuw nsw i64 %iv, 1'),
        ('%next', 'nuw nsw', 'nuw nsw exact', 'latch', '%next = add nuw nsw i64 %iv, 1'),
        # 1 is a prefix of 10: substring membership incorrectly accepts this.
        ('%next', ', 1', ', 10', 'latch', '%next = add nuw nsw i64 %iv, 1'),
        ('%next', '%iv, 1', '1, %iv', 'latch', '%next = add nuw nsw i64 %iv, 1'),
        ('%index', ', 7', ', 70', 'loop', '%index = sub nuw nsw i64 %iv, 7'),
        ('%pc', 'add i32', 'add nsw i32', 'positive', '%pc = add i32 %first.c, 23'),
        ('%pc', '%first.c, 23', '%first.different, 23', 'positive', '%pc = add i32 %first.c, 23'),
        ('%q', '840', '420', 'left', '%q = sdiv i32 840, %x'),
        ('%lc', '%q)', '%x)', 'left', '%lc = call i32 @scalar_helper(i32 %q)'),
        ('%p', '%index', '%index.other', 'loop', '%p = getelementptr i32, ptr %a, i64 %index'),
        ('%pd', 'fmul double', 'fmul fast double', 'positive', '%pd = fmul double %first.d, 0.5'),
        ('%pd', '5.000000e-01', '5.000000e+00', 'positive', '%pd = fmul double %first.d, 0.5'),
        ('%rc', '3.000000e+00', '3.000000e+01', 'right', '%rc = fmul double %dx, 3.0'),
        ('%done', 'icmp eq', 'icmp ne', 'latch', '%done = icmp eq i64 %limit, %next'),
        ('%done', 'icmp eq', 'icmp ult', 'latch', '%done = icmp eq i64 %limit, %next'),
        ('%done', '%limit, %next', '%next, %limit', 'latch', '%done = icmp eq i64 %limit, %next'),
        ('%choose', 'icmp ne', 'icmp eq', 'loop', '%choose = icmp ne i32 %x, 0'),
    ]:
        reject_affine(change_line(candidate, value, old, new), label, instruction)

    for branch, replacements, label in [
        ('br i1 %enter, label %preheader, label %exit', (
            'br i1 %nonzero, label %preheader, label %exit',
            'br i1 %enter, label %exit, label %preheader',
            'br i1 %enter, label %preheader, label %exit.other'), 'entry'),
        ('br label %loop', ('br label %loop.other',), 'preheader'),
        ('br i1 %choose, label %left, label %right', (
            'br i1 %done, label %left, label %right',
            'br i1 %choose, label %right, label %left',
            'br i1 %choose, label %left, label %right.other'), 'loop'),
        ('br i1 %done, label %scalar.fission.consumer.ph, label %loop', (
            'br i1 %choose, label %scalar.fission.consumer.ph, label %loop',
            'br i1 %done, label %loop, label %scalar.fission.consumer.ph',
            'br i1 %done, label %scalar.fission.consumer.ph.other, label %loop',
            'br i1 %done, label %scalar.fission.consumer.ph, label %loop.other'), 'latch'),
    ]:
        for replacement in replacements:
            reject_affine(replace_once(candidate, '  ' + branch, '  ' + replacement),
                          label, branch)

    # Full instruction text elsewhere in the same function cannot establish
    # preservation in its original block, even for an otherwise safe move.
    for value, source_label, destination, instruction in [
        ('%q', 'left', '  %choose = ', '%q = sdiv i32 840, %x'),
        ('%pc', 'positive', '  %parity = ', '%pc = add i32 %first.c, 23'),
        ('%done', 'latch', '  %nc = ', '%done = icmp eq i64 %limit, %next'),
    ]:
        line = next(line for line in candidate.splitlines() if line.startswith('  ' + value + ' = '))
        moved = replace_once(candidate, line + '\n', '')
        moved = replace_once(moved, destination, line + '\n' + destination)
        reject_affine(moved, source_label, instruction)

    # Concatenating whitespace across physical instructions, or finding the
    # instruction only in a comment, cannot supply a complete printed line.
    reject_affine(replace_once(candidate, '  %next = add nuw nsw i64 %iv, 1',
                              '  %next = add nuw nsw\n  i64 %iv, 1'),
                  'latch', '%next = add nuw nsw i64 %iv, 1')
    reject_affine(replace_once(candidate, '  %pc = add i32 %first.c, 23',
                              '  ; %pc = add i32 %first.c, 23'),
                  'positive', '%pc = add i32 %first.c, 23')

# All fourteen real retained outputs, including affine_runtime's unflagged
# span and expanded count, analogous relational min/max forms, current-IV
# termination, modular wrap, enclosing reuse, and the four early-exit siblings.
# These are checker fixtures; real opt transformations are still mandatory in
# the executable comparisons, at every N=0..66 and UINT64_MAX, and P=0..65.
affine_originals = Path(sys.argv[4]).read_text()
affine_outputs = Path(sys.argv[6]).read_text()
retained_affine = list(checker.FUNCTION_DEFINITION.finditer(affine_outputs))
assert len(retained_affine) == 14
for match in retained_affine:
    function = match['name']
    assert checker.check_affine_function(affine_outputs, affine_originals, function, evl=True) == match[0]

runtime_name = 'affine_runtime'
runtime_source = checker.function_definition(affine_originals, runtime_name)
runtime = checker.function_definition(affine_outputs, runtime_name)


def reject_count(candidate, original=runtime_source, function=runtime_name, reason=''):
    try:
        checker.check_affine_function(candidate, original, function, evl=True)
    except AssertionError:
        pass
    else:
        raise AssertionError('accepted affine count mutation: ' + reason)


# The enclosing count chain proves N=n only with the checked row guard and
# recurrence. Ordinary LV splits its outer exit edge with a dedicated empty
# block. Exercise the production checker with direct and forwarded exits on
# EITHER side; the successor's spelling and printed predecessor comments are
# not certificates. These retained/synthetic IRs are checker inputs only.
enclosing_name = 'affine_enclosing'
enclosing_source = checker.function_definition(affine_originals, enclosing_name)
enclosing_retained = checker.function_definition(affine_outputs, enclosing_name)
row_branch = '  br i1 %rows.done, label %exit, label %outer'
forwarder = match_once(enclosing_retained,
                       r'^  br i1 %rows.done, label %([-\w.$]+), label %outer$')[1]
assert forwarder != 'exit'
enclosing_direct = replace_match_once(
    enclosing_retained, r'^' + re.escape(forwarder) + r':[^\n]*\n(?s:.*?)(?=^[-\w.$]+:|^})', '')
enclosing_direct = replace_match_once(
    enclosing_direct, r'^  br i1 %rows.done, label %' + re.escape(forwarder) + r', label %outer$',
    row_branch)


def forward_row_exit(text, label):
    text = replace_match_once(text, '^' + re.escape(row_branch) + '$',
                              '  br i1 %rows.done, label %' + label + ', label %outer')
    site = match_once(text, r'^exit:[^\n]*\n')
    # Keep the anchored location: the text "exit:\n" also occurs at the end
    # of "row.exit:\n" and must never be searched for again as a substring.
    return (text[:site.start()] + label + ': ; deliberately untrusted preds = %entry\n'
            '  br label %exit\n\n' + text[site.start():])


# Construction checks run before the certificate mutations. Neither a label's
# suffix nor a misleading predecessor comment may redirect the insertion.
# Check the entire result as well as the unchanged unrelated blocks. These
# strings exercise the constructor only; they are not execution evidence.
construction_head = 'define void @construction() {\nrow.exit:\n'
unrelated_before = ('other.exit:\n  br label %exit\n'
                    'commented.exit: ; preds = %entry, %row.exit\n  unreachable\n'
                    'exit.more:\n  unreachable\n'
                    'exit.loopexit: ; preds = %row.exit\n  unreachable\n'
                    'other.exit.loopexit:\n  unreachable\n'
                    '; exit:\n')
unrelated_after = 'after.exit:\n  unreachable\n}\n'
exit_headers = ('exit:\n', 'exit: ; preds = %entry, %row.exit\n')
for exit_header in exit_headers:
    exit_tail = exit_header + '  ret void\n' + unrelated_after
    constructed = forward_row_exit(construction_head + row_branch + '\n' +
                                   unrelated_before + exit_tail, 'construction.bridge')
    expected = (construction_head +
                '  br i1 %rows.done, label %construction.bridge, label %outer\n' +
                unrelated_before +
                'construction.bridge: ; deliberately untrusted preds = %entry\n'
                '  br label %exit\n\n' + exit_tail)
    assert constructed == expected, constructed
    assert unrelated_before in constructed and unrelated_after in constructed, constructed
    assert construction_head in constructed, constructed

# Missing and duplicate EXACT labels must fail the anchored uniqueness check,
# even when suffix labels remain. Cover duplicates with either comment form.
for headers in ((),) + tuple((first, second) for first in exit_headers for second in exit_headers):
    malformed = (construction_head + row_branch + '\n' + unrelated_before +
                 ''.join(header + '  ret void\n' for header in headers) + unrelated_after)
    try:
        forward_row_exit(malformed, 'construction.bridge')
    except AssertionError as error:
        assert error.args == ((r'^exit:[^\n]*\n', len(headers)),), error
    else:
        raise AssertionError('accepted missing/duplicate exact exit labels: ' + repr(headers))


def mark_enclosing(text):
    for value in ('%rows.valid', '%rows.nonzero', '%rows.enter', '%inner.enter',
                  '%enter', '%row', '%row.next', '%rows.done'):
        text = attach_metadata(text, value, ', !dbg !71, !annotation !72')
    # Include metadata on both the conditional exit and unconditional hop.
    return re.sub(r'^(  br [^\n]*?)(?:, ![^\n]*)?$',
                  r'\1, !annotation !72, !dbg !71', text, flags=re.M)


enclosing_sources = (enclosing_source, forward_row_exit(enclosing_source, 'source.bridge'))
enclosing_candidates = (enclosing_direct, enclosing_retained,
                        forward_row_exit(enclosing_direct, 'return.bridge'),
                        forward_row_exit(enclosing_direct, 'unrelated_name'))
for original in enclosing_sources:
    for candidate in enclosing_candidates:
        # Both the actual hoisted expansion and n need the full certificate.
        for count in ('%8', '%n'):
            counted = change_line(candidate, '%avl', '[ %8, %vector.ph ]',
                                  '[ ' + count + ', %vector.ph ]')
            for output, input_ir in ((counted, original), (mark_enclosing(counted), original),
                                     (counted, mark_enclosing(original)),
                                     (mark_enclosing(counted), mark_enclosing(original))):
                assert checker.check_affine_function(output, input_ir, enclosing_name, evl=True) == output

        # Boundary specializations retain the guards on both sides and use
        # the actual completed export. No specialized fixture is executed.
        exported = change_line(candidate, '%avl', '[ %8, %vector.ph ]',
                               '[ %fission.completed.count, %vector.ph ]')
        for argument, values in (('%n', (0, 1, 65, 66, 2**64 - 1)),
                                  ('%rows', (0, 1, 4, 5, 2**64 - 1))):
            for value in values:
                specialized = [specialize_i64_argument(text, enclosing_name, argument, value)
                               for text in (exported, original)]
                assert checker.check_affine_function(specialized[0], specialized[1],
                                                     enclosing_name, evl=True) == specialized[0]


def reject_enclosing(candidate, original=enclosing_source, reason=''):
    reject_count(candidate, original, enclosing_name, reason)


for candidate in enclosing_candidates:
    marked = mark_enclosing(candidate)
    destination = re.search(r'^  br i1 %rows.done, label %([-\w.$]+), label %outer',
                            marked, re.M)[1]
    branch = 'br i1 %rows.done, label %' + destination + ', label %outer'
    for replacement in ('br i1 %enter, label %' + destination + ', label %outer',
                        'br i1 %rows.done, label %outer, label %' + destination,
                        'br i1 %rows.done, label %' + destination + ', label %inner.ph',
                        'br i1 %rows.done, label %' + destination + ', label %row.exit',
                        'br label %' + destination):
        reject_enclosing(replace_once(marked, branch, replacement), reason='row branch: ' + replacement)

    # Added predecessors/bypasses must be found from actual terminators, not
    # label comments. A switch predecessor must not disappear from the scan.
    for target in (destination, 'exit', 'outer', 'outer.ph', 'inner.ph',
                   'inner', 'scalar.fission.consumer.ph', 'vector.ph'):
        for terminator in ('br label %' + target,
                           'switch i64 %n, label %' + target + ' [ i64 0, label %extra ]'):
            reject_enclosing(marked[:-1] + 'extra:\n  ' + terminator + '\n}',
                             reason='extra predecessor: ' + target)

    # Apply invalid row definitions to the candidate alone AND to both sides.
    # Preservation or matching SSA spelling alone must not certify N=n.
    for value, expressions in (
        ('%rows.valid', ('icmp ule i64 %rows, 5', 'icmp sle i64 %rows, 4',
                         'icmp ule i64 %n, 4')),
        ('%rows.nonzero', ('icmp eq i64 %rows, 0', 'icmp ne i64 %rows, 1')),
        ('%rows.enter', ('or i1 %rows.valid, %rows.nonzero',)),
        ('%inner.enter', ('or i1 %valid, %nonzero',)),
        ('%enter', ('or i1 %rows.enter, %inner.enter',)),
        ('%row', ('phi i64 [ 1, %outer.ph ], [ %row.next, %row.exit ]',
                  'phi i64 [ 0, %outer.ph ], [ %row, %row.exit ]',
                  'phi i64 [ 0, %outer.ph ], [ %row.next, %outer ]')),
        ('%row.next', ('add nuw i64 %row, 0', 'add nuw i64 %row, 2',
                       'sub nuw i64 %row, 1', 'add nuw i32 %row, 1')),
        ('%rows.done', ('icmp ne i64 %row.next, %rows', 'icmp eq i64 %row, %rows',
                        'icmp eq i64 %row.next, %n', 'icmp eq i32 %row.next, %rows')),
    ):
        for expression in expressions:
            mutated = []
            for text in (marked, enclosing_source):
                line = next(line for line in text.splitlines() if line.startswith('  ' + value + ' = '))
                mutated.append(replace_once(text, line, '  ' + value + ' = ' + expression))
            reject_enclosing(mutated[0], reason='row definition: ' + expression)
            reject_enclosing(mutated[0], mutated[1], reason='matching row definition: ' + expression)

    for value in ('%rows', '%row', '%span', '%limit', '%fission.ordinal', '%8.other'):
        reject_enclosing(change_line(marked, '%avl', '[ %8, %vector.ph ]',
                                     '[ ' + value + ', %vector.ph ]'), reason='count provenance: ' + value)

for original in enclosing_sources:
    branch = re.search(r'^  br i1 %rows.done, label %([-\w.$]+), label %outer$', original, re.M)[0]
    destination = re.search(r'label %([-\w.$]+)', branch)[1]
    for replacement in ('  br i1 %enter, label %' + destination + ', label %outer',
                        '  br i1 %rows.done, label %outer, label %' + destination,
                        '  br i1 %rows.done, label %' + destination + ', label %inner.ph'):
        reject_enclosing(enclosing_retained, replace_once(original, branch, replacement),
                         reason='source row branch: ' + replacement)

# A forwarding block must contain just one unconditional branch to exit.
# Even harmless arithmetic or a PHI is outside this deliberately small proof.
# Check defects in the original too, independently of the output's shape.
for text, is_source in ((forward_row_exit(enclosing_direct, 'bridge'), False),
                        (forward_row_exit(enclosing_source, 'bridge'), True)):
    for replacement in ('br label %outer', 'br label %row.exit', 'br label %bridge',
                        'br label %missing', 'ret void', '; br label %exit',
                        'br i1 %rows.done, label %exit, label %exit',
                        'switch i64 %row, label %exit [ ]',
                        '%copy = phi i64 [ %row, %row.exit ]\n  br label %exit',
                        '%copy = add i64 %row, 0\n  br label %exit',
                        '%copy = load i32, ptr %out\n  br label %exit',
                        'store i32 0, ptr %out\n  br label %exit',
                        'call void @effect()\n  br label %exit',
                        'br label %second.bridge'):
        altered = replace_once(text, '  br label %exit\n', '  ' + replacement + '\n')
        if replacement == 'br label %second.bridge':
            altered = altered[:-1] + 'second.bridge:\n  br label %bridge\n}'
        if is_source:
            reject_enclosing(enclosing_retained, altered, reason='source forwarder: ' + replacement)
        else:
            reject_enclosing(altered, reason='forwarder: ' + replacement)

    # A bypass of the true edge cannot leave an orphan hop into exit, and the
    # failed entry guard cannot join the hop instead of bypassing the nest.
    for altered in (replace_once(text, 'label %bridge, label %outer', 'label %exit, label %outer'),
                    replace_once(text, 'label %outer.ph, label %exit', 'label %outer.ph, label %bridge'),
                    text[:-1] + 'extra:\n  br label %bridge\n}'):
        if is_source:
            reject_enclosing(enclosing_retained, altered, reason='source exit bypass/predecessor')
        else:
            reject_enclosing(altered, reason='exit bypass/predecessor')


# The completed increment has the SAME one-way refinement contract as the
# retained producer arithmetic. Five retained outputs (down and four modular
# early exits) drop nuw; eight retain it. Check both spellings directly through
# the production checker for every ordinal control, including enclosing reuse.
# The compact fixture instead keeps its independently checked participant P.
for match in retained_affine:
    function = match['name']
    if function == 'affine_compact':
        continue
    original = checker.function_definition(affine_originals, function)
    retained = match[0]
    increment = re.search(r'^  %fission.completed = (add(?: nuw)? i64 %fission.ordinal, 1)',
                          retained, re.M)
    assert increment, function
    plain = change_line(retained, '%fission.completed', increment[1],
                        'add i64 %fission.ordinal, 1')
    ph = 'inner.ph' if function == 'affine_enclosing' else 'preheader'
    for flags in ('nuw ', ''):
        candidate = change_line(plain, '%fission.completed', 'add i64', 'add ' + flags + 'i64')
        assert checker.check_affine_function(candidate, original, function, evl=True) == candidate
        marked = candidate
        for value in ('%fission.ordinal', '%fission.completed', '%fission.completed.count'):
            marked = attach_metadata(marked, value, ', !dbg !71, !annotation !72')
        assert checker.check_affine_function(marked, original, function, evl=True) == marked

        # Exercise the actual completed export at the count boundaries, even
        # where the retained LV used n or a certified expansion. Specializing
        # the argument on BOTH sides preserves the entry guard: 0, 66 and the
        # unsigned maximum bypass; 1 and 65 are admitted. These are textual
        # checker positives, not execution of these retained/specialized IRs.
        bound = re.search(r'^  %avl = phi i64 \[ (%[-\w.$]+), %vector.ph \]', candidate, re.M)[1]
        exported = change_line(candidate, '%avl', '[ ' + bound + ', %vector.ph ]',
                               '[ %fission.completed.count, %vector.ph ]')
        assert checker.check_affine_function(exported, original, function, evl=True) == exported
        for n in (0, 1, 65, 66, 2**64 - 1):
            specialized = [specialize_i64_argument(text, function, '%n', n)
                           for text in (exported, original)]
            assert checker.check_affine_function(specialized[0], specialized[1],
                                                 function, evl=True) == specialized[0]

        # Flags may be removed only. nsw is not part of the emitted contract,
        # even though these bounded fixtures also fit the signed range.
        for value, old, replacements in [
            ('%fission.completed', 'add ' + flags + 'i64',
             ('sub ' + flags + 'i64', 'add nsw i64', 'add nuw nsw i64',
              'add exact i64', 'add disjoint i64', 'add nuw nuw i64')),
            ('%fission.completed', 'i64', ('i8', 'i32', 'i128')),
            ('%fission.completed', '%fission.ordinal, 1',
             ('%fission.ordinal, 0', '%fission.ordinal, 2', '%fission.ordinal, 10',
              '%iv, 1', '%n, 1', '%fission.ordinal.other, 1', '1, %fission.ordinal')),
            ('%fission.ordinal', '[ 0, %' + ph + ' ]',
             ('[ 1, %' + ph + ' ]', '[ 0, %left ]')),
            ('%fission.ordinal', '[ %fission.completed, %latch ]',
             ('[ %n, %latch ]', '[ %fission.ordinal, %latch ]',
              '[ %fission.completed, %left ]',
              '[ %fission.completed, %latch ], [ 0, %left ]')),
            ('%fission.ordinal', 'i64', ('i32',)),
            ('%fission.completed.count', '[ %fission.completed, %latch ]',
             ('[ %n, %latch ]', '[ %fission.ordinal, %latch ]',
              '[ %fission.completed.other, %latch ]', '[ %fission.completed, %left ]',
              '[ %fission.completed, %latch ], [ %n, %preheader ]')),
            ('%fission.completed.count', 'i64', ('i32',)),
        ]:
            for replacement in replacements:
                reject_count(change_line(marked, value, old, replacement), original, function,
                             'completed identity/operation/edge: ' + replacement)

        # A complete, unique definition must be in its actual block. Metadata,
        # comments, prefixes and line splitting cannot hide a missing counter
        # or export. Keep the ordinal PHI and export checks exact, not a loose
        # match for an instruction elsewhere in the function.
        for value, destination in (('%fission.ordinal', 'entry'),
                                    ('%fission.completed', 'left'),
                                    ('%fission.completed.count', 'vector.ph')):
            line = next(line for line in marked.splitlines() if line.startswith('  ' + value + ' = '))
            moved = replace_once(marked, line + '\n', '')
            site = match_once(moved, r'^' + re.escape(destination) + r':[^\n]*\n')
            for altered in (
                moved[:site.end()] + line + '\n' + moved[site.end():],
                replace_once(marked, line + '\n', (line + '\n') * 2),
                replace_once(marked, line, '  ; ' + line.strip()),
                replace_once(marked, line, line.replace(value + ' = ', value + '.other = ', 1)),
                replace_once(marked, line, line.replace(' = ', ' =\n  ', 1)),
            ):
                reject_count(altered, original, function, 'completed definition/placement: ' + value)


# Function and temporary SSA names are not evidence. The arithmetic/guard/CFG
# certificate must work under renaming, including for the wrap analogue.
for function in ('affine_runtime', 'affine_wrap'):
    original = checker.function_definition(affine_originals, function)
    candidate = checker.function_definition(affine_outputs, function)
    original = replace_once(original, '@' + function + '(', '@unrelated_name(')
    candidate = replace_once(candidate, '@' + function + '(', '@unrelated_name(')
    for old, new in (('%3', '%minus.two'), ('%4', '%half'), ('%5', '%count')):
        # These temporaries are generated in the candidate; the hand-written
        # original may contain no such token. Rename only exact occurrences.
        assert re.search(ssa_token(old), candidate)
        original, candidate = re.sub(ssa_token(old), new, original), re.sub(ssa_token(old), new, candidate)
    assert checker.check_affine_function(candidate, original, 'unrelated_name', evl=True) == candidate

# The exactly checked subtraction spelling is analogous to the printed add -2.
subtraction = change_line(runtime, '%3', 'add i64 %span, -2', 'sub i64 %span, 2')
assert checker.check_affine_function(subtraction, runtime_source, runtime_name, evl=True) == subtraction

# Integer flag removal is one-way. Test shl and mul as well as the add/sub
# placements above, including removal of each flag separately and both.
for function, value, operation in (('affine_runtime', '%span', 'shl'),
                                    ('affine_unsigned', '%span', 'mul')):
    original = checker.function_definition(affine_originals, function)
    candidate = checker.function_definition(affine_outputs, function)
    for flags in ('nuw ', 'nsw ', ''):
        dropped = change_line(candidate, value, operation + ' i64', operation + ' ' + flags + 'i64')
        assert checker.check_affine_function(dropped, original, function, evl=True) == dropped
    unflagged_source = change_line(original, value, 'nuw nsw ', '')
    for flags in ('nuw ', 'nsw ', 'nuw nsw '):
        added = change_line(candidate, value, operation + ' i64', operation + ' ' + flags + 'i64')
        reject_count(added, unflagged_source, function, 'added ' + flags)

# Mutation on only the output must fail preservation. Make the SAME change
# on both sides too: preservation alone is not a proof of N=n. Entry counts
# 0, 66, signed/unsigned extremes must never enter under the certified guard.
for value, old, replacements in [
    ('%valid', 'icmp ule i64 %n, 65', ('icmp ule i64 %n, 66', 'icmp ule i64 %n, 64',
                                    'icmp ule i64 %n, 0', 'icmp ule i64 %n, 1',
                                    'icmp sle i64 %n, 65', 'icmp uge i64 %n, 65',
                                    'icmp ule i32 %n, 65', 'icmp ule i64 %begin, 65')),
    ('%nonzero', 'icmp ne i64 %n, 0', ('icmp eq i64 %n, 0', 'icmp ne i64 %n, 1')),
    ('%enter', 'and i1', ('or i1',)),
    ('%span', 'shl i64 %n, 1', ('shl i64 %n, 0', 'shl i64 %n, 2',
                              'shl i64 %n, 64', 'shl i64 %begin, 1', 'shl i32 %n, 1')),
    ('%origin', 'add nuw nsw i64 %bits, 1', ('add nuw nsw i64 %bits, 2',)),
    ('%next', 'add nuw nsw i64 %iv, 2', ('add nuw nsw i64 %iv, 1',)),
    ('%done', 'icmp ne i64 %next, %limit', ('icmp ult i64 %next, %limit',)),
]:
    for replacement in replacements:
        mutated = change_line(runtime, value, old, replacement)
        reject_count(mutated, reason=replacement)
        # The source span still has both flags; mirror the transformed
        # expression's flags only for this deliberate dual-side mutation.
        old_source = old.replace('shl i64', 'shl nuw nsw i64') if value == '%span' else old
        source_replacement = replacement.replace('shl i', 'shl nuw nsw i') if value == '%span' else replacement
        original = change_line(runtime_source, value, old_source, source_replacement)
        reject_count(mutated, original, reason='matching source: ' + replacement)

for value, old, replacements in [
    ('%3', 'add i64 %span, -2', ('add i64 %span, -1', 'add i64 %span, -4',
                               'sub i64 %span, 1', 'add i64 %n, -2',
                               'add i32 %span, -2', 'add nuw i64 %span, -2')),
    ('%4', 'lshr i64 %3, 1', ('lshr i64 %3, 0', 'lshr i64 %3, 2',
                             'ashr i64 %3, 1', 'lshr exact i64 %3, 1',
                             'lshr i64 %span, 1', 'lshr i32 %3, 1')),
    ('%5', 'add nuw i64 %4, 1', ('add nuw i64 %4, 0', 'add nuw i64 %4, 2',
                                'add nuw i64 %3, 1', 'add nuw nsw i64 %4, 1')),
    ('%avl', '[ %5, %vector.ph ]', ('[ %span, %vector.ph ]', '[ %begin, %vector.ph ]',
                                   '[ %5.other, %vector.ph ]', '[ %arbitrary, %vector.ph ]',
                                   '[ %5, %latch ]')),
    ('%fission.completed.count', '[ %fission.completed, %latch ]',
     ('[ %n, %latch ]', '[ %fission.completed, %left ]',
      '[ %fission.completed, %latch ], [ %n, %preheader ]')),
]:
    for replacement in replacements:
        reject_count(change_line(runtime, value, old, replacement), reason=replacement)

# Dropped flags on new integer count operations have the same refinement
# contract; added flags do not. Each intermediate must be a unique definition
# in the observed dominating block, never a comment or a coincidental alias.
plain_final = change_line(runtime, '%5', 'add nuw i64', 'add i64')
assert checker.check_affine_function(plain_final, runtime_source, runtime_name, evl=True) == plain_final
for flag in ('fast', 'reassoc', 'nnan', 'ninf', 'nsz', 'arcp', 'contract', 'afn'):
    reject_count(change_line(runtime, '%pd', 'fmul double', 'fmul ' + flag + ' double'),
                 reason='FP relaxation: ' + flag)
chain = '  %3 = add i64 %span, -2\n  %4 = lshr i64 %3, 1\n  %5 = add nuw i64 %4, 1\n'
without_chain = replace_once(runtime, chain, '')
vector_site = match_once(without_chain, r'^vector.ph:[^\n]*\n')
for altered in (replace_once(runtime, chain, ''.join('  ; ' + line.strip() + '\n' for line in chain.splitlines())),
                replace_once(runtime, chain, chain.replace('%4 = lshr i64', '%4 = lshr\n  i64')),
                replace_once(runtime, chain, chain + '  %5 = add nuw i64 %4, 1\n'),
                replace_match_once(without_chain, r'^  %q = ', chain + '  %q = '),
                without_chain[:vector_site.end()] + chain + without_chain[vector_site.end():]):
    reject_count(altered, reason='count definition/placement')
signature = match_once(runtime, r'^define void @affine_runtime\([^()]*\)[^\n{]*\{')
wrong_width = (runtime[:signature.start()] +
               replace_once(signature[0], 'i64 %n, ', 'i32 %n, ') + runtime[signature.end():])
reject_count(wrong_width, reason='argument width')
reject_count(runtime[:-1] + 'extra:\n  br label %preheader\n}', reason='guard dominance')
reject_count(runtime[:-1] + 'extra:\n  br label %loop\n}', reason='producer entry')
reject_count(runtime[:-1] + 'extra:\n  br label %vector.ph\n}', reason='consumer entry')
forwarded = replace_once(runtime, '  br label %vector.body\n',
                         '  %arbitrary = phi i64 [ %fission.completed, %scalar.fission.consumer.ph ]\n'
                         '  br label %vector.body\n')
reject_count(change_line(forwarded, '%avl', '[ %5, %vector.ph ]',
                         '[ %arbitrary, %vector.ph ]'), reason='wrong export block')

# Every arithmetic edge/width/constant in the other observed chains is
# checked too. The enclosing chain is hoisted into two dominating blocks;
# its outer guard/row recurrence is part of its completed-count certificate.
for function in ('affine_unsigned', 'affine_signed', 'affine_signed_down',
                 'affine_current', 'affine_enclosing'):
    original = checker.function_definition(affine_originals, function)
    candidate = checker.function_definition(affine_outputs, function)
    if function == 'affine_enclosing':
        region = candidate.split('outer.ph:', 1)[1].split('inner.ph:', 1)[0]
    else:
        region = checker.scalar_consumer(candidate, function)[1].split('vector.ph:', 1)[0]
    originals = set(re.findall(r'^  (%[-\w.$]+) = ', original, re.M))
    for value, expression in re.findall(r'^  (%[-\w.$]+) = (.+)', region, re.M):
        if value in originals or expression.startswith('phi '):
            continue
        for old, new in [('i64', 'i32')]:
            reject_count(change_line(candidate, value, old, new), original, function, 'chain width')
        operands = re.findall(r'%[-\w.$]+', expression)
        if operands:
            reject_count(change_line(candidate, value, operands[0], '%unrelated'),
                         original, function, 'chain operand')
        constants = list(re.finditer(r'(?<=[, ])-?\d+(?=[,) ]|$)', expression))
        if constants:
            constant = constants[-1]
            mutated = expression[:constant.start()] + str(int(constant[0]) + 1) + expression[constant.end():]
            reject_count(change_line(candidate, value, expression, mutated),
                         original, function, 'chain constant')
    if function == 'affine_enclosing':
        for value, old, new in (('%rows.valid', ', 4', ', 5'),
                                ('%row.next', ', 1', ', 2'),
                                ('%row', '[ 0, %outer.ph ]', '[ 1, %outer.ph ]')):
            reject_count(change_line(candidate, value, old, new), original, function, 'enclosing control')

# A storage-bound witness does not count completed iterations. All modular
# relational siblings may stop before n. Rename them to remove even the
# apparent function-name hint; n and every fake arithmetic alias must fail.
for function in ('affine_unsigned_early', 'affine_signed_early',
                 'affine_down_early', 'affine_signed_down_early'):
    original = replace_once(checker.function_definition(affine_originals, function),
                            '@' + function + '(', '@ordinary_name(')
    candidate = replace_once(checker.function_definition(affine_outputs, function),
                             '@' + function + '(', '@ordinary_name(')
    assert checker.check_affine_function(candidate, original, 'ordinary_name', evl=True) == candidate
    for value in ('%n', '%span', '%limit', '%arbitrary', '%fission.completed.other'):
        reject_count(change_line(candidate, '%avl', '[ %fission.completed, %vector.ph ]',
                                 '[ ' + value + ', %vector.ph ]'), original, 'ordinary_name', 'early witness')

# Affine compaction must consume actual P, retain P=0 bypass and starts. The
# existing compact fixtures above still exercise both tail policies and LV2
# forwarding; these mutations call the affine production entry point as well.
compact_affine = checker.function_definition(affine_outputs, 'affine_compact')
compact_original = checker.function_definition(affine_originals, 'affine_compact')
for value in ('%n', '%span', '%limit', '%arbitrary'):
    reject_count(change_line(compact_affine, '%avl', '[ %fission.participating.merge, %vector.ph ]',
                             '[ ' + value + ', %vector.ph ]'), compact_original, 'affine_compact', 'compact witness')
reject_count(change_line(compact_affine, '%fission.empty', 'icmp eq', 'icmp ne'),
             compact_original, 'affine_compact', 'empty bypass')

# Fixed-vscale specialization must fail before handing unsupported EVL/VP
# operations to a host backend. Renaming scalable types alone is not sound.
for intrinsic in ('llvm.experimental.get.vector.length.i64',
                  'llvm.vp.load.nxv4i32.p0', 'llvm.vp.merge.nxv4i32',
                  'llvm.vp.reduce.fadd.nxv4f64'):
    try:
        checker.specialize('@' + intrinsic + '()', 2)
    except ValueError as error:
        assert intrinsic in str(error) and 'scalar-remainder' in str(error)
    else:
        raise AssertionError('unsupported intrinsic silently specialized')

#--- functions.ll
define i64 @multiline(ptr %a,
                      i64 %n) {
entry:
  ret i64 %n
}

define i64 @arithmetic_sum(ptr %a) {
entry:
  %producer.load = load <vscale x 4 x i64>, ptr %a
  %producer.reduction = call i64 @llvm.vector.reduce.add.nxv4i64(<vscale x 4 x i64> %producer.load)
  br label %scalar.fission.consumer.ph
scalar.fission.consumer.ph:
  br label %vector.body
vector.body:
  %consumer.load = load <vscale x 4 x i64>, ptr %a
  br label %scalar.fission.consumer.body
scalar.fission.consumer.body:
  ret i64 %producer.reduction
}

declare i64 @llvm.vector.reduce.add.nxv4i64(<vscale x 4 x i64>)

; Parser/probe fixture only. Executable comparisons use the real transformed
; reduction-fission-scalar-diamond.ll, not this synthetic consumer.
define void @scalar_diamond(ptr %a, ptr %fp) {
entry:
  %s = alloca [65 x i32]
  %d = alloca [65 x double]
  %f = alloca [65 x float]
  %x = load i32, ptr %a
  %choose = icmp ne i32 %x, 0
  br i1 %choose, label %left, label %right
left:
  %q = sdiv i32 840, %x
  %lc = call i32 @scalar_helper(i32 %q)
  br label %latch
right:
  %dp = getelementptr double, ptr %fp, i64 0
  %dx = load double, ptr %dp
  br label %latch
latch:
  %c = phi i32 [ %lc, %left ], [ 17, %right ]
  store i32 %c, ptr %s
  br label %scalar.fission.consumer.ph
scalar.fission.consumer.ph:
  br label %vector.body
vector.body:
  %vi = phi i64 [ 0, %scalar.fission.consumer.ph ]
  %il = load <vscale x 4 x i32>, ptr %s
  %dl = load <vscale x 4 x double>, ptr %d
  %fl = load <vscale x 4 x float>, ptr %f
  %dr = call double @llvm.vector.reduce.fadd.nxv4f64(double 0.0, <vscale x 4 x double> %dl)
  %fr = call float @llvm.vector.reduce.fadd.nxv4f32(float 0.0, <vscale x 4 x float> %fl)
  %ir = call i32 @llvm.vector.reduce.add.nxv4i32(<vscale x 4 x i32> %il)
  br label %scalar.fission.consumer.body
scalar.fission.consumer.body:
  %ti = phi i64 [ 0, %vector.body ]
  ret void
}

; Parser/probe fixture only; actual transformed execution uses scalar-compact.ll.
define void @compact_triangle(ptr %a, ptr %fp, i64 %n, i64 %unrelated, double %start) {
entry:
  %s = alloca [65 x i32]
  %d = alloca [65 x double]
  %f = alloca [65 x float]
  %fstart = fptrunc double %start to float
  br label %preheader
preheader:
  br label %loop
loop:
  %fission.participating = phi i64 [ 0, %preheader ], [ %fission.participating.merge, %latch ]
  %pi = phi i64 [ 0, %preheader ], [ %next, %latch ]
  %x = load i32, ptr %a
  %choose = icmp ne i32 %x, 0
  br i1 %choose, label %left, label %latch
left:
  %q = sdiv i32 840, %x
  %lc = call i32 @scalar_helper(i32 %q)
  %dp = getelementptr double, ptr %fp, i64 0
  %dc = load double, ptr %dp
  %fc = fptrunc double %dc to float
  %fission.participating.next = add nuw i64 %fission.participating, 1
  store i32 %lc, ptr %s
  store double %dc, ptr %d
  store float %fc, ptr %f
  br label %latch
latch:
  %fission.participating.merge = phi i64 [ %fission.participating.next, %left ], [ %fission.participating, %loop ]
  %next = add nuw i64 %pi, 1
  %done = icmp eq i64 %next, %n
  br i1 %done, label %scalar.fission.consumer.guard, label %loop
scalar.fission.consumer.guard:
  %fission.participating.count = phi i64 [ %fission.participating.merge, %latch ]
  %fission.empty = icmp eq i64 %fission.participating.count, 0
  br i1 %fission.empty, label %scalar.fission.consumer.exit, label %scalar.fission.consumer.ph
scalar.fission.consumer.ph:
  %dead.bound = add i64 0, %fission.participating.count
  %scale = call i64 @llvm.vscale.i64()
  %vf = shl nuw i64 %scale, 2
  %min.iters.check = icmp ult i64 %fission.participating.count, %vf
  br i1 %min.iters.check, label %scalar.ph, label %vector.ph
vector.ph:
  %n.mod.vf = urem i64 %fission.participating.count, %vf
  %n.vec = sub i64 %fission.participating.count, %n.mod.vf
  br label %vector.body
vector.body:
  %vi = phi i64 [ 0, %vector.ph ], [ %vector.next, %vector.body ]
  %il = load <vscale x 4 x i32>, ptr %s
  %dl = load <vscale x 4 x double>, ptr %d
  %fl = load <vscale x 4 x float>, ptr %f
  %dr = call double @llvm.vector.reduce.fadd.nxv4f64(double 0.0, <vscale x 4 x double> %dl)
  %fr = call float @llvm.vector.reduce.fadd.nxv4f32(float 0.0, <vscale x 4 x float> %fl)
  %ir = call i32 @llvm.vector.reduce.add.nxv4i32(<vscale x 4 x i32> %il)
  %vector.next = add nuw i64 %vi, %vf
  %vector.done = icmp eq i64 %vector.next, %n.vec
  br i1 %vector.done, label %middle.block, label %vector.body
middle.block:
  %cmp.n = icmp eq i64 %fission.participating.count, %n.vec
  br i1 %cmp.n, label %scalar.fission.consumer.loopexit, label %scalar.ph
scalar.ph:
  %resume = phi i64 [ 0, %scalar.fission.consumer.ph ], [ %n.vec, %middle.block ]
  br label %scalar.fission.consumer.body
scalar.fission.consumer.body:
  %ti = phi i64 [ %resume, %scalar.ph ], [ %fission.consumer.next, %scalar.fission.consumer.body ]
  %fission.consumer.next = add nuw i64 %ti, 1
  %fission.consumer.more = icmp ne i64 %fission.consumer.next, %fission.participating.count
  br i1 %fission.consumer.more, label %scalar.fission.consumer.body, label %scalar.fission.consumer.loopexit
scalar.fission.consumer.loopexit:
  %r0.lcssa = phi i32 [ %ir, %middle.block ], [ 23, %scalar.fission.consumer.body ]
  %r1.lcssa = phi i32 [ %ir, %middle.block ], [ 29, %scalar.fission.consumer.body ]
  %rd.lcssa = phi double [ %dr, %middle.block ], [ 1.000000e+00, %scalar.fission.consumer.body ]
  %rf.lcssa = phi float [ %fr, %middle.block ], [ 2.000000e+00, %scalar.fission.consumer.body ]
  br label %scalar.fission.consumer.exit
scalar.fission.consumer.exit:
  %r0.result = phi i32 [ 17, %scalar.fission.consumer.guard ], [ %r0.lcssa, %scalar.fission.consumer.loopexit ]
  %r1.result = phi i32 [ -7, %scalar.fission.consumer.guard ], [ %r1.lcssa, %scalar.fission.consumer.loopexit ]
  %rd.result = phi double [ %start, %scalar.fission.consumer.guard ], [ %rd.lcssa, %scalar.fission.consumer.loopexit ]
  %rf.result = phi float [ %fstart, %scalar.fission.consumer.guard ], [ %rf.lcssa, %scalar.fission.consumer.loopexit ]
  ret void
}

#--- compact-evl.ll
scalar.fission.consumer.ph:
  %dead.bound = add i64 0, %fission.participating.count
  br label %vector.ph
vector.ph:
  br label %vector.body
vector.body:
  %vi = phi i64 [ 0, %vector.ph ], [ %vector.next, %vector.body ]
  %avl = phi i64 [ %fission.participating.count, %vector.ph ], [ %avl.next, %vector.body ]
  %evl = call i32 @llvm.experimental.get.vector.length.i64(i64 %avl, i32 4, i1 true)
  %il = call <vscale x 4 x i32> @llvm.vp.load.nxv4i32.p0(ptr %s, <vscale x 4 x i1> splat (i1 true), i32 %evl)
  %dl = call <vscale x 4 x double> @llvm.vp.load.nxv4f64.p0(ptr %d, <vscale x 4 x i1> splat (i1 true), i32 %evl)
  %fl = call <vscale x 4 x float> @llvm.vp.load.nxv4f32.p0(ptr %f, <vscale x 4 x i1> splat (i1 true), i32 %evl)
  %dr = call double @llvm.vp.reduce.fadd.nxv4f64(double %start, <vscale x 4 x double> %dl, <vscale x 4 x i1> splat (i1 true), i32 %evl)
  %fr = call float @llvm.vp.reduce.fadd.nxv4f32(float %fstart, <vscale x 4 x float> %fl, <vscale x 4 x i1> splat (i1 true), i32 %evl)
  %step = zext i32 %evl to i64
  %vector.next = add i64 %step, %vi
  %avl.next = sub nuw i64 %avl, %step
  %done.evl = icmp eq i64 %avl.next, 0
  br i1 %done.evl, label %middle.block, label %vector.body
middle.block:
  %ir = call i32 @llvm.vector.reduce.add.nxv4i32(<vscale x 4 x i32> %il)
  %ir2 = call i32 @llvm.vector.reduce.add.nxv4i32(<vscale x 4 x i32> %il)
  br label %scalar.fission.consumer.loopexit
scalar.fission.consumer.loopexit:
  br label %scalar.fission.consumer.exit
scalar.fission.consumer.exit:
  %r0.result = phi i32 [ 17, %scalar.fission.consumer.guard ], [ %ir, %scalar.fission.consumer.loopexit ]
  %r1.result = phi i32 [ -7, %scalar.fission.consumer.guard ], [ %ir2, %scalar.fission.consumer.loopexit ]
  %rd.result = phi double [ %start, %scalar.fission.consumer.guard ], [ %dr, %scalar.fission.consumer.loopexit ]
  %rf.result = phi float [ %fstart, %scalar.fission.consumer.guard ], [ %fr, %scalar.fission.consumer.loopexit ]
  ret void
}

#--- affine-evl.ll
; Retained affine_const EVL output. Checker/probe fixture only; executable
; comparisons continue to compile the original affine fixture with real opt.
define void @affine_const(ptr readonly %a, ptr readonly %fp, ptr %out, ptr %dout, ptr %fout, i64 %n, double %start, i64 %begin) #1 !dbg !4 {
entry:
  %scalar.fission.scratch = alloca [65 x i32], align 4
  %scalar.fission.scratch1 = alloca [65 x double], align 8
  %scalar.fission.scratch2 = alloca [65 x float], align 4
  %valid = icmp ule i64 %n, 65
  %nonzero = icmp ne i64 %n, 0
  %enter = and i1 %valid, %nonzero
  %fstart = fptrunc double %start to float
  br i1 %enter, label %preheader, label %exit

preheader:                                        ; preds = %entry
  %limit = add nuw nsw i64 %n, 7
  br label %loop, !dbg !7

loop:                                             ; preds = %latch, %preheader
  %fission.ordinal = phi i64 [ 0, %preheader ], [ %fission.completed, %latch ]
  %iv = phi i64 [ 7, %preheader ], [ %next, %latch ]
  %index = sub nuw nsw i64 %iv, 7
  %p = getelementptr i32, ptr %a, i64 %index
  %x = load i32, ptr %p, align 4
  %choose = icmp ne i32 %x, 0
  br i1 %choose, label %left, label %right, !dbg !7

left:                                             ; preds = %loop
  %q = sdiv i32 840, %x
  %lc = call i32 @scalar_helper(i32 %q)
  %ld = sitofp i32 %q to double
  br label %first.merge

right:                                            ; preds = %loop
  %dp = getelementptr double, ptr %fp, i64 %index
  %dx = load double, ptr %dp, align 8
  %rc = fmul double %dx, 3.000000e+00
  br label %first.merge

first.merge:                                      ; preds = %right, %left
  %first.c = phi i32 [ %lc, %left ], [ 17, %right ]
  %first.d = phi double [ %ld, %left ], [ %rc, %right ]
  %parity = and i64 %index, 1
  %second = icmp ne i64 %parity, 0
  br i1 %second, label %positive, label %negative

positive:                                         ; preds = %first.merge
  %pc = add i32 %first.c, 23
  %pd = fmul double %first.d, 5.000000e-01
  br label %latch

negative:                                         ; preds = %first.merge
  %nc = sub i32 %first.c, 9
  %nd = fmul double %first.d, -1.000000e+00
  br label %latch

latch:                                            ; preds = %negative, %positive
  %c = phi i32 [ %pc, %positive ], [ %nc, %negative ]
  %dc = phi double [ %pd, %positive ], [ %nd, %negative ]
  %fc = fptrunc double %dc to float
  %next = add nuw nsw i64 %iv, 1
  %done = icmp eq i64 %limit, %next
  %fission.completed = add nuw i64 %fission.ordinal, 1, !dbg !7
  %0 = getelementptr inbounds [65 x i32], ptr %scalar.fission.scratch, i32 0, i64 %fission.ordinal, !dbg !7
  store i32 %c, ptr %0, align 4, !dbg !7
  %1 = getelementptr inbounds [65 x double], ptr %scalar.fission.scratch1, i32 0, i64 %fission.ordinal, !dbg !7
  store double %dc, ptr %1, align 8, !dbg !7
  %2 = getelementptr inbounds [65 x float], ptr %scalar.fission.scratch2, i32 0, i64 %fission.ordinal, !dbg !7
  store float %fc, ptr %2, align 4, !dbg !7
  br i1 %done, label %scalar.fission.consumer.ph, label %loop, !dbg !7, !llvm.loop !8

scalar.fission.consumer.ph:                       ; preds = %latch
  %fission.completed.count = phi i64 [ %fission.completed, %latch ]
  br label %vector.ph

vector.ph:                                        ; preds = %scalar.fission.consumer.ph
  br label %vector.body

vector.body:                                      ; preds = %vector.body, %vector.ph
  %index5 = phi i64 [ 0, %vector.ph ], [ %current.iteration.next, %vector.body ], !dbg !7
  %vec.phi = phi <vscale x 4 x i32> [ insertelement (<vscale x 4 x i32> zeroinitializer, i32 17, i32 0), %vector.ph ], [ %11, %vector.body ]
  %vec.phi6 = phi <vscale x 4 x i32> [ insertelement (<vscale x 4 x i32> zeroinitializer, i32 -7, i32 0), %vector.ph ], [ %12, %vector.body ]
  %vec.phi7 = phi double [ %start, %vector.ph ], [ %9, %vector.body ]
  %vec.phi8 = phi float [ %fstart, %vector.ph ], [ %10, %vector.body ]
  %avl = phi i64 [ %n, %vector.ph ], [ %avl.next, %vector.body ]
  %3 = call i32 @llvm.experimental.get.vector.length.i64(i64 %avl, i32 4, i1 true)
  %4 = getelementptr inbounds [65 x i32], ptr %scalar.fission.scratch, i32 0, i64 %index5, !dbg !7
  %vp.op.load = call <vscale x 4 x i32> @llvm.vp.load.nxv4i32.p0(ptr align 4 %4, <vscale x 4 x i1> splat (i1 true), i32 %3), !dbg !7
  %5 = getelementptr inbounds [65 x double], ptr %scalar.fission.scratch1, i32 0, i64 %index5, !dbg !7
  %vp.op.load9 = call <vscale x 4 x double> @llvm.vp.load.nxv4f64.p0(ptr align 8 %5, <vscale x 4 x i1> splat (i1 true), i32 %3), !dbg !7
  %6 = getelementptr inbounds [65 x float], ptr %scalar.fission.scratch2, i32 0, i64 %index5, !dbg !7
  %vp.op.load10 = call <vscale x 4 x float> @llvm.vp.load.nxv4f32.p0(ptr align 4 %6, <vscale x 4 x i1> splat (i1 true), i32 %3), !dbg !7
  %7 = add <vscale x 4 x i32> %vec.phi, %vp.op.load, !dbg !7
  %8 = add <vscale x 4 x i32> %vp.op.load, %vec.phi6, !dbg !7
  %9 = call double @llvm.vp.reduce.fadd.nxv4f64(double %vec.phi7, <vscale x 4 x double> %vp.op.load9, <vscale x 4 x i1> splat (i1 true), i32 %3)
  %10 = call float @llvm.vp.reduce.fadd.nxv4f32(float %vec.phi8, <vscale x 4 x float> %vp.op.load10, <vscale x 4 x i1> splat (i1 true), i32 %3)
  %11 = call <vscale x 4 x i32> @llvm.vp.merge.nxv4i32(<vscale x 4 x i1> splat (i1 true), <vscale x 4 x i32> %7, <vscale x 4 x i32> %vec.phi, i32 %3)
  %12 = call <vscale x 4 x i32> @llvm.vp.merge.nxv4i32(<vscale x 4 x i1> splat (i1 true), <vscale x 4 x i32> %8, <vscale x 4 x i32> %vec.phi6, i32 %3)
  %13 = zext i32 %3 to i64, !dbg !7
  %current.iteration.next = add nuw i64 %13, %index5, !dbg !7
  %avl.next = sub nuw i64 %avl, %13
  %14 = icmp eq i64 %avl.next, 0
  br i1 %14, label %middle.block, label %vector.body, !dbg !7, !llvm.loop !10

middle.block:                                     ; preds = %vector.body
  %15 = call i32 @llvm.vector.reduce.add.nxv4i32(<vscale x 4 x i32> %11), !dbg !7
  %16 = call i32 @llvm.vector.reduce.add.nxv4i32(<vscale x 4 x i32> %12), !dbg !7
  br label %exit.loopexit, !dbg !7

exit.loopexit:                                    ; preds = %middle.block
  br label %exit

exit:                                             ; preds = %exit.loopexit, %entry
  %v0 = phi i32 [ 17, %entry ], [ %15, %exit.loopexit ]
  %v1 = phi i32 [ -7, %entry ], [ %16, %exit.loopexit ]
  %vd = phi double [ %start, %entry ], [ %9, %exit.loopexit ]
  %vf = phi float [ %fstart, %entry ], [ %10, %exit.loopexit ]
  %o1 = getelementptr i32, ptr %out, i64 1
  store i32 %v0, ptr %out, align 4
  store i32 %v1, ptr %o1, align 4
  store double %vd, ptr %dout, align 8
  store float %vf, ptr %fout, align 4
  ret void
}
