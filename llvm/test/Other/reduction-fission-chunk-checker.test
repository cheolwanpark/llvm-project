# RUN: split-file %s %t
# RUN: %python %t/check.py %S/../../utils/check-reduction-fission.py %t/scalar.ll %t/vector-consumer.ll %t/evl-consumer.ll

# Direct production-checker boundaries. These synthetic scalar/vector schedules
# test the checker; actual transformed execution uses the real opt/llc in the host
# driver, with independent original-IR and nonchunked C references.

#--- check.py
import importlib.util
from pathlib import Path
import sys

sys.dont_write_bytecode = True
spec = importlib.util.spec_from_file_location('fission_checker', sys.argv[1])
checker = importlib.util.module_from_spec(spec)
sys.modules[spec.name] = checker
spec.loader.exec_module(checker)
source = Path(sys.argv[2]).read_text()
checker.check_aos_chunk_scalar(source)
# No-wrap flags may disappear, but every other arithmetic character and edge
# is still checked. FP flags are never normalized by this policy.
without_flags = source.replace('add nuw i64 ', 'add i64 ').replace('sub nuw i64 ', 'sub i64 ')
checker.check_aos_chunk_scalar(without_flags)
for old, new in [('sub i64 %n, %fission.chunk.base', 'sub i64 %fission.chunk.base, %n'),
                 ('add i64 %fission.chunk.base, %fission.chunk.count', 'add i64 %fission.chunk.base, 64'),
                 ('add i64 %i, 1', 'sub i64 %i, 1')]:
    assert old in without_flags
    try:
        checker.check_aos_chunk_scalar(without_flags.replace(old, new))
    except AssertionError:
        pass
    else:
        raise AssertionError('accepted altered unflagged arithmetic')
for variant in (source, without_flags):
    checker.require_chunk_instruction(variant, 'loop', '%next = add nuw nsw i64 %i, 1')

# Earlier metadata must not erase subsequent arithmetic or terminators.
for old in ('%fission.chunk.base = phi i64 [ 0, %preheader ], [ %fission.chunk.next, %scalar.fission.chunk.latch ]',
            '%fission.chunk.remaining = sub nuw i64 %n, %fission.chunk.base',
            '%next = add nuw i64 %i, 1',
            '%fission.consumer.more = icmp ne i64 %fission.consumer.next, %fission.chunk.count'):
    checker.check_aos_chunk_scalar(source.replace(old, old + ', !dbg !99'))
checker.check_aos_chunk_scalar(source.replace('  %next = add nuw i64 %i, 1',
                                            '  %next = add nuw i64 %i, 1 ; exact next'))

# The controller vocabulary is shared with i8 and enclosing-row fixtures.
# Capacities affect storage only; each runtime count still comes from N.
for capacity in (1, 9, 64, 16384):
    variant = source.replace(', 64\n', f', {capacity}\n').replace('i64 64\n', f'i64 {capacity}\n')
    checker.check_chunk_controller(variant, capacity, exit='exit')
narrow = source.replace('i64', 'i8').replace('%n', '%n8').replace(', 64\n', ', 9\n').replace('i8 64\n', 'i8 9\n')
checker.check_chunk_controller(narrow, 9, 'i8', exit='exit', count='%n8')
checker.check_chunk_controller(narrow.replace('nuw ', ''), 9, 'i8', exit='exit', count='%n8')
nested = source.replace('preheader', 'inner.ph').replace('label %exit', 'label %row.exit').replace('\nexit:', '\nrow.exit:')
checker.check_chunk_controller(nested, 64, preheader='inner.ph', exit='row.exit')
checker.check_chunk_controller(nested.replace('nuw ', ''), 64, preheader='inner.ph', exit='row.exit')

mutations = [
    ('sub nuw i64 %n, %fission.chunk.base', 'sub nuw i64 %fission.chunk.base, %n'),
    ('sub nuw i64 %n, %fission.chunk.base', 'sub nsw i64 %n, %fission.chunk.base'),
    ('sub nuw i64 %n, %fission.chunk.base', 'sub nuw nuw i64 %n, %fission.chunk.base'),
    ('icmp ult i64 %fission.chunk.remaining, 64', 'icmp slt i64 %fission.chunk.remaining, 64'),
    ('i64 %fission.chunk.remaining, i64 64', 'i64 64, i64 %fission.chunk.remaining'),
    ('add nuw i64 %fission.chunk.base, %fission.chunk.count', 'add nuw i64 %fission.chunk.base, 64'),
    ('icmp ne i64 %fission.chunk.next, %n', 'icmp ne i64 %fission.chunk.next, %n8'),
    ('label %scalar.fission.chunk, label %exit', 'label %exit, label %scalar.fission.chunk'),
    ('[ %fission.chunk.next, %scalar.fission.chunk.latch ]', '[ %fission.chunk.next, %loop ]'),
    ('%i = phi i64 [ %fission.chunk.base,', '%i = phi i64 [ 0,'),
    ('%fission.producer.ordinal = phi i64 [ 0,', '%fission.producer.ordinal = phi i64 [ %fission.chunk.base,'),
    ('i64 %fission.producer.ordinal\n', 'i64 %i\n'),
    ('i64 %fission.producer.ordinal\n', 'i64 %fission.producer.ordinal.shadow\n'),
    ('i64 %fission.consumer.iv\n', 'i64 %fission.consumer.iv.shadow\n'),
    ('%fission.contribution = load double', '%other.contribution = load double'),
    ('i64 %fission.consumer.iv\n', 'i64 %fission.chunk.base\n'),
    ('%next = add nuw i64 %i, 1', '%next = add nuw i64 %i, 2'),
    ('%next = add nuw i64 %i, 1', '%next = add nuw i32 %i, 1'),
    ('%fission.producer.next = add nuw i64 %fission.producer.ordinal, 1', '%fission.producer.next = add nuw i64 %i, 1'),
    ('%fission.producer.next, %fission.chunk.count', '%fission.producer.next, %n'),
    ('%fission.consumer.next, %fission.chunk.count', '%fission.consumer.next, %n'),
    ('[ %sum.chunk.result, %scalar.fission.chunk.latch ]', '[ %start, %scalar.fission.chunk.latch ]'),
    ('%sum.consume = phi double [ %sum.chunk.carry,', '%sum.consume = phi double [ %start,'),
    ('%sum.chunk.result = phi double [ %update.consume,', '%sum.chunk.result = phi double [ %sum.consume,'),
    ('%update.consume = fadd double', '%update.consume = fadd reassoc double'),
    ('%updated.bits.consume = fadd double %bits.consume,', '%updated.bits.consume = fadd double %sum.consume,'),
    ('%update.lcssa = phi double [ %sum.chunk.result,', '%update.lcssa = phi double [ %bits.chunk.result,'),
    ('%nonzero = icmp ne i64 %n, 0', '%nonzero = icmp eq i64 %n, 0'),
]
for old, new in mutations:
    assert old in source, old
    try:
        checker.check_aos_chunk_scalar(source.replace(old, new))
    except AssertionError:
        pass
    else:
        raise AssertionError(f'accepted altered chunk schedule: {old} -> {new}')

# Definitions cannot be duplicated or moved to an unrelated block.
line = '  %fission.chunk.remaining = sub nuw i64 %n, %fission.chunk.base\n'
for broken in (source.replace(line, line + line),
               source.replace(line, '').replace('scalar.fission.producer.ph:\n',
                                                 'scalar.fission.producer.ph:\n' + line),
               source.replace(line, line.rstrip() + ', !dbg !99\n').replace(
                   '%fission.chunk.next = add nuw i64 %fission.chunk.base, %fission.chunk.count',
                   '%fission.chunk.next = add nuw i64 %fission.chunk.base, %n')):
    try:
        checker.check_aos_chunk_scalar(broken)
    except AssertionError:
        pass
    else:
        raise AssertionError('accepted misplaced/duplicate/metadata-hidden controller')

# Post-LV proofs start with actual recurrence definitions and walk only typed
# PHIs on real predecessors. They must work with renamed results and both
# vector/scalar joins and dedicated scalar exits from repeated LV.
def with_consumer(path):
    begin = source.index('scalar.fission.consumer.ph:\n')
    end = source.index('scalar.fission.chunk.latch:\n', begin)
    return source[:begin] + Path(path).read_text().rstrip() + '\n' + source[end:]

vector = with_consumer(sys.argv[3])
vector = vector.replace('[ %sum.chunk.carry, %scalar.fission.consumer.ph ], [ %update.consume,',
                        '[ %resume.sum, %scalar.ph ], [ %update.consume,')
vector = vector.replace('[ %bits.chunk.carry, %scalar.fission.consumer.ph ], [ %updated.bits.consume,',
                        '[ %resume.bits, %scalar.ph ], [ %updated.bits.consume,')
# The scalar loop itself is part of the supplied region, with explicit seed,
# update and local scratch operands; the final join has both real exit edges.
vector = vector.replace('%sum.chunk.result = phi double [ %update.consume, %scalar.fission.consumer.body ]',
                        '%sum.chunk.result = phi double [ %vector.sum.lcssa, %middle.block ], [ %update.consume, %scalar.fission.consumer.body ]')
vector = vector.replace('%bits.chunk.result = phi double [ %updated.bits.consume, %scalar.fission.consumer.body ]',
                        '%bits.chunk.result = phi double [ %vector.bits.lcssa, %middle.block ], [ %updated.bits.consume, %scalar.fission.consumer.body ]')
vector = vector.replace('%sum.chunk.result', '%joined.sum').replace('%bits.chunk.result', '%joined.bits')
assert checker.check_aos_chunk_results(vector, False, 4) == ['%joined.sum', '%joined.bits']
checker.check_chunk_controller(vector.replace('nuw ', ''), 64, exit='exit')
renamed = vector.replace('%vector.sum', '%88').replace('%vector.bits', '%89')
assert checker.check_aos_chunk_results(renamed, False, 4) == ['%joined.sum', '%joined.bits']

tail_exit = ('scalar.fission.consumer.body.exit:\n'
             '  %tail.sum = phi double [ %update.consume, %scalar.fission.consumer.body ]\n'
             '  %tail.bits = phi double [ %updated.bits.consume, %scalar.fission.consumer.body ]\n'
             '  br label %scalar.fission.chunk.latch\n')
forwarded = vector.replace('label %scalar.fission.chunk.latch\nscalar.fission.chunk.latch:',
                           'label %scalar.fission.consumer.body.exit\n' + tail_exit + 'scalar.fission.chunk.latch:')
forwarded = forwarded.replace('[ %update.consume, %scalar.fission.consumer.body ]\n  %joined.bits',
                               '[ %tail.sum, %scalar.fission.consumer.body.exit ]\n  %joined.bits')
forwarded = forwarded.replace('[ %updated.bits.consume, %scalar.fission.consumer.body ]\n  %fission.chunk.next',
                               '[ %tail.bits, %scalar.fission.consumer.body.exit ]\n  %fission.chunk.next')
assert forwarded != vector
assert checker.check_aos_chunk_results(forwarded, False, 4) == ['%joined.sum', '%joined.bits']

evl = with_consumer(sys.argv[4])
evl = evl.replace('  %sum.chunk.result = phi double [ %update.consume, %scalar.fission.consumer.body ]\n', '')
evl = evl.replace('  %bits.chunk.result = phi double [ %updated.bits.consume, %scalar.fission.consumer.body ]\n', '')
evl = evl.replace('%sum.chunk.result', '%vector.sum').replace('%bits.chunk.result', '%vector.bits')
assert checker.check_aos_chunk_results(evl, True, 4) == ['%vector.sum', '%vector.bits']
evl_forwarded = evl.replace('middle.block:\n', 'middle.block:\n'
    '  %end.sum = phi double [ %vector.sum, %vector.body ]\n'
    '  %end.bits = phi double [ %vector.bits, %vector.body ]\n')
evl_forwarded = evl_forwarded.replace('[ %vector.sum, %scalar.fission.chunk.latch ]', '[ %end.sum, %scalar.fission.chunk.latch ]')
evl_forwarded = evl_forwarded.replace('[ %vector.bits, %scalar.fission.chunk.latch ]', '[ %end.bits, %scalar.fission.chunk.latch ]')
assert checker.check_aos_chunk_results(evl_forwarded, True, 4) == ['%end.sum', '%end.bits']

# The forwarding bound is explicit: four real, typed forwarding blocks fit;
# a fifth does not silently turn this fixture check into unrestricted chasing.
def exit_chain(length):
    chain = evl_forwarded
    pred, last_sum, last_bits = 'middle.block', '%end.sum', '%end.bits'
    for i in range(length - 1):
        label = f'forward.{i}'
        code = (f'{label}:\n'
                f'  %forward.sum.{i} = phi double [ {last_sum}, %{pred} ]\n'
                f'  %forward.bits.{i} = phi double [ {last_bits}, %{pred} ]\n'
                '  br label %scalar.fission.chunk.latch\n')
        chain = chain.replace('  br label %scalar.fission.chunk.latch\nscalar.fission.chunk.latch:',
                              f'  br label %{label}\n' + code + 'scalar.fission.chunk.latch:')
        pred, last_sum, last_bits = label, f'%forward.sum.{i}', f'%forward.bits.{i}'
    chain = chain.replace('[ %end.sum, %scalar.fission.chunk.latch ]', f'[ {last_sum}, %scalar.fission.chunk.latch ]')
    chain = chain.replace('[ %end.bits, %scalar.fission.chunk.latch ]', f'[ {last_bits}, %scalar.fission.chunk.latch ]')
    return chain

assert checker.check_aos_chunk_results(exit_chain(4), True, 4) == ['%forward.sum.2', '%forward.bits.2']
try:
    checker.check_aos_chunk_results(exit_chain(5), True, 4)
except AssertionError:
    pass
else:
    raise AssertionError('accepted unbounded result forwarding')

post_mutations = [
    # Wrong originating reduction, seed, result, scalar resume, or final output.
    (vector, False, 'double %vsum, <vscale', 'double %vbits, <vscale'),
    (vector, False, '[ %sum.chunk.carry, %vector.ph ]', '[ %start, %vector.ph ]'),
    (vector, False, '%sum.chunk.carry = phi double [ %start,', '%sum.chunk.carry = phi double [ -0.000000e+00,'),
    (vector, False, '[ %joined.sum, %scalar.fission.chunk.latch ]\n  %bits.chunk.carry = phi double [ -0.000000e+00, %preheader ], [ %joined.bits,',
     '[ %joined.bits, %scalar.fission.chunk.latch ]\n  %bits.chunk.carry = phi double [ -0.000000e+00, %preheader ], [ %joined.sum,'),
    (vector, False, '[ %joined.sum, %scalar.fission.chunk.latch ]', '[ %joined.bits, %scalar.fission.chunk.latch ]'),
    (vector, False, '[ %joined.sum, %scalar.fission.chunk.latch ]', '[ %sum.chunk.carry, %scalar.fission.chunk.latch ]'),
    (vector, False, '[ %vector.sum.lcssa, %middle.block ]', '[ %sum.chunk.carry, %middle.block ]'),
    (vector, False, '[ %resume.sum, %scalar.ph ]', '[ %sum.chunk.carry, %scalar.ph ]'),
    (vector, False, '[ %update.consume, %scalar.fission.consumer.body ]', '[ %sum.consume, %scalar.fission.consumer.body ]'),
    (vector, False, '%update.consume = fadd double %sum.consume,', '%update.consume = fadd double %bits.consume,'),
    (vector, False, '%update.consume = fadd double', '%update.consume = fadd reassoc double'),
    (vector, False, 'store double %update.lcssa, ptr %out', 'store double %updated.bits.lcssa, ptr %out'),
    # Even a correctly typed forwarding PHI must have the actual predecessors.
    (vector, False, '[ %vector.sum, %vector.body ]', '[ %vector.sum, %vector.ph ]'),
    (vector, False, '[ %joined.sum, %scalar.fission.chunk.latch ]', '[ %joined.sum, %middle.block ]'),
    (forwarded, False, '[ %tail.sum, %scalar.fission.consumer.body.exit ]', '[ %tail.sum, %scalar.fission.consumer.body ]'),
    (forwarded, False, '%tail.sum = phi double [ %update.consume,', '%tail.sum = phi double [ %updated.bits.consume,'),
    (evl, True, 'double %vsum, <vscale', 'double %vbits, <vscale'),
    (evl, True, '<vscale x 4 x i1> splat (i1 true)', '<vscale x 4 x i1> splat (i1 false)'),
    (evl, True, '[ %vector.sum, %scalar.fission.chunk.latch ]', '[ %vsum, %scalar.fission.chunk.latch ]'),
    (evl, True, '[ %vector.sum, %scalar.fission.chunk.latch ]', '[ %vector.bits, %scalar.fission.chunk.latch ]'),
    (evl_forwarded, True, '[ %vector.sum, %vector.body ]', '[ %vector.sum, %middle.block ]'),
    (evl_forwarded, True, '%end.sum = phi double', '%end.sum = phi float'),
]
for text, evl_policy, old, new in post_mutations:
    assert old in text, old
    try:
        checker.check_aos_chunk_results(text.replace(old, new), evl_policy, 4)
    except AssertionError:
        pass
    else:
        raise AssertionError(f'accepted altered result provenance: {old} -> {new}')

#--- scalar.ll
define void @interleave2_ordered(ptr %a, ptr %out, i64 %n, double %start) {
entry:
  %scalar.fission.scratch = alloca [64 x double], align 8
  %bounded = icmp ule i64 %n, 65
  %nonzero = icmp ne i64 %n, 0
  %enter = and i1 %bounded, %nonzero
  br i1 %enter, label %preheader, label %bypass
preheader:
  br label %scalar.fission.chunk
scalar.fission.chunk:
  %fission.chunk.base = phi i64 [ 0, %preheader ], [ %fission.chunk.next, %scalar.fission.chunk.latch ]
  %sum.chunk.carry = phi double [ %start, %preheader ], [ %sum.chunk.result, %scalar.fission.chunk.latch ]
  %bits.chunk.carry = phi double [ -0.000000e+00, %preheader ], [ %bits.chunk.result, %scalar.fission.chunk.latch ]
  %fission.chunk.remaining = sub nuw i64 %n, %fission.chunk.base
  %fission.chunk.partial = icmp ult i64 %fission.chunk.remaining, 64
  %fission.chunk.count = select i1 %fission.chunk.partial, i64 %fission.chunk.remaining, i64 64
  br label %scalar.fission.producer.ph
scalar.fission.producer.ph:
  br label %loop
loop:
  %fission.producer.ordinal = phi i64 [ 0, %scalar.fission.producer.ph ], [ %fission.producer.next, %loop ]
  %i = phi i64 [ %fission.chunk.base, %scalar.fission.producer.ph ], [ %next, %loop ]
  %base = mul nuw i64 %i, 2
  %p0 = getelementptr double, ptr %a, i64 %base
  %x0 = load double, ptr %p0, align 8
  %idx1 = add nuw i64 %base, 1
  %p1 = getelementptr double, ptr %a, i64 %idx1
  %x1 = load double, ptr %p1, align 8
  %scaled = fmul double %x0, 2.0
  %shared = fadd double %scaled, %x0
  %pair = fsub double %shared, %x1
  %term = fmul double %pair, 3.0
  %next = add nuw i64 %i, 1
  %slot = getelementptr inbounds [64 x double], ptr %scalar.fission.scratch, i32 0, i64 %fission.producer.ordinal
  store double %term, ptr %slot, align 8
  %fission.producer.next = add nuw i64 %fission.producer.ordinal, 1
  %fission.producer.more = icmp ne i64 %fission.producer.next, %fission.chunk.count
  br i1 %fission.producer.more, label %loop, label %scalar.fission.consumer.ph
scalar.fission.consumer.ph:
  br label %scalar.fission.consumer.body
scalar.fission.consumer.body:
  %fission.consumer.iv = phi i64 [ 0, %scalar.fission.consumer.ph ], [ %fission.consumer.next, %scalar.fission.consumer.body ]
  %sum.consume = phi double [ %sum.chunk.carry, %scalar.fission.consumer.ph ], [ %update.consume, %scalar.fission.consumer.body ]
  %bits.consume = phi double [ %bits.chunk.carry, %scalar.fission.consumer.ph ], [ %updated.bits.consume, %scalar.fission.consumer.body ]
  %address = getelementptr inbounds [64 x double], ptr %scalar.fission.scratch, i32 0, i64 %fission.consumer.iv
  %fission.contribution = load double, ptr %address, align 8
  %update.consume = fadd double %sum.consume, %fission.contribution
  %updated.bits.consume = fadd double %bits.consume, %fission.contribution
  %fission.consumer.next = add nuw i64 %fission.consumer.iv, 1
  %fission.consumer.more = icmp ne i64 %fission.consumer.next, %fission.chunk.count
  br i1 %fission.consumer.more, label %scalar.fission.consumer.body, label %scalar.fission.chunk.latch
scalar.fission.chunk.latch:
  %sum.chunk.result = phi double [ %update.consume, %scalar.fission.consumer.body ]
  %bits.chunk.result = phi double [ %updated.bits.consume, %scalar.fission.consumer.body ]
  %fission.chunk.next = add nuw i64 %fission.chunk.base, %fission.chunk.count
  %fission.chunk.more = icmp ne i64 %fission.chunk.next, %n
  br i1 %fission.chunk.more, label %scalar.fission.chunk, label %exit
exit:
  %update.lcssa = phi double [ %sum.chunk.result, %scalar.fission.chunk.latch ]
  %updated.bits.lcssa = phi double [ %bits.chunk.result, %scalar.fission.chunk.latch ]
  store double %update.lcssa, ptr %out, align 8
  %o1 = getelementptr double, ptr %out, i64 1
  store double %updated.bits.lcssa, ptr %o1, align 8
  ret void
bypass:
  store double %start, ptr %out, align 8
  %b1 = getelementptr double, ptr %out, i64 1
  store double -0.0, ptr %b1, align 8
  ret void
}

#--- vector-consumer.ll
scalar.fission.consumer.ph:
  %scale = call i64 @llvm.vscale.i64()
  %width = mul i64 %scale, 4
  %remainder = urem i64 %fission.chunk.count, %width
  %n.vec = sub i64 %fission.chunk.count, %remainder
  %min.iters = icmp ult i64 %fission.chunk.count, %width
  br i1 %min.iters, label %scalar.ph, label %vector.ph
vector.ph:
  br label %vector.body
vector.body:
  %index = phi i64 [ 0, %vector.ph ], [ %index.next, %vector.body ]
  %vsum = phi double [ %sum.chunk.carry, %vector.ph ], [ %vector.sum, %vector.body ]
  %vbits = phi double [ %bits.chunk.carry, %vector.ph ], [ %vector.bits, %vector.body ]
  %vaddress = getelementptr inbounds [64 x double], ptr %scalar.fission.scratch, i32 0, i64 %index
  %wide.load = load <vscale x 4 x double>, ptr %vaddress, align 8
  %vector.sum = call double @llvm.vector.reduce.fadd.nxv4f64(double %vsum, <vscale x 4 x double> %wide.load)
  %vector.bits = call double @llvm.vector.reduce.fadd.nxv4f64(double %vbits, <vscale x 4 x double> %wide.load)
  %index.next = add nuw i64 %index, %width
  %vector.done = icmp eq i64 %index.next, %n.vec
  br i1 %vector.done, label %middle.block, label %vector.body
middle.block:
  %vector.sum.lcssa = phi double [ %vector.sum, %vector.body ]
  %vector.bits.lcssa = phi double [ %vector.bits, %vector.body ]
  %no.tail = icmp eq i64 %fission.chunk.count, %n.vec
  br i1 %no.tail, label %scalar.fission.chunk.latch, label %scalar.ph
scalar.ph:
  %resume.iv = phi i64 [ 0, %scalar.fission.consumer.ph ], [ %n.vec, %middle.block ]
  %resume.sum = phi double [ %sum.chunk.carry, %scalar.fission.consumer.ph ], [ %vector.sum.lcssa, %middle.block ]
  %resume.bits = phi double [ %bits.chunk.carry, %scalar.fission.consumer.ph ], [ %vector.bits.lcssa, %middle.block ]
  br label %scalar.fission.consumer.body
scalar.fission.consumer.body:
  %fission.consumer.iv = phi i64 [ %resume.iv, %scalar.ph ], [ %fission.consumer.next, %scalar.fission.consumer.body ]
  %sum.consume = phi double [ %sum.chunk.carry, %scalar.fission.consumer.ph ], [ %update.consume, %scalar.fission.consumer.body ]
  %bits.consume = phi double [ %bits.chunk.carry, %scalar.fission.consumer.ph ], [ %updated.bits.consume, %scalar.fission.consumer.body ]
  %address = getelementptr inbounds [64 x double], ptr %scalar.fission.scratch, i32 0, i64 %fission.consumer.iv
  %fission.contribution = load double, ptr %address, align 8
  %update.consume = fadd double %sum.consume, %fission.contribution
  %updated.bits.consume = fadd double %bits.consume, %fission.contribution
  %fission.consumer.next = add nuw i64 %fission.consumer.iv, 1
  %fission.consumer.more = icmp ne i64 %fission.consumer.next, %fission.chunk.count
  br i1 %fission.consumer.more, label %scalar.fission.consumer.body, label %scalar.fission.chunk.latch

#--- evl-consumer.ll
scalar.fission.consumer.ph:
  br label %vector.ph
vector.ph:
  br label %vector.body
vector.body:
  %index = phi i64 [ 0, %vector.ph ], [ %index.next, %vector.body ]
  %vsum = phi double [ %sum.chunk.carry, %vector.ph ], [ %vector.sum, %vector.body ]
  %vbits = phi double [ %bits.chunk.carry, %vector.ph ], [ %vector.bits, %vector.body ]
  %avl = phi i64 [ %fission.chunk.count, %vector.ph ], [ %avl.next, %vector.body ]
  %evl = call i32 @llvm.experimental.get.vector.length.i64(i64 %avl, i32 4, i1 true)
  %vaddress = getelementptr inbounds [64 x double], ptr %scalar.fission.scratch, i32 0, i64 %index
  %vp.load = call <vscale x 4 x double> @llvm.vp.load.nxv4f64.p0(ptr align 8 %vaddress, <vscale x 4 x i1> splat (i1 true), i32 %evl)
  %vector.sum = call double @llvm.vp.reduce.fadd.nxv4f64(double %vsum, <vscale x 4 x double> %vp.load, <vscale x 4 x i1> splat (i1 true), i32 %evl)
  %vector.bits = call double @llvm.vp.reduce.fadd.nxv4f64(double %vbits, <vscale x 4 x double> %vp.load, <vscale x 4 x i1> splat (i1 true), i32 %evl)
  %step = zext i32 %evl to i64
  %index.next = add i64 %step, %index
  %avl.next = sub nuw i64 %avl, %step
  %vector.done = icmp eq i64 %avl.next, 0
  br i1 %vector.done, label %middle.block, label %vector.body
middle.block:
  br label %scalar.fission.chunk.latch
