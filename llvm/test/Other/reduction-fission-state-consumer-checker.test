# REQUIRES: riscv-registered-target
# RUN: split-file %s %t
# RUN: %python %t/check.py %S/../../utils/check-reduction-fission.py \
# RUN:   %S/../Transforms/LoopVectorize/RISCV opt %t %S/Inputs

# Own generated mutations of actual LV1/LV2 output for both the inherited
# retained-state and analogous unconditional multiblock fixtures. Keep the
# original global-count mutation in acyclic-chunk-checker.test as well.
# Numerical execution is separately mandatory in the full checker driver.

#--- check.py
import importlib.util
from itertools import product
from pathlib import Path
import re
import sys

sys.dont_write_bytecode = True
spec = importlib.util.spec_from_file_location('checker', sys.argv[1])
checker = importlib.util.module_from_spec(spec)
sys.modules[spec.name] = checker
spec.loader.exec_module(checker)
tests, opt, work = Path(sys.argv[2]), sys.argv[3], Path(sys.argv[4])
identity_spec = importlib.util.spec_from_file_location(
    'identity', Path(sys.argv[5]) / 'reduction-fission-consumer-identity.py')
identity = importlib.util.module_from_spec(identity_spec)
identity_spec.loader.exec_module(identity)

def reject(ir, source, name, capacity, scalar, evl, old, new):
    body = checker.function_definition(ir, name)
    assert old != new and body.count(old) == 1, (name, old, new)
    candidate = ir.replace(body, body.replace(old, new, 1), 1)
    assert candidate != ir
    try:
        checker.check_state_chunk(candidate, source, name, capacity, scalar=scalar, evl=evl)
    except AssertionError:
        return
    raise AssertionError('accepted malformed consumer: ' + old + ' -> ' + new)

for fixture, functions in [('state', checker.STATE_CHUNK_FUNCTIONS),
                            ('cfg', checker.CFG_CHUNK_FUNCTIONS)]:
    source = (tests / ('reduction-fission-scalar-chunk-' + fixture + '.ll')).read_text()
    for capacity, repeats, reordered, kind in product((1, 9), (1, 2), (False, True),
                                                       ('scalar', 'tail', 'evl')):
        scalar, evl = kind == 'scalar', kind == 'evl'
        flags = [
            '-mtriple=riscv64', '-mattr=+v', '-enable-vplan-reduction-fission',
            '-hints-allow-reordering=false', '-verify-each',
            '-passes=' + 'loop-vectorize,' * repeats +
            'verify<domtree>,verify<loops>,verify<scalar-evolution>',
            '-vplan-reduction-fission-max-scratch-bytes=' + str(16 if capacity == 1 else 112),
            '-force-vector-width=' + ('1' if scalar else '4'),
            '-force-vector-interleave=' + ('0' if scalar else '1'),
            '-scalable-vectorization=' + ('off' if scalar else 'always'),
            '-pass-remarks=vplan-reduction-fission', '-S']
        if scalar:
            flags += ['-force-target-max-scalar-interleave=1']
        if reordered:
            flags += ['-vplan-reduction-fission-allow-fp-reordering']
        if kind == 'tail':
            flags += ['-tail-folding-policy=dont-fold-tail', '-enable-epilogue-vectorization=false']
        opt_result = checker.run([opt, *flags], input=source)
        ir = opt_result.stdout
        tag = f'{fixture}-c{capacity}-lv{repeats}-fp{int(reordered)}-{kind}'
        (work / (tag + '.ll')).write_text(ir)
        (work / (tag + '.remarks')).write_text(opt_result.stderr)
        for name in functions:
            body = checker.function_definition(ir, name)
            blocks = {label: checker.chunk_instructions(code)
                      for label, code in checker.loop_blocks(body).items()}
            vector = 'vector.body' in blocks
            checker.check_state_chunk(ir, source, name, capacity, scalar=scalar, evl=evl)
            certify = lambda candidate: checker.check_state_chunk(
                candidate, source, name, capacity, scalar=scalar, evl=evl)
            for renamed in identity.exercise(checker, ir, name, evl, certify):
                checker.run([opt, '-passes=verify', '-disable-output'], input=renamed)
            checker.check_state_chunk_remarks(opt_result.stderr, name, capacity,
                                              16 if capacity == 1 else 112, vector)
            policies = [(scalar, evl)]
            if scalar and capacity == 1:
                # A requested-policy bit cannot suppress a scalar certificate.
                # Also exercise scalar fallback classification under EVL policy;
                # this is the same real scalar output, not an executed EVL loop.
                policies += [(False, False), (False, True)]
            for scalar_policy, evl_policy in policies:
                checker.check_state_chunk(ir, source, name, capacity,
                                          scalar=scalar_policy, evl=evl_policy)
                def bad(old, new):
                    reject(ir, source, name, capacity, scalar_policy, evl_policy, old, new)

                # Reduction seed/result/export checks apply in every layout.
                carry = next(line for line in blocks['scalar.fission.chunk']
                             if line.startswith('%r0.chunk.carry = '))
                bad(carry, carry.replace('[ 17,', '[ 0,') if name != 'chunk_state_nested'
                    else carry.replace('[ %carry0,', '[ %carry1,'))
                bad(carry, carry.replace('%scalar.fission.chunk.latch', '%scalar.fission.consumer.ph'))
                exit = 'row.exit' if name == 'chunk_state_nested' else 'producer.exit'
                output = next(line for line in blocks[exit] if line.startswith('%out.r0 = '))
                other = next(line for line in blocks[exit] if line.startswith('%out.r1 = '))
                r0_result = re.fullmatch(r'%out.r0 = phi i32 \[ ([^,]+), %scalar.fission.chunk.latch \]', output)[1]
                r1_result = re.fullmatch(r'%out.r1 = phi i32 \[ ([^,]+), %scalar.fission.chunk.latch \]', other)[1]
                bad(output, output.replace(r0_result, r1_result))
                bad(carry, carry.replace(r0_result, r1_result))
                bad(output, output.replace('%scalar.fission.chunk.latch', '%scalar.fission.consumer.ph'))
                bad('store i32 %out.r0, ptr %o0, align 4',
                    'store i32 %out.r1, ptr %o0, align 4')
                if 'scalar.fission.consumer.body' in blocks:
                    code = blocks['scalar.fission.consumer.body']
                    ordinal = next(line for line in code if line.startswith('%fission.consumer.iv = '))
                    bad(ordinal, ordinal.replace('%bc.resume.val' if vector else '[ 0,',
                                                 '%fission.chunk.base' if vector else '[ 1,'))
                    bad(ordinal, ordinal.replace('%scalar.ph' if vector else '%scalar.fission.consumer.ph',
                                                 '%scalar.fission.producer.ph'))
                    bad(ordinal, ordinal.replace('[ %fission.consumer.next,', '[ %iv,'))
                    bad(ordinal, ordinal.replace('[ %fission.consumer.next, %scalar.fission.consumer.body ]',
                                                 '[ %fission.consumer.next, %scalar.fission.chunk ]'))
                    step = next(line for line in code if line.startswith('%fission.consumer.next = '))
                    assert step.endswith(', 1'), step
                    bad(step, step[:-1] + '2')
                    compare = '%fission.consumer.more = icmp ne i64 %fission.consumer.next, %fission.chunk.count'
                    # Preserve the t000068 failure: global N cannot terminate a
                    # local chunk consumer, even though all loads look correct.
                    bad(compare, compare.replace('%fission.chunk.count', '%n'))
                    bad(compare, compare.replace('%fission.consumer.next', '%fission.consumer.iv'))
                    bad(compare, compare.replace('icmp ne', 'icmp eq'))
                    branch = next(line for line in code if line.startswith('br '))
                    match = re.fullmatch(r'br i1 %fission.consumer.more, label %([^,]+), label %(.+)', branch)
                    assert match, branch
                    bad(branch, f'br i1 %fission.consumer.more, label %{match[2]}, label %{match[1]}')
                    bad(branch, branch.replace('label %' + match[2], 'label %scalar.fission.producer.ph'))
                    address = next(line for line in code if 'getelementptr inbounds' in line and 'x double]' in line)
                    bad(address, address.replace('%fission.consumer.iv', '%iv'))
                    reduction = next(line for line in code if line.startswith('%r0.consume = '))
                    bad(reduction, reduction.replace('[ %u0.consume,', '[ %u1.consume,'))
                    result_phi = next(line for line in blocks['scalar.fission.chunk.latch']
                                      if line.startswith('%r0.chunk.result = '))
                    bad(result_phi, result_phi.replace('%u0.consume', '%u1.consume'))
                    if vector:
                        resume = next(line for line in blocks['scalar.ph'] if line.startswith('%bc.resume.val = '))
                        bad(resume, resume.replace('[ 0,', '[ 1,'))
                        bad(resume, resume.replace('%n.vec', '%fission.chunk.count'))
                        bad(resume, resume.replace('%middle.block', '%vector.ph'))
                        guard = next(line for line in blocks['scalar.fission.consumer.ph']
                                     if line.startswith('%min.iters.check = '))
                        bad(guard, guard.replace('%fission.chunk.count', '%n'))
                        bad('%cmp.n = icmp eq i64 %fission.chunk.count, %n.vec',
                            '%cmp.n = icmp eq i64 %n, %n.vec')
                if vector and evl:
                    avl = next(line for line in blocks['vector.body'] if line.startswith('%avl = '))
                    bad(avl, avl.replace('%fission.chunk.count', '%n'))
                    next_avl = next(line for line in blocks['vector.body'] if line.startswith('%avl.next = '))
                    bad(next_avl, next_avl.replace('sub ', 'add '))
                    branch = next(line for line in blocks['vector.body'] if line.startswith('br '))
                    bad(branch, branch.replace('label %middle.block, label %vector.body',
                                               'label %vector.body, label %middle.block'))
print('PASS: state and multiblock scalar/fallback/tail/EVL consumer certificates and mutations')
