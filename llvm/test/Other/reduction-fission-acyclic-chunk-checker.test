# REQUIRES: riscv-registered-target
# RUN: split-file %s %t
# RUN: %python %t/check.py %S/../../utils/check-reduction-fission.py \
# RUN:   %S/../Transforms/LoopVectorize/RISCV/reduction-fission-scalar-chunk-cfg.ll opt llc %t

# This runnable certificate/mutation test owns its generated negative inputs.
# Numerical original/transformed/oracle execution is additionally registered in
# check-reduction-fission.py; generating or verifying IR is not execution.

#--- check.py
import importlib.util
from pathlib import Path
import re
import sys

sys.dont_write_bytecode = True
spec = importlib.util.spec_from_file_location('checker', sys.argv[1])
checker = importlib.util.module_from_spec(spec)
sys.modules[spec.name] = checker
spec.loader.exec_module(checker)
source = Path(sys.argv[2]).read_text()
opt, llc, work = sys.argv[3], sys.argv[4], Path(sys.argv[5])
common = [
    '-mtriple=riscv64', '-mattr=+v', '-enable-vplan-reduction-fission',
    '-hints-allow-reordering=false', '-verify-each',
    '-vplan-reduction-fission-max-scratch-bytes=112',
    '-pass-remarks=vplan-reduction-fission', '-pass-remarks-missed=vplan-reduction-fission']
modules = {}
for kind in ('scalar', 'tail', 'evl'):
    scalar = kind == 'scalar'
    flags = common + [
        '-passes=' + 'loop-vectorize,' * (1 if scalar else 2) +
        'verify<domtree>,verify<loops>,verify<scalar-evolution>',
        '-force-vector-width=' + ('1' if scalar else '4'),
        '-force-vector-interleave=' + ('0' if scalar else '1'),
        '-scalable-vectorization=' + ('off' if scalar else 'always'), '-S']
    if scalar:
        flags += ['-force-target-max-scalar-interleave=1']
    if kind == 'tail':
        flags += ['-tail-folding-policy=dont-fold-tail', '-enable-epilogue-vectorization=false',
                  '-vplan-reduction-fission-allow-fp-reordering']
    result = checker.run([opt, *flags], input=source)
    modules[kind] = result.stdout
    (work / (kind + '.ll')).write_text(result.stdout)
    (work / (kind + '.remarks')).write_text(result.stderr)
    instrumented = result.stdout
    for name in checker.CFG_CHUNK_FUNCTIONS:
        body = checker.function_definition(result.stdout, name)
        checker.check_state_chunk_remarks(result.stderr, name, 9, 112, not scalar)
        checked = checker.check_state_chunk(result.stdout, source, name, 9, scalar=scalar,
                                             evl=kind == 'evl', probe=kind != 'evl')
        if kind != 'evl':
            for hook in ('state_chunk_begin', 'state_chunk_end', 'state_chunk_producer',
                         'state_chunk_cfg_store', 'chunk_tail'):
                assert checked.count('call void @record_' + hook + '(') == 1, (name, hook)
            assert checked.count('call void @record_state_chunk_cfg_branch(') == (
                4 if name in ('chunk_cfg_serial', 'chunk_cfg_nested') else 2)
            assert checked.count('call void @record_chunk_vector(') == int(not scalar)
            instrumented = instrumented.replace(body, checked, 1)
    checker.run([llc, '-mtriple=riscv64', '-mattr=+v', '-verify-machineinstrs',
                 '-o', str(work / (kind + '.s'))], input=result.stdout)
    if kind != 'evl':
        instrumented += (
            '\ndeclare void @record_state_chunk_begin(i64, i64, i32, i32, double)\n'
            'declare void @record_state_chunk_end(i32, i32, i32, double, double)\n'
            'declare void @record_state_chunk_producer(i64, i64)\n'
            'declare void @record_state_chunk_cfg_store(i64, i64, i32, double, ptr, ptr)\n'
            'declare void @record_state_chunk_cfg_branch(i32)\n'
            'declare void @record_chunk_vector()\n'
            'declare void @record_chunk_tail()\n')
        checker.run([opt, '-passes=verify', '-disable-output'], input=instrumented)

def reject_certificate(ir, name, old, new, scalar):
    body = checker.function_definition(ir, name)
    assert old != new and body.count(old) == 1, (name, old, new, body)
    candidate = ir.replace(body, body.replace(old, new, 1), 1)
    assert candidate != ir, (name, old, new)
    try:
        checker.check_state_chunk(candidate, source, name, 9, scalar=scalar)
    except AssertionError:
        pass
    else:
        raise AssertionError('accepted malformed acyclic chunk: ' + old)

for kind in ('scalar', 'tail'):
    ir = modules[kind]
    scalar = kind == 'scalar'
    for name in checker.CFG_CHUNK_FUNCTIONS:
        body = checker.function_definition(ir, name)
        # LV may emit this subtraction with or without nuw. Bind exactly one
        # actual instruction, retaining its flags; corrupt only its base operand.
        remaining = [line for line in checker.chunk_instructions(
            checker.loop_blocks(body)['scalar.fission.chunk'])
            if re.fullmatch(r'%fission.chunk.remaining = sub(?: nuw)? i64 %n, '
                            r'%fission.chunk.base', line)]
        assert len(remaining) == 1, (name, remaining, body)
        reject_certificate(ir, name, remaining[0],
                           remaining[0].replace('%fission.chunk.base', '0'), scalar)
        for old, new in [
            ('%fission.chunk.base = phi i64 [ 0,', '%fission.chunk.base = phi i64 [ 1,'),
            ('%fission.chunk.partial = icmp ult i64 %fission.chunk.remaining, 9',
             '%fission.chunk.partial = icmp ult i64 %fission.chunk.remaining, 10'),
            ('%fission.producer.ordinal = phi i64 [ 0,',
             '%fission.producer.ordinal = phi i64 [ %fission.chunk.base,'),
            ('%fission.producer.more = icmp ne i64 %fission.producer.next, %fission.chunk.count',
             '%fission.producer.more = icmp ne i64 %fission.producer.next, %n'),
            ('%older.chunk.backedge = phi i32 [ %prev, %latch ]',
             '%older.chunk.backedge = phi i32 [ %state.next, %latch ]'),
            ('%dstate.chunk.backedge = phi double [ %dnext, %latch ]',
             '%dstate.chunk.backedge = phi double [ %dstate, %latch ]'),
            ('%older = phi i32 [ %older.chunk.carry, %scalar.fission.producer.ph ], [ %prev, %latch ]',
             '%older = phi i32 [ %older.chunk.carry, %scalar.fission.producer.ph ], [ %state.next, %latch ]'),
            ('%prev.fission.export = phi i32 [ %prev, %latch ]',
             '%prev.fission.export = phi i32 [ %state.next, %latch ]'),
            ('%out.next = phi i64 [ %next.fission.export, %scalar.fission.chunk.latch ]',
             '%out.next = phi i64 [ %iv.fission.export, %scalar.fission.chunk.latch ]'),
            ('br i1 %choose, label %left, label %right',
             'br i1 %choose, label %right, label %left'),
            ('%choose = and i1 %nonzero.x, %state.odd', '%choose = and i1 %nonzero.x, true'),
            ('%q = sdiv i32 840, %x', '%q = sdiv i32 840, 1'),
            ('%dnext = fadd double %dstate, %delta', '%dnext = fadd reassoc double %dstate, %delta'),
            ('store i32 %c, ptr ', 'store i32 %x, ptr '),
        ]:
            reject_certificate(ir, name, old, new, scalar)
        # A type-correct scratch-index mutation in exactly the producer GEP.
        body = checker.function_definition(ir, name)
        address = re.search(r'getelementptr inbounds \[9 x double\], ptr '
                            r'%[-\w.$]+, i32 0, i64 %fission.producer.ordinal', body)[0]
        reject_certificate(ir, name, address, address.replace('%fission.producer.ordinal', '%iv'), scalar)
    # A latch merge and serial/nested branch have independent preservation checks.
    for name in ('chunk_cfg_serial', 'chunk_cfg_nested'):
        reject_certificate(ir, name, '%second = icmp ne i32 %old.bit, 0',
                           '%second = icmp eq i32 %old.bit, 0', scalar)
    if scalar:
        reject_certificate(ir, 'chunk_cfg_diamond',
                           '%r0.chunk.carry = phi i32 [ 17,',
                           '%r0.chunk.carry = phi i32 [ 0,', True)
        reject_certificate(ir, 'chunk_cfg_header',
                           '%fission.consumer.more = icmp ne i64 %fission.consumer.next, %fission.chunk.count',
                           '%fission.consumer.more = icmp ne i64 %fission.consumer.next, %n', True)

# Exact original source attribution and independently reported stage widths
# remain mandatory, including after the second LV invocation.
remarks = (work / 'tail.remarks').read_text()
for old, new in [
    ('scalar-chunk-cfg.c:12:3:', 'scalar-chunk-cfg.c:13:3:'),
    ('scratch capacity 9,', 'scratch capacity 8,'),
    ('scratch bytes 112,', 'scratch bytes 111,'),
    ('scratch store bytes/iteration 12', 'scratch store bytes/iteration 24'),
    ('producer reread bytes/iteration 0', 'producer reread bytes/iteration 8'),
    ('duplicated producer instructions 0', 'duplicated producer instructions 1'),
    ('producer state carries 3', 'producer state carries 2'),
    ('producer VF 1', 'producer VF 4'),
    ('consumer VF vscale x 4', 'consumer VF 1'),
]:
    local = '\n'.join(line for line in remarks.splitlines() if 'scalar-chunk-cfg.c:12:3:' in line) + '\n'
    checker.check_state_chunk_remarks(local, 'chunk_cfg_diamond', 9, 112, True)
    assert old in local, old
    try:
        checker.check_state_chunk_remarks(local.replace(old, new), 'chunk_cfg_diamond', 9, 112, True)
    except AssertionError:
        pass
    else:
        raise AssertionError('accepted malformed acyclic chunk evidence: ' + old)

# Fifteen bytes cannot hold even one padded mixed-stream slot. Reject without
# mutation under both contracts; the 111/112 boundary is checked in the IR test
# and executed at C=8/C=9 by the full numerical driver.
for relaxed in (False, True):
    flags = [flag for flag in common if not flag.startswith('-vplan-reduction-fission-max-scratch-bytes=')]
    flags += ['-passes=loop-vectorize,loop-vectorize,verify<domtree>,verify<loops>,verify<scalar-evolution>',
              '-vplan-reduction-fission-max-scratch-bytes=15', '-force-vector-width=1',
              '-force-vector-interleave=0', '-force-target-max-scalar-interleave=1',
              '-scalable-vectorization=off', '-S']
    if relaxed:
        flags += ['-vplan-reduction-fission-allow-fp-reordering']
    result = checker.run([opt, *flags], input=source)
    assert 'scalar.fission' not in result.stdout, result.stdout
    for line in (12, 22, 32, 42):
        assert (f'scalar-chunk-cfg.c:{line}:3: scalar-IR reduction fission rejected: scalar-scratch-limit'
                in result.stderr), result.stderr

# Generate analogous original-program rejections, rather than weakening or
# deleting inherited controls/effects/CFG/strict-FP rejection files.
# Complete lines are fixture-specific anchors, including indentation. A comment
# containing the same spelling must never select an instruction or declaration.
# In particular, offset changes all three instructions only in this definition;
# no unanchored module-wide operand replacement is permitted.
helper_declaration = 'declare i32 @scalar_helper(i32) memory(none) nounwind willreturn speculatable'
effect_declaration = 'declare i32 @scalar_helper(i32) memory(read) nounwind willreturn speculatable'
constrained_declaration = (
    '\ndeclare double @llvm.experimental.constrained.fadd.f64(double, double, metadata, metadata)\n')
rejection_edits = [
    ('offset', [
        ('  %iv = phi i64 [0, %preheader], [%next, %latch]',
         '  %iv = phi i64 [7, %preheader], [%next, %latch]'),
        ('  br label %loop, !dbg !11',
         '  %limit = add nuw i64 %n, 7\n  br label %loop, !dbg !11'),
        ('  %done = icmp eq i64 %next, %n', '  %done = icmp eq i64 %next, %limit'),
    ], 'scalar-scratch-limit'),
    ('swapped', [('  %done = icmp eq i64 %next, %n',
                  '  %done = icmp eq i64 %n, %next')], 'scalar-scratch-limit'),
    ('volatile', [('  %dx = load double, ptr %dp, align 8',
                   '  %dx = load volatile double, ptr %dp, align 8')], 'scalar-non-simple-load'),
    ('effects', [(helper_declaration, effect_declaration)],
     'scalar-unsafe-call'),
    ('store', [('  %dnext = fadd double %dstate, %delta',
                '  store i32 %x, ptr %out\n  %dnext = fadd double %dstate, %delta')],
     'scalar-unsupported-instruction'),
    ('constrained', [('  %dnext = fadd double %dstate, %delta',
                      '  %dnext = call double @llvm.experimental.constrained.fadd.f64('
                      'double %dstate, double %delta, metadata !"round.dynamic", '
                      'metadata !"fpexcept.strict")')], 'scalar-strict-fp'),
    ('feedback', [('  %choose = and i1 %nonzero.x, %state.odd',
                   '  %observe = add i32 %r0, %r1\n'
                   '  %observe.i = icmp ne i32 %observe, 0\n'
                   '  %observe.d = fcmp one double %rd, 0.0\n'
                   '  %choose = and i1 %observe.i, %observe.d')], 'scalar-unsupported-recurrence'),
]

def code_lines(text):
    # These fixtures have no semicolons in instruction string literals. This is
    # only a nonidentity/construction check, never a way to select an anchor.
    return [line.split(';', 1)[0].strip() for line in text.splitlines()
            if line.split(';', 1)[0].strip()]

def replace_line(text, old, new):
    assert '\n' not in old and old != new and code_lines(old) != code_lines(new), (old, new)
    matches = list(re.finditer('^' + re.escape(old) + '$', text, re.M))
    assert len(matches) == 1, (old, len(matches))
    match = matches[0]
    return text[:match.start()] + new + text[match.end():]

def original_rejections(module):
    body = checker.function_definition(module, 'chunk_cfg_diamond')
    assert module.count(body) == 1
    before, _, after = module.partition(body)
    cases = []
    for name, edits, reason in rejection_edits:
        if name == 'effects':
            # Match the entire actual declaration, ignoring retained comments
            # and identically spelled attributes on unrelated declarations.
            candidate = replace_line(module, *edits[0])
        else:
            changed = body
            for old, new in edits:
                changed = replace_line(changed, old, new)
            assert code_lines(changed) != code_lines(body), name
            candidate = before + changed + after
            assert checker.function_definition(candidate, 'chunk_cfg_diamond') == changed
            if name == 'constrained':
                assert not re.search(r'^declare .*@llvm\.experimental\.constrained\.fadd\.f64\(',
                                     module, re.M)
                candidate += constrained_declaration
        # Construction cannot be swallowed by the expected compiler rejection.
        assert candidate != module and code_lines(candidate) != code_lines(module), name
        cases.append((name, candidate, reason))
    return cases

# Focused construction checks retain the original FileCheck comments and add
# collisions for every anchor both inside and outside the intended definition.
# Keep all four definitions here: analogous instructions in the other three
# functions and an unrelated declaration must remain byte-for-byte unchanged.
body = checker.function_definition(source, 'chunk_cfg_diamond')
assert source.count(body) == 1
before, _, after = source.partition(body)
comments = ''.join('; retained spelling: ' + old + '\n'
                   for _, edits, _ in rejection_edits for old, _ in edits)
assert body.count('\nentry:\n') == 1
entry = body.index('\nentry:\n')
commented_body = body[:entry] + '\n' + comments + body[entry:]
unrelated = 'declare i32 @unrelated_helper(i32) memory(none) nounwind willreturn speculatable\n'
construction_source = comments + before + commented_body + after + comments + unrelated
plain_cases = original_rejections(source + unrelated)
commented_cases = original_rejections(construction_source)
assert len(plain_cases) == len(commented_cases) == 7
for (name, plain, reason), (commented_name, candidate, commented_reason) in zip(
        plain_cases, commented_cases):
    assert (name, reason) == (commented_name, commented_reason)
    assert code_lines(candidate) == code_lines(plain), name
    assert [line for line in candidate.splitlines() if line.lstrip().startswith(';')] == [
        line for line in construction_source.splitlines() if line.lstrip().startswith(';')], name
    assert [line for line in candidate.splitlines() if line.startswith('!')] == [
        line for line in construction_source.splitlines() if line.startswith('!')], name
    if name == 'effects':
        # Undo exactly the changed declaration to compare the entire module.
        assert replace_line(candidate, effect_declaration, helper_declaration) == construction_source
    else:
        suffix = constrained_declaration if name == 'constrained' else ''
        changed = checker.function_definition(candidate, 'chunk_cfg_diamond')
        assert candidate.count(changed) == 1
        prefix, _, postfix = construction_source.partition(commented_body)
        assert candidate == prefix + changed + postfix + suffix, name
    for other in checker.CFG_CHUNK_FUNCTIONS:
        if name == 'effects' or other != 'chunk_cfg_diamond':
            assert checker.function_definition(candidate, other) == checker.function_definition(
                construction_source, other), (name, other)

module = checker.keep_functions(source, ['chunk_cfg_diamond'])
cases = original_rejections(module)
for name, candidate, reason in cases:
    (work / (name + '.input.ll')).write_text(candidate)
    for relaxed in (False, True):
        flags = common + [
            '-passes=loop-vectorize,loop-vectorize,verify<domtree>,verify<loops>,verify<scalar-evolution>',
            '-force-vector-width=1', '-force-vector-interleave=0',
            '-force-target-max-scalar-interleave=1', '-scalable-vectorization=off', '-S']
        if relaxed:
            flags += ['-vplan-reduction-fission-allow-fp-reordering']
        result = checker.run([opt, *flags], input=candidate)
        assert 'scalar.fission' not in result.stdout, (name, result.stdout)
        assert ('scalar-chunk-cfg.c:12:3: scalar-IR reduction fission rejected: ' + reason
                in result.stderr), (name, result.stderr)
print('PASS: acyclic chunk paths, guarded operations, original control/effect rejections and corruption rejection')
