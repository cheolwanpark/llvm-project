# REQUIRES: riscv-registered-target
# RUN: split-file %s %t
# RUN: opt -passes='loop-vectorize,verify<domtree>,verify<loops>,verify<scalar-evolution>' -verify-each \
# RUN:   -mtriple=riscv64 -mattr=+v -force-vector-width=4 -force-vector-interleave=1 \
# RUN:   -scalable-vectorization=always -hints-allow-reordering=false \
# RUN:   -enable-vplan-reduction-fission -tail-folding-policy=dont-fold-tail \
# RUN:   -enable-epilogue-vectorization=false -S %S/../Transforms/LoopVectorize/RISCV/reduction-fission-scalar-compact-cfg.ll -o %t.once.ll
# RUN: opt -passes='loop-vectorize,loop-vectorize,verify<domtree>,verify<loops>,verify<scalar-evolution>' -verify-each \
# RUN:   -mtriple=riscv64 -mattr=+v -force-vector-width=4 -force-vector-interleave=1 \
# RUN:   -scalable-vectorization=always -hints-allow-reordering=false \
# RUN:   -enable-vplan-reduction-fission -vplan-reduction-fission-allow-fp-reordering \
# RUN:   -tail-folding-policy=dont-fold-tail -enable-epilogue-vectorization=false \
# RUN:   -S %S/../Transforms/LoopVectorize/RISCV/reduction-fission-scalar-compact-cfg.ll -o %t.twice.ll
# RUN: opt -passes='loop-vectorize,verify<domtree>,verify<loops>,verify<scalar-evolution>' -verify-each \
# RUN:   -mtriple=riscv64 -mattr=+v -force-vector-width=4 -force-vector-interleave=1 \
# RUN:   -scalable-vectorization=always -hints-allow-reordering=false \
# RUN:   -enable-vplan-reduction-fission -S %S/../Transforms/LoopVectorize/RISCV/reduction-fission-scalar-compact-cfg.ll -o %t.once.evl.ll
# RUN: opt -passes='loop-vectorize,loop-vectorize,verify<domtree>,verify<loops>,verify<scalar-evolution>' -verify-each \
# RUN:   -mtriple=riscv64 -mattr=+v -force-vector-width=4 -force-vector-interleave=1 \
# RUN:   -scalable-vectorization=always -hints-allow-reordering=false \
# RUN:   -enable-vplan-reduction-fission -vplan-reduction-fission-allow-fp-reordering \
# RUN:   -S %S/../Transforms/LoopVectorize/RISCV/reduction-fission-scalar-compact-cfg.ll -o %t.twice.evl.ll
# RUN: %python %t/check.py %S/../../utils/check-reduction-fission.py \
# RUN:   %S/../Transforms/LoopVectorize/RISCV/reduction-fission-scalar-compact-cfg.ll \
# RUN:   %t.once.ll %t.twice.ll %t.once.evl.ll %t.twice.evl.ll

# Mutate fresh actual transformed IR before any host instrumentation. Keep
# every inherited compact/result/export mutation test. This certificate must
# distinguish each bypass edge, P from N, ordinal from original IV, exact
# empty-stream starts and final producer exports. Executable comparisons live
# in check-reduction-fission.py, with independent C and original IR references.

#--- check.py
import importlib.util
from pathlib import Path
import re
import sys

sys.dont_write_bytecode = True
spec = importlib.util.spec_from_file_location('checker', sys.argv[1])
checker = importlib.util.module_from_spec(spec)
sys.modules[spec.name] = checker
spec.loader.exec_module(checker)
source = Path(sys.argv[2]).read_text()


def definition(text, value, old, new):
    matches = list(re.finditer(r'^  %' + re.escape(value) + r' = [^\n]*$', text, re.M))
    assert len(matches) == 1, (value, len(matches))
    match = matches[0]
    assert match[0].count(old) == 1, (value, old, match[0])
    return text[:match.start()] + match[0].replace(old, new, 1) + text[match.end():]


for path in sys.argv[3:]:
    module = Path(path).read_text()
    evl = '.evl.' in path
    for name in checker.COMPACT_CFG_FUNCTIONS:
        body = checker.function_definition(module, name)
        assert checker.check_producer_exports(module, name, evl, source=source) == body
        producer, consumer = checker.scalar_consumer(body, name)
        edges = checker.check_compact_cfg_producer(producer, name)
        if not evl:
            probed = checker.check_producer_exports(module, name, evl, probe=True, source=source)
            assert probed.count('call void @record_compact_cfg_bypass(') == len(edges)
            for recorder in ('compact_iteration', 'compact_participant',
                             'scalar_consumer_vector', 'scalar_consumer_tail', 'export_guard'):
                assert probed.count('call void @record_' + recorder + '(') == 1, (name, recorder)

        def reject(candidate, obligation):
            try:
                checker.check_producer_exports(module.replace(body, candidate, 1), name,
                                               evl, source=source)
            except AssertionError as error:
                assert obligation in str(error), (name, obligation, error)
            else:
                raise AssertionError(name + ': accepted ' + obligation)

        # Changing any single bypass to increment, or dropping any operand,
        # must fail even when the common update edge remains correct.
        for edge in edges:
            reject(definition(body, 'fission.participating.merge',
                              '[ %fission.participating, %' + edge + ' ]',
                              '[ %fission.participating.next, %' + edge + ' ]'),
                   'latch participation value/edge')
            line = re.search(r'^  %fission.participating.merge = [^\n]*$', body, re.M)[0]
            pair = '[ %fission.participating, %' + edge + ' ]'
            # Remove just one pair, preserving syntactic commas elsewhere.
            short = line.replace(', ' + pair, '', 1) if ', ' + pair in line else line.replace(pair + ', ', '', 1)
            assert short != line
            reject(body.replace(line, short, 1), 'latch participation value/edge')
        reject(definition(body, 'fission.participating.merge',
                          '[ %fission.participating.next, %left ]',
                          '[ %fission.participating, %left ]'),
               'latch participation value/edge')
        reject(definition(body, 'fission.participating.next', ', 1', ', 2'),
               'compact count provenance: instruction')
        reject(definition(body, 'fission.empty', ', 0', ', 1'),
               'compact count provenance: instruction')
        start = '%carry' if name == 'compact_cfg_enclosing' else '17'
        reject(definition(body, 'r0.result', '[ ' + start + ',', '[ 0,'),
               'empty-stream start value/edge for r0')
        branch = re.search(r'br i1 %choose, label (%[-\w.$]+), label (%[-\w.$]+)', producer)
        assert branch
        reject(body.replace(branch[0], f'br i1 %choose, label {branch[2]}, label {branch[1]}', 1),
               'export control:')
        # Preserve type and bounds while deliberately using the original IV
        # for one store, or placing an extra store on one inactive edge.
        address = re.search(r'^  (%[-\w.$]+) = getelementptr inbounds \[65 x i32\], '
                            r'ptr %[-\w.$]+, i32 0, i64 %fission.participating[^\n]*$',
                            producer, re.M)
        assert address
        reject(definition(body, address[1][1:], 'i64 %fission.participating', 'i64 %iv'),
               'compact CFG: i32 compact index')
        edge = re.search(r'^right:[^\n]*\n', body, re.M)
        reject(body[:edge.end()] + '  store i32 0, ptr %a, align 4\n' + body[edge.end():],
               'compact CFG: no bypass scratch stores')
        reject(definition(body, 'c.fission.export', '%c,', '%x,'), 'producer export c:')
        if not evl:
            bound = re.search(r'%fission.consumer.more = icmp ne i64 '
                              r'%fission.consumer.next, (%[-\w.$]+)', body)[1]
            reject(definition(body, 'fission.consumer.more', ', ' + bound, ', %n'),
                   'compact count provenance: instruction')

print('PASS: compact CFG edge/count/index/export mutations, single/repeated LV, both tail policies')
