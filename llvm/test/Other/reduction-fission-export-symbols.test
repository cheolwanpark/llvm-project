# RUN: split-file %s %t
# RUN: %python %t/check.py %S/../../utils/check-reduction-fission.py \
# RUN:   %S/../Transforms/LoopVectorize/RISCV %S/../../utils/reduction-fission-execution.c.in

# Exercise the production declaration/row generator without a backend. The
# original fixtures isolate symbol, ABI and reference-origin obligations here;
# the full execution driver compiles their actual transformed variants and
# compares them with these exact originals and independent C formulas.

#--- check.py
import importlib.util
from pathlib import Path
import re
import sys

sys.dont_write_bytecode = True
spec = importlib.util.spec_from_file_location('checker', sys.argv[1])
checker = importlib.util.module_from_spec(spec)
sys.modules[spec.name] = checker
spec.loader.exec_module(checker)
fixtures = Path(sys.argv[2])
template = Path(sys.argv[3]).read_text()


def rejected(action, diagnostic):
    try:
        action()
    except ValueError as error:
        assert diagnostic in str(error), (diagnostic, error)
    else:
        raise AssertionError('accepted ' + diagnostic)


# Check the C side independently of the generator's IR signature check. A
# stale handwritten reference list must not become the source of declarations.
typedef = re.search(r'typedef void ExportFn\((.*?)\);', template, re.S)
assert typedef
assert re.sub(r'\s+', '', typedef[1]).split(',') == [
    'constuint32_t*', 'constdouble*', 'uint32_t*', 'uint64_t*',
    'double*', 'float*', 'uint64_t', 'uint64_t', 'double',
]
assert not re.search(r'^extern ExportFn\b', template, re.M)
assert template.index('@DECLARATIONS@') < template.index('} Exports[]')
assert template.index('@DECLARATIONS@') < template.index('} Chunks[]')

families = checker.EXPORT_FAMILIES + (
    ('reduction-fission-scalar-chunks.ll', checker.CHUNK_FUNCTIONS, 0, '', 'chunks'),
)
assert [family[4] for family in families] == [
    'exports', 'export_controls', 'compact_cfg', 'state_cfg', 'chunks',
]
assert sum(len(family[1]) for family in families) == 23

for prefix in ('ref_', 'independent_original_'):
    used, declared_references, declared_variants = set(), set(), set()
    state_references = set()
    for filename, functions, first_mode, _, fixture in families:
        source = checker.keep_functions((fixtures / filename).read_text(), functions)
        reference, references = checker.rename_execution_functions(
            source, {function: prefix + function for function in functions}, used)
        declarations = checker.export_reference_declarations(source, reference, references)
        assert len(declarations) == len(functions)
        for function, declaration in zip(functions, declarations):
            symbol = references[function]
            assert declaration == f'extern ExportFn {symbol};'
            assert symbol not in declared_references
            declared_references.add(symbol)
            # Full original definition, including flags, CFG, attributes and
            # debug attachments. Same ABI alone is insufficient evidence.
            assert checker.function_definition(reference, symbol) == (
                checker.function_definition(source, function).replace(
                    '@' + function + '(', '@' + symbol + '('))
            if fixture == 'state_cfg':
                state_references.add(symbol)

        def reject_reference(candidate=reference, mapping=references, diagnostic=''):
            rejected(lambda: checker.export_reference_declarations(source, candidate, mapping),
                     diagnostic)

        first, second = functions[:2]
        symbol = references[first]
        body = checker.function_definition(reference, symbol)
        missing = {key: value for key, value in references.items() if key != first}
        reject_reference(mapping=missing, diagnostic='mapping does not cover source definitions')
        reject_reference(mapping=dict(references, absent='absent'),
                         diagnostic='mapping does not cover source definitions')
        reject_reference(candidate=reference.replace(body, '', 1),
                         diagnostic=f'expected one definition for @{symbol}, found 0')
        reject_reference(candidate=reference.replace(body, 'declare void @' + symbol + '()', 1),
                         diagnostic=f'expected one definition for @{symbol}, found 0')
        reject_reference(candidate=reference + '\n' + body,
                         diagnostic=f'expected one definition for @{symbol}, found 2')
        reject_reference(mapping=dict(references, **{first: 'missing_original'}),
                         diagnostic='expected one definition for @missing_original, found 0')
        reject_reference(mapping=dict(references, **{first: references[second]}),
                         diagnostic='duplicate export reference symbol')
        swapped = dict(references)
        swapped[first], swapped[second] = swapped[second], swapped[first]
        reject_reference(mapping=swapped, diagnostic='export reference definition mismatch')
        for invalid, diagnostic in [('bad.name', 'invalid execution symbol label'),
                                    ('bad-name', 'noncanonical export reference symbol')]:
            reject_reference(mapping=dict(references, **{first: invalid}), diagnostic=diagnostic)
        # Same signature, wrong original: even a plausible compact CFG cannot
        # replace the retained-state reference or any other family member.
        wrong_body = body.replace('ret void', 'unreachable', 1)
        assert wrong_body != body
        reject_reference(candidate=reference.replace(body, wrong_body, 1),
                         diagnostic='export reference definition mismatch')
        extra, _ = checker.rename_execution_functions(
            checker.keep_functions(source, [first]), {first: 'extra_original'}, set())
        reject_reference(candidate=reference + '\n' + checker.function_definition(extra, 'extra_original'),
                         diagnostic='export reference definitions do not match mapping')
        for old, new in [('define void @', 'define i32 @'),
                         ('ptr readonly %a', 'ptr addrspace(1) %a'),
                         ('i64 %rows', 'i32 %rows'), ('double %start', 'float %start'),
                         (', i64 %n', ''), ('double %start)', 'double %start, ...)')]:
            changed = body.replace(old, new, 1)
            assert changed != body, (fixture, old)
            reject_reference(candidate=reference.replace(body, changed, 1),
                             diagnostic=f'ExportFn signature mismatch for @{symbol}')

        if fixture == 'state_cfg':
            compact = (fixtures / 'reduction-fission-scalar-compact-cfg.ll').read_text()
            impostor = checker.function_definition(compact, 'compact_cfg_serial').replace(
                '@compact_cfg_serial(', '@' + symbol + '(')
            reject_reference(candidate=reference.replace(body, impostor, 1),
                             diagnostic='export reference definition mismatch')

        if fixture == 'chunks':
            continue
        # Scalar lanes=0 and both ends of the inherited vector-width matrix;
        # policy/LV labels must preserve every row and the original mapping.
        for repeat in (1, 2):
            for policy in ('strict', 'option_on'):
                for lanes in (0, 4, 128):
                    tag = f'{fixture}_{prefix}lv{repeat}_{policy}_lanes{lanes}'
                    variant, declarations, rows = checker.export_variant(
                        source, functions, tag, references, used, first_mode, lanes)
                    assert len(rows) == len(declarations) == len(functions)
                    for mode, (function, declaration, row) in enumerate(
                            zip(functions, declarations, rows), first_mode):
                        name = f'{function}_{tag}'
                        assert declaration == f'extern ExportFn {name};'
                        assert name not in declared_variants
                        declared_variants.add(name)
                        match = re.fullmatch(r'\{"([A-Za-z][A-Za-z0-9_]*)", '
                                             r'([A-Za-z][A-Za-z0-9_]*), '
                                             r'([A-Za-z][A-Za-z0-9_]*), (\d+), (\d+)\}', row)
                        assert match and match.groups() == (
                            name, name, references[function], str(mode), str(lanes))
                        assert match[3] in declared_references
                        assert checker.function_definition(variant, match[2]) == (
                            checker.function_definition(source, function).replace(
                                '@' + function + '(', '@' + name + '('))

        snapshot = used.copy()
        rejected(lambda: checker.export_variant(source, functions, tag, references, used,
                                               first_mode, 0), 'colliding execution symbol')
        rejected(lambda: checker.export_variant(source, functions, 'missing', missing, used,
                                               first_mode, 0), 'mapping does not cover variant functions')
        rejected(lambda: checker.export_variant(source, functions + (first,), 'duplicate',
                                               references, used, first_mode, 0),
                 'duplicate export function')
        rejected(lambda: checker.export_variant(checker.keep_functions(source, [second]), functions,
                                               'missing_body', references, used, first_mode, 0),
                 f'expected one definition for @{first}, found 0')
        bad_source = source.replace('double %start)', 'float %start)', 1)
        assert bad_source != source
        rejected(lambda: checker.export_variant(bad_source, functions, 'bad_abi', references,
                                               used, first_mode, 0), 'ExportFn signature mismatch')
        rejected(lambda: checker.export_reference_declarations(bad_source, reference, references),
                 'ExportFn signature mismatch')
        assert used == snapshot

    assert state_references == {prefix + function for function in checker.STATE_CFG_FUNCTIONS}
    assert len(declared_references) == 23
    assert len(declared_variants) == 19 * 12
    assert declared_references.isdisjoint(declared_variants)
    assert used == declared_references | declared_variants

print('PASS: all export reference declarations, exact origins, ABIs and variant dispatch symbols')
