# REQUIRES: riscv-registered-target
# RUN: split-file %s %t
# RUN: opt -passes='loop-vectorize,loop-vectorize,verify<domtree>,verify<loops>,verify<scalar-evolution>' -verify-each -mtriple=riscv64 -mattr=+v -enable-vplan-reduction-fission -force-vector-width=1 -force-vector-interleave=0 -force-target-max-scalar-interleave=1 -scalable-vectorization=off -vplan-reduction-fission-max-scratch-bytes=112 -S %S/../Transforms/LoopVectorize/RISCV/reduction-fission-scalar-bitwise.ll -o %t/scalar.ll
# RUN: opt -passes='loop-vectorize,loop-vectorize,verify<domtree>,verify<loops>,verify<scalar-evolution>' -verify-each -mtriple=riscv64 -mattr=+v -enable-vplan-reduction-fission -force-vector-width=4 -force-vector-interleave=1 -scalable-vectorization=always -hints-allow-reordering=false -tail-folding-policy=dont-fold-tail -enable-epilogue-vectorization=false -vplan-reduction-fission-allow-fp-reordering -vplan-reduction-fission-max-scratch-bytes=112 -S %S/../Transforms/LoopVectorize/RISCV/reduction-fission-scalar-bitwise.ll -o %t/vector.ll
# RUN: opt -passes='loop-vectorize,loop-vectorize,verify<domtree>,verify<loops>,verify<scalar-evolution>' -verify-each -mtriple=riscv64 -mattr=+v -enable-vplan-reduction-fission -force-vector-width=1 -force-vector-interleave=0 -force-target-max-scalar-interleave=1 -scalable-vectorization=off -vplan-reduction-fission-max-scratch-bytes=784 -S %S/../Transforms/LoopVectorize/RISCV/reduction-fission-scalar-bitwise.ll -o %t/full.ll
# RUN: opt -passes='loop-vectorize,verify<domtree>,verify<loops>,verify<scalar-evolution>' -verify-each -mtriple=riscv64 -mattr=+v -enable-vplan-reduction-fission -force-vector-width=4 -force-vector-interleave=1 -scalable-vectorization=always -hints-allow-reordering=false -tail-folding-policy=dont-fold-tail -enable-epilogue-vectorization=false -vplan-reduction-fission-max-scratch-bytes=784 -S %S/../Transforms/LoopVectorize/RISCV/reduction-fission-scalar-bitwise.ll -o %t/full-vector-strict-lv1.ll
# RUN: opt -passes='loop-vectorize,loop-vectorize,verify<domtree>,verify<loops>,verify<scalar-evolution>' -verify-each -mtriple=riscv64 -mattr=+v -enable-vplan-reduction-fission -force-vector-width=4 -force-vector-interleave=1 -scalable-vectorization=always -hints-allow-reordering=false -tail-folding-policy=dont-fold-tail -enable-epilogue-vectorization=false -vplan-reduction-fission-max-scratch-bytes=784 -S %S/../Transforms/LoopVectorize/RISCV/reduction-fission-scalar-bitwise.ll -o %t/full-vector-strict-lv2.ll
# RUN: opt -passes='loop-vectorize,verify<domtree>,verify<loops>,verify<scalar-evolution>' -verify-each -mtriple=riscv64 -mattr=+v -enable-vplan-reduction-fission -force-vector-width=4 -force-vector-interleave=1 -scalable-vectorization=always -hints-allow-reordering=false -tail-folding-policy=dont-fold-tail -enable-epilogue-vectorization=false -vplan-reduction-fission-allow-fp-reordering -vplan-reduction-fission-max-scratch-bytes=784 -S %S/../Transforms/LoopVectorize/RISCV/reduction-fission-scalar-bitwise.ll -o %t/full-vector-reordered-lv1.ll
# RUN: opt -passes='loop-vectorize,loop-vectorize,verify<domtree>,verify<loops>,verify<scalar-evolution>' -verify-each -mtriple=riscv64 -mattr=+v -enable-vplan-reduction-fission -force-vector-width=4 -force-vector-interleave=1 -scalable-vectorization=always -hints-allow-reordering=false -tail-folding-policy=dont-fold-tail -enable-epilogue-vectorization=false -vplan-reduction-fission-allow-fp-reordering -vplan-reduction-fission-max-scratch-bytes=784 -S %S/../Transforms/LoopVectorize/RISCV/reduction-fission-scalar-bitwise.ll -o %t/full-vector-reordered-lv2.ll
# RUN: %python %t/check.py %S/../../utils/check-reduction-fission.py %S/../Transforms/LoopVectorize/RISCV/reduction-fission-scalar-bitwise.ll %t/scalar.ll %t/vector.ll %t/full.ll %t
# RUN: %python %t/verify.py opt %t
# RUN: opt -passes=verify -disable-output %t/scalar.probe.ll
# RUN: opt -passes=verify -disable-output %t/vector.probe.ll
# RUN: opt -passes=verify -disable-output %t/full.probe.ll
# RUN: llc -mtriple=riscv64 -mattr=+v -verify-machineinstrs %t/scalar.ll -o /dev/null
# RUN: llc -mtriple=riscv64 -mattr=+v -verify-machineinstrs %t/vector.ll -o /dev/null
# RUN: llc -mtriple=riscv64 -mattr=+v -verify-machineinstrs %t/full.ll -o /dev/null
# RUN: llc -mtriple=riscv64 -mattr=+v -verify-machineinstrs %t/full-vector-strict-lv1.ll -o /dev/null
# RUN: llc -mtriple=riscv64 -mattr=+v -verify-machineinstrs %t/full-vector-strict-lv2.ll -o /dev/null
# RUN: llc -mtriple=riscv64 -mattr=+v -verify-machineinstrs %t/full-vector-reordered-lv1.ll -o /dev/null
# RUN: llc -mtriple=riscv64 -mattr=+v -verify-machineinstrs %t/full-vector-reordered-lv2.ll -o /dev/null
# RUN: opt -passes=loop-vectorize -mtriple=riscv64 -mattr=+v -enable-vplan-reduction-fission -force-vector-width=1 -force-vector-interleave=0 -force-target-max-scalar-interleave=1 -vplan-reduction-fission-max-scratch-bytes=111 -pass-remarks=vplan-reduction-fission -S %S/../Transforms/LoopVectorize/RISCV/reduction-fission-scalar-bitwise.ll -o %t/padded.ll 2> %t/padded.remarks
# RUN: FileCheck %s --check-prefix=PAD < %t/padded.remarks
# PAD: scalar-bitwise.c:12:3: split scalar-IR reduction loop; {{.*}}scratch capacity 8, scratch bytes 96
# PAD: scalar-bitwise.c:32:3: split scalar-IR reduction loop; {{.*}}scratch capacity 8, scratch bytes 96

#--- check.py
import importlib.util
import json
from pathlib import Path
import re
import sys

sys.dont_write_bytecode = True
spec = importlib.util.spec_from_file_location('checker', sys.argv[1])
checker = importlib.util.module_from_spec(spec)
sys.modules[spec.name] = checker
spec.loader.exec_module(checker)
source = Path(sys.argv[2]).read_text()
work = Path(sys.argv[6])
mutations = dict(inherited=0, full_capacity=0, affine_count=0,
                 vector_schedule=0, result_edges=0, export_edges=0)
bodies = 0
shape_rejections = 0
probe_rejections = 0


def replace_one(text, old, new):
    assert old != new and text.count(old) == 1, ('missing/ambiguous mutation anchor', old)
    changed = text.replace(old, new, 1)
    assert changed != text
    return changed


configurations = list(zip(sys.argv[3:6], (9, 9, 65), (True, False, True),
                          ('scalar', 'vector', 'full')))
for policy in ('strict', 'reordered'):
    for repeats in (1, 2):
        tag = f'full-vector-{policy}-lv{repeats}'
        configurations.append((work / (tag + '.ll'), 65, False, tag))
for path, capacity, scalar, tag in configurations:
    inherited = tag in ('scalar', 'vector', 'full')
    ir = Path(path).read_text()
    probed = ir
    for name in checker.BITWISE_FUNCTIONS:
        if capacity < 65 and name == 'bitwise_affine':
            continue
        body = checker.function_definition(ir, name)
        assert checker.check_bitwise(ir, source, name, capacity, scalar) == body
        bodies += 1
        checked = checker.check_bitwise(ir, source, name, capacity, scalar, probe=True)
        probed = replace_one(probed, body, checked)
        # Instrument only certified sites in the actual transformed body.
        for hook, sites in (('begin', 1), ('producer', 1), ('store', 1),
                            ('guard', 1), ('consume', 1 if scalar else 2), ('end', 1)):
            assert checked.count('call void @record_bw_' + hook + '(') == sites, (name, hook)

        def reject(candidate, group=None):
            assert candidate != body, 'mutation did not change actual intended anchor'
            try:
                checker.check_bitwise(replace_one(ir, body, candidate), source, name, capacity, scalar)
            except AssertionError:
                mutations[group or ('inherited' if inherited else 'full_capacity')] += 1
            else:
                raise AssertionError(name + ': accepted bitwise mutation')

        def definition(value):
            anchors = list(re.finditer(r'^  %' + re.escape(value) + r' = [^\n]*$', body, re.M))
            assert len(anchors) == 1, (name, value)
            return anchors[0]

        def change(value, old, new, group=None):
            anchor = definition(value)
            changed = replace_one(anchor[0], old, new)
            reject(replace_one(body, anchor[0], changed), group)

        if not scalar:
            # Preserve inherited scalable certificates while extending the
            # same implementation for fixed multiplication consumers.
            shape = checker.consumer_vf4(body)
            assert shape.scalable
            entry = re.search(r'%min.iters.check = icmp ult i64 (%[-\w.$]+), (%[-\w.$]+)',
                              checker.loop_blocks(body)['scalar.fission.consumer.ph'])
            assert entry
            step = re.search(r'%index.next = add(?: nuw)? i64 %index, (%[-\w.$]+)',
                             checker.loop_blocks(body)['vector.body'])[1]

            def shape_change(value, old, new):
                global shape_rejections
                anchor = definition(value)[0]
                candidate = replace_one(body, anchor, replace_one(anchor, old, new))
                try:
                    checker.check_bitwise(replace_one(ir, body, candidate), source, name, capacity, scalar)
                except AssertionError:
                    shape_rejections += 1
                else:
                    raise AssertionError(name + ': accepted mismatched scalable shape')

            for value in (entry[2], step):
                shape_change(value[1:], ', 2', ', 1')
            for value in ('min.iters.check', 'n.mod.vf', 'index.next'):
                operand = entry[2] if value == 'min.iters.check' else step
                shape_change(value, ', ' + operand, ', 4')
            for ty, op in (('i32', 'and'), ('i64', 'xor')):
                vty = shape.vector_type(ty)
                loads = re.findall(r'^  (%[-\w.$]+) = load ' + re.escape(vty) + ',', body, re.M)
                assert len(loads) == 1
                shape_change(loads[0][1:], vty, '<4 x ' + ty + '>')
                shape_change(loads[0][1:], vty, '<vscale x 8 x ' + ty + '>')
                reduced = re.findall(r'^  (%[-\w.$]+) = call ' + ty +
                                     r' @llvm.vector.reduce.' + op + r'\.nxv4' + ty + r'\(', body, re.M)
                assert len(reduced) == 2
                for value in reduced:
                    shape_change(value[1:], '.nxv4' + ty + '(', '.v4' + ty + '(')
                    shape_change(value[1:], vty, '<4 x ' + ty + '>')
            for old, new in ((', i64 %bw.lanes, i1 true', ', i64 4, i1 true'),
                             ('%bw.lanes = mul i64 %bw.scale, 4', '%bw.lanes = mul i64 %bw.scale, 8'),
                             (', i64 1, i1 false', ', i64 4, i1 false')):
                candidate = replace_one(checked, old, new)
                try:
                    checker.check_consumer_lane_probes(candidate, shape, 'record_bw_')
                except AssertionError:
                    probe_rejections += 1
                else:
                    raise AssertionError(name + ': accepted incorrect scalable probe')

        # The full/compact consumer inherits add nuw nsw; affine may retain
        # only nuw. Accept only flag removal from this bounded unit increment.
        step = definition('fission.consumer.next')
        spelling = re.fullmatch(r'  %fission\.consumer\.next = add (?:nuw )?(?:nsw )?'
                                r'i64 %fission\.consumer\.iv, 1(, !dbg !\d+)?', step[0])
        assert spelling, (name, step[0])
        for flags in ('', 'nuw ', 'nsw ', 'nuw nsw '):
            analogous = ('  %fission.consumer.next = add ' + flags +
                         'i64 %fission.consumer.iv, 1' + (spelling[1] or ''))
            if analogous != step[0]:
                candidate = replace_one(body, step[0], analogous)
                assert checker.check_bitwise(replace_one(ir, body, candidate), source,
                                             name, capacity, scalar) == candidate
        change('fission.consumer.next', 'add ', 'sub ')
        change('fission.consumer.next', 'i64 ', 'i32 ')
        change('fission.consumer.next', '%fission.consumer.iv,', '%n,')
        change('fission.consumer.next', ', 1', ', 2')
        reject(replace_one(body, step[0], step[0] + '\n' + step[0]))
        # A correct-looking increment in another block cannot certify the
        # actual scalar body. Keep its SSA spelling to test block ownership.
        moved = replace_one(body, step[0] + '\n', '')
        ph = checker.loop_blocks(moved)['scalar.fission.consumer.ph']
        branch = re.search(r'^  br [^\n]*$', ph, re.M)
        assert branch
        moved_ph = replace_one(ph, branch[0], step[0] + '\n' + branch[0])
        reject(replace_one(moved, ph, moved_ph))
        tail = checker.loop_blocks(body)['scalar.fission.consumer.body']
        branch = re.search(r'^  br i1 (%fission\.consumer\.(?:more|done)), '
                           r'label %([-\w.$]+), label %([-\w.$]+)(, ![^\n]*)?$', tail, re.M)
        assert branch
        reject(replace_one(body, branch[0], replace_one(branch[0], branch[1], '%enter')))
        reject(replace_one(body, branch[0], f'  br i1 {branch[1]}, label %{branch[3]}, '
                           f'label %{branch[2]}' + (branch[4] or '')))
        condition = branch[1][1:]
        change(condition, 'icmp ne ' if condition.endswith('more') else 'icmp eq ',
               'icmp eq ' if condition.endswith('more') else 'icmp ne ')

        # Wrong actual arithmetic (each opcode and both source operand orders).
        for r, ty, seed, op, reverse in checker.BITWISE_REDUCTIONS:
            change('u.' + r + '.consume', op + ' ' + ty, ('or' if op == 'xor' else 'xor') + ' ' + ty)
        if scalar:
            change('a0.consume', '%a0.chunk.carry' if capacity < 65 else '-251691430', '0')
        else:
            start = '%a0.chunk.carry' if capacity < 65 else '-251691430'
            # LV uses an instruction for a dynamic carry and a constant
            # expression in the actual vector PHI for a full-trip seed.
            seed = re.search(r'^  (%[-\w.$]+) = [^\n]*insertelement \(?<vscale x 4 x i32> '
                             r'[^\n]+, i32 ' + re.escape(start) + r', i32 0', body, re.M)
            assert seed, 'missing actual vector seed anchor'
            change(seed[1][1:], 'i32 ' + start, 'i32 0')
        if capacity < 65:
            change('a0.chunk.carry', '[ -251691430,', '[ 0,')
            change('state.chunk.backedge', '[ %state.next,', '[ %state,')
            change('fission.chunk.next', '%fission.producer.completed' if name == 'bitwise_compact' else '%fission.chunk.count', '1')
        if name == 'bitwise_compact':
            change('fission.participating', '[ 0,', '[ 1,')
            change('fission.participating.count', '%fission.participating.merge', '%next')
        change('state.fission.export', '[ %state,', '[ %state.next,')
        # A correct unused XOR must not satisfy the actual observable output,
        # including the vector/scalar forwarding joins selected by repeated LV.
        exported = re.search(r'^  %out.x0 = phi i64 [^\n]*$', body, re.M)
        signature = checker.fixture_phi_signature(exported[0]) if exported else None
        assert signature and signature[2], 'missing actual XOR output anchor'
        for value, edge in signature[2]:
            change('out.x0', f'[ {value}, %{edge} ]', f'[ 0, %{edge} ]')

        if inherited:
            continue

        def extra(value, old, new, group='vector_schedule'):
            change(value, old, new, group)

        blocks = checker.loop_blocks(body)
        entry = re.search(r'%min.iters.check = icmp ult i64 (%[-\w.$]+), (%[-\w.$]+)',
                          blocks['scalar.fission.consumer.ph'])
        assert entry
        count, width = entry.groups()
        step = re.search(r'%index.next = add nuw i64 %index, (%[-\w.$]+)', blocks['vector.body'])[1]
        extra('min.iters.check', count + ',', '%seed,')
        extra('min.iters.check', 'icmp ult', 'icmp ugt')
        extra(width[1:], ', 2', ', 1')
        extra('n.mod.vf', count + ',', '%seed,')
        extra('n.mod.vf', ', ' + step, ', 1')
        extra('n.vec', 'sub ', 'add ')
        extra('index.next', ', ' + step, ', 1')
        done = re.search(r'^  (%[-\w.$]+) = icmp eq i64 %index.next, %n.vec', blocks['vector.body'], re.M)[1]
        extra(done[1:], '%index.next,', '%index,')
        branch = re.search(r'^  br i1 ' + re.escape(done) + r', label %middle.block, label %vector.body[^\n]*$',
                           blocks['vector.body'], re.M)[0]
        reject(replace_one(body, branch, replace_one(branch, 'label %middle.block, label %vector.body',
                                                     'label %vector.body, label %middle.block')), 'vector_schedule')
        extra('cmp.n', count + ',', '%seed,')
        branch = re.search(r'^  br i1 %cmp.n, label %([-\w.$]+), label %scalar.ph([^\n]*)$',
                           blocks['middle.block'], re.M)
        assert branch
        reject(replace_one(body, branch[0], f'  br i1 %cmp.n, label %scalar.ph, label %{branch[1]}' + branch[2]),
               'vector_schedule')
        extra('bc.resume.val', '[ %n.vec,', '[ 0,')
        extra('fission.consumer.iv', '[ %bc.resume.val,', '[ 0,')
        for r, ty, seed, op, _ in checker.BITWISE_REDUCTIONS:
            incoming = checker.fixture_phi_signature(definition(r + '.consume')[0])[2]
            resume = next(v for v, edge in incoming if edge == 'scalar.ph')
            signature = checker.fixture_phi_signature(definition(resume[1:])[0])
            assert signature and len(signature[2]) == 2
            for value, edge in signature[2]:
                extra(resume[1:], f'[ {value}, %{edge} ]', f'[ 0, %{edge} ]')

        # Every result PHI edge, including the scalar LCSSA forwarding edge,
        # vector-only edge and compact empty edge, must carry its own result.
        # Walk only actual scalar PHIs, stopping at arithmetic/constant roots.
        for r, ty, _, _, _ in checker.BITWISE_REDUCTIONS:
            visited = set()

            def result_edges(value):
                if not value.startswith('%') or value in visited:
                    return
                visited.add(value)
                anchor = definition(value[1:])
                signature = checker.fixture_phi_signature(anchor[0])
                if signature is None:
                    return
                assert signature[1] == ty
                for incoming, edge in signature[2]:
                    extra(value[1:], f'[ {incoming}, %{edge} ]', f'[ 0, %{edge} ]', 'result_edges')
                    result_edges(incoming)
            result_edges('%out.' + r)
        for value in ('state', 'state.next', 'c', 'dc', 'iv', 'next'):
            signature = checker.fixture_phi_signature(definition('out.' + value)[0])
            assert signature
            for incoming, edge in signature[2]:
                extra('out.' + value, f'[ {incoming}, %{edge} ]', f'[ 0, %{edge} ]', 'export_edges')

        if name != 'bitwise_affine':
            continue
        quotient = re.fullmatch(r'add(?: nuw)?(?: nsw)? i64 (%[-\w.$]+), 1',
                                checker.chunk_instructions(definition(count[1:])[0])[0].split(' = ')[1])[1]
        offset = re.fullmatch(r'udiv i64 (%[-\w.$]+), 3',
                              checker.chunk_instructions(definition(quotient[1:])[0])[0].split(' = ')[1])[1]
        offset_line = definition(offset[1:])[0]
        assert ' = add i64 %span, -3' in offset_line, 'missing actual SCEV count anchor'

        # Equivalent spellings remain tied to the same guarded producer.
        # Archive complete modules so the harness verifies these positives too.
        positives = [replace_one(body, offset_line, replace_one(offset_line, 'add i64 %span, -3', spelling))
                     for spelling in ('add nsw i64 %span, -3', 'sub i64 %span, 3',
                                      'sub nuw i64 %span, 3', 'sub nsw i64 %span, 3',
                                      'sub nuw nsw i64 %span, 3')]
        count_line = definition(count[1:])[0]
        for flags in ('', 'nuw ', 'nsw '):
            positives.append(replace_one(body, count_line,
                replace_one(count_line, 'add nuw nsw ', 'add ' + flags)))
        # Name every numbered value in this function: renaming only three
        # would leave gaps in LLVM's consecutively numbered unnamed values.
        renamed = {v: '%bw.ssa.' + v[1:] for v in re.findall(r'%\d+\b', body)}
        renamed.update({offset: '%bw.offset', quotient: '%bw.quotient', count: '%bw.count'})
        analogous = re.sub(r'%[-\w.$]+', lambda m: renamed.get(m[0], m[0]), body)
        assert analogous != body and all(v in analogous for v in renamed.values())
        positives.append(analogous)
        for i, candidate in enumerate(positives):
            module = replace_one(ir, body, candidate)
            assert checker.check_bitwise(module, source, name, capacity, scalar) == candidate
            (work / f'{tag}-{name}-{i}.analogous.ll').write_text(module)

        def affine(value, old, new):
            extra(value.lstrip('%'), old, new, 'affine_count')

        affine(count, ', 1', ', 2')
        affine(count, 'add ', 'sub ')
        affine(count, 'i64 ', 'i32 ')
        affine(count, quotient + ',', '%n,')
        affine(quotient, ', 3', ', 2')
        affine(quotient, 'udiv ', 'sdiv ')
        affine(quotient, 'i64 ', 'i32 ')
        affine(quotient, offset + ',', '%span,')
        affine(offset, ', -3', ', -6')
        affine(offset, '%span,', '%n,')
        affine(offset, 'add ', 'sub ')
        affine(offset, 'i64 ', 'i32 ')
        affine(offset, 'add ', 'add nuw ')
        affine('span', '%n,', '%seed,')
        affine('span', ', 3', ', 6')
        affine('limit', ', 7', ', 8')
        affine('next', ', 3', ', 6')
        affine('valid', ', 65', ', 66')
        affine('valid', 'icmp ule ', 'icmp sle ')
        affine('nonzero', 'icmp ne ', 'icmp eq ')
        affine('enter', 'and ', 'or ')
        reject(replace_one(body, 'br i1 %enter, label %preheader, label %exit',
                           'br i1 %enter, label %exit, label %preheader'), 'affine_count')
        affine('fission.ordinal', '[ 0,', '[ 1,')
        affine('fission.completed', ', 1', ', 2')
        affine('fission.completed.count', '[ %fission.completed,', '[ %next,')
        for value in (offset, quotient, count):
            anchor = definition(value[1:])[0]
            reject(replace_one(body, anchor, anchor + '\n' + anchor), 'affine_count')
            moved = replace_one(body, anchor + '\n', '')
            preheader = checker.loop_blocks(moved)['preheader']
            branch = re.search(r'^  br [^\n]*$', preheader, re.M)[0]
            reject(replace_one(moved, preheader, replace_one(preheader, branch, anchor + '\n' + branch)),
                   'affine_count')
        affine('min.iters.check', count + ',', '%limit,')
        # An arbitrary identity alias is outside the fixed certificate.
        alias = '  %bw.alias = add i64 ' + count + ', 0\n'
        candidate = replace_one(body, definition('min.iters.check')[0],
                                alias + replace_one(definition('min.iters.check')[0], count + ',', '%bw.alias,'))
        reject(candidate, 'affine_count')
        first, second = offset_line, definition(quotient[1:])[0]
        candidate = replace_one(body, first + '\n' + second, second + '\n' + first)
        reject(candidate, 'affine_count')
    (work / (tag + '.probe.ll')).write_text(probed + checker.BITWISE_DECLARATIONS)
# Seven actual bodies: 81 inherited negatives and 9 step/control negatives
# per body. Missing anchors or skipped rejection attempts must fail the test.
assert mutations == dict(inherited=144, full_capacity=232, affine_count=136,
                         vector_schedule=300, result_edges=252, export_edges=120), mutations
# 1184 IR rejection attempts in 19 actual bodies. The six observation-parser
# negatives below remain separate from IR mutations and execution evidence.
assert sum(mutations.values()) == 1184
assert bodies == 19, bodies

# Parsing totals is itself fail-closed; these are synthetic parser inputs,
# never evidence that a transformed function executed.
name = 'bitwise_observation'
fields = dict(comparisons=34816, producer=512 * sum(range(1, 66)),
              consumer=512 * sum(range(1, 66)), chunks=512 * 65, empty=0,
              vector=0, tail=512 * sum(range(1, 66)), fallback=512 * 65,
              zero=1536, lanes=0, scalable=0, vscale=1, **{'vector-iterations': 0})
line = 'Bitwise ' + name + ': ' + ' '.join(f'{k}={v}' for k, v in fields.items())
total = 'Bitwise: 34816 original/transformed/unsigned-oracle host comparisons (not RVV)'
text = line + '\n' + total + '\n'
assert checker.bitwise_execution_counts(text, {name: checker.BitwiseExecutionConfig(0, 65, None, 1)})[name] == fields
parser_rejections = 0
for candidate in (replace_one(text, line + '\n', ''), text + line + '\n',
                  replace_one(text, 'vector=0', 'vector=1'),
                  replace_one(text, 'zero=1536', 'zero=0'),
                  replace_one(text, 'consumer=' + str(fields['consumer']), 'consumer=1'),
                  replace_one(text, 'chunks=' + str(fields['chunks']), 'chunks=1')):
    assert candidate != text
    try:
        checker.bitwise_execution_counts(candidate, {name: checker.BitwiseExecutionConfig(0, 65, None, 1)})
    except AssertionError:
        parser_rejections += 1
    else:
        raise AssertionError('accepted incomplete bitwise observation')
assert parser_rejections == 6
counts = dict(kind='lit certificate/mutation counts; not runtime comparisons',
              bodies=bodies, ir_rejections=mutations, total_ir_rejections=sum(mutations.values()),
              observation_parser_rejections=parser_rejections,
              shape_rejections=shape_rejections, probe_rejections=probe_rejections)
assert shape_rejections == 17 * 14 and probe_rejections == 3 * 14, counts
(work / 'checker-counts.json').write_text(json.dumps(counts, indent=2) + '\n')
print(f'Bitwise checker: {bodies} actual bodies; IR rejection attempts ' +
      ', '.join(f'{key}={value}' for key, value in mutations.items()) +
      f'; total={sum(mutations.values())}; observation-parser negatives={parser_rejections}')

#--- verify.py
from pathlib import Path
import subprocess
import sys

work = Path(sys.argv[2])
probes = sorted(work.glob('full-vector-*.probe.ll'))
analogous = sorted(work.glob('*.analogous.ll'))
assert len(probes) == 4 and len(analogous) == 36, (probes, analogous)
for path in probes + analogous:
    subprocess.run([sys.argv[1], '-passes=verify', '-disable-output', str(path)], check=True)
