# REQUIRES: riscv-registered-target
# RUN: split-file %s %t
# RUN: %python %t/check.py %S/../../utils/check-reduction-fission.py \
# RUN:   %S/../Transforms/LoopVectorize/RISCV/reduction-fission-scalar-stores.ll %t opt

# The same ordered memory certificate is mandatory before host compilation.
# A valid SSA mutation moves %seen across an independent overwrite of %op.
# Fresh uninstrumented opt outputs cover full-trip/compact and canonical chunk
# schedules, both tail policies, strict/explicit fission FP reordering and
# once/twice LV. All forced VF4 configurations emit vector bodies and report
# consumer vscale x4, including capacity 1. Remainder C=1 executes the scalar
# fallback: count <= 1 < runtime VF. EVL instead enters a predicated vector body
# with the actual count as AVL. A separately labeled forced-scalar configuration
# covers consumers with no vector body. Mutate the remainder guard and EVL bound.
# Check emitted aligned VP loads and spelling-only unaligned variants. Mutations
# redirect aligned VP loads to original memory, escape derived scratch addresses,
# or use lookalike/arbitrary calls. Keep omission, duplication, control-path
# movement and read-past-overwrite rejections. No benchmark source is rewritten.
# Execution and uninstrumented RVV machine verification remain in the complete
# host driver, including all inherited matrices and independent memory oracles.

#--- check.py
import importlib.util
from itertools import product
from pathlib import Path
import re
import subprocess
import sys

sys.dont_write_bytecode = True
spec = importlib.util.spec_from_file_location('checker', sys.argv[1])
checker = importlib.util.module_from_spec(spec)
sys.modules[spec.name] = checker
spec.loader.exec_module(checker)
source = Path(sys.argv[2]).read_text()
directory = Path(sys.argv[3])
opt = sys.argv[4]
checked = scalar_consumers = vector_consumers = aligned_consumers = unaligned_consumers = 0
guarded_capacity_one = predicated_capacity_one = 0
remainder_entry_mutations = evl_entry_mutations = metadata_mutations = 0
for stem, names, capacity, ceiling in [
        ('full', checker.STORE_EXPORT_BASES, 65, 1044),
        ('chunks1', checker.STORE_CHUNK_BASES, 1, 20),
        ('chunks9', checker.STORE_CHUNK_BASES, 9, 148),
        ('chunks16', checker.STORE_CHUNK_BASES, 16, 256)]:
    original = checker.keep_functions(source, names)
    (directory / f'{stem}.ll').write_text(original)
    for repeated, reordered, policy in product((False, True), (False, True), ('tail', 'evl', 'scalar')):
        evl, scalar = policy == 'evl', policy == 'scalar'
        passes = 'loop-vectorize,' * (2 if repeated else 1)
        options = [
            '-passes=' + passes + 'verify<domtree>,verify<loops>,verify<scalar-evolution>',
            '-verify-each', '-mtriple=riscv64', '-mattr=+v',
            '-hints-allow-reordering=false', '-enable-vplan-reduction-fission',
            '-pass-remarks=vplan-reduction-fission',
            f'-vplan-reduction-fission-max-scratch-bytes={ceiling}', '-S']
        if scalar:
            options += ['-force-vector-width=1', '-force-vector-interleave=0',
                        '-force-target-max-scalar-interleave=1', '-scalable-vectorization=off']
        else:
            options += ['-force-vector-width=4', '-force-vector-interleave=1',
                        '-scalable-vectorization=always']
        if reordered:
            options += ['-vplan-reduction-fission-allow-fp-reordering']
        if not evl:
            options += ['-tail-folding-policy=dont-fold-tail', '-enable-epilogue-vectorization=false']
        result = subprocess.run([opt, *options], input=original, text=True,
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=True)
        tag = f'{stem}.lv{2 if repeated else 1}.{"reordered" if reordered else "strict"}.{policy}'
        module = result.stdout
        (directory / f'{tag}.ll').write_text(module)
        (directory / f'{tag}.remarks').write_text(result.stderr)
        assert '@record_' not in module
        assert result.stderr.count('split scalar-IR reduction loop;') == len(names), result.stderr
        for name in names:
            body = checker.function_definition(module, name)
            assert checker.check_store_function(module, source, name, capacity, evl, scalar=scalar) == body
            checked += 1
            vectors = [label for label in checker.loop_blocks(body) if label.startswith('vector.body')]
            assert len(vectors) == (0 if scalar else 1), (tag, name, vectors)
            scalar_consumers += scalar
            vector_consumers += not scalar
            guarded_capacity_one += capacity == 1 and policy == 'tail'
            predicated_capacity_one += capacity == 1 and evl
            mode = checker.STORE_FUNCTIONS.index(name)
            loc = f'scalar-stores.c:{12 + 10 * mode}:3'
            assert re.search(rf'{re.escape(loc)}: split scalar-IR reduction loop;[^\n]*'
                             rf'scratch capacity {capacity}, scratch bytes {ceiling}, '
                             r'producer live-outs 6\b', result.stderr), result.stderr
            # The second LV also visits retained vector loops and scalar
            # remainders. Its VF1 remarks do not erase the first pass's VF4.
            consumer_vfs = ['1' if scalar else 'vscale x 4']
            if repeated:
                consumer_vfs += ['1'] * (2 if policy == 'tail' else 1)
            for stage, vfs in [('producer', ['1'] * (2 if repeated else 1)),
                               ('consumer', consumer_vfs)]:
                assert re.findall(rf'{re.escape(loc)}: scalar-IR fission {stage} VF ([^\n]+)',
                                  result.stderr) == vfs, result.stderr
            if policy == 'tail':
                assert checker.check_store_function(module, source, name, capacity,
                                                    evl, probe=True) != body

            def reject(candidate, diagnostic='producer memory:'):
                assert candidate != body
                try:
                    checker.check_store_function(module.replace(body, candidate, 1),
                                                 source, name, capacity, evl, scalar=scalar)
                except AssertionError as error:
                    assert diagnostic in str(error), (name, error)
                else:
                    raise AssertionError(name + ': accepted changed memory placement/order')

            def instruction(label, pattern):
                # Match executable operands exactly, retaining the raw line
                # so mutations also exercise instructions carrying metadata.
                matches = []
                for raw in checker.loop_blocks(body)[label].splitlines():
                    normalized = checker.chunk_instructions(raw)
                    if normalized and (match := re.fullmatch(pattern, normalized[0])):
                        matches.append((raw, match))
                assert len(matches) == 1, (tag, name, label, pattern, matches)
                return matches[0]

            def mutate_instruction(found, replacements):
                global metadata_mutations
                raw, match = found
                changed = match[0]
                for group, replacement in sorted(replacements.items(), reverse=True):
                    changed = changed[:match.start(group)] + replacement + changed[match.end(group):]
                assert changed != match[0] and body.count(raw) == 1
                # Replace only the normalized instruction. The metadata and
                # comment suffix remains byte-identical, even for width 2 -> 0.
                new_raw = raw.replace(match[0], changed, 1)
                assert checker.chunk_instructions(new_raw) == [changed]
                offset = raw.index(match[0])
                assert new_raw[:offset] == raw[:offset]
                assert new_raw[offset + len(changed):] == raw[offset + len(match[0]):]
                metadata_mutations += ', !' in raw
                return body.replace(raw, new_raw, 1)

            if name in checker.STORE_CHUNK_BASES and not scalar:
                # The certificate also accepts the same executable entry
                # without metadata. This is a spelling check, not execution.
                checker.check_store_chunk_entry(re.sub(r', ![^\n]*$', '', body, flags=re.M), evl)
                if not evl:
                    remainder_entry_mutations += 1
                    guard = instruction('scalar.fission.consumer.ph',
                                        r'(%min\.iters\.check) = icmp (ult) i64 '
                                        r'(%fission.chunk.count), (%[-\w.$]+)')
                    reject(mutate_instruction(guard, {2: 'uge'}),
                           'store consumer entry:')
                    reject(mutate_instruction(guard, {4: '1'}),
                           'store consumer entry:')
                    reject(mutate_instruction(guard, {3: '%n'}),
                           'store consumer entry:')
                    width = instruction('scalar.fission.consumer.ph',
                                        re.escape(guard[1][4]) + r' = shl (nuw )i64 %[-\w.$]+, (2)')
                    reject(mutate_instruction(width, {2: '0'}), 'store consumer entry:')
                    reject(mutate_instruction(width, {1: ''}),
                           'store consumer entry:')
                    branch = instruction('scalar.fission.consumer.ph',
                                         r'br i1 (%min\.iters\.check), label (%scalar.ph), label (%vector.ph)')
                    reject(mutate_instruction(branch, {2: '%vector.ph', 3: '%scalar.ph'}),
                           'store consumer entry:')
                    reject(mutate_instruction(branch, {2: '%vector.ph'}),
                           'store consumer entry:')
                else:
                    evl_entry_mutations += 1
                    # Independent of the scalar-remainder guard: actual EVL
                    # is derived from this chunk, never the original full N.
                    avl = instruction('vector.body',
                                      r'%avl = phi i64 \[ (%fission.chunk.count), %vector.ph \], '
                                      r'\[ %avl.next, %vector.body \]')
                    reject(mutate_instruction(avl, {1: '%n'}),
                           'store consumer entry:')

            read = re.search(r'^  %seen = load i32, ptr %op[^\n]*\n', body, re.M)[0]
            overwrite = re.search(r'^  store i32 0, ptr %op[^\n]*\n', body, re.M)[0]
            assert read + overwrite in body
            reject(body.replace(read + overwrite, overwrite + read, 1))
            store = re.search(r'^  store i32 %write, ptr %p[^\n]*\n', body, re.M)[0]
            reject(body.replace(store, '', 1))
            reject(body.replace(store, store + store, 1))
            # Keep the write text, but move it to the consumer preheader.
            candidate = body.replace(store, '', 1)
            candidate = re.sub(r'(^scalar\.fission\.consumer\.ph:[^\n]*\n'
                               r'(?:[^\n]* = phi [^\n]*\n)*)',
                               lambda m: m[0] + store, candidate, count=1, flags=re.M)
            reject(candidate)
            if name == 'stores_compact':
                reject(body.replace(store, '', 1).replace('right:', 'right:\n' + store, 1))
            if 'scalar.fission.consumer.body:' in body:
                tail = checker.loop_blocks(body)['scalar.fission.consumer.body']
                load = re.search(r'^  %[-\w.$]+ = load i32, ptr (%[-\w.$]+)', tail, re.M)
                assert load
                changed_tail = tail[:load.start(1)] + '%p' + tail[load.end(1):]
                reject(body.replace(tail, changed_tail, 1))
            slot = re.search(r'^  (%[-\w.$]+) = alloca ', body, re.M)[1]
            candidate = re.sub(r'(^scalar\.fission\.consumer\.ph:[^\n]*\n'
                               r'(?:[^\n]* = phi [^\n]*\n)*)',
                               lambda m: m[0] + f'  store ptr {slot}, ptr %out, align 8\n',
                               body, count=1, flags=re.M)
            reject(candidate)

            vp_loads = list(re.finditer(
                r'^  %[-\w.$]+ = call <vscale x 4 x (i32|double|float)> '
                r'@llvm\.vp\.load\.nxv4(?:i32|f64|f32)\.p0'
                r'\(ptr align (4|8) (%[-\w.$]+), [^\n]+$', body, re.M))
            assert len(vp_loads) == (3 if evl and vectors else 0), (tag, name, vp_loads)
            if vp_loads:
                aligned_consumers += 1
                assert {load[1] for load in vp_loads} == {'i32', 'double', 'float'}
                unaligned = body
                for load in vp_loads:
                    line = load[0]
                    assert load[2] == ('8' if load[1] == 'double' else '4')
                    unaligned = unaligned.replace(line, line.replace(f'ptr align {load[2]} ', 'ptr ', 1), 1)
                    # The original argument dominates all consumer paths. A
                    # VP-load spelling must not hide an original-memory read.
                    changed = line[:load.start(3) - load.start()] + '%a' + line[load.end(3) - load.start():]
                    reject(body.replace(line, changed, 1))
                    # A derived scratch pointer can only feed GEPs and exact
                    # accesses. A pointer-taking call is still an escape.
                    reject(body.replace(line, line + f'\n  call void @escape(ptr {load[3]})', 1))
                    suffix = {'i32': 'i32', 'double': 'f64', 'float': 'f32'}[load[1]]
                    other = 'f32' if suffix == 'i32' else 'i32'
                    reject(body.replace(line, line.replace(f'nxv4{suffix}.p0', f'nxv4{other}.p0', 1), 1))
                    for old, new in [('@llvm.vp.load.', '@unrelated.load.'),
                                     ('.p0(ptr ', '.p0.extra(ptr '),
                                     ('.p0(ptr ', '.p1(ptr '),
                                     ('nxv4', 'nxv8'),
                                     ('ptr align ', 'ptr noundef align '),
                                     ('splat (i1 true)', 'splat (i1 false)')]:
                        assert old in line
                        reject(body.replace(line, line.replace(old, new, 1), 1))
                    # A constant full-width EVL cannot replace the actual
                    # tail length just because the intrinsic name matches.
                    changed, count = re.subn(r', i32 %[-\w.$]+\)', ', i32 4)', line)
                    assert count == 1
                    reject(body.replace(line, changed, 1))
                # Only the pointer attribute changes; masks, EVLs, provenance,
                # result/control and original access ordering are rechecked.
                assert unaligned != body
                assert checker.check_store_function(module.replace(body, unaligned, 1),
                                                    source, name, capacity, evl, scalar=scalar) == unaligned
                unaligned_consumers += 1

assert (checked, scalar_consumers, vector_consumers, aligned_consumers, unaligned_consumers) == (108, 36, 72, 36, 36)
assert (guarded_capacity_one, predicated_capacity_one) == (8, 8)
assert (remainder_entry_mutations, evl_entry_mutations) == (24, 24)
assert metadata_mutations > 0
print('PASS: 108 uninstrumented store consumers; 36 explicitly scalar, 72 emitted vector bodies; '
      '36 aligned EVL and 36 unaligned spelling variants; C=1: 8 guarded remainder and 8 predicated; '
      'entry, original memory order, control placement and scratch privacy mutations')
