# REQUIRES: riscv-registered-target
# RUN: split-file %s %t
# RUN: opt -passes='loop-vectorize,verify<domtree>,verify<loops>,verify<scalar-evolution>' -verify-each \
# RUN:   -mtriple=riscv64 -mattr=+v -force-vector-width=1 -force-vector-interleave=0 \
# RUN:   -force-target-max-scalar-interleave=1 -scalable-vectorization=off \
# RUN:   -enable-vplan-reduction-fission -pass-remarks=vplan-reduction-fission -S \
# RUN:   %S/../Transforms/LoopVectorize/RISCV/reduction-fission-scalar-compact-recurrence.ll -o %t/scalar.ll 2> %t/scalar.remarks
# RUN: opt -passes='loop-vectorize,loop-vectorize,verify<domtree>,verify<loops>,verify<scalar-evolution>' -verify-each \
# RUN:   -mtriple=riscv64 -mattr=+v -force-vector-width=4 -force-vector-interleave=1 \
# RUN:   -hints-allow-reordering=false -scalable-vectorization=always \
# RUN:   -tail-folding-policy=dont-fold-tail -enable-epilogue-vectorization=false \
# RUN:   -enable-vplan-reduction-fission -vplan-reduction-fission-allow-fp-reordering \
# RUN:   -pass-remarks=vplan-reduction-fission -S \
# RUN:   %S/../Transforms/LoopVectorize/RISCV/reduction-fission-scalar-compact-recurrence.ll -o %t/tail.ll 2> %t/tail.remarks
# RUN: opt -passes='loop-vectorize,verify<domtree>,verify<loops>,verify<scalar-evolution>' -verify-each \
# RUN:   -mtriple=riscv64 -mattr=+v -force-vector-width=4 -force-vector-interleave=1 \
# RUN:   -hints-allow-reordering=false -scalable-vectorization=always \
# RUN:   -enable-vplan-reduction-fission -pass-remarks=vplan-reduction-fission -S \
# RUN:   %S/../Transforms/LoopVectorize/RISCV/reduction-fission-scalar-compact-recurrence.ll -o %t/evl.ll 2> %t/evl.remarks
# RUN: opt -passes='loop-vectorize,verify<domtree>,verify<loops>,verify<scalar-evolution>' -verify-each \
# RUN:   -mtriple=riscv64 -mattr=+v -force-vector-width=1 -force-vector-interleave=0 \
# RUN:   -force-target-max-scalar-interleave=1 -scalable-vectorization=off \
# RUN:   -enable-vplan-reduction-fission -S \
# RUN:   %S/../Transforms/LoopVectorize/RISCV/reduction-fission-scalar-recurrence-compact-legacy.ll -o %t/delay.ll
# RUN: opt -passes='loop-vectorize,loop-vectorize,verify<domtree>,verify<loops>,verify<scalar-evolution>' -verify-each \
# RUN:   -mtriple=riscv64 -mattr=+v -force-vector-width=4 -force-vector-interleave=1 \
# RUN:   -hints-allow-reordering=false -scalable-vectorization=always \
# RUN:   -tail-folding-policy=dont-fold-tail -enable-epilogue-vectorization=false \
# RUN:   -enable-vplan-reduction-fission -S \
# RUN:   %S/../Transforms/LoopVectorize/RISCV/reduction-fission-scalar-recurrence-compact-legacy.ll -o %t/delay-tail.ll
# RUN: opt -passes='loop-vectorize,loop-vectorize,verify<domtree>,verify<loops>,verify<scalar-evolution>' -verify-each \
# RUN:   -mtriple=riscv64 -mattr=+v -force-vector-width=4 -force-vector-interleave=1 \
# RUN:   -hints-allow-reordering=false -scalable-vectorization=always \
# RUN:   -tail-folding-policy=dont-fold-tail -enable-epilogue-vectorization=false \
# RUN:   -enable-vplan-reduction-fission -S \
# RUN:   %S/../Transforms/LoopVectorize/RISCV/reduction-fission-scalar-compact.ll -o %t/inherited-tail.ll
# RUN: %python %t/check.py %S/../../utils/check-reduction-fission.py \
# RUN:   %S/../Transforms/LoopVectorize/RISCV %t

# Real transformed output exercises the same certificates as the executable
# comparisons. Every inherited checker/mutation remains. This fixture cannot
# substitute for linked execution of original/transformed/independent formulas.

#--- check.py
import importlib.util
from pathlib import Path
import re
import sys

spec = importlib.util.spec_from_file_location('checker', sys.argv[1])
checker = importlib.util.module_from_spec(spec)
spec.loader.exec_module(checker)
tests, work = map(Path, sys.argv[2:])
source = (tests / 'reduction-fission-scalar-compact-recurrence.ll').read_text()
outputs = {kind: (work / (kind + '.ll')).read_text() for kind in ['scalar', 'tail', 'evl']}
layouts = [
    ('compact_recurrence', 65, False, False, 12, 784),
    ('compact_recurrence_reverse', 65, False, False, 22, 780),
    ('compact_recurrence_merge', 65, True, False, 32, 784),
    ('compact_recurrence_affine', 65, True, False, 42, 784),
    ('compact_recurrence_runtime', 65, False, False, 52, 780),
    ('compact_recurrence_enclosing', 65, True, True, 62, 784),
    ('compact_recurrence_one', 1, True, False, 72, 16),
    ('compact_recurrence_255', 255, False, False, 82, 3064),
    ('compact_recurrence_limit', 5461, True, False, 92, 65536),
]
assert checker.COMPACT_RECURRENCE_CASES == layouts
for kind, text in outputs.items():
    vectorized, evl = kind != 'scalar', kind == 'evl'
    remarks = (work / (kind + '.remarks')).read_text()
    assert remarks.count('split scalar-IR reduction loop;') == len(layouts)
    for name, capacity, conditional, nested, line, size in layouts:
        if vectorized and capacity != 65:
            continue
        checker.check_recurrence_remarks(remarks, name, capacity, size, line,
            vectorized=vectorized, source_file='scalar-compact-recurrence.c')
        checked = checker.check_recurrence_function(
            text, source, name, evl, vectorized=vectorized, probe=not evl,
            capacity=capacity, compact=True)
        for recorder in ['acyclic_iteration', 'acyclic_latch', 'compact_participant',
                         'scalar_consumer_tail'] + (['scalar_consumer_vector'] if vectorized else []):
            assert checked.count('call void @record_' + recorder + '()') == int(not evl)

def change(text, pattern, replacement):
    changed, count = re.subn(pattern, replacement, text, count=1, flags=re.M)
    assert count == 1 and changed != text, pattern
    return changed

def reject(text, name='compact_recurrence', kind='scalar', capacity=65, obligation=None):
    try:
        checker.check_recurrence_function(text, source, name, kind == 'evl',
            vectorized=kind != 'scalar', capacity=capacity, compact=True)
    except AssertionError as error:
        if obligation is not None:
            assert obligation in str(error), (obligation, error)
    else:
        raise AssertionError('accepted compact recurrence mutation')

def tail_flags(text, flags):
    # Normalize only the demonstrated increment, preserving its SSA operands,
    # value, type, block and metadata. Either input spelling may occur in opt.
    text, count = re.subn(r'(^  %fission\.consumer\.next = )add nuw(?: nsw)?( i64 )',
                         r'\1add ' + flags + r'\2', text, flags=re.M)
    assert count == 1, count
    return text

# Exercise every inherited observable-output interface as well as the new
# recurrence interface below. Reusing an SSA value as the recurrence-mode flag
# used to route all of these through the three-reduction recurrence interface.
inherited = (work / 'inherited-tail.ll').read_text()
for name in ['compact_triangle', 'compact_diamond', 'compact_integer', 'compact_nested']:
    body = checker.function_definition(inherited, name)
    for flags in ('nuw', 'nuw nsw'):
        flagged = tail_flags(body, flags)
        assert checker.check_scalar_function(flagged, name, evl=False) == flagged

for name in ['compact_recurrence', 'compact_recurrence_merge',
             'compact_recurrence_reverse', 'compact_recurrence_affine',
             'compact_recurrence_runtime', 'compact_recurrence_enclosing']:
    for kind, text in outputs.items():
        body = checker.function_definition(text, name)
        for pattern, replacement in [
            (r'(\[ )23(, %[-\w.]+ \])', r'\g<1>29\2'),
            (r'(%raw = )xor', r'\1or'),
            (r'(%offset = and i32 )%prev', r'\1%older'),
            (r'(%dc = fsub double )%adx, %dprev', r'\1%dprev, %adx'),
            (r'(%choose = select i1 %none.mode, i1 )false', r'\1true'),
            (r'br i1 %choose, label %left, label %right',
             'br i1 %choose, label %right, label %left'),
            (r'(  %raw = [^\n]+\n)', r'\1\1'),
            (r'(getelementptr inbounds \[65 x i32\], ptr %[-\w.$]+, i32 0, i64 )%fission.participating$',
             r'\1%iv'),
            (r'alloca \[65 x i32\]', 'alloca [64 x i32]'),
            (r'(  store i32 %c,[^\n]+\n)', r'\1\1'),
            (r'(%fission.participating = phi i64 \[ )0', r'\g<1>1'),
            (r'(%fission.participating.next = add nuw i64 %fission.participating, )1', r'\g<1>2'),
            (r'(%fission.participating.merge = phi i64 )\[[^\n]+',
             r'\1[ %fission.participating, %left ], [ %fission.participating.next, %right ]'),
            (r'(%fission.empty = icmp )eq', r'\1ne'),
            (r'(%fission.empty = icmp eq i64 )%[-\w.$]+', r'\1%n'),
            (r'(%r0.result = phi i32 \[ )[^,]+', r'\g<1>0'),
            (r'(^right:[^\n]*\n)', r'\1  %skip.add = fadd double %dprev, 0.0\n'),
        ]:
            reject(change(body, pattern, replacement), name, kind)
        if kind == 'scalar':
            reject(change(body, r'(icmp ne i64 %fission.consumer.next, )%[-\w.$]+',
                          r'\1%n'), name, kind)
        elif kind == 'tail':
            reject(change(body, r'(%n.mod.vf = urem i64 )%[-\w.$]+', r'\1%n'), name, kind)
            reject(change(body, r'(%ud.consume = fadd )double', r'\1reassoc double'), name, kind)
            for flags in ('nuw', 'nuw nsw'):
                flagged = tail_flags(body, flags)
                assert checker.check_recurrence_function(
                    flagged, source, name, False, compact=True) == flagged
                for increment in ('0', '2', '-1'):
                    reject(change(flagged,
                        r'(%fission\.consumer\.next = add nuw(?: nsw)? i64 %[-\w.$]+, )1(?=, !|$)',
                        r'\g<1>' + increment), name, kind, obligation='compact scalar results:')
                for bound in ('%n', '%n.vec', '65'):
                    reject(change(flagged,
                        r'(%fission\.consumer\.more = icmp ne i64 %fission\.consumer\.next, )%[-\w.$]+',
                        r'\g<1>' + bound), name, kind, obligation='compact count provenance')
                reject(change(flagged, r'(%v0 = phi )i32', r'\1i8'), name, kind,
                       obligation='compact scalar results:')
                reject(change(flagged, r'store double %vd, ptr %dout',
                              'store double %start, ptr %dout'), name, kind,
                       obligation='compact scalar results:')
        else:
            reject(change(body, r'(%avl = phi i64 \[ )%[-\w.$]+', r'\1%n'), name, kind)
        if name == 'compact_recurrence_merge':
            reject(change(body, r'(%state.next = phi i32 \[ %state.update, %left \], \[ )%prev',
                          r'\1%older'), name, kind)
            update = re.search(r'^  %dstate.update = [^\n]+\n', body, re.M)[0]
            moved = body.replace(update, '', 1)
            reject(change(moved, r'(^right:[^\n]*\n)', r'\1' + update), name, kind)
        if name == 'compact_recurrence_reverse':
            reject(change(body, r'(%dstate.next = fadd double )%dprev, %dx',
                          r'\1%dx, %dprev'), name, kind)

# Source/IR SSA names and normal LV removal of poison flags do not affect
# retained operations. The compact counter itself keeps its checked nuw proof.
name = 'compact_recurrence_merge'
body = checker.function_definition(outputs['scalar'], name)
unflagged = body.replace('%state.update = add nuw nsw i32', '%state.update = add i32')
checker.check_recurrence_function(unflagged, source, name, False,
                                vectorized=False, compact=True)
renamed_source, renamed = source, body
for old, new in [('%prev', '%delay'), ('%older', '%earlier'), ('%dprev', '%fpdelay')]:
    renamed_source = re.sub(re.escape(old) + r'(?![-\w.$])', new, renamed_source)
    renamed = re.sub(re.escape(old) + r'(?![-\w.$])', new, renamed)
checker.check_recurrence_function(renamed, renamed_source, name, False,
                                vectorized=False, compact=True)

# Exact layout/source/VF assertions must distinguish both ABI stream orders.
for kind in outputs:
    remarks = (work / (kind + '.remarks')).read_text()
    for name, line, size, wrong in [('compact_recurrence', 12, 784, 780),
                                    ('compact_recurrence_reverse', 22, 780, 784)]:
        location = f'scalar-compact-recurrence.c:{line}:3:'
        local = '\n'.join(row for row in remarks.splitlines() if location in row)
        for old, new in [(f'scratch bytes {size}', f'scratch bytes {wrong}'),
                         (f'scratch bytes {size}', f'scratch bytes {size}0'),
                         ('scratch capacity 65', 'scratch capacity 64'),
                         (location, location.replace(':3:', ':4:')),
                         ('producer VF 1', 'producer VF 8'),
                         ('consumer VF ' + ('1' if kind == 'scalar' else 'vscale x 4'),
                          'consumer VF 8')]:
            assert old in local
            try:
                checker.check_recurrence_remarks(local.replace(old, new), name, 65, size, line,
                    vectorized=kind != 'scalar', source_file='scalar-compact-recurrence.c')
            except AssertionError:
                pass
            else:
                raise AssertionError('accepted compact remark mutation')

legacy_source = (tests / 'reduction-fission-scalar-recurrence-compact-legacy.ll').read_text()
for file, vectorized in [('delay.ll', False), ('delay-tail.ll', True)]:
    text = (work / file).read_text()
    checker.check_compact_delay_function(text, legacy_source, False, vectorized, probe=True)
    if vectorized:
        for flags in ('nuw', 'nuw nsw'):
            flagged = tail_flags(text, flags)
            checker.check_compact_delay_function(flagged, legacy_source, False, vectorized)
    candidate = change(text, r'(%prev = phi i32 \[ 23, %preheader \], \[ )%x', r'\1%c')
    try:
        checker.check_compact_delay_function(candidate, legacy_source, False, vectorized)
    except AssertionError:
        pass
    else:
        raise AssertionError('accepted changed historical skipped-iteration state')
