# REQUIRES: riscv-registered-target
# RUN: split-file %s %t
# RUN: %python %t/check.py %S/../../utils/check-reduction-fission.py \
# RUN:   %S/../Transforms/LoopVectorize/RISCV/reduction-fission-scalar-fneg.ll %t opt \
# RUN:   | FileCheck %s
# CHECK: Negation: 12 verified probe modules, 28 scalar stage certificates; focused mutations rejected

# Reuse inherited scheduling/participation/scratch/export proofs. Only new
# retained-negation certificate logic receives new focused mutations here.
# Actual original/transformed/independent-oracle execution is mandatory in
# check-reduction-fission.py, separately from this static certificate test.
# Check all full/compact/affine and C=1/9 EQ/NE chunk latches, including their
# loop metadata, under both policies and once/twice LV. The compact header's
# participation branch is not the producer latch.

#--- check.py
import importlib.util
from itertools import product
from pathlib import Path
import re
import subprocess
import sys

sys.dont_write_bytecode = True
spec = importlib.util.spec_from_file_location('checker', sys.argv[1])
checker = importlib.util.module_from_spec(spec)
sys.modules[spec.name] = checker
spec.loader.exec_module(checker)
source = Path(sys.argv[2]).read_text()
directory, opt = Path(sys.argv[3]), sys.argv[4]
modules = certificates = 0


def reject(module, name, capacity):
    try:
        checker.check_fneg_function(module, source, name, capacity)
    except AssertionError:
        return
    raise AssertionError('accepted changed retained negation: ' + name)


for functions, capacity, ceiling in checker.FNEG_CONFIGURATIONS:
    selected = checker.keep_functions(source, functions)
    for repeated, reordered in product((False, True), repeat=2):
        result = subprocess.run([opt, *checker.subtraction_options(ceiling, reordered, repeated)],
                                input=selected, text=True, check=True,
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        assert result.stderr.count('split scalar-IR reduction loop;') == len(functions)
        module, instrumented = result.stdout, result.stdout
        for name in functions:
            body = checker.function_definition(module, name)
            checker.check_fneg_function(module, source, name, capacity)
            probed = checker.check_fneg_function(module, source, name, capacity, probe=True)
            instrumented = instrumented.replace(body, probed, 1)
            certificates += 1
            neg = re.search(r'^  %[-\w.$]+ = fneg double %dx, !dbg !(\d+)$', body, re.M)
            assert neg, body
            latch = checker.loop_blocks(body)['latch' if name == 'stores_compact' else 'loop']
            instructions = [line.split(';', 1)[0].strip() for line in latch.splitlines()
                            if line.split(';', 1)[0].strip()]
            terminator = instructions[-1]
            branch = re.fullmatch(r'br i1 %[-\w.$]+, label %([-\w.$]+), '
                                  r'label %([-\w.$]+)(?:, ![^\n]+)?', terminator)
            consumer_entry = ('scalar.fission.consumer.guard' if name == 'stores_compact'
                              else 'scalar.fission.consumer.ph')
            assert branch and set(branch.groups()) == {'loop', consumer_entry}, terminator
            assert ', !llvm.loop !' in terminator, terminator
            latch_debug = re.search(r', !dbg !(\d+)(?=, !|$)', terminator)
            assert latch_debug and latch_debug[1] != neg[1], body
            if repeated or reordered:
                continue
            for changed in (
                    body.replace(neg[0], neg[0].replace('double %dx', 'double %start'), 1),
                    body.replace(neg[0], neg[0].replace('fneg double', 'fneg nsz double'), 1),
                    body.replace(neg[0], neg[0].split(', !dbg !')[0], 1),
                    body.replace(neg[0], neg[0].replace('!dbg !' + neg[1],
                                                     '!dbg !' + latch_debug[1]), 1)):
                assert changed != body
                reject(module.replace(body, changed, 1), name, capacity)
            if name == 'stores_compact':
                extra = '  %extra = fneg double %start, !dbg !' + neg[1] + '\n'
                changed, count = re.subn(r'(^right:[^\n]*\n)', lambda m: m[0] + extra,
                                         body, flags=re.M)
                assert count == 1
                reject(module.replace(body, changed, 1), name, capacity)
        path = directory / f'probe_{modules}.ll'
        path.write_text(instrumented + checker.SUBTRACTION_PROBE_DECLARATIONS)
        verified = subprocess.run([opt, '-passes=verify', '-disable-output', str(path)],
                                  text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        assert verified.returncode == 0, verified.stderr
        modules += 1
assert (modules, certificates) == (12, 28), (modules, certificates)
print('Negation: 12 verified probe modules, 28 scalar stage certificates; focused mutations rejected')
