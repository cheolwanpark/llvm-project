# REQUIRES: riscv-registered-target
# RUN: split-file %s %t
# RUN: %python %t/check.py opt llc %S/../../utils/check-reduction-fission.py %S/../Transforms/LoopVectorize/RISCV/reduction-fission-scalar-minmax.ll %t
#
# Compose noncanonical chunk control with all four min/max intrinsics, retained
# producer state and aliasing stores. Execute original and actual scalar split
# IR on the host, also comparing to an independent integer oracle. RVV machine
# verification is separate from this host execution.

#--- check.py
import ctypes
import importlib.util
from itertools import product
from pathlib import Path
import re
import shutil
import sys

sys.dont_write_bytecode = True
opt, llc, utility, fixture, work = sys.argv[1:]
work = Path(work)
spec = importlib.util.spec_from_file_location('checker', utility)
checker = importlib.util.module_from_spec(spec)
sys.modules[spec.name] = checker
spec.loader.exec_module(checker)
source = checker.keep_functions(Path(fixture).read_text(), ['minmax_affine'])
clang = Path(shutil.which(opt)).resolve().with_name('clang')
assert clang.is_file(), clang
u32, u64 = (1 << 32) - 1, (1 << 64) - 1
canary = 0x123456789ABCDEF0


def native(ir, tag):
    # No scalable/vector instructions are admitted by this scalar test. Strip
    # only target annotations before lowering the exact split IR for the host.
    assert '<vscale x' not in ir and not re.search(r'<\d+ x ', ir)
    ir = re.sub(r'^target (?:triple|datalayout) = .*\n', '', ir, flags=re.M)
    ir = re.sub(r'"target-(?:features|cpu|tune-cpu)"="[^"]*"', '', ir)
    path = work / (tag + '.ll')
    path.write_text(ir)
    library = work / (tag + '.so')
    checker.run([str(clang), '-O0', '-shared', '-fPIC', str(path), '-o', str(library)])
    loaded = ctypes.CDLL(str(library))
    fn = loaded.minmax_affine
    fn.argtypes = [ctypes.c_void_p] * 3 + [ctypes.c_uint64, ctypes.c_uint32, ctypes.c_uint32]
    fn.restype = None
    return loaded, fn


def signed(x):
    return (x ^ (1 << 31)) - (1 << 31)


def oracle(memory, ai, wi, n, seed):
    out = [canary] * 16
    if not 1 <= n <= 65:
        return out
    a0, a1, o0, o1 = -251691430, 1515890085, 324508639, 610839776
    x0, x1, b0, b1, q0, q1 = 81985529216486895, (-81985529216486896) & u64, 13, 229, 17, (-7) & u32
    state = seed
    for i in range(n):
        x = memory[ai + i]
        c = state ^ x
        dc = (state << 32) | c
        next_state = (state * x) & u32
        memory[wi + i] = next_state
        a0, a1 = min(a0, signed(c)), min(a1, signed(c))
        o0, o1 = max(o0, signed(c)), max(o1, signed(c))
        x0, x1 = min(x0, dc), max(x1, dc)
        b0, b1 = min(b0, c & 255), max(b1, c & 255)
        q0, q1 = (q0 + c) & u32, (q1 * c) & u32
        last_state = state
        state = next_state
    return [a0 & u32, a1 & u32, o0 & u32, o1 & u32, x0, x1,
            last_state, state, c, dc, 7 + 3 * (n - 1), 7 + 3 * n, b0, b1, q0, q1]


def execute(fn, values, ai, wi, n, seed):
    memory = (ctypes.c_uint32 * len(values))(*values)
    out = (ctypes.c_uint64 * 18)(*[canary] * 18)
    ptr = lambda i: ctypes.byref(memory, 4 * i)
    fn(ptr(ai) if 1 <= n <= 65 else None,
       ptr(wi) if 1 <= n <= 65 else None, ctypes.byref(out, 8), n, 0, seed)
    assert out[0] == out[17] == canary
    return list(out)[1:17], list(memory)


reference_library, reference = native(source, 'reference')
comparisons = 0
for capacity, ceiling in ((1, 17), (8, 104), (9, 121), (16, 208)):
    for reordered, repeated in product((False, True), repeat=2):
        tag = f'c{capacity}-r{int(reordered)}-lv{1 + repeated}'
        result = checker.run([opt, *checker.subtraction_options(ceiling, reordered, repeated)], input=source)
        ir = result.stdout
        checker.check_original_chunk_control(ir, source, 'minmax_affine', capacity)
        for ty in ('i32', 'i64', 'i8'):
            assert f'alloca [{capacity} x {ty}]' in ir
        for op in ('smin.i32', 'smax.i32', 'umin.i64', 'umax.i64', 'umin.i8', 'umax.i8'):
            assert re.search(r'%u\.\w+\.consume = call \w+ @llvm\.' + op, ir), op
        checker.run([llc, '-mtriple=riscv64', '-mattr=+v', '-verify-machineinstrs',
                     '-o', str(work / (tag + '.s'))], input=ir)
        library, transformed = native(ir, tag)
        for n, seed, offset, pattern in product(list(range(66)) + [66, u64],
                                                (0, 1, 0x80000001, u32),
                                                (-1, 0, 1, 80), range(3)):
            special = (0, 1, u32, 0x80000000, 0x7fffffff, seed)
            values = [special[i % len(special)] if pattern == 0 else
                      ((i * 1664525 + 1013904223) & u32) if pattern == 1 else seed
                      for i in range(160)]
            ai, wi = 2, 2 + offset
            expected_memory = values.copy()
            expected = oracle(expected_memory, ai, wi, n, seed)
            assert execute(reference, values, ai, wi, n, seed) == (expected, expected_memory)
            assert execute(transformed, values, ai, wi, n, seed) == (expected, expected_memory), (tag, n, seed, offset, pattern)
            comparisons += 1
print(f'PASS: {comparisons} affine min/max original/transformed/oracle comparisons')
