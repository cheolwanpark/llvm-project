# RUN: split-file %s %t
# RUN: %python %t/check.py %S/../../utils/check-reduction-fission.py \
# RUN:   %S/../Transforms/LoopVectorize/RISCV/reduction-fission-scalar-affine.ll %t/lv1.ll %t/lv2.ll

# Retained actual outputs exercise the production checker, not executable
# equivalence. check-reduction-fission.py separately generates fresh LV1/LV2
# paths and compares them with original IR and independent C references.

#--- check.py
import importlib.util
from pathlib import Path
import re
import sys

spec = importlib.util.spec_from_file_location('checker', sys.argv[1])
checker = importlib.util.module_from_spec(spec)
spec.loader.exec_module(checker)
original = Path(sys.argv[2]).read_text()
name = 'affine_compact'


def accepted(body):
    assert checker.check_affine_function(body, original, name, evl=False) == body


def rejected(body, obligation, prefix='compact scalar results:'):
    try:
        checker.check_affine_function(body, original, name, evl=False)
    except AssertionError as error:
        # Construction or earlier preservation/count failures cannot satisfy
        # a result-certificate rejection test.
        assert prefix in str(error) and obligation in str(error), (obligation, error)
    else:
        raise AssertionError('accepted ' + obligation)


def replace_once(text, pattern, replacement):
    matches = list(re.finditer(pattern, text, re.M))
    assert len(matches) == 1, (pattern, len(matches))
    match = matches[0]
    return text[:match.start()] + replacement + text[match.end():]


def definition(text, value, old, new):
    pattern = r'^  ' + re.escape(value) + r' = [^\n]*$'
    matches = list(re.finditer(pattern, text, re.M))
    assert len(matches) == 1, (value, len(matches))
    line = matches[0][0]
    assert line.count(old) == 1, (value, old, line)
    return replace_once(text, pattern, line.replace(old, new, 1))


def block(text, label):
    pattern = r'^' + re.escape(label) + r':[^\n]*\n.*?(?=^[-\w.$]+:|^}|\Z)'
    matches = list(re.finditer(pattern, text, re.M | re.S))
    assert len(matches) == 1, (label, len(matches))
    return matches[0]


def edit_block(text, label, old, new):
    match = block(text, label)
    assert match[0].count(old) == 1, (label, old)
    return text[:match.start()] + match[0].replace(old, new, 1) + text[match.end():]


def rename_label(text, old, new):
    # Keep exact header positions: no exit/row.exit suffix collisions.
    text = replace_once(text, r'^' + re.escape(old) + r':', new + ':')
    return re.sub(re.escape('%' + old) + r'(?![-\w.$])', '%' + new, text)


tail = 'scalar.fission.consumer.body'
join = 'scalar.fission.consumer.loopexit'
hop = join + '.loopexit'
end = 'scalar.fission.consumer.exit'
reductions = [('r0', 'i32', 'u0'), ('r1', 'i32', 'u1'),
              ('rd', 'double', 'ud'), ('rf', 'float', 'uf')]
for lv, path in enumerate(sys.argv[3:], 1):
    body = checker.function_definition(Path(path).read_text(), name)
    accepted(body)
    # Names and printed predecessor comments carry no correctness evidence.
    renamed = rename_label(body, 'exit.loopexit', 'output.bridge')
    if lv == 2:
        renamed = rename_label(renamed, hop, 'tail.bridge')
    renamed = re.sub(r'; preds =[^\n]*', '; deliberately untrusted comment', renamed)
    for old in (['%.lcssa16', '%.lcssa15', '%.lcssa14', '%.lcssa'] if lv == 2 else []):
        renamed = re.sub(re.escape(old) + r'(?![-\w.$])', '%renamed' + old[1:], renamed)
    if lv == 2:
        for _, _, update in reductions:
            renamed = re.sub(re.escape('%' + update + '.consume.lcssa') + r'(?![-\w.$])',
                             '%export.' + update, renamed)
    accepted(renamed)
    probed = checker.check_affine_function(body, original, name, evl=False, probe=True)
    for recorder in ('acyclic_iteration', 'acyclic_latch', 'compact_participant',
                     'scalar_consumer_vector', 'scalar_consumer_tail'):
        assert probed.count('call void @record_' + recorder + '()') == 1

    # Zero/vector-only/tail-only/mixed paths all need the same output linkage.
    # Runtime P=0..65 and every VF boundary are compared by the C harness.
    for value, ty, update in reductions:
        tail_value = '%' + update + '.consume' + ('.lcssa' if lv == 2 else '')
        predecessor = hop if lv == 2 else tail
        rejected(definition(body, '%' + value + '.lcssa', tail_value + ',', '%start,'),
                 'join reduction ' + value)
        rejected(definition(body, '%' + value + '.lcssa', '%' + predecessor + ' ]', '%scalar.ph ]'),
                 'join reduction ' + value)
        rejected(definition(body, '%' + value + '.lcssa', 'phi ' + ty, 'phi i8'), 'instruction')
        # Integer streams share contributions but have different starts.
        wrong = '%u1.consume' if value == 'r0' else '%u0.consume'
        if lv == 2:
            wrong += '.lcssa'
        rejected(definition(body, '%' + value + '.lcssa', tail_value + ',', wrong + ','),
                 'join reduction ' + value)

    for value, old, new, obligation in [
        ('%bc.resume.val', '[ 0,', '[ 1,', 'resume induction'),
        ('%fission.consumer.next', ', 1, !dbg', ', 2, !dbg', 'instruction'),
        ('%bc.merge.rdx', '[ 17,', '[ 0,', 'resume reduction'),
        ('%bc.merge.rdx11', '[ -7,', '[ 17,', 'resume reduction'),
        ('%vec.phi', 'i32 17,', 'i32 0,', 'vector recurrence start/backedge'),
        ('%vec.phi7', '[ %start,', '[ 0.000000e+00,', 'vector recurrence start/backedge'),
        ('%ud.consume', 'fadd double', 'fadd reassoc double', 'instruction'),
        ('%rd.lcssa', ('%.lcssa14' if lv == 2 else '%11') + ', %middle.block',
         '%start, %middle.block', 'join reduction rd'),
        ('%m0.lcssa', '%r0.result,', '%r1.result,', 'forwarding PHI'),
        ('%v0', '%m0.lcssa,', '%m1.lcssa,', 'output PHI r0'),
        ('%vd', '[ %start,', '[ 0.000000e+00,', 'output PHI rd'),
    ]:
        rejected(definition(body, value, old, new), obligation)
    rejected(edit_block(body, 'exit', 'store i32 %v0,', 'store i32 %v1,'), 'instruction')
    rejected(edit_block(body, 'exit', '  ret void', '  call void @unexpected()\n  ret void'),
             'output work')
    rejected(edit_block(body, 'middle.block', '  %cmp.n =',
                        '  call void @unexpected()\n  %cmp.n ='), 'middle forwarding work')
    rejected(edit_block(body, join, '  br label %' + end,
                        '  call void @unexpected()\n  br label %' + end), 'join work')
    rejected(edit_block(body, tail, 'label %' + tail + ', label %' + (hop if lv == 2 else join),
                        'label %' + (hop if lv == 2 else join) + ', label %' + tail), 'instruction')
    rejected(edit_block(body, 'middle.block', 'label %' + join + ', label %scalar.ph',
                        'label %scalar.ph, label %' + join), 'compact count provenance',
             prefix='compact count provenance')
    rejected(edit_block(body, 'scalar.fission.consumer.ph',
                        'label %scalar.ph, label %vector.ph',
                        'label %vector.ph, label %scalar.ph'), 'compact count provenance',
             prefix='compact count provenance')
    for target, obligation in [('middle.block', 'middle predecessors'),
                               (join, 'join predecessors'), (end, 'result predecessors')]:
        at = block(body, join).start()
        extra = 'unexpected:\n  br label %' + target + '\n'
        rejected(body[:at] + extra + body[at:], obligation)

    if lv == 2:
        # The exact actual tail-hop PHIs must be the only work in that block.
        for value, ty, update in reductions:
            forwarded = '%' + update + '.consume.lcssa'
            forwarding_obligation = hop + ': forwarding PHI for %' + update + '.consume'
            for old, new in [('%' + update + '.consume,', '%start,'),
                             ('phi ' + ty, 'phi i8'),
                             ('%' + tail + ' ]', '%middle.block ]'),
                             (' ]', ' ], [ %start, %entry ]')]:
                rejected(definition(body, forwarded, old, new), forwarding_obligation)
            rejected(definition(body, forwarded, '%' + update + '.consume,', forwarded + ','),
                     forwarding_obligation)
            # Duplicate matching PHIs fail uniqueness while tracing this
            # reduction, before the later block-work count is checked.
            rejected(edit_block(body, hop, '  br label %' + join,
                                '  %extra = phi ' + ty + ' [ %' + update + '.consume, %' +
                                tail + ' ]\n  br label %' + join),
                     forwarding_obligation)
        # Unrelated work leaves each forwarding PHI unique and reaches the
        # block-work check. The extra PHI here does not match any reduction.
        for instruction in ('call void @unexpected()', 'store i32 0, ptr %out',
                            '%extra = add i32 %u0.consume, 0',
                            '%extra = phi i32 [ 0, %' + tail + ' ]'):
            rejected(edit_block(body, hop, '  br label %' + join,
                                '  ' + instruction + '\n  br label %' + join), 'tail forwarding work')
        copied = edit_block(body, hop, '  %u0.consume.lcssa =',
                            '  %u0.consume.more = add i32 %u0.consume, 0\n  %u0.consume.lcssa =')
        rejected(definition(copied, '%u0.consume.lcssa', '%u0.consume,', '%u0.consume.more,'),
                 hop + ': forwarding PHI for %u0.consume')
        rejected(edit_block(body, hop, 'br label %' + join,
                            'br i1 %choose, label %' + join + ', label %' + join),
                 hop + ': instruction br label')
        rejected(edit_block(body, hop, 'br label %' + join, 'br label %' + hop),
                 'tail forwarding edge/predecessors')
        at = block(body, hop).start()
        rejected(body[:at] + 'unexpected:\n  br label %' + hop + '\n' + body[at:],
                 'tail forwarding edge/predecessors')
        rejected(body[:at] + 'unexpected:\n  switch i64 %n, label %' + hop +
                 ' [ i64 0, label %exit ]\n' + body[at:], 'tail forwarding edge/predecessors')
        longer = edit_block(body, hop, 'br label %' + join, 'br label %longer')
        at = block(longer, join).start()
        rejected(longer[:at] + 'longer:\n  br label %' + join + '\n' + longer[at:],
                 'tail forwarding edge/predecessors')
        # Middle PHIs forward actual updates, never suffixes or copy chains.
        # A swapped integer update has valid forwarding syntax but the wrong
        # recurrence seed; a wrong vector type fails the typed PHI match first.
        for value, old, new, obligation in [
            ('%.lcssa16', '%9,', '%10,', 'vector recurrence start/backedge'),
            ('%.lcssa15', 'phi <vscale x 4 x i32>', 'phi <vscale x 4 x i64>',
             'middle.block: instruction'),
            ('%.lcssa14', '%11,', '%start,', 'FP vector forwarding PHI'),
            ('%.lcssa', '%vector.body ]', '%vector.ph ]', 'FP vector forwarding PHI'),
            ('%.lcssa14', ' ]', ' ], [ %start, %vector.ph ]', 'FP vector forwarding PHI'),
        ]:
            rejected(definition(body, value, old, new), obligation)
        chained = edit_block(body, 'middle.block', '  %.lcssa14 =',
                             '  %chain = phi double [ %11, %vector.body ]\n  %.lcssa14 =')
        rejected(definition(chained, '%.lcssa14', '%11,', '%chain,'), 'FP vector forwarding PHI')

#--- lv1.ll
; Retained t000032 actual LV1 scalar-remainder output, fixture-only.
define void @affine_compact(ptr readonly %a, ptr readonly %fp, ptr %out, ptr %dout, ptr %fout, i64 %n, double %start, i64 %begin) #1 !dbg !42 {
entry:
  %scalar.fission.scratch = alloca [65 x i32], align 4
  %scalar.fission.scratch1 = alloca [65 x double], align 8
  %scalar.fission.scratch2 = alloca [65 x float], align 4
  %valid = icmp ule i64 %n, 65
  %nonzero = icmp ne i64 %n, 0
  %enter = and i1 %valid, %nonzero
  %fstart = fptrunc double %start to float
  br i1 %enter, label %preheader, label %exit

preheader:                                        ; preds = %entry
  %span = shl nuw nsw i64 %n, 1
  %limit = sub nuw nsw i64 137, %span
  br label %loop, !dbg !43

loop:                                             ; preds = %latch, %preheader
  %fission.participating = phi i64 [ 0, %preheader ], [ %fission.participating.merge, %latch ]
  %iv = phi i64 [ 137, %preheader ], [ %next, %latch ]
  %distance = sub nuw nsw i64 137, %iv
  %index = lshr i64 %distance, 1
  %p = getelementptr i32, ptr %a, i64 %index
  %x = load i32, ptr %p, align 4
  %choose = icmp ne i32 %x, 0
  br i1 %choose, label %left, label %latch, !dbg !43

left:                                             ; preds = %loop
  %q = sdiv i32 840, %x
  %lc = call i32 @scalar_helper(i32 %q)
  %dp = getelementptr double, ptr %fp, i64 %index
  %dc = load double, ptr %dp, align 8
  %fc = fptrunc double %dc to float
  %fission.participating.next = add nuw i64 %fission.participating, 1
  %0 = getelementptr inbounds [65 x i32], ptr %scalar.fission.scratch, i32 0, i64 %fission.participating
  store i32 %lc, ptr %0, align 4
  %1 = getelementptr inbounds [65 x double], ptr %scalar.fission.scratch1, i32 0, i64 %fission.participating
  store double %dc, ptr %1, align 8
  %2 = getelementptr inbounds [65 x float], ptr %scalar.fission.scratch2, i32 0, i64 %fission.participating
  store float %fc, ptr %2, align 4
  br label %latch

latch:                                            ; preds = %left, %loop
  %fission.participating.merge = phi i64 [ %fission.participating.next, %left ], [ %fission.participating, %loop ]
  %next = sub nuw nsw i64 %iv, 2
  %done = icmp eq i64 %limit, %next
  br i1 %done, label %scalar.fission.consumer.guard, label %loop, !dbg !43, !llvm.loop !44

scalar.fission.consumer.guard:                    ; preds = %latch
  %fission.participating.count = phi i64 [ %fission.participating.merge, %latch ]
  %fission.empty = icmp eq i64 %fission.participating.count, 0
  br i1 %fission.empty, label %scalar.fission.consumer.exit, label %scalar.fission.consumer.ph

scalar.fission.consumer.ph:                       ; preds = %scalar.fission.consumer.guard
  %3 = call i64 @llvm.vscale.i64()
  %4 = shl nuw i64 %3, 2
  %min.iters.check = icmp ult i64 %fission.participating.merge, %4
  br i1 %min.iters.check, label %scalar.ph, label %vector.ph

vector.ph:                                        ; preds = %scalar.fission.consumer.ph
  %5 = shl nuw i64 %3, 2
  %n.mod.vf = urem i64 %fission.participating.merge, %5
  %n.vec = sub i64 %fission.participating.merge, %n.mod.vf
  br label %vector.body

vector.body:                                      ; preds = %vector.body, %vector.ph
  %index5 = phi i64 [ 0, %vector.ph ], [ %index.next, %vector.body ], !dbg !43
  %vec.phi = phi <vscale x 4 x i32> [ insertelement (<vscale x 4 x i32> zeroinitializer, i32 17, i32 0), %vector.ph ], [ %9, %vector.body ]
  %vec.phi6 = phi <vscale x 4 x i32> [ insertelement (<vscale x 4 x i32> zeroinitializer, i32 -7, i32 0), %vector.ph ], [ %10, %vector.body ]
  %vec.phi7 = phi double [ %start, %vector.ph ], [ %11, %vector.body ]
  %vec.phi8 = phi float [ %fstart, %vector.ph ], [ %12, %vector.body ]
  %6 = getelementptr inbounds [65 x i32], ptr %scalar.fission.scratch, i32 0, i64 %index5, !dbg !43
  %wide.load = load <vscale x 4 x i32>, ptr %6, align 4, !dbg !43
  %7 = getelementptr inbounds [65 x double], ptr %scalar.fission.scratch1, i32 0, i64 %index5, !dbg !43
  %wide.load9 = load <vscale x 4 x double>, ptr %7, align 8, !dbg !43
  %8 = getelementptr inbounds [65 x float], ptr %scalar.fission.scratch2, i32 0, i64 %index5, !dbg !43
  %wide.load10 = load <vscale x 4 x float>, ptr %8, align 4, !dbg !43
  %9 = add <vscale x 4 x i32> %vec.phi, %wide.load, !dbg !43
  %10 = add <vscale x 4 x i32> %wide.load, %vec.phi6, !dbg !43
  %11 = call double @llvm.vector.reduce.fadd.nxv4f64(double %vec.phi7, <vscale x 4 x double> %wide.load9), !dbg !43
  %12 = call float @llvm.vector.reduce.fadd.nxv4f32(float %vec.phi8, <vscale x 4 x float> %wide.load10), !dbg !43
  %index.next = add nuw i64 %index5, %5, !dbg !43
  %13 = icmp eq i64 %index.next, %n.vec, !dbg !43
  br i1 %13, label %middle.block, label %vector.body, !dbg !43, !llvm.loop !45

middle.block:                                     ; preds = %vector.body
  %14 = call i32 @llvm.vector.reduce.add.nxv4i32(<vscale x 4 x i32> %9), !dbg !43
  %15 = call i32 @llvm.vector.reduce.add.nxv4i32(<vscale x 4 x i32> %10), !dbg !43
  %cmp.n = icmp eq i64 %fission.participating.merge, %n.vec, !dbg !43
  br i1 %cmp.n, label %scalar.fission.consumer.loopexit, label %scalar.ph, !dbg !43

scalar.ph:                                        ; preds = %scalar.fission.consumer.ph, %middle.block
  %bc.resume.val = phi i64 [ %n.vec, %middle.block ], [ 0, %scalar.fission.consumer.ph ], !dbg !43
  %bc.merge.rdx = phi i32 [ %14, %middle.block ], [ 17, %scalar.fission.consumer.ph ], !dbg !43
  %bc.merge.rdx11 = phi i32 [ %15, %middle.block ], [ -7, %scalar.fission.consumer.ph ], !dbg !43
  %bc.merge.rdx12 = phi double [ %11, %middle.block ], [ %start, %scalar.fission.consumer.ph ], !dbg !43
  %bc.merge.rdx13 = phi float [ %12, %middle.block ], [ %fstart, %scalar.fission.consumer.ph ], !dbg !43
  br label %scalar.fission.consumer.body

scalar.fission.consumer.body:                     ; preds = %scalar.ph, %scalar.fission.consumer.body
  %fission.consumer.iv = phi i64 [ %bc.resume.val, %scalar.ph ], [ %fission.consumer.next, %scalar.fission.consumer.body ], !dbg !43
  %r0.consume = phi i32 [ %bc.merge.rdx, %scalar.ph ], [ %u0.consume, %scalar.fission.consumer.body ], !dbg !43
  %r1.consume = phi i32 [ %bc.merge.rdx11, %scalar.ph ], [ %u1.consume, %scalar.fission.consumer.body ], !dbg !43
  %rd.consume = phi double [ %bc.merge.rdx12, %scalar.ph ], [ %ud.consume, %scalar.fission.consumer.body ], !dbg !43
  %rf.consume = phi float [ %bc.merge.rdx13, %scalar.ph ], [ %uf.consume, %scalar.fission.consumer.body ], !dbg !43
  %16 = getelementptr inbounds [65 x i32], ptr %scalar.fission.scratch, i32 0, i64 %fission.consumer.iv, !dbg !43
  %fission.contribution = load i32, ptr %16, align 4, !dbg !43
  %17 = getelementptr inbounds [65 x double], ptr %scalar.fission.scratch1, i32 0, i64 %fission.consumer.iv, !dbg !43
  %fission.contribution3 = load double, ptr %17, align 8, !dbg !43
  %18 = getelementptr inbounds [65 x float], ptr %scalar.fission.scratch2, i32 0, i64 %fission.consumer.iv, !dbg !43
  %fission.contribution4 = load float, ptr %18, align 4, !dbg !43
  %u0.consume = add i32 %r0.consume, %fission.contribution, !dbg !43
  %u1.consume = add i32 %fission.contribution, %r1.consume, !dbg !43
  %ud.consume = fadd double %rd.consume, %fission.contribution3, !dbg !43
  %uf.consume = fadd float %rf.consume, %fission.contribution4, !dbg !43
  %fission.consumer.next = add nuw i64 %fission.consumer.iv, 1, !dbg !43
  %fission.consumer.more = icmp ne i64 %fission.consumer.next, %fission.participating.count, !dbg !43
  br i1 %fission.consumer.more, label %scalar.fission.consumer.body, label %scalar.fission.consumer.loopexit, !dbg !43, !llvm.loop !46

scalar.fission.consumer.loopexit:                 ; preds = %middle.block, %scalar.fission.consumer.body
  %r0.lcssa = phi i32 [ %u0.consume, %scalar.fission.consumer.body ], [ %14, %middle.block ]
  %r1.lcssa = phi i32 [ %u1.consume, %scalar.fission.consumer.body ], [ %15, %middle.block ]
  %rd.lcssa = phi double [ %ud.consume, %scalar.fission.consumer.body ], [ %11, %middle.block ]
  %rf.lcssa = phi float [ %uf.consume, %scalar.fission.consumer.body ], [ %12, %middle.block ]
  br label %scalar.fission.consumer.exit

scalar.fission.consumer.exit:                     ; preds = %scalar.fission.consumer.loopexit, %scalar.fission.consumer.guard
  %r0.result = phi i32 [ 17, %scalar.fission.consumer.guard ], [ %r0.lcssa, %scalar.fission.consumer.loopexit ]
  %r1.result = phi i32 [ -7, %scalar.fission.consumer.guard ], [ %r1.lcssa, %scalar.fission.consumer.loopexit ]
  %rd.result = phi double [ %start, %scalar.fission.consumer.guard ], [ %rd.lcssa, %scalar.fission.consumer.loopexit ]
  %rf.result = phi float [ %fstart, %scalar.fission.consumer.guard ], [ %rf.lcssa, %scalar.fission.consumer.loopexit ]
  br label %exit.loopexit

exit.loopexit:                                    ; preds = %scalar.fission.consumer.exit
  %m0.lcssa = phi i32 [ %r0.result, %scalar.fission.consumer.exit ]
  %m1.lcssa = phi i32 [ %r1.result, %scalar.fission.consumer.exit ]
  %md.lcssa = phi double [ %rd.result, %scalar.fission.consumer.exit ]
  %mf.lcssa = phi float [ %rf.result, %scalar.fission.consumer.exit ]
  br label %exit

exit:                                             ; preds = %exit.loopexit, %entry
  %v0 = phi i32 [ 17, %entry ], [ %m0.lcssa, %exit.loopexit ]
  %v1 = phi i32 [ -7, %entry ], [ %m1.lcssa, %exit.loopexit ]
  %vd = phi double [ %start, %entry ], [ %md.lcssa, %exit.loopexit ]
  %vf = phi float [ %fstart, %entry ], [ %mf.lcssa, %exit.loopexit ]
  %o1 = getelementptr i32, ptr %out, i64 1
  store i32 %v0, ptr %out, align 4
  store i32 %v1, ptr %o1, align 4
  store double %vd, ptr %dout, align 8
  store float %vf, ptr %fout, align 4
  ret void
}

#--- lv2.ll
; Retained t000032 actual LV2 scalar-remainder output, fixture-only.
define void @affine_compact(ptr readonly %a, ptr readonly %fp, ptr %out, ptr %dout, ptr %fout, i64 %n, double %start, i64 %begin) #1 !dbg !42 {
entry:
  %scalar.fission.scratch = alloca [65 x i32], align 4
  %scalar.fission.scratch1 = alloca [65 x double], align 8
  %scalar.fission.scratch2 = alloca [65 x float], align 4
  %valid = icmp ule i64 %n, 65
  %nonzero = icmp ne i64 %n, 0
  %enter = and i1 %valid, %nonzero
  %fstart = fptrunc double %start to float
  br i1 %enter, label %preheader, label %exit

preheader:                                        ; preds = %entry
  %span = shl nuw nsw i64 %n, 1
  %limit = sub nuw nsw i64 137, %span
  br label %loop, !dbg !43

loop:                                             ; preds = %latch, %preheader
  %fission.participating = phi i64 [ 0, %preheader ], [ %fission.participating.merge, %latch ]
  %iv = phi i64 [ 137, %preheader ], [ %next, %latch ]
  %distance = sub nuw nsw i64 137, %iv
  %index = lshr i64 %distance, 1
  %p = getelementptr i32, ptr %a, i64 %index
  %x = load i32, ptr %p, align 4
  %choose = icmp ne i32 %x, 0
  br i1 %choose, label %left, label %latch, !dbg !43

left:                                             ; preds = %loop
  %q = sdiv i32 840, %x
  %lc = call i32 @scalar_helper(i32 %q)
  %dp = getelementptr double, ptr %fp, i64 %index
  %dc = load double, ptr %dp, align 8
  %fc = fptrunc double %dc to float
  %fission.participating.next = add nuw i64 %fission.participating, 1
  %0 = getelementptr inbounds [65 x i32], ptr %scalar.fission.scratch, i32 0, i64 %fission.participating
  store i32 %lc, ptr %0, align 4
  %1 = getelementptr inbounds [65 x double], ptr %scalar.fission.scratch1, i32 0, i64 %fission.participating
  store double %dc, ptr %1, align 8
  %2 = getelementptr inbounds [65 x float], ptr %scalar.fission.scratch2, i32 0, i64 %fission.participating
  store float %fc, ptr %2, align 4
  br label %latch

latch:                                            ; preds = %left, %loop
  %fission.participating.merge = phi i64 [ %fission.participating.next, %left ], [ %fission.participating, %loop ]
  %next = sub nuw nsw i64 %iv, 2
  %done = icmp eq i64 %limit, %next
  br i1 %done, label %scalar.fission.consumer.guard, label %loop, !dbg !43, !llvm.loop !44

scalar.fission.consumer.guard:                    ; preds = %latch
  %fission.participating.merge.lcssa = phi i64 [ %fission.participating.merge, %latch ]
  %fission.participating.count = phi i64 [ %fission.participating.merge, %latch ]
  %fission.empty = icmp eq i64 %fission.participating.count, 0
  br i1 %fission.empty, label %scalar.fission.consumer.exit, label %scalar.fission.consumer.ph

scalar.fission.consumer.ph:                       ; preds = %scalar.fission.consumer.guard
  %3 = call i64 @llvm.vscale.i64()
  %4 = shl nuw i64 %3, 2
  %min.iters.check = icmp ult i64 %fission.participating.merge.lcssa, %4
  br i1 %min.iters.check, label %scalar.ph, label %vector.ph

vector.ph:                                        ; preds = %scalar.fission.consumer.ph
  %5 = shl nuw i64 %3, 2
  %n.mod.vf = urem i64 %fission.participating.merge.lcssa, %5
  %n.vec = sub i64 %fission.participating.merge.lcssa, %n.mod.vf
  br label %vector.body

vector.body:                                      ; preds = %vector.body, %vector.ph
  %index5 = phi i64 [ 0, %vector.ph ], [ %index.next, %vector.body ], !dbg !43
  %vec.phi = phi <vscale x 4 x i32> [ insertelement (<vscale x 4 x i32> zeroinitializer, i32 17, i32 0), %vector.ph ], [ %9, %vector.body ]
  %vec.phi6 = phi <vscale x 4 x i32> [ insertelement (<vscale x 4 x i32> zeroinitializer, i32 -7, i32 0), %vector.ph ], [ %10, %vector.body ]
  %vec.phi7 = phi double [ %start, %vector.ph ], [ %11, %vector.body ]
  %vec.phi8 = phi float [ %fstart, %vector.ph ], [ %12, %vector.body ]
  %6 = getelementptr inbounds [65 x i32], ptr %scalar.fission.scratch, i32 0, i64 %index5, !dbg !43
  %wide.load = load <vscale x 4 x i32>, ptr %6, align 4, !dbg !43
  %7 = getelementptr inbounds [65 x double], ptr %scalar.fission.scratch1, i32 0, i64 %index5, !dbg !43
  %wide.load9 = load <vscale x 4 x double>, ptr %7, align 8, !dbg !43
  %8 = getelementptr inbounds [65 x float], ptr %scalar.fission.scratch2, i32 0, i64 %index5, !dbg !43
  %wide.load10 = load <vscale x 4 x float>, ptr %8, align 4, !dbg !43
  %9 = add <vscale x 4 x i32> %vec.phi, %wide.load, !dbg !43
  %10 = add <vscale x 4 x i32> %wide.load, %vec.phi6, !dbg !43
  %11 = call double @llvm.vector.reduce.fadd.nxv4f64(double %vec.phi7, <vscale x 4 x double> %wide.load9), !dbg !43
  %12 = call float @llvm.vector.reduce.fadd.nxv4f32(float %vec.phi8, <vscale x 4 x float> %wide.load10), !dbg !43
  %index.next = add nuw i64 %index5, %5, !dbg !43
  %13 = icmp eq i64 %index.next, %n.vec, !dbg !43
  br i1 %13, label %middle.block, label %vector.body, !dbg !43, !llvm.loop !45

middle.block:                                     ; preds = %vector.body
  %.lcssa16 = phi <vscale x 4 x i32> [ %9, %vector.body ], !dbg !43
  %.lcssa15 = phi <vscale x 4 x i32> [ %10, %vector.body ], !dbg !43
  %.lcssa14 = phi double [ %11, %vector.body ], !dbg !43
  %.lcssa = phi float [ %12, %vector.body ], !dbg !43
  %14 = call i32 @llvm.vector.reduce.add.nxv4i32(<vscale x 4 x i32> %.lcssa16), !dbg !43
  %15 = call i32 @llvm.vector.reduce.add.nxv4i32(<vscale x 4 x i32> %.lcssa15), !dbg !43
  %cmp.n = icmp eq i64 %fission.participating.merge.lcssa, %n.vec, !dbg !43
  br i1 %cmp.n, label %scalar.fission.consumer.loopexit, label %scalar.ph, !dbg !43

scalar.ph:                                        ; preds = %scalar.fission.consumer.ph, %middle.block
  %bc.resume.val = phi i64 [ %n.vec, %middle.block ], [ 0, %scalar.fission.consumer.ph ], !dbg !43
  %bc.merge.rdx = phi i32 [ %14, %middle.block ], [ 17, %scalar.fission.consumer.ph ], !dbg !43
  %bc.merge.rdx11 = phi i32 [ %15, %middle.block ], [ -7, %scalar.fission.consumer.ph ], !dbg !43
  %bc.merge.rdx12 = phi double [ %.lcssa14, %middle.block ], [ %start, %scalar.fission.consumer.ph ], !dbg !43
  %bc.merge.rdx13 = phi float [ %.lcssa, %middle.block ], [ %fstart, %scalar.fission.consumer.ph ], !dbg !43
  br label %scalar.fission.consumer.body

scalar.fission.consumer.body:                     ; preds = %scalar.ph, %scalar.fission.consumer.body
  %fission.consumer.iv = phi i64 [ %bc.resume.val, %scalar.ph ], [ %fission.consumer.next, %scalar.fission.consumer.body ], !dbg !43
  %r0.consume = phi i32 [ %bc.merge.rdx, %scalar.ph ], [ %u0.consume, %scalar.fission.consumer.body ], !dbg !43
  %r1.consume = phi i32 [ %bc.merge.rdx11, %scalar.ph ], [ %u1.consume, %scalar.fission.consumer.body ], !dbg !43
  %rd.consume = phi double [ %bc.merge.rdx12, %scalar.ph ], [ %ud.consume, %scalar.fission.consumer.body ], !dbg !43
  %rf.consume = phi float [ %bc.merge.rdx13, %scalar.ph ], [ %uf.consume, %scalar.fission.consumer.body ], !dbg !43
  %16 = getelementptr inbounds [65 x i32], ptr %scalar.fission.scratch, i32 0, i64 %fission.consumer.iv, !dbg !43
  %fission.contribution = load i32, ptr %16, align 4, !dbg !43
  %17 = getelementptr inbounds [65 x double], ptr %scalar.fission.scratch1, i32 0, i64 %fission.consumer.iv, !dbg !43
  %fission.contribution3 = load double, ptr %17, align 8, !dbg !43
  %18 = getelementptr inbounds [65 x float], ptr %scalar.fission.scratch2, i32 0, i64 %fission.consumer.iv, !dbg !43
  %fission.contribution4 = load float, ptr %18, align 4, !dbg !43
  %u0.consume = add i32 %r0.consume, %fission.contribution, !dbg !43
  %u1.consume = add i32 %fission.contribution, %r1.consume, !dbg !43
  %ud.consume = fadd double %rd.consume, %fission.contribution3, !dbg !43
  %uf.consume = fadd float %rf.consume, %fission.contribution4, !dbg !43
  %fission.consumer.next = add nuw i64 %fission.consumer.iv, 1, !dbg !43
  %fission.consumer.more = icmp ne i64 %fission.consumer.next, %fission.participating.count, !dbg !43
  br i1 %fission.consumer.more, label %scalar.fission.consumer.body, label %scalar.fission.consumer.loopexit.loopexit, !dbg !43, !llvm.loop !46

scalar.fission.consumer.loopexit.loopexit:        ; preds = %scalar.fission.consumer.body
  %u0.consume.lcssa = phi i32 [ %u0.consume, %scalar.fission.consumer.body ], !dbg !43
  %u1.consume.lcssa = phi i32 [ %u1.consume, %scalar.fission.consumer.body ], !dbg !43
  %ud.consume.lcssa = phi double [ %ud.consume, %scalar.fission.consumer.body ], !dbg !43
  %uf.consume.lcssa = phi float [ %uf.consume, %scalar.fission.consumer.body ], !dbg !43
  br label %scalar.fission.consumer.loopexit

scalar.fission.consumer.loopexit:                 ; preds = %scalar.fission.consumer.loopexit.loopexit, %middle.block
  %r0.lcssa = phi i32 [ %14, %middle.block ], [ %u0.consume.lcssa, %scalar.fission.consumer.loopexit.loopexit ]
  %r1.lcssa = phi i32 [ %15, %middle.block ], [ %u1.consume.lcssa, %scalar.fission.consumer.loopexit.loopexit ]
  %rd.lcssa = phi double [ %.lcssa14, %middle.block ], [ %ud.consume.lcssa, %scalar.fission.consumer.loopexit.loopexit ]
  %rf.lcssa = phi float [ %.lcssa, %middle.block ], [ %uf.consume.lcssa, %scalar.fission.consumer.loopexit.loopexit ]
  br label %scalar.fission.consumer.exit

scalar.fission.consumer.exit:                     ; preds = %scalar.fission.consumer.loopexit, %scalar.fission.consumer.guard
  %r0.result = phi i32 [ 17, %scalar.fission.consumer.guard ], [ %r0.lcssa, %scalar.fission.consumer.loopexit ]
  %r1.result = phi i32 [ -7, %scalar.fission.consumer.guard ], [ %r1.lcssa, %scalar.fission.consumer.loopexit ]
  %rd.result = phi double [ %start, %scalar.fission.consumer.guard ], [ %rd.lcssa, %scalar.fission.consumer.loopexit ]
  %rf.result = phi float [ %fstart, %scalar.fission.consumer.guard ], [ %rf.lcssa, %scalar.fission.consumer.loopexit ]
  br label %exit.loopexit

exit.loopexit:                                    ; preds = %scalar.fission.consumer.exit
  %m0.lcssa = phi i32 [ %r0.result, %scalar.fission.consumer.exit ]
  %m1.lcssa = phi i32 [ %r1.result, %scalar.fission.consumer.exit ]
  %md.lcssa = phi double [ %rd.result, %scalar.fission.consumer.exit ]
  %mf.lcssa = phi float [ %rf.result, %scalar.fission.consumer.exit ]
  br label %exit

exit:                                             ; preds = %exit.loopexit, %entry
  %v0 = phi i32 [ 17, %entry ], [ %m0.lcssa, %exit.loopexit ]
  %v1 = phi i32 [ -7, %entry ], [ %m1.lcssa, %exit.loopexit ]
  %vd = phi double [ %start, %entry ], [ %md.lcssa, %exit.loopexit ]
  %vf = phi float [ %fstart, %entry ], [ %mf.lcssa, %exit.loopexit ]
  %o1 = getelementptr i32, ptr %out, i64 1
  store i32 %v0, ptr %out, align 4
  store i32 %v1, ptr %o1, align 4
  store double %vd, ptr %dout, align 8
  store float %vf, ptr %fout, align 4
  ret void
}
