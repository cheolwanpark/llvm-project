# REQUIRES: riscv-registered-target
# RUN: split-file %s %t
# RUN: opt -passes='loop-vectorize,verify<domtree>,verify<loops>,verify<scalar-evolution>' -verify-each \
# RUN:   -mtriple=riscv64 -mattr=+v -force-vector-width=4 -force-vector-interleave=1 \
# RUN:   -scalable-vectorization=always -hints-allow-reordering=false \
# RUN:   -enable-vplan-reduction-fission -tail-folding-policy=dont-fold-tail \
# RUN:   -enable-epilogue-vectorization=false -S %S/../Transforms/LoopVectorize/RISCV/reduction-fission-scalar-state-cfg.ll -o %t.once.ll
# RUN: opt -passes='loop-vectorize,loop-vectorize,verify<domtree>,verify<loops>,verify<scalar-evolution>' -verify-each \
# RUN:   -mtriple=riscv64 -mattr=+v -force-vector-width=4 -force-vector-interleave=1 \
# RUN:   -scalable-vectorization=always -hints-allow-reordering=false \
# RUN:   -enable-vplan-reduction-fission -vplan-reduction-fission-allow-fp-reordering \
# RUN:   -tail-folding-policy=dont-fold-tail -enable-epilogue-vectorization=false \
# RUN:   -S %S/../Transforms/LoopVectorize/RISCV/reduction-fission-scalar-state-cfg.ll -o %t.twice.ll
# RUN: opt -passes='loop-vectorize,verify<domtree>,verify<loops>,verify<scalar-evolution>' -verify-each \
# RUN:   -mtriple=riscv64 -mattr=+v -force-vector-width=4 -force-vector-interleave=1 \
# RUN:   -scalable-vectorization=always -hints-allow-reordering=false -enable-vplan-reduction-fission \
# RUN:   -S %S/../Transforms/LoopVectorize/RISCV/reduction-fission-scalar-state-cfg.ll -o %t.once.evl.ll
# RUN: opt -passes='loop-vectorize,loop-vectorize,verify<domtree>,verify<loops>,verify<scalar-evolution>' -verify-each \
# RUN:   -mtriple=riscv64 -mattr=+v -force-vector-width=1 -force-vector-interleave=0 \
# RUN:   -force-target-max-scalar-interleave=1 -scalable-vectorization=off -enable-vplan-reduction-fission \
# RUN:   -S %S/../Transforms/LoopVectorize/RISCV/reduction-fission-scalar-state-cfg.ll -o %t.twice.scalar.ll
# RUN: %python %t/check.py %S/../../utils/check-reduction-fission.py \
# RUN:   %S/../Transforms/LoopVectorize/RISCV/reduction-fission-scalar-state-cfg.ll \
# RUN:   %t.once.ll %t.twice.ll %t.once.evl.ll %t.twice.scalar.ll

# This adds interaction mutations; all inherited recurrence, CFG, count,
# result, export, chunk and host-adapter mutation fixtures remain mandatory.
# The host comparison matrix separately executes actual original/transformed
# IR and independent C under both policies and once/twice LV.
# Its focused N=3 cases use literal participation masks/final states, including
# pattern=1 with Rows=2. Affine must participate after right1 makes state even;
# serial/nested must skip nonzero inputs when state is even. Whole-state
# comparisons retain reductions, exports and canaries; a final-arm probe also
# covers nonzero final inputs skipped by parity. The full inherited execution
# matrix and its scalar/vector entry, alias and bypass assertions remain.

#--- check.py
import importlib.util
from pathlib import Path
import re
import sys

sys.dont_write_bytecode = True
spec = importlib.util.spec_from_file_location('checker', sys.argv[1])
checker = importlib.util.module_from_spec(spec)
sys.modules[spec.name] = checker
spec.loader.exec_module(checker)
source = Path(sys.argv[2]).read_text()

# Pin the distinct ORIGINAL semantic contracts. Never change these fixtures to
# match the former overbroad state-bit oracle. State contributes in all three,
# but rows selects participation only in serial/nested, and affine updates on
# right1 alone. The original retained state, not the last participant, exports.
for name in checker.STATE_CFG_FUNCTIONS:
    original = checker.function_definition(source, name)
    blocks = checker.loop_blocks(original)
    assert '%state.arg = xor i32 %arg, %state' in blocks['left']
    assert '%out.c.copy = phi i32 [%state.merge, %latch]' in blocks['producer.exit']
    update_edge = 'right1' if name == 'state_cfg_affine' else 'right'
    assert '%state.next = add i32 %state, %state.delta' in blocks[update_edge]
    assert original.count('%state.next = add i32') == 1
    if name == 'state_cfg_affine':
        assert '%choose = icmp eq i32 %x, 0' in blocks['loop']
        assert 'br i1 %choose, label %inactive.dispatch, label %active.entry' in blocks['loop']
        assert '%state.choose' not in original and '%state.mode' not in original
        assert ('%state.merge = phi i32 [%state, %right2], [%state, %left], '
                '[%state, %right], [%state.next, %right1]') in blocks['latch']
    else:
        assert '%state.mode = icmp eq i64 %rows, 2' in blocks['loop']
        assert '%state.choose = and i1 %nonzero.x, %state.odd' in blocks['loop']
        assert ('%choose = select i1 %state.mode, i1 %state.choose, '
                'i1 %nonzero.x') in blocks['loop']
        assert '%state.merge = phi i32 [%state, %left], [%state.next, %right]' in blocks['latch']


# Completed focused comparisons are reported separately from generated/planned
# cases. A missing variant, duplicate, wrong count or substituted name rejects.
names = ['state_cfg_serial_once', 'state_cfg_affine_twice']
stdout = ''.join(f'State CFG participation {name}: comparisons=28 rows=2 cases=7\n'
                 for name in names)
assert checker.state_cfg_execution_counts(stdout, names) == {
    'completed_comparisons': 56, 'configurations': dict.fromkeys(names, 28),
}
for bad in (stdout.splitlines()[0] + '\n', stdout + stdout,
            stdout.replace('comparisons=28', 'comparisons=27', 1),
            stdout.replace('rows=2', 'rows=1', 1),
            stdout.replace('cases=7', 'cases=6', 1),
            stdout.replace(names[1], 'compact_cfg_affine_twice')):
    try:
        checker.state_cfg_execution_counts(bad, names)
    except AssertionError as error:
        assert 'state CFG execution:' in str(error), error
    else:
        raise AssertionError('accepted incomplete/substituted focused execution')


def definition(text, value, old, new):
    pattern = r'^  %' + re.escape(value) + r' = [^\n]*$'
    matches = list(re.finditer(pattern, text, re.M))
    assert len(matches) == 1, value
    line = matches[0]
    assert line[0].count(old) == 1, (value, old, line[0])
    return text[:line.start()] + line[0].replace(old, new, 1) + text[line.end():]


for path in sys.argv[3:]:
    module = Path(path).read_text()
    evl, scalar = '.evl.' in path, '.scalar.' in path
    for name in checker.STATE_CFG_FUNCTIONS:
        body = checker.function_definition(module, name)
        assert checker.check_producer_exports(module, name, evl, source=source, scalar=scalar) == body
        if not evl:
            probed = checker.check_producer_exports(module, name, evl, source=source,
                                                     scalar=scalar, probe=True)
            assert probed.count('call void @record_compact_participant()') == 1
            assert probed.count('call void @record_scalar_consumer_tail()') == 1

        def reject(candidate, obligation):
            try:
                checker.check_producer_exports(module.replace(body, candidate, 1), name,
                                               evl, source=source, scalar=scalar)
            except AssertionError as error:
                assert obligation in str(error), (name, obligation, error)
            else:
                raise AssertionError(name + ': accepted ' + obligation)

        # Retained state is observable in the predicate/contribution/export.
        # It cannot be deleted, reseeded, moved to a different path, changed
        # to read moved state, or reordered ahead of its conditional delta.
        reject(definition(body, 'state', '[ 23,', '[ 0,'), 'export control:')
        reject(definition(body, 'state.next', '%state,', '%fission.participating,'), 'export control:')
        reject(definition(body, 'state.next', '%state.delta', '%r0.consume'), 'export control:')
        reject(definition(body, 'state.merge', '%state.next,', '%state,'), 'export control:')
        if name == 'state_cfg_affine':
            # This fixture branches directly on x == 0. Mutate its actual
            # predicate, rather than failing to construct a select mutation.
            reject(definition(body, 'choose', 'icmp eq i32 %x, 0',
                              'icmp ne i32 %x, 0'), 'export control:')
        else:
            reject(definition(body, 'choose', '%state.choose,', '%nonzero.x,'), 'export control:')
        reject(definition(body, 'state.arg', ', %state', ', %x'), 'export control:')
        delta = re.search(r'^  %state.delta = [^\n]*\n', body, re.M)[0]
        update = re.search(r'^  %state.next = [^\n]*\n', body, re.M)[0]
        assert delta + update in body
        reject(body.replace(delta + update, update + delta, 1), 'retained state order/path:')
        reject(definition(body, 'state.merge.fission.export', '%state.merge,', '%state,'), 'producer export c.copy:')
        reject(definition(body, 'out.c.copy', '%state.merge.fission.export', '%c.fission.export'), 'producer export c.copy:')
        # Every bypass carries old P, including the edge that updates state.
        producer, _ = checker.scalar_consumer(body, name)
        for edge in checker.check_compact_cfg_producer(producer, name):
            reject(definition(body, 'fission.participating.merge',
                              '[ %fission.participating, %' + edge + ' ]',
                              '[ %fission.participating.next, %' + edge + ' ]'),
                   'latch participation value/edge')
        reject(definition(body, 'r0.result', '[ 17,', '[ 0,'), 'empty-stream start value/edge')
        if not evl:
            for step in ('0', '2', '-1'):
                reject(definition(body, 'fission.consumer.next', ', 1', ', ' + step),
                       'producer export:')
            bound = re.search(r'%fission.consumer.more = icmp ne i64 %fission.consumer.next, (%[-\w.$]+)', body)[1]
            reject(definition(body, 'fission.consumer.more', ', ' + bound, ', %n'), 'compact count provenance:')

print('PASS: retained state / compact CFG / final export interaction certificates')
