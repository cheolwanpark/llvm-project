# REQUIRES: riscv-registered-target
# RUN: split-file %s %t
# RUN: opt -passes='loop-vectorize,verify<domtree>,verify<loops>,verify<scalar-evolution>' -verify-each -mtriple=riscv64 -mattr=+v -force-vector-interleave=1 -scalable-vectorization=always -hints-allow-reordering=false -enable-vplan-reduction-fission -vplan-reduction-fission-force-producer-vf=2 -vplan-reduction-fission-force-accumulator-vf=4 -pass-remarks=vplan-reduction-fission -S %S/../Transforms/LoopVectorize/RISCV/reduction-fission-dispatch.ll -o %t.once.evl.ll 2> %t.once.evl.ll.remarks
# RUN: opt -passes='loop-vectorize,loop-vectorize,verify<domtree>,verify<loops>,verify<scalar-evolution>' -verify-each -mtriple=riscv64 -mattr=+v -force-vector-interleave=1 -scalable-vectorization=always -hints-allow-reordering=false -enable-vplan-reduction-fission -vplan-reduction-fission-allow-fp-reordering -vplan-reduction-fission-force-producer-vf=2 -vplan-reduction-fission-force-accumulator-vf=4 -pass-remarks=vplan-reduction-fission -S %S/../Transforms/LoopVectorize/RISCV/reduction-fission-dispatch.ll -o %t.twice.evl.ll 2> %t.twice.evl.ll.remarks
# RUN: opt -passes='loop-vectorize,verify<domtree>,verify<loops>,verify<scalar-evolution>' -verify-each -mtriple=riscv64 -mattr=+v -force-vector-interleave=1 -scalable-vectorization=always -hints-allow-reordering=false -enable-vplan-reduction-fission -tail-folding-policy=dont-fold-tail -enable-epilogue-vectorization=false -vplan-reduction-fission-force-producer-vf=2 -vplan-reduction-fission-force-accumulator-vf=4 -pass-remarks=vplan-reduction-fission -S %S/../Transforms/LoopVectorize/RISCV/reduction-fission-dispatch.ll -o %t.once.tail.ll 2> %t.once.tail.ll.remarks
# RUN: opt -passes='loop-vectorize,loop-vectorize,verify<domtree>,verify<loops>,verify<scalar-evolution>' -verify-each -mtriple=riscv64 -mattr=+v -force-vector-interleave=1 -scalable-vectorization=always -hints-allow-reordering=false -enable-vplan-reduction-fission -vplan-reduction-fission-allow-fp-reordering -tail-folding-policy=dont-fold-tail -enable-epilogue-vectorization=false -vplan-reduction-fission-force-producer-vf=2 -vplan-reduction-fission-force-accumulator-vf=4 -pass-remarks=vplan-reduction-fission -S %S/../Transforms/LoopVectorize/RISCV/reduction-fission-dispatch.ll -o %t.twice.tail.ll 2> %t.twice.tail.ll.remarks
# RUN: opt -passes='loop-vectorize,verify<domtree>,verify<loops>,verify<scalar-evolution>' -verify-each -mtriple=riscv64 -mattr=+v -force-vector-interleave=1 -scalable-vectorization=always -hints-allow-reordering=false -vplan-reduction-fission-allow-fp-reordering -enable-vplan-reduction-fission -vplan-reduction-fission-force-producer-vf=2 -vplan-reduction-fission-force-accumulator-vf=4 -pass-remarks=vplan-reduction-fission -S %S/../Transforms/LoopVectorize/RISCV/reduction-fission-dispatch.ll -o %t.once.reordered.evl.ll 2> %t.once.reordered.evl.ll.remarks
# RUN: opt -passes='loop-vectorize,loop-vectorize,verify<domtree>,verify<loops>,verify<scalar-evolution>' -verify-each -mtriple=riscv64 -mattr=+v -force-vector-interleave=1 -scalable-vectorization=always -hints-allow-reordering=false -enable-vplan-reduction-fission -vplan-reduction-fission-force-producer-vf=2 -vplan-reduction-fission-force-accumulator-vf=4 -pass-remarks=vplan-reduction-fission -S %S/../Transforms/LoopVectorize/RISCV/reduction-fission-dispatch.ll -o %t.twice.strict.evl.ll 2> %t.twice.strict.evl.ll.remarks
# RUN: opt -passes='loop-vectorize,verify<domtree>,verify<loops>,verify<scalar-evolution>' -verify-each -mtriple=riscv64 -mattr=+v -force-vector-interleave=1 -scalable-vectorization=always -hints-allow-reordering=false -vplan-reduction-fission-allow-fp-reordering -enable-vplan-reduction-fission -tail-folding-policy=dont-fold-tail -enable-epilogue-vectorization=false -vplan-reduction-fission-force-producer-vf=2 -vplan-reduction-fission-force-accumulator-vf=4 -pass-remarks=vplan-reduction-fission -S %S/../Transforms/LoopVectorize/RISCV/reduction-fission-dispatch.ll -o %t.once.reordered.tail.ll 2> %t.once.reordered.tail.ll.remarks
# RUN: opt -passes='loop-vectorize,loop-vectorize,verify<domtree>,verify<loops>,verify<scalar-evolution>' -verify-each -mtriple=riscv64 -mattr=+v -force-vector-interleave=1 -scalable-vectorization=always -hints-allow-reordering=false -enable-vplan-reduction-fission -tail-folding-policy=dont-fold-tail -enable-epilogue-vectorization=false -vplan-reduction-fission-force-producer-vf=2 -vplan-reduction-fission-force-accumulator-vf=4 -pass-remarks=vplan-reduction-fission -S %S/../Transforms/LoopVectorize/RISCV/reduction-fission-dispatch.ll -o %t.twice.strict.tail.ll 2> %t.twice.strict.tail.ll.remarks
# RUN: %python %t/check.py %S/../../utils/check-reduction-fission.py %t.once.evl.ll %t.twice.evl.ll %t.once.tail.ll %t.twice.tail.ll %t.once.reordered.evl.ll %t.twice.strict.evl.ll %t.once.reordered.tail.ll %t.twice.strict.tail.ll

# Check the actual default-dispatch stages, not a synthetic VPlan substitute.
# Every mutation must construct successfully and reach its intended certificate.
# Linked execution and independent sum/XOR formulas remain harness obligations.

#--- check.py
import importlib.util
from pathlib import Path
import re
import sys

sys.dont_write_bytecode = True
spec = importlib.util.spec_from_file_location('checker', sys.argv[1])
checker = importlib.util.module_from_spec(spec)
sys.modules[spec.name] = checker
spec.loader.exec_module(checker)


def replace_one(text, old, new):
    assert old != new and old in text, ('missing mutation anchor', old)
    changed = text.replace(old, new, 1)
    assert changed != text
    return changed


def substitute(text, pattern, replacement, count=1):
    changed, sites = re.subn(pattern, replacement, text, count=count)
    assert sites and changed != text, ('missing mutation anchor', pattern)
    return changed


def entry_checks(body, widths, tails):
    tail_widths = [tail['vf'] for tail in tails]

    def certify(candidate):
        return checker.dispatch_entry_certificates(candidate, *widths, tail_widths)

    def reject(candidate):
        assert candidate != body, 'entry mutation was not constructed'
        try:
            certify(candidate)
        except AssertionError as error:
            assert 'dispatch entry:' in str(error), error
        else:
            raise AssertionError('accepted dispatch entry mutation')

    entries = certify(body)
    blocks = checker.loop_blocks(body)
    without_flags = substitute(body, r'\b(shl|mul|add) (?:nuw nsw|nuw|nsw) i64 ',
                               r'\1 i64 ', count=0)
    assert certify(without_flags) == entries
    # Moving XOR changes stage costs. Derive each actual cost floor from its
    # certified max(VF, floor), keeping exact entry and mutation obligations.
    minima = [stage['primary']['minimum'] for stage in entries]
    assert all(not stage['ordinary'] or stage['ordinary']['minimum'] == 0 for stage in entries)
    assert checker.dispatch_entry_fields(entries) == f'{minima[0]}, {minima[1]}, 0, 0'
    debug_width_mutations = 0
    for stage in entries:
        for part in ('primary', 'ordinary'):
            cert = stage[part]
            if not cert:
                continue
            code = blocks[cert['guard']]
            cmp = re.search(r'(%[-\w.$]+) = icmp ult i64 ' + re.escape(cert['count']) +
                            ', ' + re.escape(cert['threshold']), code)
            assert cmp
            branch = re.search(r'br i1 ' + re.escape(cmp[1]) +
                               r', label %([-\w.$]+), label %([-\w.$]+)', code)
            assert branch
            scalar_target, vector_target = branch.groups()

            def replace_guard(candidate):
                assert candidate != code
                return replace_one(body, code, candidate)

            # Both logically equivalent operand order and complemented
            # comparison/branch forms must certify the same entry minimum.
            swapped = replace_one(code, cmp[0], f'{cmp[1]} = icmp ugt i64 '
                                  f'{cert["threshold"]}, {cert["count"]}')
            assert certify(replace_guard(swapped)) == entries
            inverted = replace_one(replace_one(code, 'icmp ult i64', 'icmp uge i64'),
                branch[0], f'br i1 {cmp[1]}, label %{vector_target}, label %{scalar_target}')
            assert certify(replace_guard(inverted)) == entries
            inverted = replace_one(replace_one(code, cmp[0], f'{cmp[1]} = icmp ule i64 '
                                    f'{cert["threshold"]}, {cert["count"]}'),
                branch[0], f'br i1 {cmp[1]}, label %{vector_target}, label %{scalar_target}')
            assert certify(replace_guard(inverted)) == entries
            # Changing only one half of either equivalent spelling is wrong.
            reject(replace_guard(replace_one(code, 'icmp ult i64', 'icmp uge i64')))
            reject(replace_guard(replace_one(code, 'icmp ult i64', 'icmp ugt i64')))
            reject(replace_guard(replace_one(code, branch[0], f'br i1 {cmp[1]}, '
                                             f'label %{vector_target}, label %{scalar_target}')))
            reject(replace_guard(replace_one(code, 'label %' + vector_target, 'label %bypass')))
            reject(replace_guard(replace_one(code, cmp[0], f'{cmp[1]} = icmp ult i64 '
                                             f'{cert["count"]}, {cert["count"]}')))
            reject(replace_guard(replace_one(code, cmp[0], f'{cmp[1]} = icmp ult i64 '
                                             f'{cert["threshold"]}, {cert["threshold"]}')))
            # Nonpositive/foreign max operands and wrong vscale multipliers
            # must fail even if the primary guard SSA is shared by both stages.
            definition = re.search(r'^  ' + re.escape(cert['threshold']) + r' = (.+)$', body, re.M)
            assert definition
            # Consumer definitions carry their original source coordinate.
            # Preserve it while changing operands; do not mistake !dbg's ID
            # for the width, or skip the max-floor checks when it is attached.
            maximum = re.fullmatch(r'call i64 @llvm\.umax\.i64\(i64 (%[-\w.$]+), i64 (\d+)\)'
                                   r'(, !dbg !\d+)?',
                                   definition[1])
            if maximum:
                changed = replace_one(body, definition[0], replace_one(
                    definition[0], ', i64 ' + maximum[2] + ')', ', i64 0)'))
                reject(changed)
                reject(replace_one(body, definition[0], replace_one(
                    definition[0], 'i64 ' + maximum[1] + ',', 'i64 %n,')))
                analogous = replace_one(body, definition[0], f'  {cert["threshold"]} = '
                                         f'call i64 @llvm.umax.i64(i64 {maximum[2]}, i64 {maximum[1]})'
                                         + (maximum[3] or ''))
                assert certify(analogous) == entries
                width_value = maximum[1]
            else:
                width_value = cert['threshold']
            width = re.search(r'^  ' + re.escape(width_value) +
                              r' = (shl|mul) (?:nuw )?(?:nsw )?i64 (%[-\w.$]+), (\d+)'
                              r'(, !dbg !\d+)?$', body, re.M)
            assert width, (width_value, definition[0])
            assert (1 << int(width[3]) if width[1] == 'shl' else int(width[3])) == cert['vf']
            # Splice only the captured arithmetic operand, even with metadata.
            start, end = width.start(3) - width.start(), width.end(3) - width.start()
            changed = width[0][:start] + str(int(width[3]) + 1) + width[0][end:]
            assert changed != width[0] and changed.endswith(width[0][end:])
            debug_width_mutations += bool(width[4])
            reject(replace_one(body, width[0], changed))
            for flags in ('', 'nuw ', 'nsw ', 'nuw nsw '):
                analogous = (f'  {width_value} = mul {flags}i64 {width[2]}, {cert["vf"]}'
                             + (width[4] or ''))
                if analogous != width[0]:
                    assert certify(replace_one(body, width[0], analogous)) == entries
            reject(replace_one(body, width[0], replace_one(width[0], width[2] + ',', '%n,')))
            reject(replace_one(body, width[0], replace_one(width[0], width[1] + ' ', 'add ')))
    assert debug_width_mutations, 'metadata-bearing consumer width mutation was not exercised'

    # The two stages can have distinct thresholds and share a vscale value.
    # Derive both minima rather than copying the producer's SSA or floor.
    consumer = entries[1]['primary']
    code = blocks[consumer['guard']]
    comparison = re.search(r'  (%[-\w.$]+) = icmp ult i64 %n, ' +
                           re.escape(consumer['threshold']), code)
    assert comparison
    scale = re.search(r'^  (%[-\w.$]+) = call i64 @llvm.vscale.i64\(\)', body, re.M)[1]
    new = (f'  %entry.consumer.width = mul nuw i64 {scale}, {widths[1]}\n'
           '  %entry.consumer.limit = call i64 @llvm.umax.i64(i64 13, i64 %entry.consumer.width)\n'
           f'  {comparison[1]} = icmp ult i64 %n, %entry.consumer.limit')
    separate = replace_one(body, code, replace_one(code, comparison[0], new))
    certified = certify(separate)
    assert checker.dispatch_entry_fields(certified) == f'{minima[0]}, 13, 0, 0'
    width_only = replace_one(separate, 'icmp ult i64 %n, %entry.consumer.limit',
                             'icmp ult i64 %n, %entry.consumer.width')
    assert checker.dispatch_entry_fields(certify(width_only)) == f'{minima[0]}, 0, 0, 0'
    for role, stage in enumerate(entries):
        ordinary = stage['ordinary']
        if not ordinary:
            continue
        code = blocks[ordinary['guard']]
        comparison = re.search(r'  (%[-\w.$]+) = icmp ult i64 ' +
                               re.escape(ordinary['count']) + ', ' +
                               re.escape(ordinary['threshold']), code)
        assert comparison
        new = (f'  %entry.ordinary.width = mul i64 {scale}, {ordinary["vf"]}\n'
               '  %entry.ordinary.limit = call i64 @llvm.umax.i64(i64 %entry.ordinary.width, i64 17)\n'
               f'  {comparison[1]} = icmp ult i64 {ordinary["count"]}, %entry.ordinary.limit')
        analogous = replace_one(body, code, replace_one(code, comparison[0], new))
        certified = certify(analogous)
        assert certified[role]['ordinary']['minimum'] == 17
        assert certified[1 - role]['ordinary']['minimum'] == 0
        # Ordinary entry is on N minus the actual primary resume, not N or
        # the primary rounded count on its own.
        reject(replace_one(body, f'{ordinary["count"]} = sub i64 %n,',
                            f'{ordinary["count"]} = sub i64 {stage["primary"]["rounded"]},'))
    # Each vector-rounded count and scalar resume must still agree with the
    # stage guard. A correct threshold cannot certify a changed iteration set.
    reject(replace_one(body, '%n.mod.vf = urem i64 %n,', '%n.mod.vf = urem i64 %n.vec,'))
    reject(replace_one(body, '%n.vec = sub i64 %n,', '%n.vec = add i64 %n,'))
    reject(replace_one(body, 'phi i64 [ %n.vec, %middle.block ], [ 0, %preheader ]',
                        'phi i64 [ %n.vec, %middle.block ], [ 1, %preheader ]'))
    reject(replace_one(body, '%bounded = icmp ule i64 %n, 65', '%bounded = icmp ule i64 %n, 66'))
    reject(replace_one(body, '%nonzero = icmp ne i64 %n, 0', '%nonzero = icmp eq i64 %n, 0'))


for path in sys.argv[2:]:
    module = Path(path).read_text()
    remarks = Path(path + '.remarks').read_text()
    widths = checker.dispatch_stage_vfs(remarks)
    duplicate = remarks + 'remark: dispatch.c:10:5: split scalar-IR reduction loop; duplicate\n'
    assert duplicate != remarks
    try:
        checker.dispatch_stage_vfs(duplicate)
    except AssertionError:
        pass
    else:
        raise AssertionError('accepted fifth selection')
    evl = '.evl.' in path
    for name, factor in (('interleave2', 2), ('interleave3', 3)):
        body = checker.function_definition(module, name)
        assert checker.check_dispatch_scalar_interleave(module, name, factor, evl, *widths[name]) == body
        if not evl:
            stages = {}
            probed = checker.check_dispatch_scalar_interleave(module, name, factor, evl,
                                                              *widths[name], probe=True, stages=stages)
            for stage in range(4):
                assert probed.count(f'call void @fission_interleave_probe(i32 {stage})') == 1
            assert probed.count('call void @fission_interleave_tail_probe(') == sum(
                bool(tail['vf']) for tail in stages['ordinary_tails'])
            assert stages['entries'] == checker.dispatch_entry_certificates(
                body, *widths[name], [tail['vf'] for tail in stages['ordinary_tails']])
            entry_checks(body, widths[name], stages['ordinary_tails'])

        def reject(candidate, obligation):
            assert candidate != body, 'mutation was not constructed'
            try:
                checker.check_dispatch_scalar_interleave(replace_one(module, body, candidate), name,
                                                         factor, evl, *widths[name])
            except AssertionError as error:
                assert obligation in str(error), (name, obligation, error)
            else:
                raise AssertionError(name + ': accepted ' + obligation)

        reject(replace_one(body, 'alloca [65 x i32]', 'alloca [64 x i32]'), 'scratch capacity')
        reject(replace_one(body, '@llvm.vector.reduce.xor.', '@llvm.vector.reduce.add.'), 'reduction roles')
        # No correct, unused reduction or neighboring function can stand in
        # for either returned result or the real scratch stream.
        reject(substitute(body, r'(store i32 )%[-\w.$]+(, ptr %out, align 4)', r'\g<1>0\2'),
               'output store %out')
        reject(substitute(body, r'(store i32 )%[-\w.$]+(, ptr %o1, align 4)', r'\g<1>0\2'),
               'output store %o1')
        producer, consumer = checker.scalar_consumer(body, name)
        reject(producer + 'scalar.fission.consumer.ph:\n' +
               replace_one(consumer, 'ptr %scalar.fission.scratch,', 'ptr %other.scratch,'),
               'consumer scratch address')
        vector = next(label for label in checker.loop_blocks(producer) if label.startswith('vector.body'))
        latch = checker.loop_blocks(producer)[vector]
        reject(replace_one(body, latch, substitute(latch, r', !llvm.loop !\d+', '')),
               'producer attached provenance')
        reject(replace_one(body, latch, substitute(latch, r', !dbg !\d+', '', count=0)),
               'producer attached source location')
        if not evl:
            reject(replace_one(body, '%updated.bits.consume = xor i32 %bits.consume, %fission.contribution',
                                '%updated.bits.consume = add i32 %bits.consume, %fission.contribution'), 'consumer scalar XOR update')
            reject(replace_one(body, '%update.consume = add i32 %sum.consume, %fission.contribution',
                                '%update.consume = xor i32 %sum.consume, %fission.contribution'),
                   'consumer scalar update')

    # Ordered FP has width-only gates, independently certified on each side.
    if not evl:
        stages = {}
        checker.check_dispatch_overlap(module, False, *widths['interleave2_ordered'], stages=stages)
        assert checker.dispatch_entry_fields(stages['entries']) == '0, 0, 0, 0'

print('PASS: actual early dispatch entries, results, scratch, attached provenance and source locations')
