# REQUIRES: riscv-registered-target
# RUN: split-file %s %t
# RUN: opt -passes='loop-vectorize,verify<domtree>,verify<loops>,verify<scalar-evolution>' -verify-each \
# RUN:   -mtriple=riscv64 -mattr=+v -enable-vplan-reduction-fission -force-vector-width=1 \
# RUN:   -force-vector-interleave=0 -force-target-max-scalar-interleave=1 -scalable-vectorization=off \
# RUN:   -vplan-reduction-fission-max-scratch-bytes=112 -pass-remarks=vplan-reduction-fission \
# RUN:   -S %S/../Transforms/LoopVectorize/RISCV/reduction-fission-scalar-chunk-state.ll \
# RUN:   -o %t/scalar.ll 2> %t/scalar.remarks
# RUN: opt -passes='loop-vectorize,loop-vectorize,verify<domtree>,verify<loops>,verify<scalar-evolution>' -verify-each \
# RUN:   -mtriple=riscv64 -mattr=+v -enable-vplan-reduction-fission -force-vector-width=4 \
# RUN:   -force-vector-interleave=1 -hints-allow-reordering=false -scalable-vectorization=always \
# RUN:   -tail-folding-policy=dont-fold-tail -enable-epilogue-vectorization=false \
# RUN:   -vplan-reduction-fission-allow-fp-reordering -vplan-reduction-fission-max-scratch-bytes=112 \
# RUN:   -pass-remarks=vplan-reduction-fission -S \
# RUN:   %S/../Transforms/LoopVectorize/RISCV/reduction-fission-scalar-chunk-state.ll \
# RUN:   -o %t/tail.ll 2> %t/tail.remarks
# RUN: %python %t/check.py %S/../../utils/check-reduction-fission.py \
# RUN:   %S/../Transforms/LoopVectorize/RISCV/reduction-fission-scalar-chunk-state.ll \
# RUN:   %t/scalar.ll %t/tail.ll %t/scalar.remarks %t/tail.remarks

# This certificate/mutation test supplements actual transformed-path numerical
# execution in check-reduction-fission.py. It does not replace that execution
# or the inherited checker matrices and assertions.

#--- check.py
import importlib.util
from pathlib import Path
import re
import sys

sys.dont_write_bytecode = True
spec = importlib.util.spec_from_file_location('checker', sys.argv[1])
checker = importlib.util.module_from_spec(spec)
sys.modules[spec.name] = checker
spec.loader.exec_module(checker)
source, scalar, tail, sr, vr = (Path(path).read_text() for path in sys.argv[2:])
for name in checker.STATE_CHUNK_FUNCTIONS:
    for ir, remarks, vector in [(scalar, sr, False), (tail, vr, True)]:
        checker.check_state_chunk_remarks(remarks, name, 9, 112, vector)
        checked = checker.check_state_chunk(ir, source, name, 9, scalar=not vector, probe=True)
        for hook in ('state_chunk_begin', 'state_chunk_end', 'state_chunk_producer', 'chunk_tail'):
            assert checked.count('call void @record_' + hook + '(') == 1, (name, hook)
        assert checked.count('call void @record_chunk_vector(') == int(vector)

name = 'chunk_state_pair'
for ir, vector in [(scalar, False), (tail, True)]:
    body = checker.function_definition(ir, name)
    for old, new in [
        ('%prev.chunk.carry = phi i32 [ 23,', '%prev.chunk.carry = phi i32 [ 0,'),
        ('%older.chunk.carry = phi i32 [ -11,', '%older.chunk.carry = phi i32 [ 23,'),
        ('%dstate.chunk.carry = phi double [ %start,',
         '%dstate.chunk.carry = phi double [ 0.000000e+00,'),
        ('%prev.chunk.carry = phi i32 [ 23, %preheader ], [ %prev.chunk.backedge, %scalar.fission.chunk.latch ]',
         '%prev.chunk.carry = phi i32 [ 23, %preheader ], [ %prev.chunk.backedge, %scalar.fission.consumer.ph ]'),
        ('[ %prev.chunk.carry, %scalar.fission.producer.ph ]',
         '[ 23, %scalar.fission.producer.ph ]'),
        ('[ %prev.chunk.backedge, %scalar.fission.chunk.latch ]',
         '[ %older.chunk.backedge, %scalar.fission.chunk.latch ]'),
        ('%prev.chunk.backedge = phi i32 [ %state.next, %loop ]',
         '%prev.chunk.backedge = phi i32 [ %prev, %loop ]'),
        ('%older.chunk.backedge = phi i32 [ %prev, %loop ]',
         '%older.chunk.backedge = phi i32 [ %state.next, %loop ]'),
        ('%older = phi i32 [ %older.chunk.carry, %scalar.fission.producer.ph ], [ %prev, %loop ]',
         '%older = phi i32 [ %older.chunk.carry, %scalar.fission.producer.ph ], [ %state.next, %loop ]'),
        ('%dstate.chunk.backedge = phi double [ %dnext, %loop ]',
         '%dstate.chunk.backedge = phi double [ %dstate, %loop ]'),
        ('%prev.fission.export = phi i32 [ %prev, %loop ]',
         '%prev.fission.export = phi i32 [ %state.next, %loop ]'),
        ('%dstate.fission.export = phi double [ %dstate, %loop ]',
         '%dstate.fission.export = phi double [ %dnext, %loop ]'),
        ('%out.prev = phi i32 [ %prev.fission.export, %scalar.fission.chunk.latch ]',
         '%out.prev = phi i32 [ %state.next.fission.export, %scalar.fission.chunk.latch ]'),
        ('%out.dnext = phi double [ %dnext.fission.export, %scalar.fission.chunk.latch ]',
         '%out.dnext = phi double [ %dstate.fission.export, %scalar.fission.chunk.latch ]'),
        ('%dnext = fadd double %dstate, %dx', '%dnext = fadd reassoc double %dstate, %dx'),
        ('%dnext = fadd double %dstate, %dx', '%dnext = fadd double %dx, %dstate'),
    ]:
        assert body.count(old) == 1, (old, body)
        try:
            checker.check_state_chunk(body.replace(old, new), source, name, 9, scalar=not vector)
        except AssertionError:
            pass
        else:
            raise AssertionError('accepted malformed state carry/export: ' + old)

for old, new in [
    ('scratch capacity 9,', 'scratch capacity 8,'),
    ('scratch bytes 112,', 'scratch bytes 111,'),
    ('producer state carries 3', 'producer state carries 2'),
    ('scratch store bytes/iteration 12', 'scratch store bytes/iteration 11'),
    ('scratch load bytes/iteration 12', 'scratch load bytes/iteration 24'),
    ('producer reread bytes/iteration 0', 'producer reread bytes/iteration 8'),
    ('duplicated producer instructions 0', 'duplicated producer instructions 1'),
    ('scalar-chunk-state.c:22:3:', 'scalar-chunk-state.c:23:3:'),
    ('producer VF 1', 'producer VF 4'),
    ('consumer VF vscale x 4', 'consumer VF 1'),
]:
    local = '\n'.join(line for line in vr.splitlines() if 'scalar-chunk-state.c:22:3:' in line) + '\n'
    assert old in local, old
    try:
        checker.check_state_chunk_remarks(local.replace(old, new), name, 9, 112, True)
    except AssertionError:
        pass
    else:
        raise AssertionError('accepted malformed state evidence: ' + old)

# Enclosing state must come from next/current exits, independently of chunk
# backedge names. Mutate only the original row-exit edge.
name = 'chunk_state_nested'
body = checker.function_definition(scalar, name)
old = '%seed = phi i32 [ 23, %outer.ph ], [ %out.state.next, %row.exit ]'
assert old in body
try:
    checker.check_state_chunk(body.replace(old, old.replace('%out.state.next', '%out.prev')),
                              source, name, 9, scalar=True)
except AssertionError:
    pass
else:
    raise AssertionError('accepted enclosing-loop current/next swap')
