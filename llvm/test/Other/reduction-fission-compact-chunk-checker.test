# REQUIRES: riscv-registered-target
# RUN: split-file %s %t
# RUN: opt -passes='loop-vectorize,verify<domtree>,verify<loops>,verify<scalar-evolution>' -verify-each \
# RUN:   -mtriple=riscv64 -mattr=+v -enable-vplan-reduction-fission -force-vector-width=1 \
# RUN:   -force-vector-interleave=0 -force-target-max-scalar-interleave=1 -scalable-vectorization=off \
# RUN:   -vplan-reduction-fission-max-scratch-bytes=112 -pass-remarks=vplan-reduction-fission \
# RUN:   -S %S/../Transforms/LoopVectorize/RISCV/reduction-fission-scalar-compact-chunks.ll \
# RUN:   -o %t/scalar.ll 2> %t/scalar.remarks
# RUN: opt -passes='loop-vectorize,loop-vectorize,verify<domtree>,verify<loops>,verify<scalar-evolution>' -verify-each \
# RUN:   -mtriple=riscv64 -mattr=+v -enable-vplan-reduction-fission -force-vector-width=4 \
# RUN:   -force-vector-interleave=1 -scalable-vectorization=always -hints-allow-reordering=false \
# RUN:   -tail-folding-policy=dont-fold-tail -enable-epilogue-vectorization=false \
# RUN:   -vplan-reduction-fission-allow-fp-reordering -vplan-reduction-fission-max-scratch-bytes=112 \
# RUN:   -pass-remarks=vplan-reduction-fission -S \
# RUN:   %S/../Transforms/LoopVectorize/RISCV/reduction-fission-scalar-compact-chunks.ll \
# RUN:   -o %t/tail.ll 2> %t/tail.remarks
# RUN: opt -passes='loop-vectorize,loop-vectorize,verify<domtree>,verify<loops>,verify<scalar-evolution>' -verify-each \
# RUN:   -mtriple=riscv64 -mattr=+v -enable-vplan-reduction-fission -force-vector-width=4 \
# RUN:   -force-vector-interleave=1 -scalable-vectorization=always -hints-allow-reordering=false \
# RUN:   -vplan-reduction-fission-max-scratch-bytes=112 -pass-remarks=vplan-reduction-fission \
# RUN:   -S %S/../Transforms/LoopVectorize/RISCV/reduction-fission-scalar-compact-chunks.ll \
# RUN:   -o %t/evl.ll 2> %t/evl.remarks
# RUN: %python %t/check.py %S/../../utils/check-reduction-fission.py \
# RUN:   %S/../Transforms/LoopVectorize/RISCV/reduction-fission-scalar-compact-chunks.ll \
# RUN:   %t/scalar.ll %t/tail.ll %t/evl.ll %t/scalar.remarks %t/tail.remarks %t/evl.remarks opt %S/Inputs

# The numerical driver executes real scalar/vector/tail paths against exact
# original IR and C. This test mutates fresh actual transformed IR; none of the
# inherited count/result/export/dispatch/state certificates are replaced.
# The supporting identity helper additionally exercises complete tail induction
# and load connections, and unique dominating shared/stage-local VF definitions.

#--- check.py
import importlib.util
from pathlib import Path
import re
import sys

sys.dont_write_bytecode = True
spec = importlib.util.spec_from_file_location('checker', sys.argv[1])
checker = importlib.util.module_from_spec(spec)
sys.modules[spec.name] = checker
spec.loader.exec_module(checker)
source, scalar, tail, evl, sr, tr, er = (Path(p).read_text() for p in sys.argv[2:9])
opt = sys.argv[9]
identity_spec = importlib.util.spec_from_file_location(
    'identity', Path(sys.argv[10]) / 'reduction-fission-consumer-identity.py')
identity = importlib.util.module_from_spec(identity_spec)
identity_spec.loader.exec_module(identity)
for ir, remarks, is_scalar, is_evl in [(scalar, sr, True, False),
                                      (tail, tr, False, False), (evl, er, False, True)]:
    for name in checker.COMPACT_CHUNK_FUNCTIONS:
        if name == 'compact_chunk_narrow' and not is_scalar:
            continue
        checker.check_compact_chunk_remarks(remarks, name, 9, 112, not is_scalar)
        for role in ('producer', 'consumer'):
            loc = 'scalar-compact-chunks.c:' + str(
                12 + 10 * checker.COMPACT_CHUNK_FUNCTIONS.index(name)) + ':3:'
            line = next(line for line in remarks.splitlines()
                        if loc in line and 'scalar-IR fission ' + role + ' VF ' in line)
            # Append a bad later visit too: presence of a correct first
            # location cannot satisfy repeated-LV attribution on its own.
            bad = line.replace(loc, '<unknown>:0:0:')
            for candidate in (remarks.replace(line, bad), remarks + bad + '\n'):
                try:
                    checker.check_compact_chunk_remarks(candidate, name, 9, 112, not is_scalar)
                except AssertionError:
                    pass
                else:
                    raise AssertionError(name + ': accepted lost ' + role + ' location')
        body = checker.function_definition(ir, name)
        checked = checker.check_compact_chunk(ir, source, name, 9,
                                             scalar=is_scalar, evl=is_evl, probe=not is_evl)
        certify = lambda candidate: checker.check_compact_chunk(
            candidate, source, name, 9, scalar=is_scalar, evl=is_evl)
        for renamed in identity.exercise(checker, ir, name, is_evl, certify):
            checker.run([opt, '-passes=verify', '-disable-output'], input=renamed)
        if not is_evl:
            for hook in ('begin', 'producer', 'participant', 'guard', 'end', 'tail'):
                assert checked.count('call void @record_cc_' + hook + '(') == 1, (name, hook)
            assert checked.count('call void @record_cc_vector(') == int(not is_scalar)

        def mutate(value, old, new):
            line = re.search(r'^  %' + re.escape(value) + r' = [^\n]*$', body, re.M)
            assert line and line[0].count(old) == 1, (name, value, old)
            return body[:line.start()] + line[0].replace(old, new, 1) + body[line.end():]

        def reject(candidate, reason):
            assert candidate != body, (name, reason)
            try:
                checker.check_compact_chunk(candidate, source, name, 9,
                                             scalar=is_scalar, evl=is_evl)
            except AssertionError:
                pass
            else:
                raise AssertionError(name + ': accepted ' + reason)

        for value, old, new, reason in [
            ('fission.participating', '[ 0, %scalar.fission.producer.ph ]',
             '[ %fission.chunk.base, %scalar.fission.producer.ph ]', 'failure to reset P'),
            ('fission.participating', '%scalar.fission.producer.ph', '%preheader', 'reset edge'),
            ('fission.producer.completed', '%fission.producer.next,',
             '%fission.participating.merge,', 'completed equals P'),
            ('fission.chunk.next', '%fission.producer.completed',
             '%fission.participating.count', 'global progress by P'),
            ('rd.result', '[ %rd.chunk.carry,', '[ %start,', 'original start on empty later chunk'),
            ('prev.chunk.backedge', '%state.next,', '%prev,', 'carry current instead of next'),
            ('older.chunk.backedge', '%prev,', '%state.next,', 'sequential carry substitution'),
            ('prev.fission.export', '%prev,', '%state.next,', 'current/next export swap'),
            ('last.dc.fission.export', '%last.dc,', '%dc,', 'last participant export'),
            ('older.chunk.carry', '%scalar.fission.chunk.latch',
             '%scalar.fission.consumer.exit', 'wrong carry edge'),
        ]:
            reject(mutate(value, old, new), reason)
        if is_scalar:
            reject(mutate('fission.consumer.more', '%fission.participating.count',
                          '%fission.producer.completed'), 'consuming completed instead of P')
        # Test every bypass edge independently, including larger CFGs.
        line = re.search(r'^  %fission.participating.merge = [^\n]*$', body, re.M)[0]
        for edge in ('right', 'right1', 'right2') if name in (
                'compact_chunk_cfg', 'compact_chunk_rows') else ('right',):
            reject(mutate('fission.participating.merge',
                          '[ %fission.participating, %' + edge + ' ]',
                          '[ %fission.participating.next, %' + edge + ' ]'), 'bypass increments P')

print('PASS: compact chunk reset/completed/P/empty-carry/simultaneous-state/final-export certificates')
