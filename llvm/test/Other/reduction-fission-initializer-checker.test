# RUN: split-file %s %t
# RUN: %python %t/check.py %S/../../utils/check-reduction-fission.py %t

# Synthetic certificate tests, separate from the actual transformed-path
# certificates, machine verification and three-way execution in the multiply
# and inherited bitwise matrices. Cover forms even if today's LV folds them.

#--- check.py
import importlib.util
from itertools import product
import json
from pathlib import Path
import sys

sys.dont_write_bytecode = True
spec = importlib.util.spec_from_file_location('checker', sys.argv[1])
checker = importlib.util.module_from_spec(spec)
sys.modules[spec.name] = checker
spec.loader.exec_module(checker)
counts = dict(positives=0, forms={}, rejections={}, complete=False)
(Path(sys.argv[2]) / 'initializer-counts.json').write_text(json.dumps(counts, indent=2) + '\n')


def replace_one(text, old, new):
    assert old != new and text.count(old) == 1, ('mutation anchor', old)
    changed = text.replace(old, new, 1)
    assert changed != text
    return changed


for scalable, (ty, seed), op in product(
        (False, True), (('i8', '-27'), ('i32', '-251691430'),
                        ('i64', '-81985529216486896')), ('mul', 'and', 'or', 'xor')):
    shape = checker.ConsumerVF4(scalable)
    vty = shape.vector_type(ty)
    neutral = {'mul': '1', 'and': '-1', 'or': '0', 'xor': '0'}[op]
    base = 'zeroinitializer' if neutral == '0' else f'splat ({ty} {neutral})'
    forms = [('instruction', seed), ('instruction', '%carry'), ('constant_expression', seed)]
    if not scalable:
        forms.append(('fixed_vector', seed))
    for form, start in forms:
        elements = [f'{ty} {v}' for v in (start, neutral, neutral, neutral)]
        operands = f'{vty} {base}, {ty} {start}, i32 0'
        initializer = ('insertelement ' + operands if form == 'instruction' else
                       'insertelement (' + operands + ')' if form == 'constant_expression' else
                       '<' + ', '.join(elements) + '>')
        line = '  %init = ' + initializer
        body = (f'define void @fixture({ty} %carry) {{\nentry:\n  br label %vector.ph\n'
                'vector.ph:\n' + (line + '\n' if form == 'instruction' else '') +
                '  br label %vector.body\nvector.body:\n  ret void\n}\n')
        value = '%init' if form == 'instruction' else initializer
        checker.check_integer_reduction_initializer(body, value, shape, ty, start, op)
        counts['positives'] += 1
        key = f'{form}:{ty}:{op}:{"scalable" if scalable else "fixed"}'
        counts['forms'][key] = counts['forms'].get(key, 0) + 1

        def reject(candidate_body, candidate_value, group, actual_shape=shape, actual_ty=ty):
            # Anchor and nonidentity assertions are outside rejection handling.
            assert (candidate_body, candidate_value, actual_shape, actual_ty) != (body, value, shape, ty)
            try:
                checker.check_integer_reduction_initializer(
                    candidate_body, candidate_value, actual_shape, actual_ty, start, op)
            except AssertionError:
                counts['rejections'][group] = counts['rejections'].get(group, 0) + 1
            else:
                counts['failure'] = dict(key=key, start=start, group=group, body=candidate_body,
                                         value=candidate_value, scalable=actual_shape.scalable, ty=actual_ty)
                (Path(sys.argv[2]) / 'initializer-counts.json').write_text(json.dumps(counts, indent=2) + '\n')
                raise AssertionError((key, start, 'accepted initializer corruption', group))

        def corrupt(changed, group):
            assert changed != initializer
            if form == 'instruction':
                candidate = replace_one(body, line, replace_one(line, initializer, changed))
                reject(candidate, value, group)
            else:
                reject(body, replace_one(value, initializer, changed), group)

        reject(body, value, 'shape', checker.ConsumerVF4(not scalable))
        reject(body, value, 'element_type', actual_ty='i64' if ty != 'i64' else 'i32')
        if form == 'fixed_vector':
            changed = elements.copy()
            changed[0] = f'{ty} {neutral}'
            corrupt('<' + ', '.join(changed) + '>', 'seed')
            # Check each neutral lane, its type and poison/undef independently.
            for lane in range(1, 4):
                for wrong in (f'{ty} {"0" if neutral != "0" else "1"}',
                              f'i16 {neutral}', f'{ty} poison', f'{ty} undef'):
                    changed = elements.copy()
                    changed[lane] = wrong
                    corrupt('<' + ', '.join(changed) + '>', 'neutral')
            for lane in (1, 3):
                changed = elements.copy()
                changed[0], changed[lane] = changed[lane], changed[0]
                corrupt('<' + ', '.join(changed) + '>', 'placement')
            for changed in (elements[:3], elements + [f'{ty} {neutral}']):
                corrupt('<' + ', '.join(changed) + '>', 'lane_count')
            corrupt(replace_one(initializer, f'{ty} {start}', 'i16 ' + start), 'seed_type')
            corrupt(replace_one(initializer, f'{ty} {start}', f'{ty} %carry'), 'constant_carry')
        else:
            corrupt(replace_one(initializer, f'{ty} {start}, i32 0',
                                f'{ty} {neutral}, i32 0'), 'seed')
            for wrong in ('poison', 'undef',
                          f'splat ({ty} 1)' if neutral == '0' else 'zeroinitializer'):
                corrupt(replace_one(initializer, base, wrong), 'neutral')
            for lane in ('1', '3', '4', '-1'):
                corrupt(replace_one(initializer, ', i32 0', ', i32 ' + lane), 'placement')
            corrupt(replace_one(initializer, ', i32 0', ', i64 0'), 'index_type')
            corrupt(replace_one(initializer, f'{ty} {start}, i32 0',
                                'i16 ' + start + ', i32 0'), 'seed_type')
            corrupt(replace_one(initializer, vty, f'<{"vscale x " if scalable else ""}8 x {ty}>'),
                    'lane_count')
            if start == '%carry':
                corrupt(replace_one(initializer, '%carry', '%other.carry'), 'carry')
            if form == 'instruction':
                reject(replace_one(body, line, line + '\n' + line), value, 'duplicate_definition')
                moved = replace_one(body, line + '\n', '')
                moved = replace_one(moved, 'vector.body:\n', 'vector.body:\n' + line + '\n')
                reject(moved, value, 'definition_block')
            else:
                corrupt(replace_one(initializer, f'{ty} {start}, i32 0',
                                    f'{ty} %carry, i32 0'), 'constant_carry')

assert counts['positives'] == 84, counts
assert len(counts['forms']) == 60, counts
assert all(counts['rejections'][key] > 0 for key in (
    'seed', 'neutral', 'placement', 'shape', 'element_type', 'seed_type',
    'lane_count', 'index_type', 'carry', 'constant_carry',
    'duplicate_definition', 'definition_block')), counts
counts['complete'] = True
(Path(sys.argv[2]) / 'initializer-counts.json').write_text(json.dumps(counts, indent=2) + '\n')
