; RUN: opt < %s -passes=loop-vectorize -mtriple=riscv64 -mattr=+v \
; RUN:   -force-vector-width=4 -force-vector-interleave=1 -S | FileCheck %s
;
; Freeze the ordinary lowering path while reduction fission is disabled.  In
; particular, neither the hidden analysis nor its scratch recipes may alter
; the fused vector loop or the scalar epilogue.

define i32 @fixed_reduction(ptr noalias readonly %a) {
; CHECK-LABEL: @fixed_reduction(
; CHECK:       vector.body:
; CHECK:         [[VEC_PHI:%.*]] = phi <4 x i32>
; CHECK:         [[WIDE_LOAD:%.*]] = load <4 x i32>, ptr
; CHECK:         [[VEC_ADD:%.*]] = add <4 x i32> [[VEC_PHI]], [[WIDE_LOAD]]
; CHECK:       middle.block:
; CHECK:         call i32 @llvm.vector.reduce.add.v4i32(<4 x i32> [[VEC_ADD]])
; CHECK-NOT:   fission
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %sum = phi i32 [ 0, %entry ], [ %sum.next, %loop ]
  %p = getelementptr inbounds i32, ptr %a, i64 %iv
  %x = load i32, ptr %p, align 4
  %sum.next = add i32 %sum, %x
  %iv.next = add nuw nsw i64 %iv, 1
  %done = icmp eq i64 %iv.next, 64
  br i1 %done, label %exit, label %loop

exit:
  %result = phi i32 [ %sum.next, %loop ]
  ret i32 %result
}

define i32 @runtime_reduction(ptr noalias readonly %a, i64 %n) {
; CHECK-LABEL: @runtime_reduction(
; CHECK:       vector.body:
; CHECK:       middle.block:
; CHECK:         br i1 {{.*}}, label %exit.loopexit, label %scalar.ph
; CHECK:       scalar.ph:
; CHECK:       loop:
entry:
  %empty = icmp eq i64 %n, 0
  br i1 %empty, label %exit, label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %sum = phi i32 [ 0, %entry ], [ %sum.next, %loop ]
  %p = getelementptr inbounds i32, ptr %a, i64 %iv
  %x = load i32, ptr %p, align 4
  %sum.next = add i32 %sum, %x
  %iv.next = add nuw nsw i64 %iv, 1
  %done = icmp eq i64 %iv.next, %n
  br i1 %done, label %exit, label %loop

exit:
  %result = phi i32 [ 0, %entry ], [ %sum.next, %loop ]
  ret i32 %result
}
