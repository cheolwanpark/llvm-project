enum {
  InterleaveMaxTripCount = 65,
  InterleaveMaxFactor = @INTERLEAVE_MAX_FACTOR@,
  InterleaveMaxOutputs = @INTERLEAVE_MAX_OUTPUTS@,
  InterleaveInputElements = InterleaveMaxTripCount * InterleaveMaxFactor,
  // double is the largest input element in these fixture families.
  InterleaveMaxInputBytes = InterleaveInputElements * sizeof(double)
};

