static uint64_t InterleaveEntries[4];
static uint64_t InterleaveTailEntries[2], InterleaveTailLanes[2];
static uint64_t OrdinaryTailEntries, OrdinaryTailLanes;
void fission_interleave_probe(uint32_t Stage) {
  if (Stage >= 4) abort();
  ++InterleaveEntries[Stage];
}
void fission_interleave_tail_probe(uint32_t Role, uint64_t Lanes) {
  if (Role >= 2 || !Lanes) abort();
  ++InterleaveTailEntries[Role];
  InterleaveTailLanes[Role] += Lanes;
}
static void reset_interleave_probes(void) {
  memset(InterleaveEntries, 0, sizeof(InterleaveEntries));
  memset(InterleaveTailEntries, 0, sizeof(InterleaveTailEntries));
  memset(InterleaveTailLanes, 0, sizeof(InterleaveTailLanes));
}

// The participating AoS objects end exactly at an inaccessible page, so a
// widened scalar tail or a vector chunk rounded upward cannot silently pass
// by reading the rest of a generously sized input array. Bypasses use NULL.
static const void *guarded_input(const void *Input, size_t Bytes) {
  static char *Pages;
  static size_t WritableBytes;
  if (!Bytes) return NULL;
  if (!Pages) {
    long Size = sysconf(_SC_PAGESIZE);
    if (Size <= 0) abort();
    size_t PageSize = (size_t)Size;
    WritableBytes =
        ((InterleaveMaxInputBytes + PageSize - 1) / PageSize) * PageSize;
    Pages = mmap(NULL, WritableBytes + PageSize, PROT_READ | PROT_WRITE,
                 MAP_PRIVATE | MAP_ANON, -1, 0);
    if (Pages == MAP_FAILED ||
        mprotect(Pages + WritableBytes, PageSize, PROT_NONE)) abort();
  }
  if (Bytes > InterleaveMaxInputBytes) abort();
  char *EndAligned = Pages + WritableBytes - Bytes;
  memcpy(EndAligned, Input, Bytes);
  return EndAligned;
}

static uint32_t Seed = 314159265;
static double MaxError;
static unsigned Runs;
static uint32_t random_value(void) {
  Seed = 1664525 * Seed + 1013904223;
  return Seed;
}
static uint64_t random_wide_value(void) {
  uint64_t High = random_value();
  return (High << 32) | random_value();
}
static void fail(const char *Name, unsigned N, unsigned Trial, const char *What) {
  fprintf(stderr, "%s: N=%u trial=%u: %s\n", Name, N, Trial, What);
  exit(1);
}

static void check_compact_probes(const char *Name, unsigned N, unsigned Trial,
                                 unsigned Iterations, unsigned Participants,
                                 unsigned VectorVisits, unsigned TailVisits) {
  if (CompactIterations != Iterations || CompactParticipants != Participants ||
      ScalarVectorVisits != VectorVisits || ScalarTailVisits != TailVisits)
    fail(Name, N, Trial, "compact producer/participant/vector/tail visit mismatch");
  ScalarVectorRuns += ScalarVectorVisits != 0;
}

static void check_acyclic_probes(const char *Name, unsigned N, unsigned Trial,
                                unsigned Rows, unsigned Lanes) {
  if (AcyclicIterations != Rows * N || AcyclicLatches != Rows * N ||
      ScalarVectorVisits != Rows * (N / Lanes) ||
      ScalarTailVisits != Rows * (N % Lanes))
    fail(Name, N, Trial, "acyclic producer/latch/vector/tail visit mismatch");
}

// Independent scalar formulas as well as the separately compiled original IR.
// Unsigned arithmetic models LLVM's wrapping adds; division is signed. FP
// operations retain their original iteration order, grouping and operand order.
static void reference_acyclic(bool Nested, const uint32_t *A, const double *D,
                              uint32_t *Out, double *Dout, float *Fout,
                              uint64_t N, double Start) {
  uint32_t S0 = 17, S1 = (uint32_t)-7;
  double DS = Start;
  float FS = (float)Start;
  if (N && N <= 65)
    for (unsigned I = 0; I < N; ++I) {
      uint32_t C;
      double DC;
      if (A[I]) {
        int32_t Q = 840 / (int32_t)A[I];
        C = scalar_helper((uint32_t)Q);
        DC = (double)Q;
      } else {
        C = 17;
        DC = D[I] * 3.0;
      }
      if (!Nested || A[I]) {
        if (Nested ? (A[I] & 2) != 0 : (I & 1) != 0) {
          C += 23;
          DC *= 0.5;
        } else {
          C -= 9;
          DC *= -1.0;
        }
      }
      float FC = (float)DC;
      S0 = S0 + C;
      S1 = C + S1;
      DS = DS + DC;
      FS = FS + FC;
    }
  Out[0] = S0;
  Out[1] = S1;
  *Dout = DS;
  *Fout = FS;
}

// Count the original modular relational control independently of reductions.
// Flipping the sign bit maps signed ordering to unsigned ordering, avoiding
// signed C overflow or implementation-defined out-of-range signed conversions.
static unsigned reference_affine_count(unsigned Control, uint64_t N,
                                        int64_t Begin) {
  if (!N || N > 65) return 0;
  if (!Control) return (unsigned)N;
  bool Down = Control >= 3, Signed = Control == 2 || Control == 4;
  uint64_t IV = (uint64_t)Begin;
  uint64_t Limit = Down ? IV - 3 * N : IV + 3 * N;
  for (unsigned Count = 1; Count <= N; ++Count) {
    IV = Down ? IV - 3 : IV + 3;
    uint64_t L = IV, R = Limit;
    if (Signed) {
      L ^= UINT64_C(1) << 63;
      R ^= UINT64_C(1) << 63;
    }
    if (!(Down ? L > R : L < R)) return Count;
  }
  abort(); // Equality at N is a mandatory upper bound, not the actual count.
}

static void reference_affine_compact(const uint32_t *A, const double *D,
                                      uint32_t *Out, double *Dout, float *Fout,
                                      uint64_t N, double Start) {
  uint32_t S0 = 17, S1 = (uint32_t)-7;
  double DS = Start;
  float FS = (float)Start;
  if (N && N <= 65)
    for (unsigned I = 0; I < N; ++I)
      if (A[I]) {
        uint32_t C = scalar_helper((uint32_t)(840 / (int32_t)A[I]));
        float FC = (float)D[I];
        S0 = S0 + C;
        S1 = C + S1;
        DS = DS + D[I];
        FS = FS + FC;
      }
  Out[0] = S0;
  Out[1] = S1;
  *Dout = DS;
  *Fout = FS;
}

static void reference_acyclic_enclosing(const uint32_t *A, const double *D,
                                        uint32_t *Out, double *Dout,
                                        uint64_t Rows, uint64_t N, double Start) {
  uint32_t S = 19;
  double DS = Start;
  if (!Rows || Rows > 4 || !N || N > 65)
    return;
  for (unsigned R = 0; R < Rows; ++R) {
    for (unsigned I = 0; I < N; ++I) {
      uint32_t X = A[65 * R + I], Salted = X ^ R, C;
      double DC;
      if (X & 1) {
        C = scalar_helper(Salted);
        DC = D[65 * R + I] * 3.0;
      } else {
        C = 0u - Salted;
        DC = (double)(int32_t)C;
      }
      if (I & 1) {
        C ^= 37;
        DC *= 0.5;
      }
      S += C;
      DS += DC;
    }
    Out[R] = S;
    Dout[R] = DS;
  }
}

// Count using the actual participation predicates. Simulate only integer row
// feedback for the alias case; output row r overwrites input row 1, element r.
// This determines later row participation without using transformed counters.
static void compact_nested_counts(uint32_t *A, unsigned Rows, unsigned N,
                                   unsigned Lanes, bool Alias,
                                   unsigned *Participants, unsigned *Vectors,
                                   unsigned *Tails) {
  uint32_t Carry = 19;
  *Participants = *Vectors = *Tails = 0;
  for (unsigned R = 0; R < Rows; ++R) {
    unsigned P = 0;
    for (unsigned I = 0; I < N; ++I) {
      uint32_t X = A[R * 65 + I];
      if (X & 1) {
        ++P;
        Carry += scalar_helper(X ^ R);
      }
    }
    *Participants += P;
    *Vectors += P / Lanes;
    *Tails += P % Lanes;
    if (Alias) A[65 + R] = Carry;
  }
}

// Ordinary LLVM FP does not promise a NaN payload. All other bit patterns,
// including the sign of an unchanged zero initial value, must match exactly.
static bool compact_doubles_equal(const double *A, const double *B, unsigned N) {
  for (unsigned I = 0; I < N; ++I)
    if (!(isnan(A[I]) && isnan(B[I])) && memcmp(A + I, B + I, sizeof(*A)))
      return false;
  return true;
}
static bool compact_floats_equal(const float *A, const float *B, unsigned N) {
  for (unsigned I = 0; I < N; ++I)
    if (!(isnan(A[I]) && isnan(B[I])) && memcmp(A + I, B + I, sizeof(*A)))
      return false;
  return true;
}
static void check_interleave_entries(const char *Name, unsigned N,
                                     unsigned Trial, unsigned PVF,
                                     unsigned AVF, unsigned PTVF,
                                     unsigned ATVF, unsigned PMin,
                                     unsigned AMin, unsigned PTMin,
                                     unsigned ATMin) {
  unsigned Active = N && N <= 65 ? N : 0;
  uint64_t PEntries = Active >= PMin ? Active / PVF : 0;
  uint64_t AEntries = Active >= AMin ? Active / AVF : 0;
  unsigned PR = Active - PEntries * PVF, AR = Active - AEntries * AVF;
  uint64_t TailEntries[] = {PTVF && PR >= PTMin ? PR / PTVF : 0,
                            ATVF && AR >= ATMin ? AR / ATVF : 0};
  uint64_t TailLanes[] = {TailEntries[0] * PTVF, TailEntries[1] * ATVF};
  uint64_t Expected[] = {PEntries, PR - TailLanes[0], AEntries, AR - TailLanes[1]};
  if (memcmp(InterleaveEntries, Expected, sizeof(Expected)) ||
      memcmp(InterleaveTailEntries, TailEntries, sizeof(TailEntries)) ||
      memcmp(InterleaveTailLanes, TailLanes, sizeof(TailLanes)) ||
      InterleaveEntries[0] * PVF + InterleaveEntries[1] +
          InterleaveTailLanes[0] != Active ||
      InterleaveEntries[2] * AVF + InterleaveEntries[3] +
          InterleaveTailLanes[1] != Active)
    fail(Name, N, Trial,
         "vector/scalar/ordinary-tail entries or participating lanes mismatch");
  OrdinaryTailEntries += InterleaveTailEntries[0] + InterleaveTailEntries[1];
  OrdinaryTailLanes += InterleaveTailLanes[0] + InterleaveTailLanes[1];
}

// Preserve inherited counts and add the complete finite domain for certified
// dispatch. This covers either stage's threshold and every VF/remainder
// boundary even when the two stages use different minima. N=0/66 and larger
// inherited counts check entry bypass; large vscales can have only scalar work.
static unsigned interleave_counts(unsigned *Values, const unsigned *Inherited,
                                  unsigned Size, bool Certified) {
  memcpy(Values, Inherited, Size * sizeof(*Values));
  unsigned Count = Size;
  if (Certified)
    for (unsigned N = 0; N <= 66; ++N) {
      bool Found = false;
      for (unsigned I = 0; I < Count; ++I) Found |= Values[I] == N;
      if (!Found) Values[Count++] = N;
    }
  return Count;
}

static void dispatch_integer_formula(const uint32_t *A, uint32_t *Out,
                                     uint64_t N, unsigned Factor) {
  uint32_t Sum = 17, Bits = 23;
  if (Factor != 2 && Factor != 3) abort();
  if (N && N <= 65)
    for (uint64_t I = 0; I < N; ++I) {
      uint32_t X = A[Factor * I];
      uint32_t Pair = ((X * 3u) ^ X) - A[Factor * I + 1];
      uint32_t Term = Factor == 2 ? Pair * 7u : Pair + A[Factor * I + 2];
      Sum += Term;
      Bits ^= Term;
    }
  // Stores follow all input loads, including when Out aliases A.
  Out[0] = Sum;
  Out[1] = Bits;
}
static void fill_fp(double *A, unsigned Count, unsigned Trial) {
  for (unsigned I = 0; I < Count; ++I) {
    switch (Trial % 8) {
    case 1: A[I] = 0.0; break;
    case 2: A[I] = -0.0; break;
    case 3: A[I] = (double[]){1e16, 1.0, -1e16, 0.0}[I % 4]; break;
    default: A[I] = (double)(int32_t)random_value() / 1024.0; break;
    }
  }
  if (Trial % 8 == 4) A[0] = NAN;
  if (Trial % 8 == 5) A[0] = INFINITY;
  if (Trial % 8 == 6) { A[0] = INFINITY; A[1] = -INFINITY; }
}
static bool equal_fp(double Actual, double Expected, bool Relaxed,
                     const double *Input, unsigned N, double Start,
                     unsigned Trial) {
  if (!Relaxed)
    return memcmp(&Actual, &Expected, sizeof(double)) == 0;
  if (isnan(Expected)) return isnan(Actual);
  if (isinf(Expected)) return Actual == Expected;
  if (!isfinite(Actual)) return false;
  if ((Trial % 8 == 1 || Trial % 8 == 2) && Expected == 0)
    return Actual == 0 && signbit(Actual) == signbit(Expected);
  // Absolute forward-error bound scaled by the sum of magnitudes, including
  // cancellation. A small relative error against a near-zero sum is invalid.
  double Magnitude = fabs(Start);
  for (unsigned I = 0; I < N; ++I) Magnitude += fabs(Input[I] * 120.0);
  double Error = fabs(Actual - Expected);
  if (Error > MaxError) MaxError = Error;
  return Error <= 16 * DBL_EPSILON * (N + 1) * Magnitude;
}


// Keep this independent of IR names/control expressions. The bounded affine
// fixtures visit the same n items as their canonical siblings. Delay state is
// reset per row; reduction starts carry across rows and writes may alias the
// next row's inputs.
static void reference_recurrence(bool Two, bool Branch, bool Enclosing,
                                  unsigned Capacity, const uint32_t *A,
                                  const double *D, uint32_t *Out, double *Dout,
                                  uint64_t N, uint64_t Rows, double Start) {
  uint32_t S0 = 17, S1 = (uint32_t)-7;
  double DS = Start;
  if (N && N <= Capacity && (!Enclosing || (Rows && Rows <= 4)))
    for (unsigned R = 0; R < (Enclosing ? Rows : 1); ++R) {
      uint32_t Prev = 23, Older = 11;
      double DPrev = -0.0, DOlder = 0.5;
      for (unsigned I = 0; I < N; ++I) {
        unsigned Index = (Enclosing ? 65 * R : 0) + I;
        uint32_t X = A[Index], Raw = Prev ^ X;
        double DX = D[Index];
        bool Left = !Branch || (Prev & 1);
        uint32_t C = Left ? scalar_helper(Raw) : Raw ^ 7;
        double Delta = Left ? DX : DX * 0.5;
        double Contribution = Delta - DPrev;
        uint32_t Next = Two ? (X & 127) + Older : X;
        double DNext = Two ? DX - DOlder : DX;
        S0 += C;
        S1 = C + S1;
        DS += Contribution;
        Older = Prev;
        DOlder = DPrev;
        Prev = Next;
        DPrev = DNext;
      }
      if (Enclosing) {
        Out[0] = S0;
        Out[1] = S1;
        *Dout = DS;
      }
    }
  Out[0] = S0;
  Out[1] = S1;
  *Dout = DS;
}

// Counts come from this independent scalar formula, including alias writes
// between rows. Each row has its own P and consumer rounding/tail.
typedef struct {
  unsigned Iterations, Participants, Vector, Tail;
} CompactRecurrenceCounts;

static CompactRecurrenceCounts reference_compact_recurrence(
    bool Conditional, bool Enclosing, bool AddState, unsigned Capacity, unsigned Lanes,
    const uint32_t *A, const double *D, uint32_t *Out, double *Dout,
    uint64_t N, uint64_t Rows, double Start, int64_t Begin) {
  CompactRecurrenceCounts Counts = {0, 0, 0, 0};
  uint32_t S0 = 17, S1 = (uint32_t)-7;
  double DS = Start;
  unsigned Mode = (uint64_t)Begin & 7;
  if (N && N <= Capacity && (!Enclosing || (Rows && Rows <= 4)))
    for (unsigned R = 0; R < (Enclosing ? Rows : 1); ++R) {
      uint32_t Prev = 23, Older = 11;
      double DPrev = -0.0, DOlder = 0.5;
      unsigned P = 0, Base = Enclosing ? 65 * R : 0;
      for (unsigned I = 0; I < N; ++I) {
        uint32_t X = A[Base + I];
        double DX = D[Base + I];
        bool Participate = Mode == 0 ? false : Mode == 1 ? true :
                           Mode == 3 ? I == 0 : Mode == 4 ? I + 1 == N :
                           Mode == 5 ? DPrev > 0.0 : (Prev & 1) != 0;
        uint32_t Next = Prev;
        double DNext = DPrev;
        if (!Conditional || Participate) {
          Next = (X & 127) + Older;
          DNext = AddState ? DPrev + DX : DX - DOlder;
        }
        if (Participate) {
          unsigned Address = Base + (Prev & 63);
          uint32_t C = scalar_helper(Prev ^ A[Address]);
          double Contribution = D[Address] - DPrev;
          S0 += C;
          S1 = C + S1;
          DS += Contribution;
          ++P;
        }
        Older = Prev;
        DOlder = DPrev;
        Prev = Next;
        DPrev = DNext;
      }
      Counts.Iterations += N;
      Counts.Participants += P;
      Counts.Vector += Lanes ? P / Lanes : 0;
      Counts.Tail += Lanes ? P % Lanes : P;
      if (Enclosing) {
        Out[0] = S0;
        Out[1] = S1;
        *Dout = DS;
      }
    }
  Out[0] = S0;
  Out[1] = S1;
  *Dout = DS;
  return Counts;
}

// Independent formulas for the exact historical feedback/export fixtures.
// Observed accumulators stay scalar; their consumers contain only closed sums.
static unsigned retained_export_oracle(unsigned Kind, const uint32_t *A, const double *D,
                                       uint32_t *Out, double *DOut, uint64_t N,
                                       double Start, unsigned Mode) {
  uint32_t R0 = 17, R1 = (uint32_t)-7, Prev = 23, Older = 11;
  uint32_t LastR0 = 17, LastPrev = 23;
  double RD = Start, DP = -0.0, DO = 0.5;
  unsigned P = 0;
  if (N && N <= 65)
    for (unsigned I = 0; I < N; ++I) {
      uint32_t X = A[Kind == 3 ? R0 : I];
      double DX = D[I];
      uint32_t Next = (X & 127) + Older;
      double DN = DX - DO;
      LastR0 = R0;
      LastPrev = Prev;
      bool Active = Kind < 7 || (Mode == 0 ? false : Mode == 1 ? true :
                                 Mode == 3 ? I == 0 : Mode == 4 ? I+1 == N :
                                 Mode == 5 ? DP > 0.0 :
                                 ((Kind == 7 ? R0 : Prev) & 1) != 0);
      if (Active) {
        unsigned Address = Kind >= 7 ? ((Kind == 9 ? R0 : Prev) & 63) : I;
        uint32_t Raw = (Kind == 0 ? R0 : Prev) ^ A[Kind == 3 ? LastR0 : Address];
        bool Left = Kind != 4 || (R0 & 1);
        uint32_t C = Left ? scalar_helper(Raw) : Raw ^ 7;
        double DC = (Kind >= 7 ? D[Address] : Left ? DX : DX * 0.5) - DP;
        R0 += C;
        R1 += Kind == 2 ? R0 : C;
        RD = RD + DC;
        ++P;
      }
      if (Kind == 1) Next = R0;
      if (Kind == 8) Next = (X & 127) + R0;
      Older = Prev;
      Prev = Next;
      DO = DP;
      DP = DN;
    }
  Out[0] = R0 + (Kind == 5 ? LastR0 : Kind == 6 || Kind == 10 ? LastPrev : 0);
  Out[1] = R1;
  *DOut = RD;
  return P;
}

static void check_retained_exports(void) {
  uint32_t SavedSeed = Seed;
  unsigned Total = 0;
  for (unsigned C = 0; C < sizeof(RetainedExports) / sizeof(*RetainedExports); ++C) {
    unsigned Kind = RetainedExports[C].Mode, Lanes = RetainedExports[C].VectorLanes;
    unsigned Runs = 0, Vectors = 0, Tails = 0;
    for (unsigned K = 0; K < 68; ++K)
      for (unsigned Mode = 0; Mode < (Kind >= 7 ? 6u : 1u); ++Mode)
        for (unsigned Trial = 0; Trial < 8; ++Trial)
          for (unsigned Alias = 0; Alias < 2; ++Alias) {
            uint64_t N = K == 67 ? UINT64_MAX : K;
            // The original address-feedback fixture has an unbounded R0 GEP.
            // N=0/1 and entry bypasses are defined without inventing a bound.
            if (Kind == 3 && N > 1 && N <= 65) continue;
            bool Enter = N && N <= 65;
            uint32_t Actual[68], Original[68], Independent[68];
            double AD[68], OD[68], ID[68];
            for (unsigned I = 0; I < 68; ++I) Actual[I] = Trial < 2 ? 0 : random_value();
            fill_fp(AD, 68, Trial);
            memcpy(Original, Actual, sizeof(Actual));
            memcpy(Independent, Actual, sizeof(Actual));
            memcpy(OD, AD, sizeof(AD));
            memcpy(ID, AD, sizeof(AD));
            uint32_t AO[4] = {111,0,0,222}, OO[4] = {111,0,0,222}, IO[4] = {111,0,0,222};
            double ADO[3] = {3.5,0,-7.5}, ODO[3] = {3.5,0,-7.5}, IDO[3] = {3.5,0,-7.5};
            double Start = Trial & 1 ? 0.25 : -0.0;
            unsigned P = retained_export_oracle(Kind, Enter ? Independent : NULL,
                Enter ? ID : NULL, Alias ? Independent+1 : IO+1, Alias ? ID+1 : IDO+1, N, Start, Mode);
            RetainedExports[C].Reference(Enter ? Original : NULL, Enter ? OD : NULL,
                Alias ? Original+1 : OO+1, Alias ? OD+1 : ODO+1, N, 1, Start, Mode);
            if (memcmp(Original, Independent, sizeof(Original)) || memcmp(OO, IO, sizeof(OO)) ||
                !compact_doubles_equal(OD, ID, 68) || !compact_doubles_equal(ODO, IDO, 3))
              fail(RetainedExports[C].Name, N, Trial, "retained original / independent formula");
            AcyclicIterations = AcyclicLatches = ScalarVectorVisits = ScalarTailVisits = 0;
            RetainedExports[C].Fn(Enter ? Actual : NULL, Enter ? AD : NULL,
                Alias ? Actual+1 : AO+1, Alias ? AD+1 : ADO+1, N, 1, Start, Mode);
            unsigned V = Lanes ? P / Lanes : 0, T = Lanes ? P % Lanes : P;
            if (memcmp(Actual, Original, sizeof(Actual)) || memcmp(AO, OO, sizeof(AO)) ||
                !compact_doubles_equal(AD, OD, 68) || !compact_doubles_equal(ADO, ODO, 3) ||
                AcyclicIterations != (Enter ? N : 0) || AcyclicLatches != (Enter ? N : 0) ||
                ScalarVectorVisits != V || ScalarTailVisits != T)
              fail(RetainedExports[C].Name, N, Trial, "retained transformed result/count/alias/canary");
            Vectors += V;
            Tails += T;
            ++Runs;
          }
    if (!Runs || !Tails || (Kind != 3 && Lanes && Lanes <= 65 && !Vectors)) abort();
    printf("Retained export %s: %u comparisons, vector=%u tail=%u\n",
           RetainedExports[C].Name, Runs, Vectors, Tails);
    Total += Runs;
  }
  Seed = SavedSeed;
  printf("Retained exports: %u additional host comparisons (not RVV execution)\n", Total);
  for (unsigned C = 0; C < sizeof(CrossRetention) / sizeof(*CrossRetention); ++C) {
    unsigned Runs = 0;
    for (unsigned K = 0; K < 68; ++K)
      for (unsigned Trial = 0; Trial < 8; ++Trial) {
        uint64_t N = K == 67 ? UINT64_MAX : K;
        uint32_t A[66], Saved[66], Expected = 19;
        for (unsigned I = 0; I < 66; ++I) A[I] = Trial == 0 ? 0 : Trial == 1 ? 1 : random_value();
        memcpy(Saved, A, sizeof(A));
        if (N && N <= 65)
          for (unsigned I = 0; I < N; ++I) if (A[I]) Expected += A[I];
        const uint32_t *Input = N && N <= 65 ? A : NULL;
        if (CrossRetention[C].Reference(Input, N) != Expected ||
            CrossRetention[C].Fn(Input, N) != Expected || memcmp(A, Saved, sizeof(A)))
          fail(CrossRetention[C].Name, N, Trial, "retained cross reduction result/input");
        ++Runs;
      }
    printf("Cross retention %s: %u original/transformed/formula comparisons\n", CrossRetention[C].Name, Runs);
  }
  Seed = SavedSeed;
}

static void check_compact_delays(void) {
  uint32_t SavedSeed = Seed;
  unsigned Comparisons = 0;
  for (unsigned C = 0; C < sizeof(CompactDelays) / sizeof(*CompactDelays); ++C)
    for (unsigned K = 0; K < 68; ++K)
      for (unsigned Trial = 0; Trial < 8; ++Trial) {
        uint64_t N = K == 67 ? UINT64_MAX : K;
        uint32_t A[65], Expected = 17, Prev = 23;
        unsigned P = 0, Trips = N && N <= 65 ? N : 0;
        for (unsigned I = 0; I < 65; ++I)
          A[I] = Trial == 0 ? 0 : Trial == 1 ? 1 : Trial == 2 ? I & 1 :
                 Trial == 3 ? I == 0 : Trial == 4 ? I + 1 == Trips : random_value();
        for (unsigned I = 0; I < Trips; ++I) {
          if (A[I]) {
            Expected += scalar_helper(Prev);
            ++P;
          }
          Prev = A[I];
        }
        uint32_t Ref = CompactDelays[C].Reference(Trips ? A : NULL, N);
        AcyclicIterations = AcyclicLatches = CompactParticipants = 0;
        ScalarVectorVisits = ScalarTailVisits = 0;
        uint32_t Actual = CompactDelays[C].Fn(Trips ? A : NULL, N);
        unsigned Lanes = CompactDelays[C].VectorLanes;
        if (Actual != Ref || Ref != Expected || AcyclicIterations != Trips ||
            AcyclicLatches != Trips || CompactParticipants != P ||
            ScalarVectorVisits != (Lanes ? P / Lanes : 0) ||
            ScalarTailVisits != (Lanes ? P % Lanes : P))
          fail(CompactDelays[C].Name, (unsigned)N, Trial, "historical compact delay formula/result/count");
        ++Comparisons;
      }
  Runs += Comparisons;
  Seed = SavedSeed;
  printf("Historical compact delay: %u original/transformed/formula comparisons\n", Comparisons);
}

static void check_compact_recurrences(void) {
  uint32_t SavedSeed = Seed;
  static uint32_t A[5528], Actual[5528], Ref[5528], Formula[5528];
  static double D[5528], ActualD[5528], RefD[5528], FormulaD[5528];
  static const uint64_t RowCounts[] = {0, 1, 2, 4, 5, UINT64_MAX};
  static const int64_t Origins[] = {INT64_MIN, -8, 0, 248, 256, INT64_MAX - 7};
  unsigned Comparisons = 0, VectorRuns = 0, TailRuns = 0;
  for (unsigned C = 0; C < sizeof(CompactRecurrences) / sizeof(*CompactRecurrences); ++C) {
    unsigned Capacity = CompactRecurrences[C].Capacity;
    unsigned Size = CompactRecurrences[C].Enclosing ? 262 : Capacity + 65;
    unsigned Lanes = CompactRecurrences[C].VectorLanes;
    bool SawZero = false, SawEmpty = false, SawAll = false, SawSparse = false;
    bool SawVector = false, SawTail = false, SawBoundary = false;
    bool SawFirst = false, SawLast = false, SawMixed = false, SawExact = false;
    for (unsigned K = 0; K < (Capacity == 65 ? 68u : 12u); ++K)
      for (unsigned R = 0; R < (CompactRecurrences[C].Enclosing ? 6u : 1u); ++R)
        for (unsigned Mode = 0; Mode < 6; ++Mode)
          for (unsigned Trial = 0; Trial < 8; ++Trial) {
            uint64_t N = Capacity == 65 ? (K == 67 ? UINT64_MAX : K) :
                         (uint64_t[]){0, 1, 2, 3, 4, 7, 8, Capacity / 2,
                                      Capacity - 1, Capacity, Capacity + 1, UINT64_MAX}[K];
            uint64_t Rows = CompactRecurrences[C].Enclosing ? RowCounts[R] : 1;
            bool Enter = N && N <= Capacity && Rows && Rows <= 4;
            int64_t Begin = (int64_t)((uint64_t)Origins[Trial % 6] | Mode);
            double Start = Trial % 2 ? 3.5 : -0.0;
            for (unsigned I = 0; I < Size; ++I)
              A[I] = Trial == 0 ? 0 : Trial == 1 ? UINT32_MAX :
                     Trial == 2 ? I : random_value();
            fill_fp(D, Size, Trial);
            for (unsigned Alias = 0; Alias < 2; ++Alias) {
              memcpy(Actual, A, Size * sizeof(*A));
              memcpy(Ref, A, Size * sizeof(*A));
              memcpy(Formula, A, Size * sizeof(*A));
              memcpy(ActualD, D, Size * sizeof(*D));
              memcpy(RefD, D, Size * sizeof(*D));
              memcpy(FormulaD, D, Size * sizeof(*D));
              uint32_t Out[4] = {123, 0, 0, 456}, RefOut[4] = {123, 0, 0, 456}, FOut[2];
              double Dout[3] = {17.5, 0.0, -19.5}, RDout[3] = {17.5, 0.0, -19.5}, FDout;
              unsigned Offset = CompactRecurrences[C].Enclosing ? 65 : 0;
              CompactRecurrenceCounts Expected = reference_compact_recurrence(
                  CompactRecurrences[C].Conditional, CompactRecurrences[C].Enclosing,
                  CompactRecurrences[C].AddState, Capacity, Lanes,
                  Enter ? Formula : NULL, Enter ? FormulaD : NULL,
                  Alias ? Formula + Offset : FOut, Alias ? FormulaD + Offset : &FDout,
                  N, Rows, Start, Begin);
              CompactRecurrences[C].Reference(Enter ? Ref : NULL, Enter ? RefD : NULL,
                  Alias ? Ref + Offset : RefOut + 1, Alias ? RefD + Offset : RDout + 1,
                  N, Rows, Start, Begin);
              if ((Alias && (memcmp(Formula, Ref, Size * sizeof(*Ref)) ||
                             !compact_doubles_equal(FormulaD, RefD, Size))) ||
                  (!Alias && (memcmp(FOut, RefOut + 1, sizeof(FOut)) ||
                              !compact_doubles_equal(&FDout, RDout + 1, 1))))
                fail(CompactRecurrences[C].Name, (unsigned)N, Trial, "compact state original / formula");
              AcyclicIterations = AcyclicLatches = CompactParticipants = 0;
              ScalarVectorVisits = ScalarTailVisits = 0;
              CompactRecurrences[C].Fn(Enter ? Actual : NULL, Enter ? ActualD : NULL,
                  Alias ? Actual + Offset : Out + 1, Alias ? ActualD + Offset : Dout + 1,
                  N, Rows, Start, Begin);
              if (memcmp(Actual, Ref, Size * sizeof(*Ref)) ||
                  !compact_doubles_equal(ActualD, RefD, Size) ||
                  (!Alias && (memcmp(Out, RefOut, sizeof(Out)) ||
                              !compact_doubles_equal(Dout, RDout, 3))) ||
                  AcyclicIterations != Expected.Iterations ||
                  AcyclicLatches != Expected.Iterations ||
                  CompactParticipants != Expected.Participants ||
                  ScalarVectorVisits != Expected.Vector || ScalarTailVisits != Expected.Tail)
                fail(CompactRecurrences[C].Name, (unsigned)N, Trial, "compact state result/alias/canary/count");
              if (Mode == 0 && Expected.Participants != 0)
                fail(CompactRecurrences[C].Name, (unsigned)N, Trial, "empty stream formula");
              if (Mode == 1 && Expected.Participants != Expected.Iterations)
                fail(CompactRecurrences[C].Name, (unsigned)N, Trial, "all active formula");
              if ((Mode == 3 || Mode == 4) &&
                  Expected.Participants != (Enter ? (CompactRecurrences[C].Enclosing ? Rows : 1) : 0))
                fail(CompactRecurrences[C].Name, (unsigned)N, Trial, "first/last only formula");
              SawZero |= N == 0;
              SawEmpty |= Expected.Iterations && !Expected.Participants;
              SawAll |= Expected.Participants && Expected.Participants == Expected.Iterations;
              SawSparse |= Expected.Participants && Expected.Participants < Expected.Iterations;
              SawBoundary |= Enter && N == Capacity && Mode == 1;
              SawFirst |= Enter && Mode == 3;
              SawLast |= Enter && Mode == 4;
              SawVector |= Expected.Vector != 0;
              SawTail |= Expected.Tail != 0;
              SawMixed |= Expected.Vector && Expected.Tail;
              SawExact |= Expected.Vector && !Expected.Tail;
              VectorRuns += Expected.Vector != 0;
              TailRuns += Expected.Tail != 0;
              ++Comparisons;
            }
          }
    if (!SawZero || !SawEmpty || !SawAll || !SawBoundary || !SawFirst || !SawLast ||
        !SawTail || (Capacity > 1 && !SawSparse) ||
        (Lanes && Lanes <= Capacity && (!SawVector || !SawExact)) ||
        (Lanes && Lanes < Capacity && !SawMixed))
      fail(CompactRecurrences[C].Name, Capacity, 0, "compact state coverage missing");
  }
  Runs += Comparisons;
  Seed = SavedSeed;
  printf("Compact producer recurrences: %u comparisons, %u vector runs, %u tail runs; "
         "exact N/P, aliases, starts, ordered FP and row reuse\n",
         Comparisons, VectorRuns, TailRuns);
}

static void check_recurrences(void) {
  uint32_t SavedSeed = Seed;
  static uint32_t A[5463], Actual[5463], Ref[5463], Formula[5463];
  static double D[5463], ActualD[5463], RefD[5463], FormulaD[5463];
  static const uint64_t RowCounts[] = {0, 1, 2, 4, 5, UINT64_MAX};
  static const int64_t Origins[] = {INT64_MIN, -1, 0, 255, 256, INT64_MAX};
  unsigned VectorRuns = 0, TailRuns = 0, Comparisons = 0;
  for (unsigned C = 0; C < sizeof(Recurrences) / sizeof(*Recurrences); ++C) {
    unsigned Capacity = Recurrences[C].Capacity;
    unsigned Size = Recurrences[C].Enclosing ? 262 : Capacity + 2;
    unsigned Lanes = Recurrences[C].VectorLanes;
    bool SawVector = false, SawTail = false, SawFull = false, SawZero = false, SawOne = false;
    for (unsigned K = 0; K < (Capacity == 65 ? 68u : 12u); ++K)
      for (unsigned R = 0; R < (Recurrences[C].Enclosing ? 6u : 1u); ++R)
        for (unsigned Trial = 0; Trial < 16; ++Trial) {
          uint64_t N = Capacity == 65 ? (K == 67 ? UINT64_MAX : K) :
                       (uint64_t[]){0, 1, 2, 3, 4, 7, 8, Capacity / 2,
                                    Capacity - 1, Capacity, Capacity + 1, UINT64_MAX}[K];
          uint64_t Rows = Recurrences[C].Enclosing ? RowCounts[R] : 1;
          unsigned ActiveRows = N && N <= Capacity && Rows && Rows <= 4 ? Rows : 0;
          unsigned ActiveN = ActiveRows ? N : 0;
          unsigned V = Lanes ? ActiveRows * (ActiveN / Lanes) : 0;
          unsigned T = ActiveRows * (Lanes ? ActiveN % Lanes : ActiveN);
          SawFull |= ActiveRows && N == Capacity;
          SawZero |= N == 0;
          SawOne |= ActiveRows && N == 1;
          double Start = Trial % 2 ? 3.5 : -0.0;
          int64_t Begin = Origins[Trial % 6];
          for (unsigned I = 0; I < Size; ++I)
            A[I] = Trial / 2 == 0 ? 0 : Trial / 2 == 1 ? UINT32_MAX :
                   Trial / 2 == 2 ? I : random_value();
          fill_fp(D, Size, Trial);
          const uint32_t *Input = ActiveRows ? A : NULL;
          const double *FPInput = ActiveRows ? D : NULL;
          memcpy(Actual, A, Size * sizeof(*A));
          memcpy(ActualD, D, Size * sizeof(*D));
          uint32_t Out[4] = {123, 0, 0, 456}, RefOut[4] = {123, 0, 0, 456}, FOut[2];
          double Dout[3] = {17.5, 0.0, -19.5}, RDout[3] = {17.5, 0.0, -19.5}, FDout;
          reference_recurrence(Recurrences[C].Two, Recurrences[C].Branch,
                               Recurrences[C].Enclosing, Capacity, Input, FPInput,
                               FOut, &FDout, N, Rows, Start);
          Recurrences[C].Reference(Input, FPInput, RefOut + 1, RDout + 1,
                                    N, Rows, Start, Begin);
          if (memcmp(FOut, RefOut + 1, sizeof(FOut)) ||
              !compact_doubles_equal(&FDout, RDout + 1, 1))
            fail(Recurrences[C].Name, (unsigned)N, Trial, "recurrence original / formula");
          AcyclicIterations = AcyclicLatches = ScalarVectorVisits = ScalarTailVisits = 0;
          Recurrences[C].Fn(Input, FPInput, Out + 1, Dout + 1, N, Rows, Start, Begin);
          if (memcmp(Out, RefOut, sizeof(Out)) || !compact_doubles_equal(Dout, RDout, 3) ||
              memcmp(A, Actual, Size * sizeof(*A)) ||
              memcmp(D, ActualD, Size * sizeof(*D)) ||
              AcyclicIterations != ActiveRows * ActiveN ||
              AcyclicLatches != ActiveRows * ActiveN ||
              ScalarVectorVisits != V || ScalarTailVisits != T)
            fail(Recurrences[C].Name, (unsigned)N, Trial, "recurrence result/canary/count");
          SawVector |= V != 0;
          SawTail |= T != 0;
          VectorRuns += V != 0;
          TailRuns += T != 0;

          // Compare the entire arrays, including all unwritten elements.
          // Alias writes in an enclosing loop alter the following row. The
          // independent formula, original IR and split stages see those writes.
          memcpy(Actual, A, Size * sizeof(*A));
          memcpy(Ref, A, Size * sizeof(*A));
          memcpy(Formula, A, Size * sizeof(*A));
          memcpy(ActualD, D, Size * sizeof(*D));
          memcpy(RefD, D, Size * sizeof(*D));
          memcpy(FormulaD, D, Size * sizeof(*D));
          unsigned Offset = Recurrences[C].Enclosing ? 65 : 0;
          reference_recurrence(Recurrences[C].Two, Recurrences[C].Branch,
                               Recurrences[C].Enclosing, Capacity,
                               ActiveRows ? Formula : NULL, ActiveRows ? FormulaD : NULL,
                               Formula + Offset, FormulaD + Offset, N, Rows, Start);
          Recurrences[C].Reference(ActiveRows ? Ref : NULL, ActiveRows ? RefD : NULL,
                                    Ref + Offset, RefD + Offset, N, Rows, Start, Begin);
          if (memcmp(Formula, Ref, Size * sizeof(*Ref)) ||
              !compact_doubles_equal(FormulaD, RefD, Size))
            fail(Recurrences[C].Name, (unsigned)N, Trial, "recurrence original / formula alias");
          AcyclicIterations = AcyclicLatches = ScalarVectorVisits = ScalarTailVisits = 0;
          Recurrences[C].Fn(ActiveRows ? Actual : NULL, ActiveRows ? ActualD : NULL,
                             Actual + Offset, ActualD + Offset, N, Rows, Start, Begin);
          if (memcmp(Actual, Ref, Size * sizeof(*Ref)) ||
              !compact_doubles_equal(ActualD, RefD, Size) ||
              AcyclicIterations != ActiveRows * ActiveN ||
              AcyclicLatches != ActiveRows * ActiveN ||
              ScalarVectorVisits != V || ScalarTailVisits != T)
            fail(Recurrences[C].Name, (unsigned)N, Trial, "recurrence alias/reuse/count");
          Comparisons += 2;
        }
    if (!SawFull || !SawZero || !SawOne || !SawTail ||
        (Lanes && Lanes <= Capacity && !SawVector))
      fail(Recurrences[C].Name, Capacity, 0, "recurrence coverage missing");
  }
  Runs += Comparisons;
  Seed = SavedSeed;
  printf("Producer recurrences: %u comparisons, %u vector runs, %u tail runs; "
         "original IR / transformed / independent formulas; exact counts and scratch reuse\n",
         Comparisons, VectorRuns, TailRuns);
}


static void check_deinterleave_adapter(void) {
  // The oracle is scalar AoS indexing, independent of the Python adapter's
  // shuffle masks. Byte copies compare integer and double representations,
  // including signed zeros, infinities and NaN payloads, without FP arithmetic.
  enum { MaxElements = @ADAPTER_MAX_ELEMENTS@ };
  uint64_t Input[MaxElements], Saved[MaxElements];
  uint64_t Output[2 * MaxElements + 2], Expected[2 * MaxElements + 2];
  unsigned Comparisons = 0;
  for (unsigned C = 0; C < sizeof(Adapters) / sizeof(*Adapters); ++C)
    for (unsigned Trial = 0; Trial < 8; ++Trial) {
      unsigned F = Adapters[C].Factor, L = Adapters[C].Lanes;
      unsigned Bytes = Adapters[C].ElementBytes;
      for (unsigned I = 0; I < MaxElements; ++I)
        Input[I] = random_wide_value();
      // Include distinct boundary representations in the double probes as
      // well as arbitrary payloads. No C floating operation can quiet a NaN.
      static const uint64_t Special[] = {
          UINT64_C(0), UINT64_C(0x8000000000000000),
          UINT64_C(0x7ff0000000000000), UINT64_C(0xfff0000000000000),
          UINT64_C(0x7ff8000000001234), UINT64_C(0xfff8000000005678),
          UINT64_C(0x0000000000000001), UINT64_C(0x7fefffffffffffff)};
      memcpy(Input, &Special[Trial], Bytes);
      memcpy((unsigned char *)Input + (F * L - 1) * Bytes,
             &Special[7 - Trial], Bytes);
      memcpy(Saved, Input, sizeof(Input));
      for (unsigned I = 0; I < 2 * MaxElements + 2; ++I)
        Output[I] = Expected[I] = random_wide_value();
      unsigned char *Ref = (unsigned char *)(Expected + 1);
      const unsigned char *Source = (const unsigned char *)Input;
      for (unsigned Use = 0; Use < 2; ++Use)
        for (unsigned Member = 0; Member < F; ++Member)
          for (unsigned Lane = 0; Lane < L; ++Lane) {
            unsigned ToMember = Use == 0 ? Member : F - 1 - Member;
            size_t To = ((Use * F + ToMember) * L + Lane) * Bytes;
            size_t From = (F * Lane + Member) * Bytes;
            memcpy(Ref + To, Source + From, Bytes);
          }
      Adapters[C].Fn(Input, Output + 1);
      if (memcmp(Output, Expected, sizeof(Output)))
        fail(Adapters[C].Name, L, Trial, "adapter lane/aggregate/canary mismatch");
      if (memcmp(Input, Saved, sizeof(Input)))
        fail(Adapters[C].Name, L, Trial, "adapter input modified");
      ++Comparisons;
    }
  for (unsigned C = 0; C < sizeof(AdapterPoison) / sizeof(*AdapterPoison); ++C) {
    if (AdapterPoison[C].Fn() != (UINT32_C(17) ^ (uint32_t)-19))
      fail(AdapterPoison[C].Name, 0, 0, "defined lane contaminated by poison");
    ++Comparisons;
  }
  printf("PASS: %u host deinterleave adapter comparisons against scalar indexing\n",
         Comparisons);
}

// Independent producer/export oracle. It evaluates each original producer
// once, retains its last iteration (including inactive iterations), and writes
// outputs only after that row's reductions. No transformed IR/probes are used
// to calculate expected values or participation, including aliased future rows.
typedef struct {
  uint32_t A[262], Out[22];
  double D[262], DOut[10];
  float FOut[10];
  uint64_t Indices[10];
} ExportState;

typedef struct {
  unsigned Iterations, Participants, Vectors, Tails, Empty, Bypasses, InactiveFinal;
  unsigned CFGBypasses[3];
} ExportCounts;

static void export_oracle(unsigned Mode, const uint32_t *A, const double *D,
                           uint32_t *Out, uint64_t *Indices, double *DOut,
                           float *FOut, uint64_t Rows, uint64_t N, double Start,
                           unsigned Lanes, ExportCounts *Counts) {
  unsigned Control = Mode;
  bool Stateful = Mode >= 16;
  if (Mode >= 4) {
    static const unsigned Bases[] = {0, 1, 1, 0, 2, 1, 1, 3, 2, 2, 2, 3, 2, 2, 2};
    Mode = Bases[Mode - 4];
  }
  bool Nested = Mode == 3, Compact = Mode >= 2;
  bool Enter = N && N <= 65;
  Counts->Bypasses = !Enter || (Nested && (!Rows || Rows > 4));
  if (Nested && (!Enter || !Rows || Rows > 4)) return;
  uint32_t R0 = 17, R1 = (uint32_t)-7, Salt = 3;
  double RD = Start;
  float RF = (float)Start;
  for (unsigned Row = 0; Row < (Nested ? Rows : 1); ++Row) {
    uint32_t State = 23;
    uint32_t LastX = (uint32_t)-99, LastC = (uint32_t)-101;
    double LastD = -0.0;
    float LastF = -0.0f;
    uint64_t Current = UINT64_MAX, Next = 0;
    unsigned P = 0, Base = Nested ? 65 * Row : 0;
    if (Enter) {
      for (unsigned I = 0; I < N; ++I) {
        LastX = A[Base + I];
        bool Active = Mode == 0 || LastX != 0;
        // Only serial/nested use rows==2 to select a state-bit predicate.
        // Affine participation is x!=0, even after right1 makes state even.
        if ((Control == 16 || Control == 17) && Rows == 2)
          Active = Active && (State & 1);
        if (Active) {
          uint32_t Arg = LastX;
          if (Mode != 0) {
            int64_t Divisor = LastX <= INT32_MAX ? (int64_t)LastX :
                              (int64_t)LastX - INT64_C(4294967296);
            Arg = (uint32_t)(INT64_C(840) / Divisor);
          }
          if (Control == 12 || Control == 16) {
            uint32_t Bias = I & 1 ? LastX + 23 : LastX - 9;
            uint32_t Extra = LastX > 5 ? Bias + 5 : Bias ^ 3;
            Arg ^= Extra;
          } else if (Control >= 13) {
            Arg = LastX > 5 ? Arg + (I & 1 ? 23 : 5) : Arg ^ UINT32_MAX;
          }
          if (Nested) Arg ^= Salt;
          if (Stateful) Arg ^= State;
          LastC = scalar_helper(Arg);
          LastD = D[Base + I] * 3.0;
          LastF = (float)LastD;
        } else {
          LastC = LastX ^ 7;
          LastD = -0.0;
          LastF = -0.0f;
          if (Control >= 12) {
            unsigned Edge = (Control == 14 || Control == 15 || Control == 18) ? I % 3 : 0;
            ++Counts->CFGBypasses[Edge];
            if (Stateful && (Control != 18 || Edge == 1)) State += LastX + 1;
          }
        }
        if (Control == 9) {
          // The serial diamond follows the original conditional producer.
          LastC = I & 1 ? LastC + 23 : LastC ^ UINT32_MAX;
          LastD *= I & 1 ? 0.5 : -1.0;
          LastF = (float)LastD;
        } else if (Control == 10 && Active) {
          // Nested diamond exists only on the original active arm.
          LastC = LastX > 5 ? LastC + 23 : LastC ^ UINT32_MAX;
        }
        if (!Compact || Active) {
          R0 += LastC;
          R1 = LastC + R1;
          RD = RD + LastD;
          RF = RF + LastF;
          ++P;
        }
        Current = Control < 4 || Control == 12 || Control == 16 ? I : Control == 4 ? 7 + I :
                  Control == 6 ? 137 - 2 * I : 7 + 2 * I;
        Next = Control < 4 || Control == 12 || Control == 16 ? I + 1 : Control == 4 ? Current + 1 :
               Control == 6 ? Current - 2 : Current + 2;
      }
      Counts->Iterations += N;
      Counts->Participants += P;
      Counts->Vectors += Lanes ? P / Lanes : 0;
      Counts->Tails += Lanes ? P % Lanes : P;
      Counts->Empty += Compact && P == 0;
      Counts->InactiveFinal += Mode != 0 && LastX == 0;
    }
    unsigned O = Nested ? Row * 5 : 0, F = Nested ? Row * 2 : 0;
    Out[O] = R0;
    Out[O + 1] = R1;
    Out[O + 2] = LastX;
    Out[O + 3] = LastC;
    Out[O + 4] = Stateful ? State : LastC;
    Indices[F] = Current;
    Indices[F + 1] = Next;
    DOut[F] = RD;
    DOut[F + 1] = LastD;
    FOut[F] = RF;
    FOut[F + 1] = LastF;
    Salt = LastC;
  }
}

static void init_export_state(ExportState *S, unsigned N, unsigned P,
                              unsigned Layout, unsigned Trial) {
  // Include padding in the bitwise state comparisons and preserve canaries
  // before/after every typed output and the input arrays.
  memset(S, 0x5a, sizeof(*S));
  static const double Values[] = {0.0, -0.0, 0x1p54, -0x1p54,
                                   0.25, -0.125, 1.0, -1.0};
  for (unsigned R = 0; R < 4; ++R)
    for (unsigned I = 0; I < 65; ++I) {
      // Retain the inherited prefix/suffix layouts. New export controls also
      // exercise exactly P evenly spaced participants among N iterations.
      bool Active = Layout == 2 ? I < N && (I + 1) * P / N != I * P / N :
                    Layout ? I < N && I >= N - P : I < P;
      S->A[1 + 65 * R + I] = Active ? 1 + (I + R) % 13 : 0;
      S->D[1 + 65 * R + I] = Trial == 0 ? -0.0 :
                                      Values[(I + R + Trial) % 8];
    }
}

static void export_pointers(ExportState *S, bool Nested, bool Alias,
                            bool NoInput, bool NoFP, const uint32_t **A,
                            const double **D, uint32_t **Out, double **DOut) {
  *A = NoInput ? NULL : S->A + 1;
  *D = NoFP ? NULL : S->D + 1;
  *Out = Alias ? S->A + 1 + (Nested ? 65 : 0) : S->Out + 1;
  *DOut = Alias ? S->D + 1 + (Nested ? 65 : 0) : S->DOut + 1;
}

static void check_state_cfg_participation(unsigned C) {
  // Literal masks/state exports from the three ORIGINAL fixtures, independent
  // of export_oracle and the transformed probes. Bit I denotes iteration I.
  // N=3, pattern=1 includes both first-only and last-only layouts; last-only
  // makes affine's state even before a nonzero final input. Serial/nested
  // also need cases where parity suppresses a nonzero input, recovers, or
  // leaves P=0 with a nonzero final input. Rows=1 must ignore state parity.
  static const struct {
    uint32_t Input[3];
    unsigned Mask[3][2]; // serial, nested, affine; Rows=1,2
    uint32_t State[3][2];
  } Cases[] = {
      {{1, 0, 0}, {{1, 1}, {1, 1}, {1, 1}}, {{25, 25}, {25, 25}, {24, 24}}},
      {{0, 0, 3}, {{4, 4}, {4, 4}, {4, 4}}, {{25, 25}, {25, 25}, {24, 24}}},
      {{0, 2, 3}, {{6, 4}, {6, 4}, {6, 6}}, {{24, 27}, {24, 27}, {23, 23}}},
      {{0, 1, 3}, {{6, 0}, {6, 0}, {6, 6}}, {{24, 30}, {24, 30}, {23, 23}}},
      {{1, 0, 3}, {{5, 1}, {5, 1}, {5, 5}}, {{24, 28}, {24, 28}, {24, 24}}},
      {{1, 2, 3}, {{7, 7}, {7, 7}, {7, 7}}, {{23, 23}, {23, 23}, {23, 23}}},
      {{0, 0, 0}, {{0, 0}, {0, 0}, {0, 0}}, {{26, 26}, {26, 26}, {24, 24}}},
  };
  unsigned Control = Exports[C].Mode, Lanes = Exports[C].VectorLanes, Runs = 0;
  if (Control < 16 || Control > 18) abort();
  for (unsigned K = 0; K < sizeof(Cases) / sizeof(*Cases); ++K)
    for (unsigned R = 0; R < 2; ++R)
      for (unsigned Trial = 0; Trial < 2; ++Trial) {
        unsigned Mask = Cases[K].Mask[Control - 16][R], P = 0, Edges[3] = {0};
        for (unsigned I = 0; I < 3; ++I) {
          P += (Mask >> I) & 1;
          if (!(Mask & (1u << I))) ++Edges[Control == 18 ? I % 3 : 0];
        }
        double Start = Trial ? 0.25 : -0.0;
        ExportState Actual, Original, Independent;
        init_export_state(&Actual, 3, 0, 0, 0);
        memcpy(Actual.A + 1, Cases[K].Input, sizeof(Cases[K].Input));
        Actual.D[1] = 1.0;
        Actual.D[2] = -0.5;
        Actual.D[3] = 0.25;
        memcpy(&Original, &Actual, sizeof(Original));
        memcpy(&Independent, &Actual, sizeof(Independent));
        ExportCounts Expected = {0};
        export_oracle(Control, Independent.A + 1, Independent.D + 1,
                      Independent.Out + 1, Independent.Indices + 1,
                      Independent.DOut + 1, Independent.FOut + 1,
                      R + 1, 3, Start, Lanes, &Expected);
        // Reintroducing the overbroad Stateful && Rows==2 predicate fails
        // here for the affine last-only case, before any transformed call.
        if (Expected.Iterations != 3 || Expected.Participants != P ||
            Expected.Vectors != (Lanes ? P / Lanes : 0) ||
            Expected.Tails != (Lanes ? P % Lanes : P) ||
            Expected.Empty != (P == 0) || Expected.Bypasses ||
            Expected.InactiveFinal != (Cases[K].Input[2] == 0) ||
            memcmp(Expected.CFGBypasses, Edges, sizeof(Edges)) ||
            Independent.Out[3] != Cases[K].Input[2] ||
            (!(Mask & 4) && Independent.Out[4] != (Cases[K].Input[2] ^ 7)) ||
            Independent.Indices[1] != (Control == 16 ? 2u : 11u) ||
            Independent.Indices[2] != (Control == 16 ? 3u : 13u) ||
            Independent.Out[5] != Cases[K].State[Control - 16][R])
          fail(Exports[C].Name, 3, K, "state CFG literal participation/state oracle");
        Exports[C].Reference(Original.A + 1, Original.D + 1, Original.Out + 1,
                             Original.Indices + 1, Original.DOut + 1,
                             Original.FOut + 1, R + 1, 3, Start);
        if (memcmp(&Original, &Independent, sizeof(Original)))
          fail(Exports[C].Name, 3, K, "state CFG original / oracle exports/reductions/canaries");
        reset_compact_probes();
        Exports[C].Fn(Actual.A + 1, Actual.D + 1, Actual.Out + 1,
                      Actual.Indices + 1, Actual.DOut + 1, Actual.FOut + 1,
                      R + 1, 3, Start);
        check_compact_probes(Exports[C].Name, 3, K, 3, P,
                             Lanes ? P / Lanes : 0, Lanes ? P % Lanes : P);
        // Keep the inherited x==0 final-input probe. Separately check the
        // actual final participation arm, which can skip a nonzero x.
        if (ExportEmptyVisits != (P == 0) || ExportBypassVisits ||
            ExportInactiveFinalVisits != (Cases[K].Input[2] == 0) ||
            CompactLastParticipated != ((Mask & 4) != 0) ||
            memcmp(CompactCFGBypasses, Edges, sizeof(Edges)) ||
            memcmp(&Actual, &Original, sizeof(Actual)) ||
            memcmp(&Actual, &Independent, sizeof(Actual)))
          fail(Exports[C].Name, 3, K, "state CFG transformed participation/exports/reductions/canaries");
        ++Runs;
      }
  printf("State CFG participation %s: comparisons=%u rows=2 cases=7\n",
         Exports[C].Name, Runs);
}

static void check_exports(void) {
  static const uint64_t Ns[] = {0, 1, 2, 3, 4, 5, 7, 8, 9, 15, 16, 17,
                                 31, 32, 33, 63, 64, 65, 66, UINT64_MAX};
  static const uint64_t RowCounts[] = {0, 1, 2, 4, 5, UINT64_MAX};
  unsigned Total = 0;
  for (unsigned C = 0; C < sizeof(Exports) / sizeof(*Exports); ++C) {
    unsigned Mode = Exports[C].Mode, Lanes = Exports[C].VectorLanes;
    bool Stateful = Mode >= 16;
    if (Stateful) check_state_cfg_participation(C);
    bool Nested = Mode == 3 || Mode == 11 || Mode == 15;
    bool Compact = Mode == 2 || Mode == 3 || Mode == 8 || Mode == 11 || Mode >= 12;
    bool Unconditional = Mode == 0 || Mode == 4 || Mode == 7;
    uint64_t Iterations = 0, Participants = 0, Vectors = 0, Tails = 0, Empty = 0;
    unsigned Bypasses = 0, FinalInactive = 0, Runs = 0;
    unsigned CFGEdges = 0;
    for (unsigned K = 0; K < sizeof(Ns) / sizeof(*Ns); ++K)
      for (unsigned J = 0; J < (Stateful ? 2 : Nested ? 6 : 1); ++J)
        for (unsigned Pattern = 0; Pattern < (Ns[K] == 65 ? 66 : 5); ++Pattern)
          for (unsigned Layout = 0; Layout < (Mode >= 4 ? 3 : 2); ++Layout)
            for (unsigned Trial = 0; Trial < 3; ++Trial)
              for (unsigned Alias = 0; Alias < 2; ++Alias) {
                uint64_t N = Ns[K], Rows = Stateful ? 1 + J : Nested ? RowCounts[J] : 1;
                bool Enter = N && N <= 65 && (!Nested || (Rows && Rows <= 4));
                unsigned P = 0;
                if (N && N <= 65)
                  P = N == 65 ? Pattern : Pattern == 0 ? 0 : Pattern == 1 ? 1 :
                      Pattern == 2 ? N : Pattern == 3 ? N - 1 : (N + 1) / 2;
                double Start = Trial == 0 ? -0.0 : Trial == 1 ? 0.0 : 0.25;
                ExportState Actual, Original, Independent;
                init_export_state(&Actual, N <= 65 ? N : 0, P, Layout, Trial);
                memcpy(&Original, &Actual, sizeof(Actual));
                memcpy(&Independent, &Actual, sizeof(Actual));
                // For all-inactive nonalias nests no later output can create
                // a participant. Aliased nests instead use their real FP input
                // because a row's output may enable a later row's contribution.
                bool NoFP = !Enter || (!Unconditional && P == 0 && (!Nested || !Alias));
                const uint32_t *A;
                const double *D;
                uint32_t *Out;
                double *DOut;
                ExportCounts Expected = {0};
                export_pointers(&Independent, Nested, Alias, !Enter, NoFP,
                                &A, &D, &Out, &DOut);
                export_oracle(Mode, A, D, Out, Independent.Indices + 1, DOut,
                              Independent.FOut + 1, Rows, N, Start, Lanes, &Expected);
                export_pointers(&Original, Nested, Alias, !Enter, NoFP,
                                &A, &D, &Out, &DOut);
                Exports[C].Reference(A, D, Out, Original.Indices + 1, DOut,
                                     Original.FOut + 1, Rows, N, Start);
                if (memcmp(&Original, &Independent, sizeof(Original)))
                  fail(Exports[C].Name, N, Pattern, "original IR versus independent export oracle");
                export_pointers(&Actual, Nested, Alias, !Enter, NoFP,
                                &A, &D, &Out, &DOut);
                reset_compact_probes();
                Exports[C].Fn(A, D, Out, Actual.Indices + 1, DOut,
                              Actual.FOut + 1, Rows, N, Start);
                check_compact_probes(Exports[C].Name, N, Pattern,
                                     Expected.Iterations, Expected.Participants,
                                     Expected.Vectors, Expected.Tails);
                if (ExportEmptyVisits != Expected.Empty)
                  fail(Exports[C].Name, N, Pattern, "P=0 consumer bypass count");
                if (ExportBypassVisits != Expected.Bypasses ||
                    ExportInactiveFinalVisits != Expected.InactiveFinal)
                  fail(Exports[C].Name, N, Pattern, "entry bypass/final-inactive execution counts");
                for (unsigned Edge = 0; Edge < 3; ++Edge) {
                  if (CompactCFGBypasses[Edge] != Expected.CFGBypasses[Edge])
                    fail(Exports[C].Name, N, Pattern, "exact compact CFG bypass-edge counts");
                  if (CompactCFGBypasses[Edge]) CFGEdges |= 1u << Edge;
                }
                if (memcmp(&Actual, &Original, sizeof(Actual)) ||
                    memcmp(&Actual, &Independent, sizeof(Actual)))
                  fail(Exports[C].Name, N, Pattern,
                       "producer exports/reductions/alias/canary/input mismatch");
                Iterations += CompactIterations;
                Participants += CompactParticipants;
                Vectors += ScalarVectorVisits;
                Tails += ScalarTailVisits;
                Empty += ExportEmptyVisits;
                Bypasses += ExportBypassVisits;
                FinalInactive += ExportInactiveFinalVisits;
                ++Runs;
              }
    // A width above the bound intentionally executes no vector iterations.
    // Every claimed path otherwise needs concrete nonzero execution evidence
    // for THIS function, vscale, FP setting and single/repeated-LV variant.
    if (!Iterations || !Participants || !Tails || !Bypasses ||
        (Lanes && Lanes <= 65 && !Vectors) || ((!Lanes || Lanes > 65) && Vectors) ||
        (Compact && !Empty) || (!Compact && Empty) ||
        (!Unconditional && !FinalInactive))
      fail(Exports[C].Name, 65, 0, "missing concrete export-path execution evidence");
    if (Mode >= 12 && CFGEdges != ((Mode == 14 || Mode == 15 || Mode == 18) ? 7u : 1u))
      fail(Exports[C].Name, 65, CFGEdges, "every compact CFG bypass edge must execute");
    printf("Producer exports %s: %u comparisons; N=%llu P=%llu vector=%llu "
           "tail=%llu empty=%llu zero-entry=%u final-inactive=%u cfg-bypass-mask=%u\n",
           Exports[C].Name, Runs, (unsigned long long)Iterations,
           (unsigned long long)Participants, (unsigned long long)Vectors,
           (unsigned long long)Tails, (unsigned long long)Empty, Bypasses, FinalInactive,
           CFGEdges);
    Total += Runs;
  }
  if (!Total) abort();
  printf("Producer exports: %u additional host comparisons (not RVV execution)\n", Total);
}

// These validation-only probes run in the actual transformed scheduler and
// stage headers. They enforce a complete producer followed by exactly count
// consumer lanes, then scratch reuse at local index zero in the next chunk.
static const char *ChunkName;
static unsigned ChunkN, ChunkCapacity, ChunkLanes, ChunkRows;
static unsigned ChunkBase, ChunkCount, ChunkProduced, ChunkConsumed;
static unsigned ChunkProgress, ChunkCompletedRows, ChunkBegins, ChunkEnds;
static unsigned ChunkVectors, ChunkTails, ChunkPartial, ChunkComplete;
static bool ChunkActive;

void record_chunk_begin(uint64_t Base, uint64_t Count) {
  unsigned Remaining = ChunkN - ChunkProgress;
  unsigned Expected = Remaining < ChunkCapacity ? Remaining : ChunkCapacity;
  if (ChunkActive || ChunkCompletedRows >= ChunkRows || !Remaining ||
      Base != ChunkProgress || Count != Expected || !Count)
    fail(ChunkName, ChunkN, ChunkBegins, "chunk base/count/order mismatch");
  ChunkActive = true;
  ChunkBase = (unsigned)Base;
  ChunkCount = (unsigned)Count;
  ChunkProduced = ChunkConsumed = 0;
  ++ChunkBegins;
  ChunkPartial += Count < ChunkCapacity;
  ChunkComplete += Count == ChunkCapacity;
}

void record_chunk_producer(uint64_t Global, uint64_t Local) {
  if (!ChunkActive || ChunkConsumed || ChunkProduced >= ChunkCount ||
      Local != ChunkProduced || Global != ChunkBase + Local)
    fail(ChunkName, ChunkN, ChunkBegins, "producer global/local ordinal or schedule");
  ++ChunkProduced;
}

static void record_chunk_lanes(unsigned Lanes) {
  if (!ChunkActive || !Lanes || ChunkProduced != ChunkCount ||
      ChunkConsumed > ChunkCount || Lanes > ChunkCount - ChunkConsumed)
    fail(ChunkName, ChunkN, ChunkBegins, "consumer before producer or invalid lane count");
  ChunkConsumed += Lanes;
}

void record_chunk_vector(void) {
  record_chunk_lanes(ChunkLanes);
  ++ChunkVectors;
}

void record_chunk_tail(void) {
  record_chunk_lanes(1);
  ++ChunkTails;
}

void record_chunk_end(void) {
  if (!ChunkActive || ChunkProduced != ChunkCount || ChunkConsumed != ChunkCount)
    fail(ChunkName, ChunkN, ChunkBegins, "incomplete chunk producer/consumer execution");
  ChunkActive = false;
  ChunkProgress += ChunkCount;
  if (ChunkProgress == ChunkN) {
    ChunkProgress = 0;
    ++ChunkCompletedRows;
  }
  ++ChunkEnds;
}

// Single original-order traversal, independent of chunks and transformed IR.
// Outputs can alias the current or next row's inputs. Observe stores at each
// row exit before reading the next row; salt depends on its last producer.
static void chunk_oracle(bool Nested, const uint32_t *A, const double *D,
                         uint32_t *Out, uint64_t *Indices, double *DOut,
                         float *FOut, uint64_t Rows, uint64_t N, double Start,
                         unsigned MaxN) {
  bool Enter = N && N <= MaxN;
  if (Nested && (!Enter || !Rows || Rows > 4)) return;
  uint32_t R0 = 17, R1 = (uint32_t)-7, Salt = 3;
  double RD = Start;
  float RF = (float)Start;
  for (unsigned Row = 0; Row < (Nested ? Rows : 1); ++Row) {
    uint32_t X = (uint32_t)-99, C = (uint32_t)-101;
    uint64_t IV = UINT64_MAX, Next = 0;
    double DC = -0.0;
    float FC = -0.0f;
    for (unsigned I = 0; Enter && I < N; ++I) {
      unsigned Offset = (Nested ? 65 * Row : 0) + I;
      X = A[Offset];
      C = scalar_helper(Nested ? X ^ Salt : X);
      DC = D[Offset] * 3.0;
      FC = (float)DC;
      R0 += C;
      R1 = C + R1;
      RD = RD + DC;
      RF = RF + FC;
      IV = I;
      Next = I + 1;
    }
    unsigned O = Nested ? Row * 5 : 0, F = Nested ? Row * 2 : 0;
    Out[O] = R0;
    Out[O + 1] = R1;
    Out[O + 2] = X;
    Out[O + 3] = Out[O + 4] = C;
    Indices[F] = IV;
    Indices[F + 1] = Next;
    DOut[F] = RD;
    DOut[F + 1] = DC;
    FOut[F] = RF;
    FOut[F + 1] = FC;
    Salt = C;
  }
}

static void check_chunks(void) {
  static const uint64_t Ns[] = {0, 1, 2, 3, 4, 7, 8, 9, 10, 15, 16, 17,
                                 18, 19, 27, 28, 32, 33, 63, 64, 65, 66,
                                 127, 128, 129, 254, 255, 256,
                                 UINT64_MAX};
  static const uint64_t RowCounts[] = {0, 1, 2, 4, 5, UINT64_MAX};
  unsigned Total = 0;
  for (unsigned C = 0; C < sizeof(Chunks) / sizeof(*Chunks); ++C) {
    bool Nested = Chunks[C].Nested;
    unsigned Capacity = Chunks[C].Capacity, Lanes = Chunks[C].VectorLanes;
    unsigned MaxN = Chunks[C].MaxN;
    unsigned Runs = 0, Vectors = 0, Tails = 0, Complete = 0, Partial = 0;
    unsigned Zero = 0, Multi = 0, AliasMulti = 0;
    for (unsigned K = 0; K < sizeof(Ns) / sizeof(*Ns); ++K)
      for (unsigned J = 0; J < (Nested ? 6 : 1); ++J)
        for (unsigned Trial = 0; Trial < 10; ++Trial)
          for (unsigned Alias = 0; Alias < 2; ++Alias) {
            uint64_t N = Ns[K], Rows = Nested ? RowCounts[J] : 1;
            bool Enter = N && N <= MaxN && (!Nested || (Rows && Rows <= 4));
            double Start = Trial == 0 ? -0.0 : Trial == 1 ? 0.0 : 0.25;
            ExportState Actual, Original, Independent;
            init_export_state(&Actual, N <= MaxN ? N : 0, N <= MaxN ? N : 0,
                              Trial % 2, Trial);
            // Move cancellation across each chunk boundary; adding chunk
            // sums to Start, resetting an accumulator, or adding an identity
            // can change bits. The independent oracle retains every addition.
            for (unsigned R = 0; R < 4; ++R)
              for (unsigned I = 0; I < 65; ++I) {
                unsigned Position = (65 * R + I + Trial) % Capacity;
                if (Trial >= 2)
                  Actual.D[1 + 65 * R + I] = Position == 0 ? 0x1p54 :
                      Position == Capacity - 1 ? -0x1p54 : 0.25;
              }
            memcpy(&Original, &Actual, sizeof(Actual));
            memcpy(&Independent, &Actual, sizeof(Actual));
            const uint32_t *A;
            const double *D;
            uint32_t *Out;
            double *DOut;
            export_pointers(&Independent, Nested, Alias, !Enter, !Enter,
                            &A, &D, &Out, &DOut);
            chunk_oracle(Nested, A, D, Out, Independent.Indices + 1, DOut,
                         Independent.FOut + 1, Rows, N, Start, MaxN);
            export_pointers(&Original, Nested, Alias, !Enter, !Enter,
                            &A, &D, &Out, &DOut);
            Chunks[C].Reference(A, D, Out, Original.Indices + 1, DOut,
                                Original.FOut + 1, Rows, N, Start);
            if (memcmp(&Original, &Independent, sizeof(Original)))
              fail(Chunks[C].Name, N, Trial, "original IR versus independent chunk oracle");
            ChunkName = Chunks[C].Name;
            ChunkN = Enter ? N : 0;
            ChunkRows = Enter ? Rows : 0;
            ChunkCapacity = Capacity;
            ChunkLanes = Lanes;
            ChunkActive = false;
            ChunkProgress = ChunkCompletedRows = ChunkBegins = ChunkEnds = 0;
            ChunkVectors = ChunkTails = ChunkComplete = ChunkPartial = 0;
            export_pointers(&Actual, Nested, Alias, !Enter, !Enter,
                            &A, &D, &Out, &DOut);
            Chunks[C].Fn(A, D, Out, Actual.Indices + 1, DOut,
                         Actual.FOut + 1, Rows, N, Start);
            unsigned Full = ChunkN / Capacity, Remainder = ChunkN % Capacity;
            unsigned ExpectedChunks = ChunkRows * (Full + (Remainder != 0));
            unsigned ExpectedVectors = Lanes ? ChunkRows *
                (Full * (Capacity / Lanes) + Remainder / Lanes) : 0;
            unsigned ExpectedTails = ChunkN * ChunkRows - ExpectedVectors * Lanes;
            if (ChunkActive || ChunkProgress || ChunkCompletedRows != ChunkRows ||
                ChunkBegins != ExpectedChunks || ChunkEnds != ExpectedChunks ||
                ChunkVectors != ExpectedVectors || ChunkTails != ExpectedTails ||
                ChunkComplete != ChunkRows * Full ||
                ChunkPartial != ChunkRows * (Remainder != 0))
              fail(ChunkName, N, Trial, "exact chunk/vector/tail/row execution counts");
            if (memcmp(&Actual, &Original, sizeof(Actual)) ||
                memcmp(&Actual, &Independent, sizeof(Actual)))
              fail(ChunkName, N, Trial, "chunk reductions/exports/alias/input/canary mismatch");
            Vectors += ChunkVectors;
            Tails += ChunkTails;
            Complete += ChunkComplete;
            Partial += ChunkPartial;
            Zero += !Enter;
            Multi += Enter && N > Capacity;
            AliasMulti += Nested && Alias && Enter && Rows > 1 && N > Capacity;
            ++Runs;
          }
    if (!Complete || !Tails || !Zero || !Multi ||
        (Capacity > 1 && !Partial) || (Nested && !AliasMulti) ||
        (Lanes && Lanes <= Capacity && !Vectors) ||
        ((!Lanes || Lanes > Capacity) && Vectors))
      fail(Chunks[C].Name, 65, 0, "missing concrete chunk path execution evidence");
    printf("Bounded chunks %s: %u comparisons; C=%u vector=%u tail=%u "
           "complete=%u partial=%u zero=%u multi=%u alias-multi=%u\n",
           Chunks[C].Name, Runs, Capacity, Vectors, Tails, Complete, Partial,
           Zero, Multi, AliasMulti);
    Total += Runs;
  }
  if (!Total) abort();
  printf("Bounded chunks: %u additional host comparisons (not RVV execution)\n", Total);
}


// Exact producer-state probes, validation only. Expected state advances once
// per original iteration using input arrays, independently of transformed SSA.
// Chunk boundaries never reset it. Nested rows seed from the preceding row's
// final next state; current exports are separately checked at each chunk exit.
static const uint32_t *StateChunkA;
static const double *StateChunkD;
static unsigned StateChunkMode, StateProducerVisits;
static uint32_t StatePrev, StateOlder;
static double StateD;

void record_state_chunk_begin(uint64_t Base, uint64_t Count, uint32_t Prev,
                              uint32_t Older, double D) {
  record_chunk_begin(Base, Count);
  if (Prev != StatePrev || Older != StateOlder || memcmp(&D, &StateD, sizeof(D)))
    fail(ChunkName, ChunkN, ChunkBegins, "producer state initial/carry mismatch");
}

void record_state_chunk_producer(uint64_t Global, uint64_t Local) {
  record_chunk_producer(Global, Local);
  ++StateProducerVisits;
}

void record_state_chunk_end(uint32_t Prev, uint32_t Older, uint32_t Next,
                            double D, double DNext) {
  uint32_t Current = StatePrev, Old = StateOlder, Updated = StatePrev;
  double CurrentD = StateD, UpdatedD = StateD;
  bool Pair = StateChunkMode == 1 || StateChunkMode == 3;
  for (unsigned I = 0; I < ChunkCount; ++I) {
    unsigned Offset = (StateChunkMode == 3 ? 65 * ChunkCompletedRows : 0) + ChunkBase + I;
    Current = StatePrev;
    Old = StateOlder;
    CurrentD = StateD;
    Updated = Pair ? StateChunkA[Offset] + Old : StateChunkA[Offset];
    UpdatedD = CurrentD + StateChunkD[Offset];
    StatePrev = Updated;
    if (Pair) StateOlder = Current;
    StateD = UpdatedD;
  }
  if (Prev != Current || Older != Old || Next != Updated ||
      memcmp(&D, &CurrentD, sizeof(D)) || memcmp(&DNext, &UpdatedD, sizeof(DNext)))
    fail(ChunkName, ChunkN, ChunkBegins, "producer current/next exports or simultaneous carry");
  record_chunk_end();
}

typedef struct {
  uint32_t A[262], Out[22];
  double D[262], DOut[18];
  float FOut[10];
  uint64_t Indices[10];
} StateChunkState;

// One original-order traversal, no chunk arithmetic and no probe inputs.
// Writes happen after each row, preserving permitted aliasing with future rows.
static void state_chunk_oracle(unsigned Mode, const uint32_t *A, const double *D,
                                uint32_t *Out, uint64_t *Indices, double *DOut,
                                uint64_t Rows, uint64_t N, double Start) {
  bool Nested = Mode == 3, Pair = Mode == 1 || Nested;
  if (!N || N > 65 || (Nested && (!Rows || Rows > 4))) return;
  uint32_t R0 = 17, R1 = (uint32_t)-7, Prev = 23, Older = (uint32_t)-11;
  double RD = Start, DS = Start;
  for (unsigned Row = 0; Row < (Nested ? Rows : 1); ++Row) {
    uint32_t Current = Prev, Old = Older, Updated = Prev;
    double CurrentD = DS, NextD = DS, DC = 0;
    for (unsigned I = 0; I < N; ++I) {
      unsigned Offset = (Nested ? 65 * Row : 0) + I;
      Current = Prev;
      Old = Older;
      CurrentD = DS;
      Updated = Pair ? A[Offset] + Old : A[Offset];
      uint32_t C = scalar_helper(Current ^ Updated);
      NextD = CurrentD + D[Offset];
      DC = Mode == 2 ? CurrentD - D[Offset] : NextD - CurrentD;
      R0 += C;
      R1 = C + R1;
      RD = RD + DC;
      Prev = Updated;
      if (Pair) Older = Current;
      DS = NextD;
    }
    unsigned O = Nested ? 5 * Row : 0, F = Nested ? 4 * Row : 0;
    unsigned J = Nested ? 2 * Row : 0;
    Out[O] = R0;
    Out[O + 1] = R1;
    Out[O + 2] = Current;
    Out[O + 3] = Old;
    Out[O + 4] = Updated;
    DOut[F] = RD;
    DOut[F + 1] = CurrentD;
    DOut[F + 2] = NextD;
    DOut[F + 3] = DC;
    Indices[J] = N - 1;
    Indices[J + 1] = N;
  }
}

static void state_chunk_pointers(StateChunkState *S, bool Alias, bool Enter,
                                  const uint32_t **A, const double **D,
                                  uint32_t **Out, double **DOut) {
  *A = Enter ? S->A + 1 : NULL;
  *D = Enter ? S->D + 1 : NULL;
  *Out = Alias ? S->A + 66 : S->Out + 1;
  *DOut = Alias ? S->D + 66 : S->DOut + 1;
}

static void check_state_chunks(void) {
  static const uint64_t RowCounts[] = {0, 1, 2, 4, 5, UINT64_MAX};
  static const double Values[] = {-0.0, 0.0, 0x1p54, -0x1p54, 0.25, -0.125, 1.0, -1.0};
  unsigned Total = 0;
  for (unsigned C = 0; C < sizeof(StateChunks) / sizeof(*StateChunks); ++C) {
    unsigned Mode = StateChunks[C].Mode, Capacity = StateChunks[C].Capacity;
    unsigned Lanes = StateChunks[C].VectorLanes;
    bool Nested = Mode == 3;
    unsigned Runs = 0, Produced = 0, Consumed = 0, Begins = 0;
    unsigned Vectors = 0, Tails = 0, Zero = 0, Multi = 0, Partial = 0, Full = 0;
    for (unsigned K = 0; K < 68; ++K)
      for (unsigned R = 0; R < (Nested ? 6u : 1u); ++R)
        for (unsigned Trial = 0; Trial < 8; ++Trial)
          for (unsigned Alias = 0; Alias < 2; ++Alias) {
            uint64_t N = K == 67 ? UINT64_MAX : K;
            uint64_t Rows = Nested ? RowCounts[R] : 1;
            bool Enter = N && N <= 65 && (!Nested || (Rows && Rows <= 4));
            double Start = Trial == 0 ? -0.0 : Trial == 1 ? 0.0 :
                           Trial == 2 ? 0.25 : -8.25;
            StateChunkState Actual, Original, Independent;
            memset(&Actual, 0x5a, sizeof(Actual));
            for (unsigned I = 0; I < 260; ++I) {
              Actual.A[1 + I] = Trial == 0 ? 0 : Trial == 1 ? I + 1 : random_value();
              Actual.D[1 + I] = Values[(I + Trial) % 8];
            }
            memcpy(&Original, &Actual, sizeof(Actual));
            memcpy(&Independent, &Actual, sizeof(Actual));
            const uint32_t *A;
            const double *D;
            uint32_t *Out;
            double *DOut;
            state_chunk_pointers(&Independent, Alias, Enter, &A, &D, &Out, &DOut);
            state_chunk_oracle(Mode, A, D, Out, Independent.Indices + 1, DOut, Rows, N, Start);
            state_chunk_pointers(&Original, Alias, Enter, &A, &D, &Out, &DOut);
            StateChunks[C].Reference(A, D, Out, Original.Indices + 1, DOut,
                                     Original.FOut + 1, Rows, N, Start);
            if (memcmp(&Original, &Independent, sizeof(Original)))
              fail(StateChunks[C].Name, N, Trial, "original state IR versus independent oracle");

            state_chunk_pointers(&Actual, Alias, Enter, &A, &D, &Out, &DOut);
            ChunkName = StateChunks[C].Name;
            ChunkN = Enter ? N : 0;
            ChunkRows = Enter ? Rows : 0;
            ChunkCapacity = Capacity;
            ChunkLanes = Lanes;
            ChunkActive = false;
            ChunkProgress = ChunkCompletedRows = ChunkBegins = ChunkEnds = 0;
            ChunkVectors = ChunkTails = ChunkComplete = ChunkPartial = 0;
            StateProducerVisits = 0;
            StateChunkA = A;
            StateChunkD = D;
            StateChunkMode = Mode;
            StatePrev = 23;
            StateOlder = (uint32_t)-11;
            StateD = Start;
            StateChunks[C].Fn(A, D, Out, Actual.Indices + 1, DOut,
                              Actual.FOut + 1, Rows, N, Start);
            unsigned Complete = ChunkN / Capacity, Rem = ChunkN % Capacity;
            unsigned ExpectedChunks = ChunkRows * (Complete + (Rem != 0));
            unsigned ExpectedVectors = Lanes ? ChunkRows *
                (Complete * (Capacity / Lanes) + Rem / Lanes) : 0;
            unsigned ExpectedIterations = ChunkRows * ChunkN;
            if (ChunkActive || ChunkProgress || ChunkCompletedRows != ChunkRows ||
                ChunkBegins != ExpectedChunks || ChunkEnds != ExpectedChunks ||
                StateProducerVisits != ExpectedIterations ||
                ChunkVectors != ExpectedVectors ||
                ChunkTails != ExpectedIterations - ExpectedVectors * Lanes ||
                ChunkComplete != Complete * ChunkRows ||
                ChunkPartial != (Rem != 0) * ChunkRows)
              fail(ChunkName, N, Trial, "exact retained-state chunk/stage/row counts");
            if (memcmp(&Actual, &Original, sizeof(Actual)) ||
                memcmp(&Actual, &Independent, sizeof(Actual)))
              fail(ChunkName, N, Trial, "state chunk result/current/next/alias/input/canary mismatch");
            Produced += StateProducerVisits;
            Consumed += ChunkVectors * Lanes + ChunkTails;
            Begins += ChunkBegins;
            Vectors += ChunkVectors;
            Tails += ChunkTails;
            Full += ChunkComplete;
            Partial += ChunkPartial;
            Zero += !Enter;
            Multi += Enter && N > Capacity;
            ++Runs;
          }
    if (!Produced || Produced != Consumed || !Begins || !Tails || !Full || !Zero ||
        !Multi || (Capacity > 1 && !Partial) ||
        (Lanes && Lanes <= Capacity && !Vectors) || ((!Lanes || Lanes > Capacity) && Vectors))
      fail(StateChunks[C].Name, 65, 0, "missing retained-state transformed-path evidence");
    printf("State chunks %s: comparisons=%u producer=%u consumer=%u chunks=%u "
           "vector=%u tail=%u complete=%u partial=%u zero=%u multi=%u\n",
           StateChunks[C].Name, Runs, Produced, Consumed, Begins, Vectors, Tails,
           Full, Partial, Zero, Multi);
    Total += Runs;
  }
  printf("State chunks: %u original/transformed/oracle host comparisons (not RVV)\n", Total);
}


// AoS probes use the actual load/store addresses from each emitted stage.
// In particular a global producer IV must never index the reused scratch.
static const double *AosInput;
static double AosSum, AosBits;
static unsigned AosProducerVectors, AosProducerTails, AosBypasses;
static unsigned AosProducerLanes;

static void aos_equal(double Actual, double Expected) {
  if (memcmp(&Actual, &Expected, sizeof(double)))
    fail(ChunkName, ChunkN, ChunkBegins, "ordered chunk carry bits");
}

static double aos_term(const double *A, unsigned I) {
  double Scaled = A[2 * I] * 2.0;
  double Shared = Scaled + A[2 * I];
  double Pair = Shared - A[2 * I + 1];
  return Pair * 3.0;
}

void record_aos_chunk_begin(uint64_t Base, uint64_t Count, double Sum, double Bits) {
  record_chunk_begin(Base, Count);
  aos_equal(Sum, AosSum);
  aos_equal(Bits, AosBits);
}

static unsigned aos_index(const double *Base, const double *Address,
                          unsigned Stride, unsigned Bound) {
  uintptr_t B = (uintptr_t)Base, P = (uintptr_t)Address;
  unsigned Bytes = Stride * sizeof(double);
  if (P < B || (P - B) % Bytes || (P - B) / Bytes >= Bound)
    fail(ChunkName, ChunkN, ChunkBegins, "invalid actual stage address");
  return (P - B) / Bytes;
}

void record_aos_chunk_producer(const double *Input, const double *Scratch,
                               const double *Address, uint64_t Lanes, uint32_t Vector) {
  unsigned Global = aos_index(AosInput, Input, 2, ChunkN);
  unsigned Local = aos_index(Scratch, Address, 1, ChunkCapacity);
  if (!ChunkActive || ChunkConsumed || !Lanes ||
      Lanes != (Vector ? AosProducerLanes : 1) ||
      Local != ChunkProduced || Global != ChunkBase + Local ||
      ChunkProduced > ChunkCount || Lanes > ChunkCount - ChunkProduced)
    fail(ChunkName, ChunkN, ChunkBegins, "vector producer global/local/count/order");
  ChunkProduced += Lanes;
  if (Vector) ++AosProducerVectors;
  else ++AosProducerTails;
}

void record_aos_chunk_consumer(const double *Scratch, const double *Address,
                               uint64_t Lanes, uint32_t Vector) {
  unsigned Local = aos_index(Scratch, Address, 1, ChunkCapacity);
  if (Local != ChunkConsumed || Lanes != (Vector ? ChunkLanes : 1))
    fail(ChunkName, ChunkN, ChunkBegins, "consumer local/count");
  record_chunk_lanes(Lanes);
  if (Vector) ++ChunkVectors;
  else ++ChunkTails;
}

void record_aos_chunk_end(double Sum, double Bits) {
  for (unsigned I = ChunkBase; I < ChunkBase + ChunkCount; ++I) {
    double Term = aos_term(AosInput, I);
    AosSum = AosSum + Term;
    AosBits = AosBits + Term;
  }
  aos_equal(Sum, AosSum);
  aos_equal(Bits, AosBits);
  record_chunk_end();
}

void record_aos_chunk_bypass(void) { ++AosBypasses; }

static void aos_oracle(const double *A, double *Out, uint64_t N, double Start) {
  double Sum = Start, Bits = -0.0;
  // One original-order traversal, with no chunk sums or extra identity adds.
  if (N && N <= 65)
    for (unsigned I = 0; I < N; ++I) {
      double Term = aos_term(A, I);
      Sum = Sum + Term;
      Bits = Bits + Term;
    }
  Out[0] = Sum;
  Out[1] = Bits;
}

static void check_aos_chunks(void) {
  static const uint64_t Ns[] = {0, 1, 2, 3, 7, 8, 15, 16, 31, 32, 33,
                                63, 64, 65, 66, UINT64_MAX};
  unsigned Total = 0;
  for (unsigned C = 0; C < sizeof(AosChunks) / sizeof(*AosChunks); ++C) {
    unsigned PV = AosChunks[C].ProducerLanes, CV = AosChunks[C].ConsumerLanes;
    unsigned Runs = 0, PVector = 0, PTail = 0, CVector = 0, CTail = 0;
    unsigned Complete = 0, Partial = 0, Multi = 0, Zero = 0;
    for (unsigned K = 0; K < sizeof(Ns) / sizeof(*Ns); ++K)
      for (unsigned Trial = 0; Trial < 10; ++Trial)
        for (unsigned Alias = 0; Alias < 2; ++Alias) {
          uint64_t N = Ns[K];
          bool Enter = N && N <= 65;
          double Start = Trial == 0 ? -0.0 : Trial == 1 ? 0.0 : 0.25;
          struct { double A[132], Out[4]; } Actual, Original, Independent;
          for (unsigned I = 0; I < 132; ++I) Actual.A[I] = -7654.5;
          for (unsigned I = 0; I < 4; ++I) Actual.Out[I] = 9876.5;
          for (unsigned I = 0; I < 65; ++I) {
            Actual.A[1 + 2 * I] = Trial == 0 ? -0.0 : Trial == 1 ? 0.0 :
                (double)((int)((I * 17 + Trial * 11) % 53) - 26) / 16.0;
            Actual.A[2 + 2 * I] = Trial < 2 ? -0.0 : (double)(I % 7) / 8.0;
          }
          if (Trial >= 2) {
            // Opposite large terms straddle the full/partial chunk boundary.
            Actual.A[1 + 2 * 62] = 0x1p54;
            Actual.A[1 + 2 * 63] = 0.25;
            Actual.A[1 + 2 * 64] = -0x1p54;
          }
          memcpy(&Original, &Actual, sizeof(Actual));
          memcpy(&Independent, &Actual, sizeof(Actual));
          double *ExpectedOut = Alias ? Independent.A + 129 : Independent.Out + 1;
          aos_oracle(Enter ? Independent.A + 1 : NULL, ExpectedOut, N, Start);
          ref_chunk_ordered(Enter ? Original.A + 1 : NULL,
                            Alias ? Original.A + 129 : Original.Out + 1, N, Start);
          if (memcmp(&Original, &Independent, sizeof(Original)))
            fail(AosChunks[C].Name, N, Trial, "original AoS IR versus independent oracle");
          ChunkName = AosChunks[C].Name;
          ChunkN = Enter ? N : 0;
          ChunkRows = Enter ? 1 : 0;
          ChunkCapacity = 64;
          ChunkLanes = CV;
          AosProducerLanes = PV;
          ChunkActive = false;
          ChunkProgress = ChunkCompletedRows = ChunkBegins = ChunkEnds = 0;
          ChunkVectors = ChunkTails = ChunkComplete = ChunkPartial = 0;
          AosProducerVectors = AosProducerTails = AosBypasses = 0;
          AosInput = Enter ? Actual.A + 1 : NULL;
          AosSum = Start;
          AosBits = -0.0;
          AosChunks[C].Fn(AosInput, Alias ? Actual.A + 129 : Actual.Out + 1, N, Start);
          unsigned Full = ChunkN / 64, Rem = ChunkN % 64;
          unsigned ExpectedPV = Full * (64 / PV) + Rem / PV;
          unsigned ExpectedCV = Full * (64 / CV) + Rem / CV;
          if (ChunkActive || ChunkProgress || ChunkCompletedRows != ChunkRows ||
              ChunkBegins != Full + (Rem != 0) || ChunkEnds != ChunkBegins ||
              ChunkComplete != Full || ChunkPartial != (Rem != 0) ||
              AosProducerVectors != ExpectedPV || ChunkVectors != ExpectedCV ||
              AosProducerTails != ChunkN - ExpectedPV * PV ||
              ChunkTails != ChunkN - ExpectedCV * CV || AosBypasses != !Enter)
            fail(ChunkName, N, Trial, "AoS exact chunk/producer/consumer/vector/tail/bypass counts");
          if (memcmp(&Actual, &Original, sizeof(Actual)) ||
              memcmp(&Actual, &Independent, sizeof(Actual)))
            fail(ChunkName, N, Trial, "AoS chunk output/alias/input/canary bits");
          PVector += AosProducerVectors;
          PTail += AosProducerTails;
          CVector += ChunkVectors;
          CTail += ChunkTails;
          Complete += ChunkComplete;
          Partial += ChunkPartial;
          Multi += ChunkBegins > 1;
          Zero += AosBypasses;
          ++Runs;
        }
    if (!Complete || !Partial || !Multi || !Zero || !PTail || !CTail ||
        ((PV <= 64) != (PVector != 0)) || ((CV <= 64) != (CVector != 0)))
      fail(AosChunks[C].Name, 65, 0, "missing actual AoS chunk path evidence");
    printf("Vectorizable producer chunks %s: %u comparisons; C=64 PV=%u CV=%u "
           "producer-vector=%u producer-tail=%u consumer-vector=%u consumer-tail=%u "
           "complete=%u partial=%u multi=%u zero=%u\n", AosChunks[C].Name, Runs,
           PV, CV, PVector, PTail, CVector, CTail, Complete, Partial, Multi, Zero);
    Total += Runs;
  }
  if (!Total) abort();
  printf("Vectorizable producer chunks: %u additional host comparisons (not RVV execution)\n", Total);
}

static void check_integration(void) {
  unsigned Total = 0;
  for (unsigned C = 0; C < sizeof(Integration) / sizeof(*Integration); ++C) {
    unsigned Mode = Integration[C].Mode, Lanes = Integration[C].VectorLanes;
    unsigned Vectors = 0, Tails = 0, Zeros = 0, Multiple = 0, Complete = 0, Partial = 0;
    for (unsigned K = 0; K < 75; ++K)
      for (unsigned Trial = 0; Trial < 8; ++Trial)
        for (unsigned Alias = 0; Alias < 2; ++Alias) {
          static const uint64_t Extra[] = {127, 128, 129, 254, 255, 256, 257, UINT64_MAX};
          uint64_t N = K < 67 ? K : Extra[K - 67];
          bool Enter = N && N <= (Mode == 2 ? 255 : 65);
          struct { uint32_t A[258], Out[3]; } Actual, Original, Formula;
          for (unsigned I = 0; I < 258; ++I)
            Actual.A[I] = Trial == 0 ? 0 : Trial == 1 ? I : random_value();
          for (unsigned I = 0; I < 3; ++I) Actual.Out[I] = random_value();
          memcpy(&Original, &Actual, sizeof(Actual));
          memcpy(&Formula, &Actual, sizeof(Actual));
          uint32_t Start = random_value(), Sum = Start;
          if (Enter)
            for (unsigned I = 0; I < N; ++I) {
              uint32_t X = Formula.A[1 + I];
              if (Mode == 1 && X) X *= 3;
              Sum += scalar_helper(X ^ 7);
            }
          uint32_t *Expected = Alias ? Formula.A + 1 : Formula.Out + 1;
          *Expected = Sum;
          Integration[C].Reference(Enter ? Original.A + 1 : NULL,
                                   Alias ? Original.A + 1 : Original.Out + 1, N, Start);
          if (memcmp(&Original, &Formula, sizeof(Original)))
            fail(Integration[C].Name, N, Trial, "integration original IR / independent formula");
          AcyclicIterations = AcyclicLatches = ScalarVectorVisits = ScalarTailVisits = 0;
          ChunkName = Integration[C].Name;
          ChunkN = Enter ? N : 0;
          ChunkRows = Enter ? 1 : 0;
          ChunkCapacity = 65;
          ChunkLanes = Lanes;
          ChunkActive = false;
          ChunkProgress = ChunkCompletedRows = ChunkBegins = ChunkEnds = 0;
          ChunkVectors = ChunkTails = ChunkComplete = ChunkPartial = 0;
          Integration[C].Fn(Enter ? Actual.A + 1 : NULL,
                            Alias ? Actual.A + 1 : Actual.Out + 1, N, Start);
          if (memcmp(&Actual, &Formula, sizeof(Actual)) ||
              memcmp(&Actual, &Original, sizeof(Actual)))
            fail(Integration[C].Name, N, Trial, "integration transformed result/alias/input/canary");
          if (Mode == 2) {
            unsigned Full = ChunkN / 65, Rem = ChunkN % 65;
            unsigned EV = Full * (65 / Lanes) + Rem / Lanes;
            if (ChunkActive || ChunkProgress || ChunkCompletedRows != ChunkRows ||
                ChunkBegins != Full + (Rem != 0) || ChunkEnds != ChunkBegins ||
                ChunkComplete != Full || ChunkPartial != (Rem != 0) ||
                ChunkVectors != EV || ChunkTails != ChunkN - EV * Lanes ||
                AcyclicIterations || AcyclicLatches || ScalarVectorVisits || ScalarTailVisits)
              fail(ChunkName, N, Trial, "integration exact chunk and stage counts");
            Vectors += ChunkVectors;
            Tails += ChunkTails;
            Multiple += ChunkBegins > 1;
            Complete += ChunkComplete;
            Partial += ChunkPartial;
          } else {
            check_acyclic_probes(Integration[C].Name, Enter ? N : 0, Trial, 1, Lanes);
            if (ChunkBegins || ChunkEnds || ChunkVectors || ChunkTails)
              fail(ChunkName, N, Trial, "full-trip integration entered chunk machinery");
            Vectors += ScalarVectorVisits;
            Tails += ScalarTailVisits;
          }
          Zeros += !Enter;
          ++Total;
        }
    if (!Tails || !Zeros || ((Lanes <= 65) != (Vectors != 0)) ||
        (Mode == 2 && (!Multiple || !Complete || !Partial)))
      fail(Integration[C].Name, 65, 0, "missing integration execution paths");
    printf("Integration %s: vector=%u tail=%u bypass=%u multi=%u full=%u partial=%u\n",
           Integration[C].Name, Vectors, Tails, Zeros, Multiple, Complete, Partial);
  }
  if (!Total) abort();
  printf("Integration: %u additional original/transformed/independent host comparisons\n", Total);
}

int main(void) {
  check_recurrences();
  check_compact_recurrences();
  check_compact_delays();
  check_retained_exports();
  static const unsigned Counts[] = {
      0, 1, 2, 3, 4, 5, 7, 8, 9, 15, 16, 17, 31, 32, 33, 63, 64, 65, 66,
      257, 1023, 1024, 1025};
  static const int32_t Steps[] = {0, 1, -3, INT32_MAX, INT32_MIN};
  uint32_t Input[1026], Out[InterleaveMaxOutputs + 2];
  uint32_t RefOut[InterleaveMaxOutputs + 2], Dst[1026], RefDst[1026];
  uint32_t Dst2[1026], RefDst2[1026];
  double FPInput[1026], Result[7], RefResult[7];
  uint64_t CallInput[65];
  uint32_t InterleaveInput[InterleaveInputElements];
  double InterleaveFPInput[InterleaveInputElements];
  for (unsigned C = 0; C < sizeof(Combined) / sizeof(*Combined); ++C)
    for (unsigned K = 0; K < sizeof(Counts) / sizeof(*Counts); ++K)
      for (unsigned Trial = 0; Trial < 20; ++Trial) {
        unsigned N = Counts[K];
        int32_t Step = Steps[Trial % 5];
        double Start = Trial % 8 == 2 ? -0.0 : Trial % 8 == 3 ? 1.0 : 3.5;
        for (unsigned I = 0; I < 1026; ++I) {
          Input[I] = random_value();
          Dst[I] = RefDst[I] = random_value();
          Dst2[I] = RefDst2[I] = random_value();
        }
        for (unsigned I = 0; I < sizeof(Out) / sizeof(*Out); ++I)
          Out[I] = RefOut[I] = random_value();
        for (unsigned I = 0; I < 7; ++I) Result[I] = RefResult[I] = I + 0.25;
        fill_fp(FPInput, 1026, Trial);
        ref_combined(Input, RefOut + 1, N, RefResult + 1, Start, FPInput,
                     RefDst + 1, RefDst2 + 1, Step);
        Combined[C].Fn(Input, Out + 1, N, Result + 1, Start, FPInput,
                       Dst + 1, Dst2 + 1, Step);
        if (memcmp(Out, RefOut, sizeof(Out)) ||
            memcmp(Dst, RefDst, sizeof(Dst)) ||
            memcmp(Dst2, RefDst2, sizeof(Dst2)))
          fail(Combined[C].Name, N, Trial, "integer output or canary mismatch");
        if (Result[0] != RefResult[0] || Result[2] != RefResult[2] ||
            !equal_fp(Result[1], RefResult[1], Combined[C].Relaxed,
                      FPInput, N <= 1024 ? N : 0, Start, Trial))
          fail(Combined[C].Name, N, Trial, "FP result or canary mismatch");
        ++Runs;
      }
  for (unsigned C = 0; C < sizeof(Inductions) / sizeof(*Inductions); ++C)
    for (unsigned Trial = 0; Trial < 200; ++Trial) {
      for (unsigned I = 0; I < 1026; ++I) Input[I] = random_value();
      for (unsigned I = 0; I < sizeof(Out) / sizeof(*Out); ++I)
        Out[I] = RefOut[I] = random_value();
      Inductions[C].Reference(Input, RefOut + 1, Steps[Trial % 5]);
      Inductions[C].Fn(Input, Out + 1, Steps[Trial % 5]);
      if (memcmp(Out, RefOut, sizeof(Out)))
        fail(Inductions[C].Name, 257, Trial, "induction result mismatch");
      ++Runs;
    }
  for (unsigned C = 0; C < sizeof(FP) / sizeof(*FP); ++C)
    for (unsigned Trial = 0; Trial < 200; ++Trial) {
      fill_fp(FPInput, 1026, Trial);
      for (unsigned I = 0; I < 7; ++I) Result[I] = RefResult[I] = I + 0.25;
      ref_fp_reordering(FPInput, RefResult + 1);
      FP[C].Fn(FPInput, Result + 1);
      if (Result[0] != RefResult[0] || Result[6] != RefResult[6])
        fail(FP[C].Name, 65, Trial, "FP output canary mismatch");
      for (unsigned I = 1; I <= 5; ++I)
        if (!equal_fp(Result[I], RefResult[I], true, FPInput, 65, -0.0, Trial))
          fail(FP[C].Name, 65, Trial, "reordered FP mismatch");
      ++Runs;
    }
  static const uint64_t ScalarCounts[] = {
      0, 1, 2, 3, 4, 5, 7, 8, 9, 15, 16, 17, 31, 32, 33, 63, 64, 65, 66, UINT64_MAX};
  for (unsigned C = 0; C < sizeof(Scalars) / sizeof(*Scalars); ++C)
    for (unsigned K = 0; K < sizeof(ScalarCounts) / sizeof(*ScalarCounts); ++K)
      for (unsigned Trial = 0; Trial < 20; ++Trial) {
        uint64_t N = ScalarCounts[K];
        uint32_t Start = random_value();
        for (unsigned I = 0; I < 1026; ++I) Input[I] = random_value();
        // Null input exercises the entry guard for zero and invalid counts.
        const uint32_t *A = N && N <= 65 ? Input : NULL;
        uint64_t Actual[3] = {UINT64_MAX, UINT64_MAX, UINT64_MAX};
        uint64_t Expected[3] = {UINT64_MAX, UINT64_MAX, UINT64_MAX};
        Scalars[C].Reference(A, Expected + 1, N, Start);
        ScalarVectorVisits = 0;
        Scalars[C].Fn(A, Actual + 1, N, Start);
        if ((!N || N > 65) && ScalarVectorVisits)
          fail(Scalars[C].Name, (unsigned)N, Trial, "entry guard entered vector consumer");
        if (N == 65 && Scalars[C].VectorLanes <= 65 && !ScalarVectorVisits)
          fail(Scalars[C].Name, (unsigned)N, Trial, "vector consumer did not execute");
        ScalarVectorRuns += ScalarVectorVisits != 0;
        if (memcmp(Actual, Expected, sizeof(Actual)))
          fail(Scalars[C].Name, (unsigned)N, Trial,
               "early scalar integer result or canary mismatch");
        // Also exercise input/output aliasing: the original loop is read-only,
        // so scratch cannot require an invented noalias contract.
        _Alignas(uint64_t) uint32_t Alias[66], RefAlias[66];
        memcpy(Alias, Input, sizeof(Alias));
        memcpy(RefAlias, Input, sizeof(RefAlias));
        Scalars[C].Reference(RefAlias, RefAlias, N, Start);
        Scalars[C].Fn(Alias, Alias, N, Start);
        if (memcmp(Alias, RefAlias, sizeof(Alias)))
          fail(Scalars[C].Name, (unsigned)N, Trial, "input/output alias mismatch");
        Runs += 2;
      }
  for (unsigned C = 0; C < sizeof(ScalarMixed) / sizeof(*ScalarMixed); ++C)
    for (unsigned K = 0; K < sizeof(ScalarCounts) / sizeof(*ScalarCounts); ++K)
      for (unsigned Trial = 0; Trial < 20; ++Trial) {
        uint64_t N = ScalarCounts[K];
        double Start = Trial % 8 == 2 ? -0.0 : Trial % 8 == 3 ? 1.0 : 3.5;
        for (unsigned I = 0; I < 1026; ++I) Input[I] = random_value();
        fill_fp(FPInput, 1026, Trial);
        const uint32_t *A = N && N <= 65 ? Input : NULL;
        const double *D = N && N <= 65 ? FPInput : NULL;
        for (unsigned I = 0; I < sizeof(Out) / sizeof(*Out); ++I) Out[I] = RefOut[I] = random_value();
        double ActualD[3] = {19.5, 7.0, 3.25}, ExpectedD[3] = {19.5, 7.0, 3.25};
        float ActualF[3] = {19.5f, 7.0f, 3.25f}, ExpectedF[3] = {19.5f, 7.0f, 3.25f};
        ref_scalar_mixed(A, D, RefOut + 1, ExpectedD + 1, ExpectedF + 1, N, Start);
        ScalarVectorVisits = 0;
        ScalarMixed[C].Fn(A, D, Out + 1, ActualD + 1, ActualF + 1, N, Start);
        if ((!N || N > 65) && ScalarVectorVisits)
          fail(ScalarMixed[C].Name, (unsigned)N, Trial, "entry guard entered FP consumer");
        if (N == 65 && ScalarMixed[C].VectorLanes <= 65 && !ScalarVectorVisits)
          fail(ScalarMixed[C].Name, (unsigned)N, Trial, "vector FP consumer did not execute");
        ScalarVectorRuns += ScalarVectorVisits != 0;
        if (memcmp(Out, RefOut, sizeof(Out)) ||
            memcmp(ActualD, ExpectedD, sizeof(ActualD)) ||
            memcmp(ActualF, ExpectedF, sizeof(ActualF)))
          fail(ScalarMixed[C].Name, (unsigned)N, Trial,
               "early scalar ordered FP, integer, or canary mismatch");
        ++Runs;
      }
  for (unsigned C = 0; C < sizeof(ScalarDiamond) / sizeof(*ScalarDiamond); ++C)
    for (unsigned K = 0; K < sizeof(ScalarCounts) / sizeof(*ScalarCounts); ++K)
      for (unsigned Trial = 0; Trial < 40; ++Trial) {
        uint64_t N = ScalarCounts[K];
        bool Enter = N && N <= 65;
        unsigned Pattern = Trial % 5;
        double Start = Trial % 8 == 2 ? -0.0 : Trial % 8 == 3 ? 1.0 : 3.5;
        for (unsigned I = 0; I < 1026; ++I) {
          bool Divide = Pattern == 0 ? true : Pattern == 1 ? false :
                        Pattern == 2 ? I % 2 : Pattern == 3 ? (I / 7) % 2 :
                        random_value() % 2;
          int32_t Denominator = (int32_t)(I % 31 + 1);
          if (Trial % 2) Denominator = -Denominator;
          Input[I] = Divide ? (uint32_t)Denominator : 0;
        }
        fill_fp(FPInput, 1026, Trial);
        // All-divide calls supply null for the untaken load arm. All-load
        // calls supply zero divisors for the untaken arithmetic arm.
        const uint32_t *A = Enter ? Input : NULL;
        const double *D = Enter && Pattern != 0 ? FPInput : NULL;
        for (unsigned I = 0; I < sizeof(Out) / sizeof(*Out); ++I) Out[I] = RefOut[I] = random_value();
        double ActualD[3] = {19.5, 7.0, 3.25}, ExpectedD[3] = {19.5, 7.0, 3.25};
        float ActualF[3] = {19.5f, 7.0f, 3.25f}, ExpectedF[3] = {19.5f, 7.0f, 3.25f};
        ref_scalar_diamond(A, D, RefOut + 1, ExpectedD + 1, ExpectedF + 1, N, Start);
        ScalarVectorVisits = ScalarTailVisits = 0;
        ScalarDiamond[C].Fn(A, D, Out + 1, ActualD + 1, ActualF + 1, N, Start);
        unsigned Lanes = ScalarDiamond[C].VectorLanes;
        if (!Enter && (ScalarVectorVisits || ScalarTailVisits))
          fail(ScalarDiamond[C].Name, (unsigned)N, Trial, "diamond guard entered consumer");
        if (Enter && (N == 1 || N == 65) &&
            (ScalarVectorVisits != N / Lanes || ScalarTailVisits != N % Lanes))
          fail(ScalarDiamond[C].Name, (unsigned)N, Trial,
               "diamond vector/scalar consumer participation mismatch");
        ScalarVectorRuns += ScalarVectorVisits != 0;
        if (memcmp(Out, RefOut, sizeof(Out)) ||
            memcmp(ActualD, ExpectedD, sizeof(ActualD)) ||
            memcmp(ActualF, ExpectedF, sizeof(ActualF)))
          fail(ScalarDiamond[C].Name, (unsigned)N, Trial,
               "diamond shared integer, ordered FP or canary mismatch");
        uint32_t Alias[66], RefAlias[66];
        memcpy(Alias, Input, sizeof(Alias));
        memcpy(RefAlias, Input, sizeof(RefAlias));
        ref_scalar_diamond(RefAlias, D, RefAlias, ExpectedD + 1, ExpectedF + 1, N, Start);
        ScalarDiamond[C].Fn(Alias, D, Alias, ActualD + 1, ActualF + 1, N, Start);
        if (memcmp(Alias, RefAlias, sizeof(Alias)) ||
            memcmp(ActualD, ExpectedD, sizeof(ActualD)) ||
            memcmp(ActualF, ExpectedF, sizeof(ActualF)))
          fail(ScalarDiamond[C].Name, (unsigned)N, Trial, "diamond alias mismatch");
        Runs += 2;
      }
  for (unsigned C = 0; C < sizeof(Acyclic) / sizeof(*Acyclic); ++C)
    for (unsigned K = 0; K < 68; ++K)
      for (unsigned Trial = 0; Trial < 16; ++Trial) {
        uint64_t N = K <= 66 ? K : UINT64_MAX;
        bool Enter = N && N <= 65, NeedsD = false;
        for (unsigned I = 0; I < 66; ++I) {
          // All divide, all load, alternating in both phases, runs, sparse,
          // random; nonzero values exercise both inner nested branches.
          unsigned Pattern = Trial % 8;
          bool Divide = Pattern == 0 ? true : Pattern == 1 ? false :
                        Pattern == 2 ? I % 2 : Pattern == 3 ? !(I % 2) :
                        Pattern == 4 ? (I / 7) % 2 : Pattern == 5 ? I % 13 :
                        random_value() % 2;
          int32_t Denominator = (int32_t)(I % 29 + 1);
          if (Trial >= 8) Denominator = -Denominator;
          Input[I] = Divide ? (uint32_t)Denominator : 0;
          if (Enter && I < N && !Divide) NeedsD = true;
          switch (Trial / 2) {
          case 0: FPInput[I] = -0.0; break;
          case 1: FPInput[I] = (double[]){1e16, 1.0, -1e16, 0.0}[I % 4]; break;
          case 2: FPInput[I] = INFINITY; break;
          case 3: FPInput[I] = -INFINITY; break;
          case 4: FPInput[I] = NAN; break;
          case 5: FPInput[I] = 0x1p-1074; break;
          case 6: FPInput[I] = 0x1p-149; break;
          default: FPInput[I] = (double)(int32_t)random_value() / 1024.0; break;
          }
        }
        uint32_t SavedInput[66];
        double SavedD[66];
        memcpy(SavedInput, Input, sizeof(SavedInput));
        memcpy(SavedD, FPInput, sizeof(SavedD));
        const uint32_t *A = Enter ? Input : NULL;
        const double *D = NeedsD ? FPInput : NULL;
        double Start = Trial % 2 ? 3.5 : -0.0;
        for (unsigned I = 0; I < sizeof(Out) / sizeof(*Out); ++I)
          Out[I] = RefOut[I] = random_value();
        double ActualD[3] = {19.5, 7.0, 3.25}, ExpectedD[3] = {19.5, 7.0, 3.25};
        float ActualF[3] = {19.5f, 7.0f, 3.25f}, ExpectedF[3] = {19.5f, 7.0f, 3.25f};
        Acyclic[C].Reference(A, D, RefOut + 1, ExpectedD + 1, ExpectedF + 1, N, Start);
        uint32_t Formula[2];
        double FormulaD;
        float FormulaF;
        reference_acyclic(Acyclic[C].Nested, A, D, Formula, &FormulaD, &FormulaF, N, Start);
        if (memcmp(Formula, RefOut + 1, sizeof(Formula)) ||
            !compact_doubles_equal(&FormulaD, ExpectedD + 1, 1) ||
            !compact_floats_equal(&FormulaF, ExpectedF + 1, 1))
          fail(Acyclic[C].Name, (unsigned)N, Trial, "original IR / independent scalar formula mismatch");
        AcyclicIterations = AcyclicLatches = ScalarVectorVisits = ScalarTailVisits = 0;
        Acyclic[C].Fn(A, D, Out + 1, ActualD + 1, ActualF + 1, N, Start);
        check_acyclic_probes(Acyclic[C].Name, Enter ? N : 0, Trial, 1, Acyclic[C].VectorLanes);
        ScalarVectorRuns += ScalarVectorVisits != 0;
        if (memcmp(Out, RefOut, sizeof(Out)) ||
            !compact_doubles_equal(ActualD, ExpectedD, 3) ||
            !compact_floats_equal(ActualF, ExpectedF, 3) ||
            memcmp(Input, SavedInput, sizeof(SavedInput)) ||
            memcmp(FPInput, SavedD, sizeof(SavedD)))
          fail(Acyclic[C].Name, (unsigned)N, Trial, "acyclic result, ordered FP, canary or input mismatch");
        // Final writes can alias both producer inputs. Repeated calls also
        // overwrite every used scratch element after a different branch path.
        uint32_t Alias[66], RefAlias[66];
        double DAlias[66], RefDAlias[66];
        memcpy(Alias, Input, sizeof(Alias));
        memcpy(RefAlias, Input, sizeof(RefAlias));
        memcpy(DAlias, FPInput, sizeof(DAlias));
        memcpy(RefDAlias, FPInput, sizeof(RefDAlias));
        Acyclic[C].Reference(RefAlias, NeedsD ? RefDAlias : NULL, RefAlias,
                             RefDAlias, ExpectedF + 1, N, Start);
        AcyclicIterations = AcyclicLatches = ScalarVectorVisits = ScalarTailVisits = 0;
        Acyclic[C].Fn(Alias, NeedsD ? DAlias : NULL, Alias, DAlias, ActualF + 1, N, Start);
        check_acyclic_probes(Acyclic[C].Name, Enter ? N : 0, Trial, 1, Acyclic[C].VectorLanes);
        if (memcmp(Alias, RefAlias, sizeof(Alias)) ||
            !compact_doubles_equal(DAlias, RefDAlias, 66) ||
            !compact_floats_equal(ActualF, ExpectedF, 3))
          fail(Acyclic[C].Name, (unsigned)N, Trial, "acyclic alias or scratch reuse mismatch");
        Runs += 2;
      }
  unsigned AffineVectorRuns = 0, AffineTailRuns = 0;
  unsigned AffineEarlyRuns[5] = {0}, AffineFullRuns[5] = {0};
  unsigned AffineControlVectors[5] = {0}, AffineControlTails[5] = {0};
  for (unsigned C = 0; C < sizeof(Affine) / sizeof(*Affine); ++C) {
    unsigned CompactPaths = 0;
    for (unsigned K = 0; K < (Affine[C].Compact ? 134u : 68u); ++K)
      for (unsigned Trial = 0; Trial < 16; ++Trial) {
        uint64_t N = K >= 68 ? 65 : K == 67 ? UINT64_MAX : K;
        bool Enter = N && N <= 65, NeedsD = false;
        unsigned P = 0;
        const int64_t Begins[] = {INT64_MIN, -1000, -33, -1, 0, 31, INT64_MAX,
                                  INT64_MIN + 31, INT64_MAX - 31, -2, -3, 1,
                                  INT64_MIN + 1, INT64_MAX - 1};
        unsigned BeginCases = Affine[C].Control ? sizeof(Begins) / sizeof(*Begins) : 7;
        int64_t Begin = Begins[Trial % BeginCases];
        unsigned ActualN = reference_affine_count(Affine[C].Control, N, Begin);
        if (Enter) {
          AffineEarlyRuns[Affine[C].Control] += ActualN < N;
          AffineFullRuns[Affine[C].Control] += ActualN == N && N == 65;
        }
        double Start = Trial % 2 ? 3.5 : -0.0;
        for (unsigned I = 0; I < 66; ++I) {
          bool Active = K >= 68 ? (I * 7 + Trial) % 65 < K - 68 :
                        Trial % 8 == 0 ? true : Trial % 8 == 1 ? false :
                        Trial % 8 == 2 ? I % 2 : Trial % 8 == 3 ? !(I % 2) :
                        Trial % 8 == 4 ? (I / 7) % 2 : Trial % 8 == 5 ? I % 13 :
                        random_value() % 2;
          int32_t Divisor = I % 29 + 1;
          if (Trial >= 8) Divisor = -Divisor;
          Input[I] = Active ? (uint32_t)Divisor : 0;
          if (I < ActualN) {
            if (Affine[C].Compact ? Active : !Active) NeedsD = true;
            if (!Affine[C].Compact || Active) ++P;
          }
          switch (Trial / 2) {
          case 0: FPInput[I] = -0.0; break;
          case 1: FPInput[I] = (double[]){1e16, 1.0, -1e16, 0.0}[I % 4]; break;
          case 2: FPInput[I] = INFINITY; break;
          case 3: FPInput[I] = -INFINITY; break;
          case 4: FPInput[I] = NAN; break;
          case 5: FPInput[I] = 0x1p-1074; break;
          case 6: FPInput[I] = 0x1p-149; break;
          default: FPInput[I] = (double)(int32_t)random_value() / 1024.0; break;
          }
        }
        uint32_t SavedInput[66];
        double SavedD[66];
        memcpy(SavedInput, Input, sizeof(SavedInput));
        memcpy(SavedD, FPInput, sizeof(SavedD));
        const uint32_t *A = Enter ? Input : NULL;
        const double *D = NeedsD ? FPInput : NULL;
        for (unsigned I = 0; I < sizeof(Out) / sizeof(*Out); ++I)
          Out[I] = RefOut[I] = random_value();
        double ActualD[3] = {19.5, 7.0, 3.25}, ExpectedD[3] = {19.5, 7.0, 3.25};
        float ActualF[3] = {19.5f, 7.0f, 3.25f}, ExpectedF[3] = {19.5f, 7.0f, 3.25f};
        Affine[C].Reference(A, D, RefOut + 1, ExpectedD + 1, ExpectedF + 1,
                             N, Start, Begin);
        uint32_t Formula[2];
        double FormulaD;
        float FormulaF;
        if (Affine[C].Compact)
          reference_affine_compact(A, D, Formula, &FormulaD, &FormulaF, N, Start);
        else
          reference_acyclic(Affine[C].Nested, A, D, Formula, &FormulaD, &FormulaF, ActualN, Start);
        if (memcmp(Formula, RefOut + 1, sizeof(Formula)) ||
            !compact_doubles_equal(&FormulaD, ExpectedD + 1, 1) ||
            !compact_floats_equal(&FormulaF, ExpectedF + 1, 1))
          fail(Affine[C].Name, (unsigned)N, Trial, "affine original IR / independent formula mismatch");
        AcyclicIterations = AcyclicLatches = CompactParticipants = 0;
        ScalarVectorVisits = ScalarTailVisits = 0;
        Affine[C].Fn(A, D, Out + 1, ActualD + 1, ActualF + 1, N, Start, Begin);
        unsigned Lanes = Affine[C].VectorLanes;
        if (AcyclicIterations != ActualN ||
            AcyclicLatches != ActualN ||
            (Affine[C].Compact && CompactParticipants != P) ||
            ScalarVectorVisits != P / Lanes || ScalarTailVisits != P % Lanes)
          fail(Affine[C].Name, (unsigned)N, Trial, "affine exact producer/control/participant/vector/tail counts");
        // Require these paths separately for every compact LV1/LV2, FP
        // option and fixed-vscale variant, not just somewhere in the matrix.
        // P=0 here must follow an entered producer with no participants.
        if (Affine[C].Compact && Enter) {
          CompactPaths |= !P ? 1u : !ScalarVectorVisits ? 2u :
                          !ScalarTailVisits ? 4u : 8u;
          if (P + 1 == Lanes)
            CompactPaths |= 16u;
          if (P == Lanes)
            CompactPaths |= 32u;
          if (P == Lanes + 1)
            CompactPaths |= 64u;
        }
        AffineVectorRuns += ScalarVectorVisits != 0;
        AffineTailRuns += ScalarTailVisits != 0;
        AffineControlVectors[Affine[C].Control] += ScalarVectorVisits != 0;
        AffineControlTails[Affine[C].Control] += ScalarTailVisits != 0;
        if (memcmp(Out, RefOut, sizeof(Out)) ||
            !compact_doubles_equal(ActualD, ExpectedD, 3) ||
            !compact_floats_equal(ActualF, ExpectedF, 3) ||
            memcmp(Input, SavedInput, sizeof(SavedInput)) ||
            memcmp(FPInput, SavedD, sizeof(SavedD)))
          fail(Affine[C].Name, (unsigned)N, Trial, "affine ordered results, signed zero, canaries or inputs");
        // Repeated scratch use and simultaneous integer/FP output-input alias.
        uint32_t Alias[66], RefAlias[66], FormulaAlias[66];
        double DAlias[66], RefDAlias[66], FormulaDAlias[66];
        memcpy(Alias, Input, sizeof(Alias));
        memcpy(RefAlias, Input, sizeof(RefAlias));
        memcpy(FormulaAlias, Input, sizeof(FormulaAlias));
        memcpy(DAlias, FPInput, sizeof(DAlias));
        memcpy(RefDAlias, FPInput, sizeof(RefDAlias));
        memcpy(FormulaDAlias, FPInput, sizeof(FormulaDAlias));
        Affine[C].Reference(RefAlias, NeedsD ? RefDAlias : NULL, RefAlias,
                             RefDAlias, ExpectedF + 1, N, Start, Begin);
        if (Affine[C].Compact)
          reference_affine_compact(FormulaAlias, NeedsD ? FormulaDAlias : NULL,
                                    FormulaAlias, FormulaDAlias, &FormulaF, N, Start);
        else
          reference_acyclic(Affine[C].Nested, FormulaAlias, NeedsD ? FormulaDAlias : NULL,
                              FormulaAlias, FormulaDAlias, &FormulaF, ActualN, Start);
        if (memcmp(FormulaAlias, RefAlias, sizeof(RefAlias)) ||
            !compact_doubles_equal(FormulaDAlias, RefDAlias, 66) ||
            !compact_floats_equal(&FormulaF, ExpectedF + 1, 1))
          fail(Affine[C].Name, (unsigned)N, Trial, "affine independent alias formula mismatch");
        AcyclicIterations = AcyclicLatches = CompactParticipants = 0;
        ScalarVectorVisits = ScalarTailVisits = 0;
        Affine[C].Fn(Alias, NeedsD ? DAlias : NULL, Alias, DAlias, ActualF + 1, N, Start, Begin);
        if (AcyclicIterations != ActualN ||
            AcyclicLatches != ActualN ||
            (Affine[C].Compact && CompactParticipants != P) ||
            ScalarVectorVisits != P / Lanes || ScalarTailVisits != P % Lanes ||
            memcmp(Alias, RefAlias, sizeof(Alias)) ||
            !compact_doubles_equal(DAlias, RefDAlias, 66) ||
            !compact_floats_equal(ActualF, ExpectedF, 3))
          fail(Affine[C].Name, (unsigned)N, Trial, "affine alias/reuse result or exact stage counts");
        Runs += 2;
      }
    if (Affine[C].Compact) {
      unsigned Lanes = Affine[C].VectorLanes;
      unsigned Required = 3u | (Lanes <= 65 ? 4u : 0u) |
                          (Lanes < 65 ? 8u : 0u) |
                          (Lanes <= 66 ? 16u : 0u) |
                          (Lanes <= 65 ? 32u : 0u) |
                          (Lanes < 65 ? 64u : 0u);
      if ((CompactPaths & Required) != Required)
        fail(Affine[C].Name, 65, CompactPaths,
             "compact P=0, scalar-only, vector-exact and vector/tail boundary paths");
    }
  }
  if (!AffineVectorRuns || !AffineTailRuns)
    fail("affine matrix", 65, 0, "actual vector and remainder paths both required");
  for (unsigned Control = 1; Control <= 4; ++Control)
    if (!AffineEarlyRuns[Control] || !AffineFullRuns[Control] ||
        !AffineControlVectors[Control] || !AffineControlTails[Control])
      fail("affine modular controls", 65, Control,
           "early exit, full capacity, vector and tail execution required per control");
  for (unsigned C = 0; C < sizeof(ScalarConstants) / sizeof(*ScalarConstants); ++C)
    for (unsigned Trial = 0; Trial < 200; ++Trial) {
      uint32_t X = random_value();
      ScalarVectorVisits = 0;
      if (ScalarConstants[C].Fn(X) != ScalarConstants[C].Reference(X))
        fail(ScalarConstants[C].Name, 200, Trial, "constant/narrow trip mismatch");
      if (ScalarConstants[C].RequireVector && !ScalarVectorVisits)
        fail(ScalarConstants[C].Name, 200, Trial, "narrow IV vector consumer did not execute");
      ScalarVectorRuns += ScalarVectorVisits != 0;
      ++Runs;
    }
  for (unsigned C = 0; C < sizeof(AcyclicBounds) / sizeof(*AcyclicBounds); ++C)
    for (unsigned Trial = 0; Trial < 16; ++Trial) {
      unsigned N = AcyclicBounds[C].Count;
      uint32_t Cutoff = Trial == 0 ? 0 : Trial == 1 ? 1 : Trial == 2 ? N / 2 :
                        Trial == 3 ? N : Trial == 4 ? N + 1 : random_value();
      uint32_t Formula = 17;
      for (unsigned I = 0; I < N; ++I) {
        uint32_t First = I < Cutoff ? I + 3 : I;
        Formula += (I & 1) ? (First ^ 7) : First;
      }
      uint32_t Expected = AcyclicBounds[C].Reference(Cutoff);
      AcyclicIterations = AcyclicLatches = ScalarVectorVisits = ScalarTailVisits = 0;
      uint32_t Actual = AcyclicBounds[C].Fn(Cutoff);
      if (Actual != Expected || Actual != Formula ||
          AcyclicIterations != N || AcyclicLatches != N ||
          ScalarTailVisits != N || ScalarVectorVisits)
        fail(AcyclicBounds[C].Name, N, Trial, "acyclic capacity/index boundary mismatch");
      ++Runs;
    }
  static const uint64_t RowCounts[] = {0, 1, 2, 4, 5, UINT64_MAX};
  for (unsigned C = 0; C < sizeof(ScalarNested) / sizeof(*ScalarNested); ++C)
    for (unsigned R = 0; R < sizeof(RowCounts) / sizeof(*RowCounts); ++R)
      for (unsigned K = 0; K < sizeof(ScalarCounts) / sizeof(*ScalarCounts); ++K)
        for (unsigned Trial = 0; Trial < 20; ++Trial) {
          uint64_t Rows = RowCounts[R], N = ScalarCounts[K];
          bool Enter = Rows && Rows <= 4 && N && N <= 65;
          double Start = Trial % 8 == 2 ? -0.0 : Trial % 8 == 3 ? 1.0 : 3.5;
          for (unsigned I = 0; I < 1026; ++I) {
            Input[I] = random_value();
            if (ScalarNested[C].ProbeProducer && Trial < 2)
              Input[I] = (Input[I] & ~1u) | Trial;
          }
          fill_fp(FPInput, 1026, Trial);
          uint32_t SavedInput[1026];
          double SavedD[1026];
          memcpy(SavedInput, Input, sizeof(SavedInput));
          memcpy(SavedD, FPInput, sizeof(SavedD));
          for (unsigned I = 0; I < sizeof(Out) / sizeof(*Out); ++I) Out[I] = RefOut[I] = random_value();
          for (unsigned I = 0; I < 7; ++I) Result[I] = RefResult[I] = I + 0.25;
          // With rejected row/inner guards even the output pointers may be
          // null: no row, producer or consumer may execute.
          ScalarNested[C].Reference(Enter ? Input : NULL, Enter ? FPInput : NULL,
                                    Enter ? RefOut + 1 : NULL,
                                    Enter ? RefResult + 1 : NULL, Rows, N, Start);
          if (ScalarNested[C].ProbeProducer) {
            uint32_t Formula[10];
            double FormulaD[7];
            memcpy(Formula, Out, sizeof(Formula));
            memcpy(FormulaD, Result, sizeof(FormulaD));
            reference_acyclic_enclosing(Enter ? Input : NULL, Enter ? FPInput : NULL,
                                         Enter ? Formula + 1 : NULL,
                                         Enter ? FormulaD + 1 : NULL, Rows, N, Start);
            if (memcmp(Formula, RefOut, sizeof(Formula)) ||
                !compact_doubles_equal(FormulaD, RefResult, 7))
              fail(ScalarNested[C].Name, (unsigned)N, Trial, "enclosing independent formula mismatch");
          }
          ScalarVectorVisits = 0;
          ScalarTailVisits = 0;
          AcyclicIterations = AcyclicLatches = 0;
          ScalarNested[C].Fn(Enter ? Input : NULL, Enter ? FPInput : NULL,
                             Enter ? Out + 1 : NULL, Enter ? Result + 1 : NULL,
                             Rows, N, Start);
          if (ScalarNested[C].ProbeProducer) {
            check_acyclic_probes(ScalarNested[C].Name, Enter ? N : 0, Trial,
                                  Enter ? Rows : 0, ScalarNested[C].VectorLanes);
            if (memcmp(Input, SavedInput, sizeof(SavedInput)) ||
                memcmp(FPInput, SavedD, sizeof(SavedD)))
              fail(ScalarNested[C].Name, (unsigned)N, Trial, "enclosing producer changed inputs");
          }
          if (!Enter && ScalarVectorVisits)
            fail(ScalarNested[C].Name, (unsigned)N, Trial,
                 "nested entry guard entered consumer");
          if (ScalarNested[C].ProbeTail &&
              ((!Enter && ScalarTailVisits) ||
               (Enter && (N == 1 || N == 65) &&
                ScalarTailVisits != Rows * (N % ScalarNested[C].VectorLanes))))
            fail(ScalarNested[C].Name, (unsigned)N, Trial,
                 "nested diamond scalar-tail participation mismatch");
          if (Enter && N == 65 && ScalarNested[C].VectorLanes <= N) {
            // There must be at least one vector-header visit per row, not
            // merely a single entry somewhere in the enclosing function.
            unsigned PerRow = (unsigned)N / ScalarNested[C].VectorLanes;
            if (ScalarVectorVisits != Rows * PerRow)
              fail(ScalarNested[C].Name, (unsigned)N, Trial,
                   "repeated inner vector consumer did not execute for every row");
          }
          ScalarVectorRuns += ScalarVectorVisits != 0;
          if (memcmp(Out, RefOut, sizeof(Out)) ||
              memcmp(Result, RefResult, sizeof(Result)))
            fail(ScalarNested[C].Name, (unsigned)N, Trial,
                 "nested integer, ordered FP, exported result or canary mismatch");
          // Store row outputs into a future row's inputs. This preserves the
          // real outer dependence: the next producer must see those stores.
          uint32_t Alias[262], RefAlias[262];
          double DAlias[262], RefDAlias[262];
          memcpy(Alias, Input, sizeof(Alias));
          memcpy(RefAlias, Input, sizeof(RefAlias));
          memcpy(DAlias, FPInput, sizeof(DAlias));
          memcpy(RefDAlias, FPInput, sizeof(RefDAlias));
          ScalarNested[C].Reference(RefAlias, RefDAlias, RefAlias + 65, RefDAlias + 65,
                                    Rows, N, Start);
          if (ScalarNested[C].ProbeProducer) {
            uint32_t FormulaAlias[262];
            double FormulaD[262];
            memcpy(FormulaAlias, SavedInput, sizeof(FormulaAlias));
            memcpy(FormulaD, SavedD, sizeof(FormulaD));
            reference_acyclic_enclosing(FormulaAlias, FormulaD, FormulaAlias + 65,
                                         FormulaD + 65, Rows, N, Start);
            if (memcmp(FormulaAlias, RefAlias, sizeof(FormulaAlias)) ||
                !compact_doubles_equal(FormulaD, RefDAlias, 262))
              fail(ScalarNested[C].Name, (unsigned)N, Trial, "enclosing independent alias formula mismatch");
          }
          AcyclicIterations = AcyclicLatches = ScalarVectorVisits = ScalarTailVisits = 0;
          ScalarNested[C].Fn(Alias, DAlias, Alias + 65, DAlias + 65, Rows, N, Start);
          if (ScalarNested[C].ProbeProducer)
            check_acyclic_probes(ScalarNested[C].Name, Enter ? N : 0, Trial,
                                  Enter ? Rows : 0, ScalarNested[C].VectorLanes);
          if (memcmp(Alias, RefAlias, sizeof(Alias)) ||
              memcmp(DAlias, RefDAlias, sizeof(DAlias)))
            fail(ScalarNested[C].Name, (unsigned)N, Trial,
                 "nested future-input alias or scratch reuse mismatch");
          Runs += 2;
        }
  // Independent N and P sweeps: in addition to guarded original counts, hold
  // N=65 and exercise EVERY compact count P=0..65 in permuted iteration order.
  // This reaches vector boundaries and tails based on P rather than N.
  unsigned CountCases = sizeof(ScalarCounts) / sizeof(*ScalarCounts);
  for (unsigned C = 0; C < sizeof(Compact) / sizeof(*Compact); ++C)
    for (unsigned K = 0; K < CountCases + 66; ++K)
      for (unsigned Trial = 0; Trial < 16; ++Trial) {
        uint64_t N = K < CountCases ? ScalarCounts[K] : 65;
        bool Enter = N && N <= 65;
        unsigned P = 0, Lanes = Compact[C].VectorLanes;
        double Start = Trial % 2 ? 3.5 : -0.0;
        for (unsigned I = 0; I < 66; ++I) {
          unsigned Pattern = Trial % 8;
          bool Active = K >= CountCases ? (I * 7 + Trial) % 65 < K - CountCases :
                        Pattern == 0 ? false : Pattern == 1 ? true :
                        Pattern == 2 ? I == N / 2 : Pattern == 3 ? I + 1 == N :
                        Pattern == 4 ? I % 2 : Pattern == 5 ? (I / 7) % 2 :
                        Pattern == 6 ? I % 13 == 0 : random_value() % 2;
          Input[I] = Active ? I % 31 + 1 : 0;
          if (Enter && I < N && Active) ++P;
          switch (Trial / 2) {
          case 0: FPInput[I] = -0.0; break;
          case 1: FPInput[I] = (double[]){1e16, 1.0, -1e16, 0.0}[I % 4]; break;
          case 2: FPInput[I] = INFINITY; break;
          case 3: FPInput[I] = -INFINITY; break;
          case 4: FPInput[I] = NAN; break;
          case 5: FPInput[I] = 0x1p-1074; break;
          case 6: FPInput[I] = 0x1p-149; break;
          default: FPInput[I] = (double)(int32_t)random_value() / 1024.0; break;
          }
        }
        // P=0: every divisor is zero and every conditional FP pointer is null.
        const uint32_t *A = Enter ? Input : NULL;
        const double *D = P ? FPInput : NULL;
        for (unsigned I = 0; I < sizeof(Out) / sizeof(*Out); ++I) Out[I] = RefOut[I] = random_value();
        double ActualD[3] = {19.5, 7.0, 3.25}, ExpectedD[3] = {19.5, 7.0, 3.25};
        float ActualF[3] = {19.5f, 7.0f, 3.25f}, ExpectedF[3] = {19.5f, 7.0f, 3.25f};
        Compact[C].Reference(A, D, RefOut + 1, ExpectedD + 1, ExpectedF + 1, N, Start);
        reset_compact_probes();
        Compact[C].Fn(A, D, Out + 1, ActualD + 1, ActualF + 1, N, Start);
        check_compact_probes(Compact[C].Name, (unsigned)N, Trial, Enter ? N : 0,
                              P, P / Lanes, P % Lanes);
        if (memcmp(Out, RefOut, sizeof(Out)) ||
            !compact_doubles_equal(ActualD, ExpectedD, 3) ||
            !compact_floats_equal(ActualF, ExpectedF, 3))
          fail(Compact[C].Name, (unsigned)N, Trial, "compact ordered result/canary mismatch");
        // Repeated invocation overwrites the same scratch, with final outputs
        // aliasing both integer predicates and floating contributions.
        uint32_t Alias[66], RefAlias[66];
        double DAlias[66], RefDAlias[66];
        memcpy(Alias, Input, sizeof(Alias));
        memcpy(RefAlias, Input, sizeof(RefAlias));
        memcpy(DAlias, FPInput, sizeof(DAlias));
        memcpy(RefDAlias, FPInput, sizeof(RefDAlias));
        Compact[C].Reference(RefAlias, P ? RefDAlias : NULL, RefAlias, RefDAlias,
                              ExpectedF + 1, N, Start);
        reset_compact_probes();
        Compact[C].Fn(Alias, P ? DAlias : NULL, Alias, DAlias, ActualF + 1, N, Start);
        check_compact_probes(Compact[C].Name, (unsigned)N, Trial, Enter ? N : 0,
                              P, P / Lanes, P % Lanes);
        if (memcmp(Alias, RefAlias, sizeof(Alias)) ||
            !compact_doubles_equal(DAlias, RefDAlias, 66) ||
            !compact_floats_equal(ActualF, ExpectedF, 3))
          fail(Compact[C].Name, (unsigned)N, Trial, "compact input/output alias mismatch");
        Runs += 2;
      }
  for (unsigned C = 0; C < sizeof(CompactInteger) / sizeof(*CompactInteger); ++C)
    for (unsigned K = 0; K < CountCases + 66; ++K) {
      uint64_t N = K < CountCases ? ScalarCounts[K] : 65;
      bool Enter = N && N <= 65;
      unsigned P = 0, Lanes = CompactInteger[C].VectorLanes;
      for (unsigned I = 0; I < 66; ++I) {
        Input[I] = (I * 7 + 3) % 65 < (K < CountCases ? 33 : K - CountCases)
                     ? random_value() : 0;
        if (Enter && I < N && Input[I]) ++P;
      }
      uint64_t Actual[3] = {19, 7, 23}, Expected[3] = {19, 7, 23};
      uint32_t Start = random_value();
      CompactInteger[C].Reference(Enter ? Input : NULL, Expected + 1, N, Start);
      reset_compact_probes();
      CompactInteger[C].Fn(Enter ? Input : NULL, Actual + 1, N, Start);
      check_compact_probes(CompactInteger[C].Name, (unsigned)N, K, Enter ? N : 0,
                            P, P / Lanes, P % Lanes);
      if (memcmp(Actual, Expected, sizeof(Actual)))
        fail(CompactInteger[C].Name, (unsigned)N, K, "compact i64 result/flags mismatch");
      ++Runs;
    }
  for (unsigned C = 0; C < sizeof(CompactNested) / sizeof(*CompactNested); ++C)
    for (unsigned R = 0; R < sizeof(RowCounts) / sizeof(*RowCounts); ++R)
      for (unsigned K = 0; K < CountCases; ++K)
        for (unsigned Trial = 0; Trial < 8; ++Trial) {
          uint64_t Rows = RowCounts[R], N = ScalarCounts[K];
          bool Enter = Rows && Rows <= 4 && N && N <= 65;
          unsigned P = 0, V = 0, T = 0, Lanes = CompactNested[C].VectorLanes;
          for (unsigned I = 0; I < 262; ++I) {
            // Alternate empty/full rows, plus one, sparse and random rows.
            bool Active = Trial == 0 ? false : Trial == 1 ? true :
                          Trial == 2 ? I % 65 == 64 : Trial == 3 ? (I / 65) % 2 :
                          Trial == 4 ? I % 17 == 0 : random_value() % 2;
            Input[I] = (random_value() & ~1u) | Active;
          }
          fill_fp(FPInput, 262, Trial);
          if (Enter)
            compact_nested_counts(Input, Rows, N, Lanes, false, &P, &V, &T);
          double Start = Trial % 2 ? 3.5 : -0.0;
          for (unsigned I = 0; I < sizeof(Out) / sizeof(*Out); ++I) Out[I] = RefOut[I] = random_value();
          for (unsigned I = 0; I < 7; ++I) Result[I] = RefResult[I] = I + 0.25;
          CompactNested[C].Reference(Enter ? Input : NULL, P ? FPInput : NULL,
                                      Enter ? RefOut + 1 : NULL, Enter ? RefResult + 1 : NULL,
                                      Rows, N, Start);
          reset_compact_probes();
          CompactNested[C].Fn(Enter ? Input : NULL, P ? FPInput : NULL,
                               Enter ? Out + 1 : NULL, Enter ? Result + 1 : NULL,
                               Rows, N, Start);
          check_compact_probes(CompactNested[C].Name, (unsigned)N, Trial,
                                Enter ? Rows * N : 0, P, V, T);
          if (memcmp(Out, RefOut, sizeof(Out)) || memcmp(Result, RefResult, sizeof(Result)))
            fail(CompactNested[C].Name, (unsigned)N, Trial, "compact nested carry/reuse mismatch");
          uint32_t Alias[262], RefAlias[262], CountAlias[262];
          double DAlias[262], RefDAlias[262];
          memcpy(Alias, Input, sizeof(Alias));
          memcpy(RefAlias, Input, sizeof(RefAlias));
          memcpy(CountAlias, Input, sizeof(CountAlias));
          memcpy(DAlias, FPInput, sizeof(DAlias));
          memcpy(RefDAlias, FPInput, sizeof(RefDAlias));
          if (Enter)
            compact_nested_counts(CountAlias, Rows, N, Lanes, true, &P, &V, &T);
          CompactNested[C].Reference(RefAlias, RefDAlias, RefAlias + 65, RefDAlias + 65,
                                      Rows, N, Start);
          reset_compact_probes();
          CompactNested[C].Fn(Alias, DAlias, Alias + 65, DAlias + 65, Rows, N, Start);
          check_compact_probes(CompactNested[C].Name, (unsigned)N, Trial,
                                Enter ? Rows * N : 0, P, V, T);
          if (memcmp(Alias, RefAlias, sizeof(Alias)) ||
              memcmp(DAlias, RefDAlias, sizeof(DAlias)))
            fail(CompactNested[C].Name, (unsigned)N, Trial, "compact nested future-row alias mismatch");
          Runs += 2;
        }
  // Newly admitted short producers run both vector chunks and scalar tails
  // at small vscales. Larger vscales also exercise scalar-only stage dispatch.
  // Zero and out-of-bound counts exercise the original guarded bypass.
  for (unsigned C = 0; C < sizeof(ShortInts) / sizeof(*ShortInts); ++C)
    for (unsigned K = 0; K < sizeof(Counts) / sizeof(*Counts); ++K)
      for (unsigned Trial = 0; Trial < 20; ++Trial) {
        unsigned N = Counts[K];
        for (unsigned I = 0; I < 1026; ++I) Input[I] = random_value();
        for (unsigned I = 0; I < sizeof(Out) / sizeof(*Out); ++I)
          Out[I] = RefOut[I] = random_value();
        ShortInts[C].Reference(Input, RefOut + 1, N);
        ShortInts[C].Fn(Input, Out + 1, N);
        if (memcmp(Out, RefOut, sizeof(Out)))
          fail(ShortInts[C].Name, N, Trial, "short integer result/canary mismatch");
        ++Runs;
      }
  for (unsigned C = 0; C < sizeof(ShortFP) / sizeof(*ShortFP); ++C)
    for (unsigned K = 0; K < sizeof(Counts) / sizeof(*Counts); ++K)
      for (unsigned Trial = 0; Trial < 20; ++Trial) {
        unsigned N = Counts[K];
        double Start = Trial % 8 == 2 ? -0.0 : Trial % 8 == 3 ? 1.0 : 3.5;
        fill_fp(FPInput, 1026, Trial);
        for (unsigned I = 0; I < 7; ++I) Result[I] = RefResult[I] = I + 0.25;
        ShortFP[C].Reference(FPInput, RefResult + 1, N, Start);
        ShortFP[C].Fn(FPInput, Result + 1, N, Start);
        for (unsigned I = 0; I < 7; ++I) {
          bool Output = I >= 1 && I <= ShortFP[C].Outputs;
          if (!equal_fp(Result[I], RefResult[I],
                        Output && ShortFP[C].Relaxed, FPInput,
                        N <= 65 ? N : 0, I == 1 ? Start : -0.0, Trial))
            fail(ShortFP[C].Name, N, Trial,
                 "short FP ordered/relaxed result or canary mismatch");
        }
        ++Runs;
      }
  // The nxv2 producer and nxv8 consumer have different full-chunk bounds.
  // At scale=1, N=2..7 takes a producer vector chunk and a scalar consumer;
  // N=9 takes both vector stages and both tails. Large scales also exercise
  // the scalar-only consumer dispatch. Bypass calls use a null input to
  // ensure that the original N=0 and N>65 guards still suppress input reads.
  for (unsigned C = 0; C < sizeof(FixedCalls) / sizeof(*FixedCalls); ++C)
    for (unsigned Trial = 0; Trial < 200; ++Trial) {
      for (unsigned I = 0; I < 65; ++I)
        CallInput[I] = random_wide_value();
      for (unsigned I = 0; I < sizeof(Out) / sizeof(*Out); ++I)
        Out[I] = RefOut[I] = random_value();
      ref_independent_vfs(CallInput, RefOut + 1);
      FixedCalls[C].Fn(CallInput, Out + 1);
      if (memcmp(Out, RefOut, sizeof(Out)))
        fail(FixedCalls[C].Name, 65, Trial, "fixed call result/canary mismatch");
      ++Runs;
    }
  for (unsigned C = 0; C < sizeof(BoundedCalls) / sizeof(*BoundedCalls); ++C)
    for (unsigned K = 0; K < sizeof(Counts) / sizeof(*Counts); ++K)
      for (unsigned Trial = 0; Trial < 20; ++Trial) {
        unsigned N = Counts[K];
        for (unsigned I = 0; I < 65; ++I)
          CallInput[I] = random_wide_value();
        for (unsigned I = 0; I < sizeof(Out) / sizeof(*Out); ++I)
          Out[I] = RefOut[I] = random_value();
        const uint64_t *A = N && N <= 65 ? CallInput : NULL;
        ref_independent_vfs_bounded(A, RefOut + 1, N);
        BoundedCalls[C].Fn(A, Out + 1, N);
        if (memcmp(Out, RefOut, sizeof(Out)))
          fail(BoundedCalls[C].Name, N, Trial,
               "bounded call result/canary mismatch");
        ++Runs;
      }
  // Both VF orders execute the vector producer/consumer and their separate
  // tails. Repeated ordinary LV may add vector tails; count their entries
  // and lanes as well as residual scalar visits. Exact multiples have zero
  // tail visits. The same checks hold when a complete input group is
  // intentionally reread in the consumer.
  for (unsigned C = 0; C < sizeof(InterleaveInts) / sizeof(*InterleaveInts); ++C) {
    unsigned DispatchRuns = 0, DispatchAliases = 0, DispatchBypasses = 0;
    uint64_t DispatchEntries[4] = {0};
    uint64_t DispatchOrdinaryEntries[2] = {0}, DispatchOrdinaryLanes[2] = {0};
    unsigned Cases[sizeof(Counts) / sizeof(*Counts) + 67];
    unsigned CaseCount = interleave_counts(Cases, Counts, sizeof(Counts) / sizeof(*Counts),
                                          InterleaveInts[C].ScalarDispatch);
    for (unsigned K = 0; K < CaseCount; ++K)
      for (unsigned Trial = 0; Trial < 20; ++Trial) {
        unsigned N = Cases[K], Factor = InterleaveInts[C].Factor;
        for (unsigned I = 0; I < 65 * Factor; ++I)
          InterleaveInput[I] = random_value();
        const uint32_t *A = guarded_input(
            InterleaveInput, N && N <= 65 ? N * Factor * sizeof(*A) : 0);
        for (unsigned I = 0; I < sizeof(Out) / sizeof(*Out); ++I)
          Out[I] = RefOut[I] = random_value();
        InterleaveInts[C].Reference(A, RefOut + 1, N);
        if (InterleaveInts[C].ScalarDispatch) {
          uint32_t Independent[InterleaveMaxOutputs + 2];
          memcpy(Independent, Out, sizeof(Independent));
          dispatch_integer_formula(A, Independent + 1, N, Factor);
          if (memcmp(Independent, RefOut, sizeof(Independent)))
            fail(InterleaveInts[C].Name, N, Trial, "original IR / independent sum-XOR formula mismatch");
        }
        reset_interleave_probes();
        InterleaveInts[C].Fn(A, Out + 1, N);
        check_interleave_entries(
            InterleaveInts[C].Name, N, Trial, InterleaveInts[C].ProducerVF,
            InterleaveInts[C].AccumulatorVF, InterleaveInts[C].ProducerTailVF,
            InterleaveInts[C].AccumulatorTailVF, InterleaveInts[C].ProducerMin,
            InterleaveInts[C].AccumulatorMin, InterleaveInts[C].ProducerTailMin,
            InterleaveInts[C].AccumulatorTailMin);
        if (memcmp(Out, RefOut, sizeof(Out)))
          fail(InterleaveInts[C].Name, N, Trial,
               "interleaved integer result/canary mismatch");
        if (N && N <= InterleaveMaxTripCount &&
            memcmp(A, InterleaveInput, N * Factor * sizeof(*A)))
          fail(InterleaveInts[C].Name, N, Trial,
               "interleaved integer input modified");
        ++Runs;
        if (InterleaveInts[C].ScalarDispatch) {
          ++DispatchRuns;
          DispatchBypasses += !N || N > 65;
          for (unsigned S = 0; S < 4; ++S) DispatchEntries[S] += InterleaveEntries[S];
          for (unsigned S = 0; S < 2; ++S) {
            DispatchOrdinaryEntries[S] += InterleaveTailEntries[S];
            DispatchOrdinaryLanes[S] += InterleaveTailLanes[S];
          }
        }
        if (Trial == 0 && N >= 2 && N <= 65) {
          uint32_t AliasReference[InterleaveInputElements];
          if (N * Factor < InterleaveInts[C].Outputs) abort();
          memcpy(AliasReference, InterleaveInput, N * Factor * sizeof(*A));
          InterleaveInts[C].Reference(AliasReference, AliasReference, N);
          if (InterleaveInts[C].ScalarDispatch) {
            uint32_t Independent[InterleaveInputElements];
            memcpy(Independent, InterleaveInput, N * Factor * sizeof(*A));
            dispatch_integer_formula(Independent, Independent, N, Factor);
            if (memcmp(Independent, AliasReference, N * Factor * sizeof(*A)))
              fail(InterleaveInts[C].Name, N, Trial, "aliased original IR / independent formula mismatch");
          }
          reset_interleave_probes();
          InterleaveInts[C].Fn(A, (uint32_t *)A, N);
          check_interleave_entries(
              InterleaveInts[C].Name, N, Trial, InterleaveInts[C].ProducerVF,
              InterleaveInts[C].AccumulatorVF, InterleaveInts[C].ProducerTailVF,
              InterleaveInts[C].AccumulatorTailVF, InterleaveInts[C].ProducerMin,
              InterleaveInts[C].AccumulatorMin, InterleaveInts[C].ProducerTailMin,
              InterleaveInts[C].AccumulatorTailMin);
          if (memcmp(A, AliasReference, N * Factor * sizeof(*A)))
            fail(InterleaveInts[C].Name, N, Trial,
                 "interleaved integer aliased output mismatch");
          ++Runs;
          if (InterleaveInts[C].ScalarDispatch) {
            ++DispatchRuns;
            ++DispatchAliases;
            for (unsigned S = 0; S < 4; ++S) DispatchEntries[S] += InterleaveEntries[S];
            for (unsigned S = 0; S < 2; ++S) {
              DispatchOrdinaryEntries[S] += InterleaveTailEntries[S];
              DispatchOrdinaryLanes[S] += InterleaveTailLanes[S];
            }
          }
        }
      }
    if (InterleaveInts[C].ScalarDispatch) {
      // A width larger than the finite bound legitimately has no vector
      // entries. A width-one ordinary remainder can also consume its whole
      // stream. Require scalar visits whenever a scalar remainder can exist.
      unsigned PT = InterleaveInts[C].ProducerTailVF;
      unsigned AT = InterleaveInts[C].AccumulatorTailVF;
      if (!DispatchRuns || !DispatchAliases || !DispatchBypasses ||
          (InterleaveInts[C].ProducerVF > 1 && PT != 1 && !DispatchEntries[1]) ||
          (InterleaveInts[C].AccumulatorVF > 1 && AT != 1 && !DispatchEntries[3]) ||
          (InterleaveInts[C].ProducerVF <= 65 && InterleaveInts[C].ProducerMin <= 65 &&
           !DispatchEntries[0]) ||
          (InterleaveInts[C].AccumulatorVF <= 65 && InterleaveInts[C].AccumulatorMin <= 65 &&
           !DispatchEntries[2]))
        fail(InterleaveInts[C].Name, 0, 0, "missing dispatch execution path");
      printf("Dispatch %s: comparisons=%u aliases=%u bypasses=%u "
             "producer-vector=%llu producer-tail=%llu consumer-vector=%llu consumer-tail=%llu "
             "producer-ordinary=%llu producer-ordinary-lanes=%llu "
             "consumer-ordinary=%llu consumer-ordinary-lanes=%llu\n",
             InterleaveInts[C].Name, DispatchRuns, DispatchAliases, DispatchBypasses,
             (unsigned long long)DispatchEntries[0], (unsigned long long)DispatchEntries[1],
             (unsigned long long)DispatchEntries[2], (unsigned long long)DispatchEntries[3],
             (unsigned long long)DispatchOrdinaryEntries[0], (unsigned long long)DispatchOrdinaryLanes[0],
             (unsigned long long)DispatchOrdinaryEntries[1], (unsigned long long)DispatchOrdinaryLanes[1]);
    }
  }
  for (unsigned C = 0; C < sizeof(InterleaveFP) / sizeof(*InterleaveFP); ++C) {
    unsigned Cases[sizeof(Counts) / sizeof(*Counts) + 67];
    unsigned CaseCount = interleave_counts(Cases, Counts, sizeof(Counts) / sizeof(*Counts),
                                          InterleaveFP[C].EntryCertified);
    for (unsigned K = 0; K < CaseCount; ++K)
      for (unsigned Trial = 0; Trial < 20; ++Trial) {
        unsigned N = Cases[K], Factor = InterleaveFP[C].Factor;
        double Start = Trial % 8 == 2 ? -0.0 : Trial % 8 == 3 ? 1.0 : 3.5;
        fill_fp(InterleaveFPInput, 65 * Factor, Trial);
        const double *A = guarded_input(
            InterleaveFPInput, N && N <= 65 ? N * Factor * sizeof(*A) : 0);
        for (unsigned I = 0; I < 7; ++I) Result[I] = RefResult[I] = I + 0.25;
        InterleaveFP[C].Reference(A, RefResult + 1, N, Start);
        reset_interleave_probes();
        InterleaveFP[C].Fn(A, Result + 1, N, Start);
        check_interleave_entries(
            InterleaveFP[C].Name, N, Trial, InterleaveFP[C].ProducerVF,
            InterleaveFP[C].AccumulatorVF, InterleaveFP[C].ProducerTailVF,
            InterleaveFP[C].AccumulatorTailVF, InterleaveFP[C].ProducerMin,
            InterleaveFP[C].AccumulatorMin, InterleaveFP[C].ProducerTailMin,
            InterleaveFP[C].AccumulatorTailMin);
        if (memcmp(Result, RefResult, sizeof(Result)))
          fail(InterleaveFP[C].Name, N, Trial,
               "interleaved ordered FP result/canary mismatch");
        if (N && N <= InterleaveMaxTripCount &&
            memcmp(A, InterleaveFPInput, N * Factor * sizeof(*A)))
          fail(InterleaveFP[C].Name, N, Trial,
               "interleaved ordered FP input modified");
        ++Runs;
        if (Trial == 0 && N >= 2 && N <= 65) {
          double AliasReference[InterleaveInputElements];
          if (N * Factor < InterleaveFP[C].Outputs) abort();
          memcpy(AliasReference, InterleaveFPInput, N * Factor * sizeof(*A));
          InterleaveFP[C].Reference(AliasReference, AliasReference, N, Start);
          reset_interleave_probes();
          InterleaveFP[C].Fn(A, (double *)A, N, Start);
          check_interleave_entries(
              InterleaveFP[C].Name, N, Trial, InterleaveFP[C].ProducerVF,
              InterleaveFP[C].AccumulatorVF, InterleaveFP[C].ProducerTailVF,
              InterleaveFP[C].AccumulatorTailVF, InterleaveFP[C].ProducerMin,
              InterleaveFP[C].AccumulatorMin, InterleaveFP[C].ProducerTailMin,
              InterleaveFP[C].AccumulatorTailMin);
          if (memcmp(A, AliasReference, N * Factor * sizeof(*A)))
            fail(InterleaveFP[C].Name, N, Trial,
                 "interleaved ordered FP aliased output mismatch");
          ++Runs;
        }
      }
  }
  check_deinterleave_adapter();
  check_exports();
  check_chunks();
  check_state_chunks();
  check_aos_chunks();
  check_integration();
  printf("PASS: %u executions; interleave stages/tails counted with guarded "
         "input ends; integer and ordered FP exact; relaxed FP "
         "classification/signed-zero/error bounds; max absolute FP difference %.17g\n",
         Runs, MaxError);
  printf("Early scalar fission: %u host comparisons entered a vector consumer\n",
         ScalarVectorRuns);
  printf("Ordinary AoS vector tails: %llu entries, %llu participating lanes "
         "(scalar-remainder host configuration only)\n",
         (unsigned long long)OrdinaryTailEntries,
         (unsigned long long)OrdinaryTailLanes);
  printf("Compact streams: exact integer/non-NaN FP bits; NaNs by classification; "
         "exact producer/participant/vector/tail counts\n");
  printf("Acyclic producers: original IR and independent scalar references; "
         "exact producer/latch/vector/tail counts and capacity boundaries\n");
  printf("Affine controls: %u vector runs and %u tail runs; exact producer/latch/"
         "participant counts, original IR and independent formulas\n",
         AffineVectorRuns, AffineTailRuns);
  return 0;
}
