// No memory access, exceptions, convergence, or FP-environment effects. opt
// only sees the explicitly attributed declaration, with no vector mapping.
uint32_t scalar_helper(uint32_t X) {
  X ^= X >> 13;
  X *= UINT32_C(0x85ebca6b);
  return X ^ (X >> 16);
}

static unsigned ScalarVectorVisits, ScalarVectorRuns, ScalarTailVisits;
static unsigned CompactIterations, CompactParticipants;
static bool CompactLastParticipated;
static unsigned ExportEmptyVisits, ExportBypassVisits, ExportInactiveFinalVisits;
static unsigned CompactCFGBypasses[3];
static unsigned AcyclicIterations, AcyclicLatches;
void record_scalar_consumer_vector(void) { ++ScalarVectorVisits; }
void record_scalar_consumer_tail(void) { ++ScalarTailVisits; }
void record_compact_iteration(void) {
  ++CompactIterations;
  CompactLastParticipated = false;
}
void record_compact_participant(void) {
  ++CompactParticipants;
  CompactLastParticipated = true;
}
void record_export_guard(uint64_t P) { ExportEmptyVisits += P == 0; }
void record_export_bypass(void) { ++ExportBypassVisits; }
void record_export_final(uint32_t X) { ExportInactiveFinalVisits += X == 0; }
void record_compact_cfg_bypass(unsigned Edge) {
  if (Edge >= 3) abort();
  ++CompactCFGBypasses[Edge];
}
void record_acyclic_iteration(void) { ++AcyclicIterations; }
void record_acyclic_latch(void) { ++AcyclicLatches; }

static void reset_compact_probes(void) {
  ScalarVectorVisits = ScalarTailVisits = 0;
  CompactIterations = CompactParticipants = 0;
  CompactLastParticipated = false;
  ExportEmptyVisits = 0;
  ExportBypassVisits = ExportInactiveFinalVisits = 0;
  memset(CompactCFGBypasses, 0, sizeof(CompactCFGBypasses));
}

