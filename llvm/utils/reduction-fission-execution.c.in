  // Only default early-fission sum/XOR dispatch fixtures use this oracle.
  // Omitted fields in every inherited VPlan row remain false.
  bool ScalarDispatch;
  // Certified unsigned entry is count >= max(VF, Minimum). Minima are
  // unscaled counts in the guarded stage; VF fields are already scaled. Zero
  // preserves every inherited VPlan row's width-only entry contract.
  unsigned ProducerMin, AccumulatorMin, ProducerTailMin, AccumulatorTailMin;
} InterleaveInts[] = {@INTERLEAVE_INT@};
