// Instantiated by check-reduction-fission.py; @...@ are template substitutions.
// The original scalar IR is compiled by the same backend as the specializations.

#include <float.h>
#include <math.h>
#include <stdbool.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

typedef void CombinedFn(const uint32_t *, uint32_t *, uint64_t, double *, double,
                        const double *, uint32_t *, uint32_t *, int32_t);
typedef void InductionFn(const uint32_t *, uint32_t *, int32_t);
typedef void FPFn(const double *, double *);
typedef void ScalarSumFn(const uint32_t *, void *, uint64_t, uint32_t);
typedef void ScalarMixedFn(const uint32_t *, const double *, uint32_t *,
                           double *, float *, uint64_t, double);
typedef uint32_t ScalarConstantFn(uint32_t);
typedef void ScalarNestedFn(const uint32_t *, const double *, uint32_t *,
                            double *, uint64_t, uint64_t, double);
extern CombinedFn ref_combined;
extern InductionFn ref_induction, ref_negative_step, ref_truncated;
extern FPFn ref_fp_reordering;
extern ScalarSumFn ref_scalar_helper_sum, ref_arithmetic_sum;
extern ScalarMixedFn ref_scalar_mixed;
extern ScalarConstantFn ref_narrow_constant, ref_one_iteration;
extern ScalarNestedFn ref_scalar_nested;
extern ScalarMixedFn ref_scalar_diamond;
extern ScalarSumFn ref_diamond_arithmetic;
extern ScalarNestedFn ref_scalar_diamond_nested;
extern ScalarMixedFn ref_compact_triangle, ref_compact_diamond;
extern ScalarSumFn ref_compact_integer;
extern ScalarNestedFn ref_compact_nested;
@DECLARATIONS@

static const struct {
  const char *Name;
  bool Relaxed;
  CombinedFn *Fn;
} Combined[] = {@COMBINED@};
static const struct {
  const char *Name;
  InductionFn *Fn, *Reference;
} Inductions[] = {@INDUCTIONS@};
static const struct {
  const char *Name;
  FPFn *Fn;
} FP[] = {@FP@};
static const struct {
  const char *Name;
  ScalarSumFn *Fn, *Reference;
  unsigned VectorLanes;
} Scalars[] = {@SCALARS@};
static const struct {
  const char *Name;
  ScalarMixedFn *Fn;
  unsigned VectorLanes;
} ScalarMixed[] = {@SCALAR_MIXED@};
static const struct {
  const char *Name;
  ScalarMixedFn *Fn;
  unsigned VectorLanes;
} ScalarDiamond[] = {@SCALAR_DIAMOND@};
static const struct {
  const char *Name;
  ScalarConstantFn *Fn, *Reference;
  bool RequireVector;
} ScalarConstants[] = {@SCALAR_CONSTANTS@};
static const struct {
  const char *Name;
  ScalarNestedFn *Fn, *Reference;
  unsigned VectorLanes;
  bool ProbeTail;
} ScalarNested[] = {@SCALAR_NESTED@};
static const struct {
  const char *Name;
  ScalarMixedFn *Fn, *Reference;
  unsigned VectorLanes;
} Compact[] = {@COMPACT@};
static const struct {
  const char *Name;
  ScalarSumFn *Fn, *Reference;
  unsigned VectorLanes;
} CompactInteger[] = {@COMPACT_INTEGER@};
static const struct {
  const char *Name;
  ScalarNestedFn *Fn, *Reference;
  unsigned VectorLanes;
} CompactNested[] = {@COMPACT_NESTED@};

// No memory access, exceptions, convergence, or FP-environment effects. opt
// only sees the explicitly attributed declaration, with no vector mapping.
uint32_t scalar_helper(uint32_t X) {
  X ^= X >> 13;
  X *= UINT32_C(0x85ebca6b);
  return X ^ (X >> 16);
}

static unsigned ScalarVectorVisits, ScalarVectorRuns, ScalarTailVisits;
static unsigned CompactIterations, CompactParticipants;
void record_scalar_consumer_vector(void) { ++ScalarVectorVisits; }
void record_scalar_consumer_tail(void) { ++ScalarTailVisits; }
void record_compact_iteration(void) { ++CompactIterations; }
void record_compact_participant(void) { ++CompactParticipants; }

static void reset_compact_probes(void) {
  ScalarVectorVisits = ScalarTailVisits = 0;
  CompactIterations = CompactParticipants = 0;
}

static uint32_t Seed = 314159265;
static double MaxError;
static unsigned Runs;
static uint32_t random_value(void) {
  Seed = 1664525 * Seed + 1013904223;
  return Seed;
}
static void fail(const char *Name, unsigned N, unsigned Trial, const char *What) {
  fprintf(stderr, "%s: N=%u trial=%u: %s\n", Name, N, Trial, What);
  exit(1);
}

static void check_compact_probes(const char *Name, unsigned N, unsigned Trial,
                                 unsigned Iterations, unsigned Participants,
                                 unsigned VectorVisits, unsigned TailVisits) {
  if (CompactIterations != Iterations || CompactParticipants != Participants ||
      ScalarVectorVisits != VectorVisits || ScalarTailVisits != TailVisits)
    fail(Name, N, Trial, "compact producer/participant/vector/tail visit mismatch");
  ScalarVectorRuns += ScalarVectorVisits != 0;
}

// Count using the actual participation predicates. Simulate only integer row
// feedback for the alias case; output row r overwrites input row 1, element r.
// This determines later row participation without using transformed counters.
static void compact_nested_counts(uint32_t *A, unsigned Rows, unsigned N,
                                   unsigned Lanes, bool Alias,
                                   unsigned *Participants, unsigned *Vectors,
                                   unsigned *Tails) {
  uint32_t Carry = 19;
  *Participants = *Vectors = *Tails = 0;
  for (unsigned R = 0; R < Rows; ++R) {
    unsigned P = 0;
    for (unsigned I = 0; I < N; ++I) {
      uint32_t X = A[R * 65 + I];
      if (X & 1) {
        ++P;
        Carry += scalar_helper(X ^ R);
      }
    }
    *Participants += P;
    *Vectors += P / Lanes;
    *Tails += P % Lanes;
    if (Alias) A[65 + R] = Carry;
  }
}

// Ordinary LLVM FP does not promise a NaN payload. All other bit patterns,
// including the sign of an unchanged zero initial value, must match exactly.
static bool compact_doubles_equal(const double *A, const double *B, unsigned N) {
  for (unsigned I = 0; I < N; ++I)
    if (!(isnan(A[I]) && isnan(B[I])) && memcmp(A + I, B + I, sizeof(*A)))
      return false;
  return true;
}
static bool compact_floats_equal(const float *A, const float *B, unsigned N) {
  for (unsigned I = 0; I < N; ++I)
    if (!(isnan(A[I]) && isnan(B[I])) && memcmp(A + I, B + I, sizeof(*A)))
      return false;
  return true;
}
static void fill_fp(double *A, unsigned Count, unsigned Trial) {
  for (unsigned I = 0; I < Count; ++I) {
    switch (Trial % 8) {
    case 1: A[I] = 0.0; break;
    case 2: A[I] = -0.0; break;
    case 3: A[I] = (double[]){1e16, 1.0, -1e16, 0.0}[I % 4]; break;
    default: A[I] = (double)(int32_t)random_value() / 1024.0; break;
    }
  }
  if (Trial % 8 == 4) A[0] = NAN;
  if (Trial % 8 == 5) A[0] = INFINITY;
  if (Trial % 8 == 6) { A[0] = INFINITY; A[1] = -INFINITY; }
}
static bool equal_fp(double Actual, double Expected, bool Relaxed,
                     const double *Input, unsigned N, double Start,
                     unsigned Trial) {
  if (!Relaxed)
    return memcmp(&Actual, &Expected, sizeof(double)) == 0;
  if (isnan(Expected)) return isnan(Actual);
  if (isinf(Expected)) return Actual == Expected;
  if (!isfinite(Actual)) return false;
  if ((Trial % 8 == 1 || Trial % 8 == 2) && Expected == 0)
    return Actual == 0 && signbit(Actual) == signbit(Expected);
  // Absolute forward-error bound scaled by the sum of magnitudes, including
  // cancellation. A small relative error against a near-zero sum is invalid.
  double Magnitude = fabs(Start);
  for (unsigned I = 0; I < N; ++I) Magnitude += fabs(Input[I] * 120.0);
  double Error = fabs(Actual - Expected);
  if (Error > MaxError) MaxError = Error;
  return Error <= 16 * DBL_EPSILON * (N + 1) * Magnitude;
}

int main(void) {
  static const unsigned Counts[] = {
      0, 1, 2, 3, 7, 8, 15, 16, 17, 31, 32, 33, 63, 64, 65, 257, 1023, 1024, 1025};
  static const int32_t Steps[] = {0, 1, -3, INT32_MAX, INT32_MIN};
  uint32_t Input[1026], Out[10], RefOut[10], Dst[1026], RefDst[1026];
  uint32_t Dst2[1026], RefDst2[1026];
  double FPInput[1026], Result[7], RefResult[7];
  for (unsigned C = 0; C < sizeof(Combined) / sizeof(*Combined); ++C)
    for (unsigned K = 0; K < sizeof(Counts) / sizeof(*Counts); ++K)
      for (unsigned Trial = 0; Trial < 20; ++Trial) {
        unsigned N = Counts[K];
        int32_t Step = Steps[Trial % 5];
        double Start = Trial % 8 == 2 ? -0.0 : Trial % 8 == 3 ? 1.0 : 3.5;
        for (unsigned I = 0; I < 1026; ++I) {
          Input[I] = random_value();
          Dst[I] = RefDst[I] = random_value();
          Dst2[I] = RefDst2[I] = random_value();
        }
        for (unsigned I = 0; I < 10; ++I) Out[I] = RefOut[I] = random_value();
        for (unsigned I = 0; I < 7; ++I) Result[I] = RefResult[I] = I + 0.25;
        fill_fp(FPInput, 1026, Trial);
        ref_combined(Input, RefOut + 1, N, RefResult + 1, Start, FPInput,
                     RefDst + 1, RefDst2 + 1, Step);
        Combined[C].Fn(Input, Out + 1, N, Result + 1, Start, FPInput,
                       Dst + 1, Dst2 + 1, Step);
        if (memcmp(Out, RefOut, sizeof(Out)) ||
            memcmp(Dst, RefDst, sizeof(Dst)) ||
            memcmp(Dst2, RefDst2, sizeof(Dst2)))
          fail(Combined[C].Name, N, Trial, "integer output or canary mismatch");
        if (Result[0] != RefResult[0] || Result[2] != RefResult[2] ||
            !equal_fp(Result[1], RefResult[1], Combined[C].Relaxed,
                      FPInput, N <= 1024 ? N : 0, Start, Trial))
          fail(Combined[C].Name, N, Trial, "FP result or canary mismatch");
        ++Runs;
      }
  for (unsigned C = 0; C < sizeof(Inductions) / sizeof(*Inductions); ++C)
    for (unsigned Trial = 0; Trial < 200; ++Trial) {
      for (unsigned I = 0; I < 1026; ++I) Input[I] = random_value();
      for (unsigned I = 0; I < 10; ++I) Out[I] = RefOut[I] = random_value();
      Inductions[C].Reference(Input, RefOut + 1, Steps[Trial % 5]);
      Inductions[C].Fn(Input, Out + 1, Steps[Trial % 5]);
      if (memcmp(Out, RefOut, sizeof(Out)))
        fail(Inductions[C].Name, 257, Trial, "induction result mismatch");
      ++Runs;
    }
  for (unsigned C = 0; C < sizeof(FP) / sizeof(*FP); ++C)
    for (unsigned Trial = 0; Trial < 200; ++Trial) {
      fill_fp(FPInput, 1026, Trial);
      for (unsigned I = 0; I < 7; ++I) Result[I] = RefResult[I] = I + 0.25;
      ref_fp_reordering(FPInput, RefResult + 1);
      FP[C].Fn(FPInput, Result + 1);
      if (Result[0] != RefResult[0] || Result[6] != RefResult[6])
        fail(FP[C].Name, 65, Trial, "FP output canary mismatch");
      for (unsigned I = 1; I <= 5; ++I)
        if (!equal_fp(Result[I], RefResult[I], true, FPInput, 65, -0.0, Trial))
          fail(FP[C].Name, 65, Trial, "reordered FP mismatch");
      ++Runs;
    }
  static const uint64_t ScalarCounts[] = {
      0, 1, 2, 3, 4, 5, 7, 8, 9, 15, 16, 17, 31, 32, 33, 63, 64, 65, 66, UINT64_MAX};
  for (unsigned C = 0; C < sizeof(Scalars) / sizeof(*Scalars); ++C)
    for (unsigned K = 0; K < sizeof(ScalarCounts) / sizeof(*ScalarCounts); ++K)
      for (unsigned Trial = 0; Trial < 20; ++Trial) {
        uint64_t N = ScalarCounts[K];
        uint32_t Start = random_value();
        for (unsigned I = 0; I < 1026; ++I) Input[I] = random_value();
        // Null input exercises the entry guard for zero and invalid counts.
        const uint32_t *A = N && N <= 65 ? Input : NULL;
        uint64_t Actual[3] = {UINT64_MAX, UINT64_MAX, UINT64_MAX};
        uint64_t Expected[3] = {UINT64_MAX, UINT64_MAX, UINT64_MAX};
        Scalars[C].Reference(A, Expected + 1, N, Start);
        ScalarVectorVisits = 0;
        Scalars[C].Fn(A, Actual + 1, N, Start);
        if ((!N || N > 65) && ScalarVectorVisits)
          fail(Scalars[C].Name, (unsigned)N, Trial, "entry guard entered vector consumer");
        if (N == 65 && Scalars[C].VectorLanes <= 65 && !ScalarVectorVisits)
          fail(Scalars[C].Name, (unsigned)N, Trial, "vector consumer did not execute");
        ScalarVectorRuns += ScalarVectorVisits != 0;
        if (memcmp(Actual, Expected, sizeof(Actual)))
          fail(Scalars[C].Name, (unsigned)N, Trial,
               "early scalar integer result or canary mismatch");
        // Also exercise input/output aliasing: the original loop is read-only,
        // so scratch cannot require an invented noalias contract.
        _Alignas(uint64_t) uint32_t Alias[66], RefAlias[66];
        memcpy(Alias, Input, sizeof(Alias));
        memcpy(RefAlias, Input, sizeof(RefAlias));
        Scalars[C].Reference(RefAlias, RefAlias, N, Start);
        Scalars[C].Fn(Alias, Alias, N, Start);
        if (memcmp(Alias, RefAlias, sizeof(Alias)))
          fail(Scalars[C].Name, (unsigned)N, Trial, "input/output alias mismatch");
        Runs += 2;
      }
  for (unsigned C = 0; C < sizeof(ScalarMixed) / sizeof(*ScalarMixed); ++C)
    for (unsigned K = 0; K < sizeof(ScalarCounts) / sizeof(*ScalarCounts); ++K)
      for (unsigned Trial = 0; Trial < 20; ++Trial) {
        uint64_t N = ScalarCounts[K];
        double Start = Trial % 8 == 2 ? -0.0 : Trial % 8 == 3 ? 1.0 : 3.5;
        for (unsigned I = 0; I < 1026; ++I) Input[I] = random_value();
        fill_fp(FPInput, 1026, Trial);
        const uint32_t *A = N && N <= 65 ? Input : NULL;
        const double *D = N && N <= 65 ? FPInput : NULL;
        for (unsigned I = 0; I < 10; ++I) Out[I] = RefOut[I] = random_value();
        double ActualD[3] = {19.5, 7.0, 3.25}, ExpectedD[3] = {19.5, 7.0, 3.25};
        float ActualF[3] = {19.5f, 7.0f, 3.25f}, ExpectedF[3] = {19.5f, 7.0f, 3.25f};
        ref_scalar_mixed(A, D, RefOut + 1, ExpectedD + 1, ExpectedF + 1, N, Start);
        ScalarVectorVisits = 0;
        ScalarMixed[C].Fn(A, D, Out + 1, ActualD + 1, ActualF + 1, N, Start);
        if ((!N || N > 65) && ScalarVectorVisits)
          fail(ScalarMixed[C].Name, (unsigned)N, Trial, "entry guard entered FP consumer");
        if (N == 65 && ScalarMixed[C].VectorLanes <= 65 && !ScalarVectorVisits)
          fail(ScalarMixed[C].Name, (unsigned)N, Trial, "vector FP consumer did not execute");
        ScalarVectorRuns += ScalarVectorVisits != 0;
        if (memcmp(Out, RefOut, sizeof(Out)) ||
            memcmp(ActualD, ExpectedD, sizeof(ActualD)) ||
            memcmp(ActualF, ExpectedF, sizeof(ActualF)))
          fail(ScalarMixed[C].Name, (unsigned)N, Trial,
               "early scalar ordered FP, integer, or canary mismatch");
        ++Runs;
      }
  for (unsigned C = 0; C < sizeof(ScalarDiamond) / sizeof(*ScalarDiamond); ++C)
    for (unsigned K = 0; K < sizeof(ScalarCounts) / sizeof(*ScalarCounts); ++K)
      for (unsigned Trial = 0; Trial < 40; ++Trial) {
        uint64_t N = ScalarCounts[K];
        bool Enter = N && N <= 65;
        unsigned Pattern = Trial % 5;
        double Start = Trial % 8 == 2 ? -0.0 : Trial % 8 == 3 ? 1.0 : 3.5;
        for (unsigned I = 0; I < 1026; ++I) {
          bool Divide = Pattern == 0 ? true : Pattern == 1 ? false :
                        Pattern == 2 ? I % 2 : Pattern == 3 ? (I / 7) % 2 :
                        random_value() % 2;
          int32_t Denominator = (int32_t)(I % 31 + 1);
          if (Trial % 2) Denominator = -Denominator;
          Input[I] = Divide ? (uint32_t)Denominator : 0;
        }
        fill_fp(FPInput, 1026, Trial);
        // All-divide calls supply null for the untaken load arm. All-load
        // calls supply zero divisors for the untaken arithmetic arm.
        const uint32_t *A = Enter ? Input : NULL;
        const double *D = Enter && Pattern != 0 ? FPInput : NULL;
        for (unsigned I = 0; I < 10; ++I) Out[I] = RefOut[I] = random_value();
        double ActualD[3] = {19.5, 7.0, 3.25}, ExpectedD[3] = {19.5, 7.0, 3.25};
        float ActualF[3] = {19.5f, 7.0f, 3.25f}, ExpectedF[3] = {19.5f, 7.0f, 3.25f};
        ref_scalar_diamond(A, D, RefOut + 1, ExpectedD + 1, ExpectedF + 1, N, Start);
        ScalarVectorVisits = ScalarTailVisits = 0;
        ScalarDiamond[C].Fn(A, D, Out + 1, ActualD + 1, ActualF + 1, N, Start);
        unsigned Lanes = ScalarDiamond[C].VectorLanes;
        if (!Enter && (ScalarVectorVisits || ScalarTailVisits))
          fail(ScalarDiamond[C].Name, (unsigned)N, Trial, "diamond guard entered consumer");
        if (Enter && (N == 1 || N == 65) &&
            (ScalarVectorVisits != N / Lanes || ScalarTailVisits != N % Lanes))
          fail(ScalarDiamond[C].Name, (unsigned)N, Trial,
               "diamond vector/scalar consumer participation mismatch");
        ScalarVectorRuns += ScalarVectorVisits != 0;
        if (memcmp(Out, RefOut, sizeof(Out)) ||
            memcmp(ActualD, ExpectedD, sizeof(ActualD)) ||
            memcmp(ActualF, ExpectedF, sizeof(ActualF)))
          fail(ScalarDiamond[C].Name, (unsigned)N, Trial,
               "diamond shared integer, ordered FP or canary mismatch");
        uint32_t Alias[66], RefAlias[66];
        memcpy(Alias, Input, sizeof(Alias));
        memcpy(RefAlias, Input, sizeof(RefAlias));
        ref_scalar_diamond(RefAlias, D, RefAlias, ExpectedD + 1, ExpectedF + 1, N, Start);
        ScalarDiamond[C].Fn(Alias, D, Alias, ActualD + 1, ActualF + 1, N, Start);
        if (memcmp(Alias, RefAlias, sizeof(Alias)) ||
            memcmp(ActualD, ExpectedD, sizeof(ActualD)) ||
            memcmp(ActualF, ExpectedF, sizeof(ActualF)))
          fail(ScalarDiamond[C].Name, (unsigned)N, Trial, "diamond alias mismatch");
        Runs += 2;
      }
  for (unsigned C = 0; C < sizeof(ScalarConstants) / sizeof(*ScalarConstants); ++C)
    for (unsigned Trial = 0; Trial < 200; ++Trial) {
      uint32_t X = random_value();
      ScalarVectorVisits = 0;
      if (ScalarConstants[C].Fn(X) != ScalarConstants[C].Reference(X))
        fail(ScalarConstants[C].Name, 200, Trial, "constant/narrow trip mismatch");
      if (ScalarConstants[C].RequireVector && !ScalarVectorVisits)
        fail(ScalarConstants[C].Name, 200, Trial, "narrow IV vector consumer did not execute");
      ScalarVectorRuns += ScalarVectorVisits != 0;
      ++Runs;
    }
  static const uint64_t RowCounts[] = {0, 1, 2, 4, 5, UINT64_MAX};
  for (unsigned C = 0; C < sizeof(ScalarNested) / sizeof(*ScalarNested); ++C)
    for (unsigned R = 0; R < sizeof(RowCounts) / sizeof(*RowCounts); ++R)
      for (unsigned K = 0; K < sizeof(ScalarCounts) / sizeof(*ScalarCounts); ++K)
        for (unsigned Trial = 0; Trial < 20; ++Trial) {
          uint64_t Rows = RowCounts[R], N = ScalarCounts[K];
          bool Enter = Rows && Rows <= 4 && N && N <= 65;
          double Start = Trial % 8 == 2 ? -0.0 : Trial % 8 == 3 ? 1.0 : 3.5;
          for (unsigned I = 0; I < 1026; ++I) Input[I] = random_value();
          fill_fp(FPInput, 1026, Trial);
          for (unsigned I = 0; I < 10; ++I) Out[I] = RefOut[I] = random_value();
          for (unsigned I = 0; I < 7; ++I) Result[I] = RefResult[I] = I + 0.25;
          // With rejected row/inner guards even the output pointers may be
          // null: no row, producer or consumer may execute.
          ScalarNested[C].Reference(Enter ? Input : NULL, Enter ? FPInput : NULL,
                                    Enter ? RefOut + 1 : NULL,
                                    Enter ? RefResult + 1 : NULL, Rows, N, Start);
          ScalarVectorVisits = 0;
          ScalarTailVisits = 0;
          ScalarNested[C].Fn(Enter ? Input : NULL, Enter ? FPInput : NULL,
                             Enter ? Out + 1 : NULL, Enter ? Result + 1 : NULL,
                             Rows, N, Start);
          if (!Enter && ScalarVectorVisits)
            fail(ScalarNested[C].Name, (unsigned)N, Trial,
                 "nested entry guard entered consumer");
          if (ScalarNested[C].ProbeTail &&
              ((!Enter && ScalarTailVisits) ||
               (Enter && (N == 1 || N == 65) &&
                ScalarTailVisits != Rows * (N % ScalarNested[C].VectorLanes))))
            fail(ScalarNested[C].Name, (unsigned)N, Trial,
                 "nested diamond scalar-tail participation mismatch");
          if (Enter && N == 65 && ScalarNested[C].VectorLanes <= N) {
            // There must be at least one vector-header visit per row, not
            // merely a single entry somewhere in the enclosing function.
            unsigned PerRow = (unsigned)N / ScalarNested[C].VectorLanes;
            if (ScalarVectorVisits != Rows * PerRow)
              fail(ScalarNested[C].Name, (unsigned)N, Trial,
                   "repeated inner vector consumer did not execute for every row");
          }
          ScalarVectorRuns += ScalarVectorVisits != 0;
          if (memcmp(Out, RefOut, sizeof(Out)) ||
              memcmp(Result, RefResult, sizeof(Result)))
            fail(ScalarNested[C].Name, (unsigned)N, Trial,
                 "nested integer, ordered FP, exported result or canary mismatch");
          // Store row outputs into a future row's inputs. This preserves the
          // real outer dependence: the next producer must see those stores.
          uint32_t Alias[262], RefAlias[262];
          double DAlias[262], RefDAlias[262];
          memcpy(Alias, Input, sizeof(Alias));
          memcpy(RefAlias, Input, sizeof(RefAlias));
          memcpy(DAlias, FPInput, sizeof(DAlias));
          memcpy(RefDAlias, FPInput, sizeof(RefDAlias));
          ScalarNested[C].Reference(RefAlias, RefDAlias, RefAlias + 65, RefDAlias + 65,
                                    Rows, N, Start);
          ScalarNested[C].Fn(Alias, DAlias, Alias + 65, DAlias + 65, Rows, N, Start);
          if (memcmp(Alias, RefAlias, sizeof(Alias)) ||
              memcmp(DAlias, RefDAlias, sizeof(DAlias)))
            fail(ScalarNested[C].Name, (unsigned)N, Trial,
                 "nested future-input alias or scratch reuse mismatch");
          Runs += 2;
        }
  // Independent N and P sweeps: in addition to guarded original counts, hold
  // N=65 and exercise EVERY compact count P=0..65 in permuted iteration order.
  // This reaches vector boundaries and tails based on P rather than N.
  unsigned CountCases = sizeof(ScalarCounts) / sizeof(*ScalarCounts);
  for (unsigned C = 0; C < sizeof(Compact) / sizeof(*Compact); ++C)
    for (unsigned K = 0; K < CountCases + 66; ++K)
      for (unsigned Trial = 0; Trial < 16; ++Trial) {
        uint64_t N = K < CountCases ? ScalarCounts[K] : 65;
        bool Enter = N && N <= 65;
        unsigned P = 0, Lanes = Compact[C].VectorLanes;
        double Start = Trial % 2 ? 3.5 : -0.0;
        for (unsigned I = 0; I < 66; ++I) {
          unsigned Pattern = Trial % 8;
          bool Active = K >= CountCases ? (I * 7 + Trial) % 65 < K - CountCases :
                        Pattern == 0 ? false : Pattern == 1 ? true :
                        Pattern == 2 ? I == N / 2 : Pattern == 3 ? I + 1 == N :
                        Pattern == 4 ? I % 2 : Pattern == 5 ? (I / 7) % 2 :
                        Pattern == 6 ? I % 13 == 0 : random_value() % 2;
          Input[I] = Active ? I % 31 + 1 : 0;
          if (Enter && I < N && Active) ++P;
          switch (Trial / 2) {
          case 0: FPInput[I] = -0.0; break;
          case 1: FPInput[I] = (double[]){1e16, 1.0, -1e16, 0.0}[I % 4]; break;
          case 2: FPInput[I] = INFINITY; break;
          case 3: FPInput[I] = -INFINITY; break;
          case 4: FPInput[I] = NAN; break;
          case 5: FPInput[I] = 0x1p-1074; break;
          case 6: FPInput[I] = 0x1p-149; break;
          default: FPInput[I] = (double)(int32_t)random_value() / 1024.0; break;
          }
        }
        // P=0: every divisor is zero and every conditional FP pointer is null.
        const uint32_t *A = Enter ? Input : NULL;
        const double *D = P ? FPInput : NULL;
        for (unsigned I = 0; I < 10; ++I) Out[I] = RefOut[I] = random_value();
        double ActualD[3] = {19.5, 7.0, 3.25}, ExpectedD[3] = {19.5, 7.0, 3.25};
        float ActualF[3] = {19.5f, 7.0f, 3.25f}, ExpectedF[3] = {19.5f, 7.0f, 3.25f};
        Compact[C].Reference(A, D, RefOut + 1, ExpectedD + 1, ExpectedF + 1, N, Start);
        reset_compact_probes();
        Compact[C].Fn(A, D, Out + 1, ActualD + 1, ActualF + 1, N, Start);
        check_compact_probes(Compact[C].Name, (unsigned)N, Trial, Enter ? N : 0,
                              P, P / Lanes, P % Lanes);
        if (memcmp(Out, RefOut, sizeof(Out)) ||
            !compact_doubles_equal(ActualD, ExpectedD, 3) ||
            !compact_floats_equal(ActualF, ExpectedF, 3))
          fail(Compact[C].Name, (unsigned)N, Trial, "compact ordered result/canary mismatch");
        // Repeated invocation overwrites the same scratch, with final outputs
        // aliasing both integer predicates and floating contributions.
        uint32_t Alias[66], RefAlias[66];
        double DAlias[66], RefDAlias[66];
        memcpy(Alias, Input, sizeof(Alias));
        memcpy(RefAlias, Input, sizeof(RefAlias));
        memcpy(DAlias, FPInput, sizeof(DAlias));
        memcpy(RefDAlias, FPInput, sizeof(RefDAlias));
        Compact[C].Reference(RefAlias, P ? RefDAlias : NULL, RefAlias, RefDAlias,
                              ExpectedF + 1, N, Start);
        reset_compact_probes();
        Compact[C].Fn(Alias, P ? DAlias : NULL, Alias, DAlias, ActualF + 1, N, Start);
        check_compact_probes(Compact[C].Name, (unsigned)N, Trial, Enter ? N : 0,
                              P, P / Lanes, P % Lanes);
        if (memcmp(Alias, RefAlias, sizeof(Alias)) ||
            !compact_doubles_equal(DAlias, RefDAlias, 66) ||
            !compact_floats_equal(ActualF, ExpectedF, 3))
          fail(Compact[C].Name, (unsigned)N, Trial, "compact input/output alias mismatch");
        Runs += 2;
      }
  for (unsigned C = 0; C < sizeof(CompactInteger) / sizeof(*CompactInteger); ++C)
    for (unsigned K = 0; K < CountCases + 66; ++K) {
      uint64_t N = K < CountCases ? ScalarCounts[K] : 65;
      bool Enter = N && N <= 65;
      unsigned P = 0, Lanes = CompactInteger[C].VectorLanes;
      for (unsigned I = 0; I < 66; ++I) {
        Input[I] = (I * 7 + 3) % 65 < (K < CountCases ? 33 : K - CountCases)
                     ? random_value() : 0;
        if (Enter && I < N && Input[I]) ++P;
      }
      uint64_t Actual[3] = {19, 7, 23}, Expected[3] = {19, 7, 23};
      uint32_t Start = random_value();
      CompactInteger[C].Reference(Enter ? Input : NULL, Expected + 1, N, Start);
      reset_compact_probes();
      CompactInteger[C].Fn(Enter ? Input : NULL, Actual + 1, N, Start);
      check_compact_probes(CompactInteger[C].Name, (unsigned)N, K, Enter ? N : 0,
                            P, P / Lanes, P % Lanes);
      if (memcmp(Actual, Expected, sizeof(Actual)))
        fail(CompactInteger[C].Name, (unsigned)N, K, "compact i64 result/flags mismatch");
      ++Runs;
    }
  for (unsigned C = 0; C < sizeof(CompactNested) / sizeof(*CompactNested); ++C)
    for (unsigned R = 0; R < sizeof(RowCounts) / sizeof(*RowCounts); ++R)
      for (unsigned K = 0; K < CountCases; ++K)
        for (unsigned Trial = 0; Trial < 8; ++Trial) {
          uint64_t Rows = RowCounts[R], N = ScalarCounts[K];
          bool Enter = Rows && Rows <= 4 && N && N <= 65;
          unsigned P = 0, V = 0, T = 0, Lanes = CompactNested[C].VectorLanes;
          for (unsigned I = 0; I < 262; ++I) {
            // Alternate empty/full rows, plus one, sparse and random rows.
            bool Active = Trial == 0 ? false : Trial == 1 ? true :
                          Trial == 2 ? I % 65 == 64 : Trial == 3 ? (I / 65) % 2 :
                          Trial == 4 ? I % 17 == 0 : random_value() % 2;
            Input[I] = (random_value() & ~1u) | Active;
          }
          fill_fp(FPInput, 262, Trial);
          if (Enter)
            compact_nested_counts(Input, Rows, N, Lanes, false, &P, &V, &T);
          double Start = Trial % 2 ? 3.5 : -0.0;
          for (unsigned I = 0; I < 10; ++I) Out[I] = RefOut[I] = random_value();
          for (unsigned I = 0; I < 7; ++I) Result[I] = RefResult[I] = I + 0.25;
          CompactNested[C].Reference(Enter ? Input : NULL, P ? FPInput : NULL,
                                      Enter ? RefOut + 1 : NULL, Enter ? RefResult + 1 : NULL,
                                      Rows, N, Start);
          reset_compact_probes();
          CompactNested[C].Fn(Enter ? Input : NULL, P ? FPInput : NULL,
                               Enter ? Out + 1 : NULL, Enter ? Result + 1 : NULL,
                               Rows, N, Start);
          check_compact_probes(CompactNested[C].Name, (unsigned)N, Trial,
                                Enter ? Rows * N : 0, P, V, T);
          if (memcmp(Out, RefOut, sizeof(Out)) || memcmp(Result, RefResult, sizeof(Result)))
            fail(CompactNested[C].Name, (unsigned)N, Trial, "compact nested carry/reuse mismatch");
          uint32_t Alias[262], RefAlias[262], CountAlias[262];
          double DAlias[262], RefDAlias[262];
          memcpy(Alias, Input, sizeof(Alias));
          memcpy(RefAlias, Input, sizeof(RefAlias));
          memcpy(CountAlias, Input, sizeof(CountAlias));
          memcpy(DAlias, FPInput, sizeof(DAlias));
          memcpy(RefDAlias, FPInput, sizeof(RefDAlias));
          if (Enter)
            compact_nested_counts(CountAlias, Rows, N, Lanes, true, &P, &V, &T);
          CompactNested[C].Reference(RefAlias, RefDAlias, RefAlias + 65, RefDAlias + 65,
                                      Rows, N, Start);
          reset_compact_probes();
          CompactNested[C].Fn(Alias, DAlias, Alias + 65, DAlias + 65, Rows, N, Start);
          check_compact_probes(CompactNested[C].Name, (unsigned)N, Trial,
                                Enter ? Rows * N : 0, P, V, T);
          if (memcmp(Alias, RefAlias, sizeof(Alias)) ||
              memcmp(DAlias, RefDAlias, sizeof(DAlias)))
            fail(CompactNested[C].Name, (unsigned)N, Trial, "compact nested future-row alias mismatch");
          Runs += 2;
        }
  printf("PASS: %u executions; integer and ordered FP exact; relaxed FP "
         "classification/signed-zero/error bounds; max absolute FP difference %.17g\n",
         Runs, MaxError);
  printf("Early scalar fission: %u host comparisons entered a vector consumer\n",
         ScalarVectorRuns);
  printf("Compact streams: exact integer/non-NaN FP bits; NaNs by classification; "
         "exact producer/participant/vector/tail counts\n");
  return 0;
}
