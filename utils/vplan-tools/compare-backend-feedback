#!/usr/bin/env python3
"""Compare the LV receipt dump with a legacy analytics-only collection."""
import argparse
import json
from pathlib import Path
import sys

from feedback_comparison import compare_collection
from model_errors import ToolError


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--middle-end', type=Path, required=True, help='feedback JSONL or stderr dump')
    parser.add_argument('--backend-dir', type=Path, required=True, help='legacy meta-compiler work directory')
    parser.add_argument('--output', type=Path, required=True, help='full comparison, including field differences')
    args = parser.parse_args()
    try:
        result = compare_collection(args.middle_end, args.backend_dir)
        args.output.parent.mkdir(parents=True, exist_ok=True)
        args.output.write_text(json.dumps(result, indent=2, sort_keys=True) + '\n')
        print(f"equal={result['equal']} different={result['different']} "
              f"unavailable_or_missing={result['unavailable_or_missing']} "
              f"population_equal={result['population_equal']}")
        return 0 if result['all_equal'] else 1
    except (ToolError, OSError, ValueError, KeyError, TypeError) as exc:
        print(str(exc), file=sys.stderr)
        return 2


if __name__ == '__main__':
    sys.exit(main())
