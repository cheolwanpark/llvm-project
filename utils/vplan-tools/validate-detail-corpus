#!/usr/bin/env python3
"""Collect ordinary LLVM detail for each DB benchmark and validate report v2."""
from collections import Counter
import sys

import vplan_tools as vt
from provenance import snapshot
from vplan_report import parse_reports


def walk(nodes):
    for node in nodes:
        yield node
        yield from walk(node.get('events', []))
        yield from walk(node.get('children', []))


def main(argv=None):
    parser = vt.argument_parser(__doc__)
    parser.add_argument('--output-dir', type=vt.resolved_path, required=True)
    parser.add_argument('--benchmark')
    parser.add_argument('--skip-build', action='store_true')
    args = parser.parse_args(argv)
    if args.output_dir.exists() and any(args.output_dir.iterdir()):
        raise vt.ToolError('--output-dir must be new or empty')
    benchmarks, metadata = vt.load_database(args.db, benchmark_id=args.benchmark)
    if not benchmarks:
        raise vt.ToolError('no matching benchmarks')
    clang = ((args.build_dir or args.llvm_path / 'build-vplan-tools') / 'bin/clang' if args.skip_build
             else vt.ensure_compiler(args.llvm_path, args.build_dir, args.jobs))
    args.output_dir.mkdir(parents=True, exist_ok=True)
    summary = dict(schema_version=1, complete=False, successful=False,
        provenance=snapshot(args.llvm_path, args.db, clang), metadata=metadata,
        benchmarks=[], reports=0, unsupported=0, errors=0, record_counts={})
    counts = Counter()
    for index, b in enumerate(benchmarks, 1):
        print(f'[{index}/{len(benchmarks)}] {b.id}', file=sys.stderr, flush=True)
        directory = args.output_dir / vt.report_name(b.id)
        directory.mkdir()
        row = dict(id=b.id, raw=str(directory / 'detail.txt'), json=str(directory / 'detail.json'))
        try:
            result = vt.compile_report(clang, b, True, args.timeout, compiler_mode='direct',
                meta_script=args.llvm_path / 'utils/vplan-meta-compile', artifacts_dir=directory / 'source')
            (directory / 'detail.txt').write_text(result.stderr)
            if result.returncode:
                raise vt.ToolError(f'compiler exited {result.returncode}')
            parsed = parse_reports(result.stderr, stage='ordinary-llvm')
            vt.write_json(directory / 'detail.json', parsed)
            row.update(status='validated', reports=len(parsed['reports']))
            summary['reports'] += row['reports']
            summary['unsupported'] += len(parsed['unsupported'])
            for r in parsed['reports']:
                counts.update(n['kind'] for n in walk(r['events']))
                for p in r['plans']:
                    for e in p['evaluations']:
                        counts.update(n['kind'] for n in walk(e['events']))
        except (vt.ToolError, OSError, ValueError) as exc:
            row.update(status='error', reason=str(exc))
            summary['errors'] += 1
            print(str(exc), file=sys.stderr, flush=True)
        summary['benchmarks'].append(row)
        summary['record_counts'] = dict(sorted(counts.items()))
        vt.write_json(args.output_dir / 'summary.json', summary)
    summary.update(complete=True, successful=summary['errors'] == 0 and summary['unsupported'] == 0)
    vt.write_json(args.output_dir / 'summary.json', summary)
    print(f"Validated {summary['reports']} reports; errors={summary['errors']}, unsupported={summary['unsupported']}")
    return 0 if summary['successful'] else 1


if __name__ == '__main__':
    vt.cli(main)
