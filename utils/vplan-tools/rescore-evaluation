#!/usr/bin/env python3
"""Rescore a saved port evaluation without recompilation or a measurement DB."""
import argparse
import json
from pathlib import Path
import shutil

from cost_model import Settings, add_arguments, identity, rescore
from evaluation import compare, evaluate, print_metrics, summarize_rows
from model_errors import ToolError
import vplan_tools as vt


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--evaluation', type=Path, required=True)
    parser.add_argument('--output-dir', type=Path, required=True)
    add_arguments(parser)
    args = parser.parse_args()
    settings = Settings.from_args(args)
    source = json.loads((args.evaluation / 'summary.json').read_text())
    if not source['complete'] or not source['successful']: raise ToolError('source evaluation must be complete and successful')
    expected = identity(settings)
    for key in ('model', 'implementation_digest', 'datasheet_digest', 'observation_schema', 'stage'):
        if source['identity'].get(key) != expected[key]: raise ToolError('incompatible saved model: ' + key)
    if args.output_dir.exists() and any(args.output_dir.iterdir()): raise ToolError('output directory must be new or empty')
    args.output_dir.mkdir(parents=True, exist_ok=True)
    rows = []
    for original in source['rows']:
        if not original['eligible']:
            rows.append(original)
            continue
        name = vt.report_name(original['id']) + '.json'
        reports = json.loads((args.evaluation / 'reports' / name).read_text())
        if any(r['identity'] != source['identity'] for r in reports): raise ToolError('report identity mismatch')
        candidates = {}
        for r in reports:
            candidates.setdefault(int(r['vf'][1:]), []).append(rescore(r, settings))
        if sorted(candidates) != original['evaluated_vfs']: raise ToolError('candidate VF population changed')
        benchmark = vt.Benchmark(original['id'], original['source_split'], '', [], {},
                                 {int(v): c for v, c in original['measured_cycles'].items()})
        benchmark.ignored_measured = {int(v): c for v, c in original['ignored_measured_cycles'].items()}
        row = evaluate(dict(benchmark=benchmark, candidates=candidates, reason=None,
                            coverage=original['candidate_coverage']), settings)
        rows.append(row)
        vt.write_json(args.output_dir / 'reports' / name, [r for group in candidates.values() for r in group])
    result = {k: source[k] for k in ('schema', 'compiler_context', 'dataset_fingerprint', 'metadata')}
    result.update(complete=True, successful=any(r['eligible'] for r in rows), identity=expected,
                  rows=rows, metrics=summarize_rows(rows), source_evaluation=str(args.evaluation.resolve()),
                  replay_required=False, baseline_required=source['baseline_required'],
                  validation='ranking-only; no replay for these settings')
    baseline_path = args.evaluation / 'baseline.json'
    if baseline_path.exists():
        baseline = json.loads(baseline_path.read_text())
        result['comparison'] = compare(rows, baseline['rows'])
        shutil.copyfile(baseline_path, args.output_dir / 'baseline.json')
    vt.write_json(args.output_dir / 'summary.json', result)
    print_metrics(expected['model'], result['metrics'])
    return 0


if __name__ == '__main__': vt.cli(main)
