#ifndef VPLAN_TOOLS_CMATH
#define VPLAN_TOOLS_CMATH
#include <math.h>
#include <stdlib.h>
#define VPLAN_MATH_OVERLOAD(name) \
  inline float name(float x) { return ::name##f(x); } \
  inline long double name(long double x) { return ::name##l(x); }
VPLAN_MATH_OVERLOAD(fabs)
VPLAN_MATH_OVERLOAD(sqrt)
VPLAN_MATH_OVERLOAD(sin)
VPLAN_MATH_OVERLOAD(cos)
VPLAN_MATH_OVERLOAD(exp)
VPLAN_MATH_OVERLOAD(log)
VPLAN_MATH_OVERLOAD(log10)
VPLAN_MATH_OVERLOAD(floor)
VPLAN_MATH_OVERLOAD(ceil)
#undef VPLAN_MATH_OVERLOAD
inline float abs(float x) { return ::fabsf(x); }
inline double abs(double x) { return ::fabs(x); }
inline long double abs(long double x) { return ::fabsl(x); }
namespace std {
using ::abs; using ::fabs; using ::sqrt; using ::sin; using ::cos;
using ::exp; using ::log; using ::log10; using ::floor; using ::ceil;
using ::pow; using ::fmin; using ::fmax;
}
#endif
