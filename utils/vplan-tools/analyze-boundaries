#!/usr/bin/env python3
"""Exact one-coefficient argmin regions from saved candidate cost features."""
import argparse
import csv
from fractions import Fraction as Q
import json
import math
from pathlib import Path

import vplan_tools as vt


def region(lines, chosen):
    """Intersect all pairwise inequalities on x>=0, including tie ownership.

    Each line is (VF, candidate ID, intercept, slope). The lexicographic
    VF/ID tie-break agrees with selection; same-VF plan ties do not affect VF.
    """
    lo, hi, lc, hc = Q(0), None, True, False
    for other in lines:
        if other is chosen:
            continue
        d, rhs = chosen[3] - other[3], other[2] - chosen[2]
        closed = chosen[:2] < other[:2]
        if not d:
            if rhs < 0 or (rhs == 0 and not closed):
                return None
            continue
        bound = rhs / d
        if d > 0:
            if hi is None or bound < hi:
                hi, hc = bound, closed
            elif bound == hi:
                hc &= closed
        else:
            if bound > lo:
                lo, lc = bound, closed
            elif bound == lo:
                lc &= closed
    if hi is not None and (lo > hi or (lo == hi and not (lc and hc))):
        return None
    return dict(lower=lo, upper=hi, lower_closed=lc, upper_closed=hc)


def contains(interval, x):
    return (x > interval['lower'] or (x == interval['lower'] and interval['lower_closed'])) and (
        interval['upper'] is None or x < interval['upper'] or
        (x == interval['upper'] and interval['upper_closed']))


def atoms(points):
    """Partition only at exact argmin boundaries, not at sampled coefficients."""
    points = sorted({Q(0)} | set(points))
    for i, p in enumerate(points):
        yield dict(lower=p, upper=p, lower_closed=True, upper_closed=True), p
        end = points[i + 1] if i + 1 < len(points) else None
        yield dict(lower=p, upper=end, lower_closed=False, upper_closed=False), (
            (p + end) / 2 if end is not None else p + 1)


def interval_text(r):
    lo, hi = r['lower'], r['upper']
    if lo == hi:
        return '{' + str(lo) + '}'
    return ('[' if r['lower_closed'] else '(') + str(lo) + ', ' + (
        str(hi) if hi is not None else 'inf') + (']' if r['upper_closed'] else ')')


def analyze(cases, key, coefficients):
    result, points = [], set()
    for case in cases:
        lines = [(r['vf'], r['candidate'], sum(Q(v) * Q(coefficients[k])
                  for k, v in r['features'].items() if k != key), Q(r['features'][key]))
                 for r in case['candidates']]
        segments = []
        for line in lines:
            r = region(lines, line)
            if r is None:
                continue
            points.add(r['lower'])
            if r['upper'] is not None:
                points.add(r['upper'])
            cycles = case['cycles'][line[0]]
            regret = Q(cycles) / Q(case['oracle_cycles']) - 1
            delta = (Q(cycles) - Q(case['baseline_cycles'])) / Q(case['oracle_cycles'])
            segments.append(r | dict(vf=line[0], candidate=line[1], cycles=cycles,
                                     cycle_change=Q(cycles) / Q(case['baseline_cycles']) - 1,
                                     regret=regret, regret_delta=delta, within_15pp=delta <= Q(15, 100)))
        segments.sort(key=lambda r: (r['lower'], not r['lower_closed'], r['vf']))
        result.append(dict(id=case['id'], baseline_vf=case['baseline_vf'], oracle_vf=case['oracle_vf'],
                           baseline_regret=Q(case['baseline_cycles']) / Q(case['oracle_cycles']) - 1,
                           segments=segments,
                           keep=[s for s in segments if s['vf'] == case['baseline_vf']],
                           oracle=[s for s in segments if s['vf'] == case['oracle_vf']],
                           improve=[s for s in segments if s['cycle_change'] < 0],
                           within_15pp=[s for s in segments if s['within_15pp']]))
    global_regions = []
    for r, x in atoms(points):
        selected = [next(s for s in case['segments'] if contains(s, x)) for case in result]
        signature = [s['vf'] for s in selected]
        # Merge neighboring atoms with the same selection vector, retaining
        # isolated tie points when their selection differs on both sides.
        if global_regions and global_regions[-1]['selected_vfs'] == signature:
            global_regions[-1].update(upper=r['upper'], upper_closed=r['upper_closed'])
            continue
        metrics = dict(mean_regret=sum(Q(s['cycles']) / Q(c['oracle_cycles']) - 1
                                      for s, c in zip(selected, cases)) / len(cases),
                       correct=sum(s['vf'] == c['oracle_vf'] for s, c in zip(selected, cases)),
                       improvements=sum(s['cycle_change'] < 0 for s in selected),
                       regressions=sum(s['cycle_change'] > 0 for s in selected),
                       unchanged=sum(s['vf'] == c['baseline_vf'] for s, c in zip(selected, cases)),
                       within_15pp=sum(s['within_15pp'] for s in selected),
                       total=len(cases), worst_regret=max(s['regret'] for s in selected),
                       median_regret=vt.percentile([float(s['regret']) for s in selected], .5),
                       p95_regret=vt.percentile([float(s['regret']) for s in selected], .95))
        changes = [dict(id=c['id'], before=c['baseline_vf'], after=s['vf'],
                        cycle_change=s['cycle_change'], regret=s['regret'], regret_delta=s['regret_delta'],
                        within_15pp=s['within_15pp']) for c, s in zip(cases, selected)
                   if c['baseline_vf'] != s['vf']]
        contributions = sorted([dict(id=c['id'], vf=s['vf'], regret=s['regret'],
                                     mean_contribution=s['regret'] / len(cases))
                                for c, s in zip(cases, selected)], key=lambda r: (-r['regret'], r['id']))
        global_regions.append(r | dict(metrics=metrics, changes=changes, selected_vfs=signature,
                                      mean_contributions=contributions))
    for r in global_regions:
        del r['selected_vfs']
        r['contains_reference'] = contains(r, Q(coefficients[key]))
        r['width'] = interval_width(r)
    best = min(r['metrics']['mean_regret'] for r in global_regions)
    return dict(key=key, fixed={k: v for k, v in coefficients.items() if k != key}, cases=result,
                global_regions=global_regions,
                preserve_all=[r for r in global_regions if not r['changes']],
                within_15pp_all=[r for r in global_regions if r['metrics']['within_15pp'] == len(cases)],
                best=[r for r in global_regions if r['metrics']['mean_regret'] == best])


def interval_width(r):
    lo, hi = r['lower'], r['upper']
    if hi == lo: return dict(kind='isolated-point', additive=Q(0), fold=Q(1), octaves=0.)
    if hi is None: return dict(kind='unbounded-above', additive=None, fold=None, octaves=None)
    if lo == 0: return dict(kind='touches-zero', additive=hi, fold=None, octaves=None)
    return dict(kind='finite', additive=hi - lo, fold=hi / lo, octaves=math.log2(float(hi / lo)))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--evaluation', type=Path, required=True)
    parser.add_argument('--output-dir', type=Path, required=True)
    parser.add_argument('--term', action='append', required=True, metavar='NAME',
                        help='coefficient to vary over [0, infinity); repeat for independent axes')
    parser.add_argument('--set', action='append', default=[], metavar='NAME=VALUE',
                        help='override a fixed coefficient; accepts fractions such as 3/2; '
                             'baseline choices remain those in the saved evaluation')
    args = parser.parse_args()
    summary = json.loads((args.evaluation / 'summary.json').read_text())
    if not summary['complete'] or not summary['successful']:
        raise vt.ToolError('requires a complete successful evaluation')
    coefficients = dict(summary['identity']['machine_parameters']['coefficients'])
    if summary['identity']['model'] == 'mir-port-aware-v1':
        if args.term != ['body_scale'] or args.set:
            parser.error('port-aware analysis varies only body_scale; configuration and scalar tail remain fixed')
    for key in args.term:
        if key not in coefficients:
            parser.error(f'unknown term {key!r}; available: {", ".join(coefficients)}')
    for setting in args.set:
        key, separator, value = setting.partition('=')
        if not separator or key not in coefficients or key in args.term:
            parser.error('--set requires a known, non-varied NAME=VALUE')
        try:
            coefficients[key] = Q(value)
        except (ValueError, ZeroDivisionError):
            parser.error(f'invalid finite coefficient: {setting!r}')
    cases = []
    for row in summary['rows']:
        if not row['eligible']:
            continue
        reports = json.loads((args.evaluation / 'reports' / (vt.report_name(row['id']) + '.json')).read_text())
        if not all(r['identity'] == summary['identity'] and set(r['features']) == set(coefficients)
                   for r in reports):
            raise vt.ToolError('report identity/features disagree with evaluation')
        candidates = [dict(vf=int(r['vf'][1:]), candidate=r['candidate'], features=r['features']) for r in reports]
        if sorted({r['vf'] for r in candidates}) != row['evaluated_vfs']:
            raise vt.ToolError('report candidate population differs from evaluation')
        cycles = {int(v): n for v, n in row['measured_cycles'].items() if int(v) in row['evaluated_vfs']}
        oracle = min(cycles, key=lambda v: (cycles[v], v))
        cases.append(dict(id=row['id'], candidates=candidates, cycles=cycles, baseline_vf=row['selected_vf'],
                          baseline_cycles=cycles[row['selected_vf']], oracle_vf=oracle, oracle_cycles=cycles[oracle]))
    if not cases:
        raise vt.ToolError('no eligible benchmarks')
    axes = [analyze(cases, key, coefficients) for key in dict.fromkeys(args.term)]
    args.output_dir.mkdir(parents=True, exist_ok=True)
    output = dict(method='exact rational intersection of affine argmin inequalities; nonnegative unbounded coefficients',
                  scope='exact affine boundaries of persisted numeric features; smoothing/norm features are rounded constants; existing measurements, no new timings',
                  source_evaluation=str(args.evaluation), identity=summary['identity'],
                  baseline='saved evaluation selections; unchanged by coefficient overrides',
                  stability='per benchmark regret(new) <= regret(saved selection) + 0.15; diagnostic only, no acceptance threshold',
                  analysis_coefficients=coefficients,
                  dataset_fingerprint=summary['dataset_fingerprint'], candidates=cases, axes=axes)
    (args.output_dir / 'boundaries.json').write_text(json.dumps(output, indent=2, default=str) + '\n')
    with (args.output_dir / 'cases.csv').open('w', newline='') as f:
        writer = csv.writer(f)
        writer.writerow(['axis', 'benchmark', 'baseline_vf', 'oracle_vf', 'baseline_regret',
                         'keep_ranges', 'oracle_ranges', 'improvement_ranges', 'within_15pp_ranges'])
        for axis in axes:
            for c in axis['cases']:
                writer.writerow([axis['key'], c['id'], c['baseline_vf'], c['oracle_vf'], float(c['baseline_regret']),
                                 '; '.join(interval_text(s) for s in c['keep']),
                                 '; '.join(interval_text(s) for s in c['oracle']) or 'none',
                                 '; '.join(f"{interval_text(s)} -> s{s['vf']} ({float(s['cycle_change']):+.6%})"
                                           for s in c['improve']) or 'none',
                                 '; '.join(interval_text(s) for s in c['within_15pp']) or 'none'])
    for axis in axes:
        print(axis['key'], 'preserve:', [interval_text(r) for r in axis['preserve_all']],
              'best:', [(interval_text(r), float(r['metrics']['mean_regret'])) for r in axis['best']])


if __name__ == '__main__':
    main()
