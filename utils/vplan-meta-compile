#!/usr/bin/env python3
"""Rank middle-end observations in Python and replay explicit selections."""
from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path
import subprocess
import sys


sys.path.insert(0, str(Path(__file__).resolve().parent / "vplan-tools"))
from model_errors import ToolError
from observations import validate_manifest, bind_observation
from selection import load_policy, select_loops

class MetaCompileError(ToolError):
    pass


def write_json(path: Path, value) -> None:
    path.write_text(json.dumps(value, indent=2, allow_nan=False) + "\n")


def digest(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def llvm_flag(name: str, value: str) -> list[str]:
    return ["-mllvm", f"-{name}={value}"]


def resume_flags(flags: list[str]) -> list[str]:
    """Preprocessing is performed once; retain all target/codegen options."""
    out = []
    i = 0
    while i < len(flags):
        flag = flags[i]
        if flag in ("-I", "-D", "-U", "-isystem", "-idirafter", "-include", "-imacros"):
            if i + 1 == len(flags):
                raise MetaCompileError(f"missing value for {flag}")
            i += 2
            continue
        if flag.startswith(("-I", "-D", "-U", "-std=")) or flag == "-nostdlibinc":
            i += 1
            continue
        out.append(flag)
        i += 1
    return out


def validate_flags(flags: list[str]) -> None:
    # Source/output actions belong to the driver. In particular, an inherited
    # forced width would change planning before candidate enumeration.
    forbidden = ("-o", "-c", "-S", "-emit-llvm", "-x", "-E", "-fsyntax-only")
    for i, flag in enumerate(flags):
        if flag in forbidden or flag.startswith(("-flto", "-fprofile", "-fsanitize",
                                                  "-fpass-plugin")):
            raise MetaCompileError(f"unsupported meta-compiler option: {flag}")
        if flag == "-mllvm":
            if i + 1 == len(flags):
                raise MetaCompileError("missing -mllvm argument")
            option = flags[i + 1].lstrip("-").split("=", 1)[0]
            if option.startswith(("vplan-", "force-vector-width", "stop-", "start-")):
                raise MetaCompileError(f"driver owns compiler option: {option}")


class Driver:
    def __init__(self, clang: Path, source: Path, work: Path, flags: list[str],
                 timeout: int = 120, extract_function: str | None = None,
                 llvm_extract: Path | None = None):
        self.clang = clang.resolve()
        self.source = source.resolve()
        self.work = work.resolve()
        self.flags = flags
        self.timeout = timeout
        self.commands = []
        self.extract_function = extract_function
        self.llvm_extract = llvm_extract or self.clang.parent / "llvm-extract"

    def run(self, label: str, command: list[str], *, executable: Path | None = None) -> subprocess.CompletedProcess:
        # Integrated cc1 keeps timeout cancellation from leaving a compiler
        # grandchild behind. Processes stay in the campaign's process group.
        command = ([str(executable), *command] if executable else
                   [str(self.clang), *command, "-fintegrated-cc1"])
        self.commands.append({"stage": label, "argv": command})
        write_json(self.work / "commands.json", self.commands)
        try:
            result = subprocess.run(command, capture_output=True, text=True,
                                    errors="replace", timeout=self.timeout)
        except subprocess.TimeoutExpired as exc:
            (self.work / f"{label}.stderr").write_text(
                (exc.stderr or b"").decode(errors="replace")
                if isinstance(exc.stderr, bytes) else (exc.stderr or ""))
            raise MetaCompileError(f"{label}: compiler timed out after {self.timeout}s") from exc
        (self.work / f"{label}.stdout").write_text(result.stdout)
        (self.work / f"{label}.stderr").write_text(result.stderr)
        if result.returncode:
            raise MetaCompileError(
                f"{label}: compiler failed ({result.returncode}); "
                f"see {self.work / (label + '.stderr')}\n{result.stderr}")
        return result

    def manifest(self, path: Path, run_id: str) -> dict:
        try:
            value = json.loads(path.read_text())
            validate_manifest(value, run_id)
            return value
        except (OSError, ValueError, KeyError, TypeError) as exc:
            raise MetaCompileError(f"invalid manifest {path}: {exc}") from exc

    def compile(self, output: Path | None, emit: str, stop_after_ra: bool,
                detail: bool, analytics_only: bool = False, weights_path: Path | None = None,
                spill_count_unit: str | None = None) -> dict:
        if analytics_only and not stop_after_ra:
            raise MetaCompileError("--analytics-only requires --stop-after-ra")
        if analytics_only and (weights_path or spill_count_unit):
            raise MetaCompileError("raw analytics do not consume weights or spill count options")
        policy = None if analytics_only else load_policy(weights_path=weights_path, spill_count_unit=spill_count_unit)
        validate_flags(self.flags)
        if self.work.exists() and any(self.work.iterdir()):
            raise MetaCompileError(f"work directory must be empty: {self.work}")
        self.work.mkdir(parents=True, exist_ok=True)
        checkpoint = self.work / "pre-vectorize.bc"
        self.run("prepare", [*self.flags, *llvm_flag("vplan-pipeline", "prepare"),
                             "-emit-llvm", "-c", str(self.source), "-o", str(checkpoint)])
        if self.extract_function:
            extracted = self.work / "extracted.bc"
            self.run("extract", [str(checkpoint), "--func", self.extract_function,
                                 "--recursive", "--keep-const-init", "-o", str(extracted)],
                     executable=self.llvm_extract)
            checkpoint.rename(self.work / "module-pre-vectorize.bc")
            extracted.rename(checkpoint)
        identity = {"checkpoint": digest(checkpoint), "compiler": digest(self.clang),
                    "flags": self.flags, "protocol": 3,
                    "extract_function": self.extract_function}
        run_id = hashlib.sha256(json.dumps(identity, sort_keys=True).encode()).hexdigest()
        write_json(self.work / "identity.json", identity | {"run_id": run_id})
        common = [*resume_flags(self.flags), "-x", "ir", str(checkpoint),
                  *llvm_flag("vplan-pipeline", "resume"),
                  *llvm_flag("vplan-ra-run-id", run_id)]
        report_flags = ["-mllvm", "-print-vplans", "-mllvm", "-print-detailed-vplans"] if detail else []
        manifest_path = self.work / "candidates.json"
        self.run("discover", [*common, *report_flags, *llvm_flag("vplan-candidates-output", str(manifest_path)),
                              "-S", "-emit-llvm", "-o", str(self.work / "discovery.ll")])
        manifest = self.manifest(manifest_path, run_id)
        statuses = []
        selections = []
        loops = {(r["function"], r["loop"]): r for r in manifest["loops"]}
        for index, row in enumerate(manifest["candidates"]):
            status = {"id": row["id"], "status": "unavailable"}
            statuses.append(status)
            if policy and not policy.requires_backend:
                status.update(policy.evaluate_middle_end(
                    row, loops[(row["function"], row["loop"])]))
                continue
            if not row["probeable"]:
                status["reason"] = row.get("reason", "not probeable")
                continue
            label = f"probe-{index:04d}"
            analytics_path = self.work / f"{label}.analytics.json"
            probe_manifest = self.work / f"{label}.manifest.json"
            mir = self.work / f"{label}.mir"
            try:
                self.run(label, [*common, *report_flags,
                    *llvm_flag("vplan-probe-candidate", row["id"]),
                    *llvm_flag("vplan-candidates-output", str(probe_manifest)),
                    *llvm_flag("vplan-analytics-output", str(analytics_path)),
                    *llvm_flag("stop-after", "riscv-vplan-analytics"), "-S", "-o", str(mir)])
            except MetaCompileError as exc:
                status.update(status="probe-failed", reason=str(exc))
                if probe_manifest.exists():
                    failed = self.manifest(probe_manifest, run_id)
                    if failed["candidates"] != manifest["candidates"] or failed["loops"] != manifest["loops"]:
                        raise MetaCompileError(f"{label}: candidate context changed")
                    reasons = [f["reason"] for f in failed["failures"] if f["id"] == row["id"]]
                    if reasons:
                        status["reason"] = "; ".join(reasons)
                continue
            probe = self.manifest(probe_manifest, run_id)
            if probe["candidates"] != manifest["candidates"] or probe["loops"] != manifest["loops"]:
                raise MetaCompileError(f"{label}: candidate set/context changed during replay")
            failures = [f for f in probe["failures"] if f["id"] == row["id"]]
            if failures:
                status.update(status="probe-failed", reason=failures[0]["reason"])
                continue
            choice = {"function": row["function"], "loop": row["loop"], "scalar": False,
                      "id": row["id"], "ic": 1, "epilogue_vf": "f0"}
            if probe["selections"] != [choice]:
                raise MetaCompileError(f"{label}: requested candidate/configuration not materialized")
            try:
                observation = bind_observation(json.loads(analytics_path.read_text()), row,
                    loops[(row["function"], row["loop"])], run_id)
                if not mir.is_file() or not mir.stat().st_size:
                    raise ValueError("missing MIR")
            except (OSError, ValueError) as exc:
                raise MetaCompileError(f"{label}: invalid backend result: {exc}") from exc
            status.update(status="collected", analytics=str(analytics_path), vlen=observation["VLen"])
            if not analytics_only:
                try:
                    status.update(policy.evaluate(row, observation))
                except ToolError as exc:
                    status.update(status="unsupported", reason=str(exc))
        if policy and not policy.requires_backend:
            # Check the chosen vector's materialization and runtime safety in
            # LLVM IR. This needs no RA analytics and never changes its cost.
            # Like LLVM's late rejection, a rejected winner leaves this loop
            # scalar rather than silently substituting another vector width.
            for index, choice in enumerate(select_loops(policy, manifest, statuses)):
                if choice["scalar"]:
                    continue
                label = f"check-{index:04d}"
                check_path = self.work / f"{label}.manifest.json"
                self.run(label, [*common,
                    *llvm_flag("vplan-probe-candidate", choice["id"]),
                    *llvm_flag("vplan-candidates-output", str(check_path)),
                    "-S", "-emit-llvm", "-o", str(self.work / f"{label}.ll")])
                checked = self.manifest(check_path, run_id)
                if checked["candidates"] != manifest["candidates"] or checked["loops"] != manifest["loops"]:
                    raise MetaCompileError(f"{label}: candidate context changed")
                failures = [f["reason"] for f in checked["failures"] if f["id"] == choice["id"]]
                if failures:
                    for candidate, status in zip(manifest["candidates"], statuses, strict=True):
                        if (candidate["function"], candidate["loop"]) == (choice["function"], choice["loop"]):
                            status.update(status="loop-rejected", reason="; ".join(failures))
                elif checked["selections"] != [choice]:
                    raise MetaCompileError(f"{label}: requested candidate not materialized")
        statuses_path = self.work / "candidate-status.json"
        write_json(statuses_path, {"version": 3, "run_id": run_id, "candidates": statuses,
                                   "policy": policy.identity if policy else None})
        selection_path = self.work / "selection.json"
        if not analytics_only:
            selections = select_loops(policy, manifest, statuses)
            write_json(selection_path, {"version": 3, "run_id": run_id,
                "loops": manifest["loops"], "candidates": manifest["candidates"], "selections": selections})
        result = {"version": 3, "run_id": run_id, "candidates": len(statuses),
                  "manifest": str(manifest_path), "candidate_status": str(statuses_path),
                  "stage": "middle-end" if policy and not policy.requires_backend else "post-ra-cleanup",
                  "analytics_only": analytics_only}
        if not analytics_only:
            result["selection"] = str(selection_path)
            result["policy"] = policy.identity
        if not stop_after_ra:
            if output is None:
                raise MetaCompileError("final compilation requires --output")
            output = output.resolve()
            output.parent.mkdir(parents=True, exist_ok=True)
            final_manifest = self.work / "final.manifest.json"
            actions = {"llvm": ["-S", "-emit-llvm"], "asm": ["-S"], "obj": ["-c"]}
            final = self.run("final", [*common, *llvm_flag("vplan-selection-input", str(selection_path)),
                                      *llvm_flag("vplan-candidates-output", str(final_manifest)),
                                      *report_flags, *actions[emit], "-o", str(output)])
            replay = self.manifest(final_manifest, run_id)
            if replay["candidates"] != manifest["candidates"]:
                raise MetaCompileError("final compilation regenerated a different candidate set")
            if replay["loops"] != manifest["loops"] or replay["selections"] != selections or replay["failures"]:
                raise MetaCompileError("final compilation selection/configuration mismatch")
            if not output.is_file() or not output.stat().st_size:
                raise MetaCompileError("final compilation produced no output")
            if detail:
                sys.stderr.write(final.stderr)
            result.update(stage="final", output=str(output), final_manifest=str(final_manifest))
        write_json(self.work / "result.json", result)
        return result


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--clang", required=True, type=Path)
    parser.add_argument("--input", required=True, type=Path)
    parser.add_argument("--work-dir", required=True, type=Path)
    parser.add_argument("--output", type=Path)
    parser.add_argument("--emit", choices=("llvm", "asm", "obj"), default="obj")
    parser.add_argument("--stop-after-ra", action="store_true")
    parser.add_argument("--analytics-only", action="store_true", help="collect raw facts without computing backend costs")
    parser.add_argument("--weights", type=Path, help="legacy option; rejected by the fixed policy")
    parser.add_argument("--spill-count-unit", choices=("instruction", "register"))
    parser.add_argument("--detail", action="store_true")
    parser.add_argument("--extract-function", help="isolate a function at the pre-vectorizer checkpoint")
    parser.add_argument("--llvm-extract", type=Path, help="matching llvm-extract binary")
    parser.add_argument("--timeout", type=int, default=120, help="seconds per compiler invocation")
    parser.add_argument("flags", nargs=argparse.REMAINDER)
    args = parser.parse_args(argv)
    flags = args.flags[1:] if args.flags[:1] == ["--"] else args.flags
    if args.timeout <= 0:
        parser.error("--timeout must be positive")
    if not args.stop_after_ra and args.output is None:
        parser.error("--output is required unless --stop-after-ra is used")
    try:
        result = Driver(args.clang, args.input, args.work_dir, flags, args.timeout,
                        args.extract_function, args.llvm_extract).compile(
            args.output, args.emit, args.stop_after_ra, args.detail, args.analytics_only, args.weights,
            args.spill_count_unit)
        print(json.dumps(result))
        return 0
    except (ToolError, OSError) as exc:
        print(f"meta-compiler: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
